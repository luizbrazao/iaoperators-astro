---
// Las tres puertas de la home — la traducción visual de la arquitectura del
// plan (docs/plan-arquitectura-2026-08.md, §5.3): integración como core
// evergreen primero; cumplimiento como wedge de adquisición 2026–2027 con más
// peso visual, pero en segundo lugar de la jerarquía.
//
// Sustituye al antiguo ComplianceBanner, que ocupaba el espacio bajo el hero
// con una sola intención (Ley 10/2025) antes de que la home consolidara la
// suya. La cuenta atrás de la Ley vive ahora dentro de la puerta 2.
//
// Cambio de 2026-08-10 (fase 1 del reposicionamiento): la tercera puerta deja
// de ser "servicios de agencia" —un catálogo horizontal que contradecía el
// mensaje de las otras dos— y pasa a ser el tercer pilar real: arquitectura
// tecnológica, la familia Radiografía → Roadmap → Implementación.
//
// Fase 2 (10/ago/2026): la puerta ya no entra por el paso 01 sino por el hub
// del pilar, /es/arquitectura-tecnologica/. Los tres pasos siguen enlazados
// individualmente dentro de la tarjeta.
//
// ES-only: las puertas 1 y 2 apuntan a silos que no existen en EN/PT.
import { LEY } from "@/data/sectores-sac";
import { getArquitectura, ARQUITECTURA_TITLE, ARQUITECTURA_HUB_HREF } from "@/data/servicios";

const deadline = new Date(`${LEY.plazoAdaptacion}T00:00:00+01:00`);
const diasRestantes = Math.max(
  0,
  Math.ceil((deadline.getTime() - Date.now()) / (1000 * 60 * 60 * 24)),
);

const pasos = getArquitectura("es");

const doors = [
  {
    href: "/es/integracion/",
    badge: "Core",
    title: "Integración de sistemas",
    body: "El sistema que ya tienes, conectado y automatizado: ERP, TPV, e-commerce, CRM y WhatsApp — con IA donde aporta.",
    cta: "Ver integración →",
    highlight: false,
    steps: null,
  },
  {
    href: "/es/cumplimiento/",
    badge: "Con plazo legal",
    title: "Cumplimiento tecnológico",
    body: "Verifactu y la Ley 10/2025 sin cambiar de software. Adaptamos lo que ya usas y dejamos la evidencia lista para la auditoría.",
    cta: "Ver cumplimiento →",
    highlight: true,
    steps: null,
  },
  {
    href: ARQUITECTURA_HUB_HREF,
    badge: "Base del trabajo",
    title: ARQUITECTURA_TITLE.es,
    body: "Entendemos lo que tienes, definimos qué debería cambiar y lo construimos. Tres pasos, el mismo equipo.",
    cta: "Ver arquitectura tecnológica →",
    highlight: false,
    steps: pasos,
  },
];
---

<section class="px-4 py-14">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {doors.map((door) => (
        <div
          class={`group flex flex-col rounded-3xl p-7 md:p-8 bg-[#0a0a0a] transition-all duration-300 ${
            door.highlight
              ? "border border-orange-500/40 hover:border-orange-500/70"
              : "border border-white/5 hover:border-orange-500/30"
          }`}
        >
          <span class="inline-block self-start px-3 py-1 rounded-full bg-orange-500/10 text-orange-400 text-xs font-semibold mb-4">
            {door.badge}
          </span>

          <h2 class="text-xl md:text-2xl font-semibold text-white mb-3">
            <a href={door.href} class="hover:text-orange-400 transition-colors">
              {door.title}
            </a>
          </h2>

          <p class="text-gray-400 text-sm md:text-base leading-relaxed mb-5 flex-1">{door.body}</p>

          {door.steps && (
            <ol class="mb-5 flex flex-col gap-2 border-t border-white/5 pt-5">
              {door.steps.map((paso) => (
                <li>
                  <a href={paso.href} class="flex items-baseline gap-2 group/step">
                    <span class="text-orange-400 text-xs font-bold tabular-nums">{paso.num}</span>
                    <span class="text-sm text-gray-300 group-hover/step:text-orange-400 transition-colors">
                      {paso.label}
                    </span>
                    <span class="text-xs text-gray-600">{paso.promesa}</span>
                  </a>
                </li>
              ))}
            </ol>
          )}

          {door.highlight && (
            <p class="text-xs text-gray-500 mb-4">
              Ley 10/2025:{" "}
              <span
                class="text-orange-400 font-semibold tabular-nums"
                data-home-countdown
                data-deadline={LEY.plazoAdaptacion}
              >
                {diasRestantes}
              </span>{" "}
              días de plazo · Verifactu: 2027
            </p>
          )}

          <a href={door.href} class="text-orange-400 font-medium text-sm hover:underline">
            {door.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var el = document.querySelector("[data-home-countdown]");
    if (!el) return;
    var deadline = new Date(el.getAttribute("data-deadline") + "T00:00:00+01:00").getTime();
    el.textContent = String(Math.max(0, Math.ceil((deadline - Date.now()) / 86400000)));
  })();
</script>
