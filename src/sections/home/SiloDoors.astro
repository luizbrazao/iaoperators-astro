---
// Las puertas de la home — la traducción visual de la arquitectura del plan
// (docs/plan-arquitectura-2026-08.md, §5.3): integración como core evergreen
// primero; cumplimiento como wedge de adquisición 2026–2027 con más peso
// visual, pero en segundo lugar de la jerarquía.
//
// Sustituye al antiguo ComplianceBanner, que ocupaba el espacio bajo el hero
// con una sola intención (Ley 10/2025) antes de que la home consolidara la
// suya. La cuenta atrás de la Ley vive ahora dentro de la puerta 2.
//
// Cambio de 2026-08-10 (fase 1 del reposicionamiento): la tercera puerta deja
// de ser "servicios de agencia" —un catálogo horizontal que contradecía el
// mensaje de las otras dos— y pasa a ser el tercer pilar real: arquitectura
// tecnológica, la familia Radiografía → Roadmap → Implementación.
//
// Fase 2 (10/ago/2026): la puerta ya no entra por el paso 01 sino por el hub
// del pilar. Los tres pasos siguen enlazados individualmente dentro de la
// tarjeta.
//
// Ago/2026: las puertas dejan de ser ES-only. La diferencia entre idiomas es
// una sola y es deliberada: **la puerta de cumplimiento no se traduce**. Su
// contenido es la Ley 10/2025 y Verifactu, obligaciones españolas con plazo y
// sanción; ofrecerlas en /en/ o /pt/ sería vender una urgencia que no aplica a
// quien lee. En su lugar, EN/PT reciben como tercera puerta el catálogo de
// servicios, que es donde vive el resto de la oferta. La rejilla sigue siendo
// de tres columnas en los tres idiomas.
import { LEY } from "@/data/sectores-sac";
import {
  getArquitectura,
  ARQUITECTURA_TITLE,
  arquitecturaHubHref,
  hubCtaLabel,
  SERVICE_HUB_PATH,
  type Loc,
} from "@/data/servicios";
import { integracionHref } from "@/data/integracion";

type Props = { locale?: string };
const { locale: localeProp = "es" } = Astro.props as Props;
const locale: Loc =
  localeProp === "en" || localeProp === "pt" ? (localeProp as Loc) : "es";

const deadline = new Date(`${LEY.plazoAdaptacion}T00:00:00+01:00`);
const diasRestantes = Math.max(
  0,
  Math.ceil((deadline.getTime() - Date.now()) / (1000 * 60 * 60 * 24)),
);

const pasos = getArquitectura(locale);

const COPY = {
  es: {
    integracion: {
      badge: "Core",
      title: "Integración de sistemas",
      body: "El sistema que ya tienes, conectado y automatizado: ERP, TPV, e-commerce, CRM y WhatsApp — con IA donde aporta.",
      cta: "Ver integración →",
    },
    cumplimiento: {
      badge: "Con plazo legal",
      title: "Cumplimiento tecnológico",
      body: "RRSIF/VERI*FACTU y Ley 10/2025 sobre tus sistemas actuales. Adaptamos los requisitos técnicos aplicables y construimos trazabilidad y evidencia operativa.",
      cta: "Ver cumplimiento →",
    },
    arquitectura: {
      badge: "Base del trabajo",
      body: "Entendemos lo que tienes, definimos qué debería cambiar y lo construimos. Tres pasos, el mismo equipo.",
      cta: "Ver arquitectura tecnológica →",
    },
    servicios: {
      badge: "Capacidades",
      title: "IA y servicios digitales",
      body: "Automatización, agentes, chatbots, web, SEO y marketing. Capacidades que usamos dentro de los proyectos y que también prestamos por separado.",
    },
  },
  en: {
    integracion: {
      badge: "Core",
      title: "Systems integration",
      body: "The systems you already run, connected and automated: ERP, POS, e-commerce, CRM and WhatsApp — with AI where it actually helps.",
      cta: "See integration →",
    },
    cumplimiento: null,
    arquitectura: {
      badge: "The groundwork",
      body: "We understand what you have, define what should change, and build it. Three steps, one team.",
      cta: "See technology architecture →",
    },
    servicios: {
      badge: "Capabilities",
      title: "AI and digital services",
      body: "Automation, agents, chatbots, web, SEO and marketing. Capabilities we use inside projects and also deliver on their own.",
    },
  },
  pt: {
    integracion: {
      badge: "Core",
      title: "Integração de sistemas",
      body: "Os sistemas que você já usa, conectados e automatizados: ERP, PDV, e-commerce, CRM e WhatsApp — com IA onde ela agrega.",
      cta: "Ver integração →",
    },
    cumplimiento: null,
    arquitectura: {
      badge: "Base do trabalho",
      body: "Entendemos o que você tem, definimos o que deveria mudar e construímos. Três passos, a mesma equipe.",
      cta: "Ver arquitetura tecnológica →",
    },
    servicios: {
      badge: "Capacidades",
      title: "IA e serviços digitais",
      body: "Automação, agentes, chatbots, web, SEO e marketing. Capacidades que usamos dentro dos projetos e que também prestamos separadamente.",
    },
  },
} as const;

const c = COPY[locale];

const puertaIntegracion = {
  href: integracionHref(locale),
  badge: c.integracion.badge,
  title: c.integracion.title,
  body: c.integracion.body,
  cta: c.integracion.cta,
  highlight: false,
  steps: null as typeof pasos | null,
  countdown: false,
};

const puertaCumplimiento = c.cumplimiento
  ? {
      href: "/es/cumplimiento/",
      badge: c.cumplimiento.badge,
      title: c.cumplimiento.title,
      body: c.cumplimiento.body,
      cta: c.cumplimiento.cta,
      highlight: true,
      steps: null as typeof pasos | null,
      countdown: true,
    }
  : null;

const puertaArquitectura = {
  href: arquitecturaHubHref(locale),
  badge: c.arquitectura.badge,
  title: ARQUITECTURA_TITLE[locale],
  body: c.arquitectura.body,
  cta: c.arquitectura.cta,
  highlight: false,
  steps: pasos,
  countdown: false,
};

// Tercera puerta de EN/PT: el catálogo. No es un pilar y no se presenta como
// tal —de ahí que no lleve la lista de pasos ni el badge de jerarquía—, pero
// mantiene el enlace desde la página de más autoridad del dominio hacia el hub
// de servicios, que es lo que sostiene las ocho landings en el índice.
const puertaServicios = {
  href: `/${locale}/${SERVICE_HUB_PATH}`,
  badge: c.servicios.badge,
  title: c.servicios.title,
  body: c.servicios.body,
  cta: `${hubCtaLabel(locale)} →`,
  highlight: false,
  steps: null as typeof pasos | null,
  countdown: false,
};

const doors = [
  puertaIntegracion,
  ...(puertaCumplimiento ? [puertaCumplimiento] : []),
  puertaArquitectura,
  ...(puertaCumplimiento ? [] : [puertaServicios]),
];
---

<section class="px-4 py-14">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {doors.map((door) => (
        <div
          class={`group flex flex-col rounded-3xl p-7 md:p-8 bg-[#0a0a0a] transition-all duration-300 ${
            door.highlight
              ? "border border-orange-500/40 hover:border-orange-500/70"
              : "border border-white/5 hover:border-orange-500/30"
          }`}
        >
          <span class="inline-block self-start px-3 py-1 rounded-full bg-orange-500/10 text-orange-400 text-xs font-semibold mb-4">
            {door.badge}
          </span>

          <h2 class="text-xl md:text-2xl font-semibold text-white mb-3">
            <a href={door.href} class="hover:text-orange-400 transition-colors">
              {door.title}
            </a>
          </h2>

          <p class="text-gray-400 text-sm md:text-base leading-relaxed mb-5 flex-1">{door.body}</p>

          {door.steps && (
            <ol class="mb-5 flex flex-col gap-2 border-t border-white/5 pt-5">
              {door.steps.map((paso) => (
                <li>
                  <a href={paso.href} class="flex items-baseline gap-2 group/step">
                    <span class="text-orange-400 text-xs font-bold tabular-nums">{paso.num}</span>
                    <span class="text-sm text-gray-300 group-hover/step:text-orange-400 transition-colors">
                      {paso.label}
                    </span>
                    <span class="text-xs text-gray-600">{paso.promesa}</span>
                  </a>
                </li>
              ))}
            </ol>
          )}

          {door.countdown && (
            <p class="text-xs text-gray-500 mb-4">
              Ley 10/2025:{" "}
              <span
                class="text-orange-400 font-semibold tabular-nums"
                data-home-countdown
                data-deadline={LEY.plazoAdaptacion}
              >
                {diasRestantes}
              </span>{" "}
              días de plazo · RRSIF: 2027
            </p>
          )}

          <a href={door.href} class="text-orange-400 font-medium text-sm hover:underline">
            {door.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var el = document.querySelector("[data-home-countdown]");
    if (!el) return;
    var deadline = new Date(el.getAttribute("data-deadline") + "T00:00:00+01:00").getTime();
    el.textContent = String(Math.max(0, Math.ceil((deadline - Date.now()) / 86400000)));
  })();
</script>
