---
// Catálogo de servicios en la home. Enlaza a las landings (link interno desde la
// página de mayor autoridad) y muestra la oferta completa de la agencia.
const { locale = "es" } = Astro.props;

const CONTENT: Record<string, any> = {
  es: {
    badge: "Servicios",
    title: "Todo lo que tu empresa necesita para crecer con IA",
    subtitle: "De la estrategia a producción, sin hand-offs. Elige por dónde empezar.",
    cta: "Ver servicio",
    items: [
      { title: "Automatización con IA", desc: "Agentes, procesos e integraciones API con n8n.", path: "servicios/automatizacion-ia/" },
      { title: "Chatbots", desc: "Asistentes con IA para WhatsApp y web, 24/7.", path: "servicios/chatbots/" },
      { title: "Diseño web", desc: "Webs rápidas, con SEO técnico y conversión.", path: "servicios/diseno-web/" },
      { title: "Agencia SEO", desc: "Posicionamiento en Google y en buscadores con IA.", path: "servicios/agencia-seo/" },
      { title: "Marketing digital", desc: "Estrategia, ads y automatización orientados a ventas.", path: "servicios/marketing-digital/" },
      { title: "Agencia de IA", desc: "Estrategia, consultoría e implementación de IA.", path: "servicios/agencia-ia/" },
      { title: "Consultoría de IA", desc: "Diagnóstico, estrategia y roadmap de IA — y lo construimos.", path: "servicios/consultoria-ia/" },
      { title: "Radiografía Digital", desc: "Auditoría e inventario de tu parque tecnológico.", path: "auditoria-de-sistemas/" },
    ],
  },
  pt: {
    badge: "Serviços",
    title: "Tudo o que sua empresa precisa para crescer com IA",
    subtitle: "Da estratégia à produção, sem hand-offs. Escolha por onde começar.",
    cta: "Ver serviço",
    items: [
      { title: "Automação com IA", desc: "Agentes, processos e integrações API com n8n.", path: "servicios/automatizacion-ia/" },
      { title: "Chatbots", desc: "Assistentes com IA para WhatsApp e web, 24/7.", path: "servicios/chatbots/" },
      { title: "Criação de sites", desc: "Sites rápidos, com SEO técnico e conversão.", path: "servicios/diseno-web/" },
      { title: "Agência de SEO", desc: "Posicionamento no Google e em buscadores com IA.", path: "servicios/agencia-seo/" },
      { title: "Marketing digital", desc: "Estratégia, ads e automação orientados a vendas.", path: "servicios/marketing-digital/" },
      { title: "Agência de IA", desc: "Estratégia, consultoria e implementação de IA.", path: "servicios/agencia-ia/" },
      { title: "Consultoria de IA", desc: "Diagnóstico, estratégia e roadmap de IA — e a gente constrói.", path: "servicios/consultoria-ia/" },
      { title: "Radiografia Digital", desc: "Auditoria e inventário do seu parque tecnológico.", path: "auditoria-de-sistemas/" },
    ],
  },
  en: {
    badge: "Services",
    title: "Everything your business needs to grow with AI",
    subtitle: "From strategy to production, no hand-offs. Pick where to start.",
    cta: "View service",
    items: [
      { title: "AI Automation", desc: "Agents, processes and API integrations with n8n.", path: "servicios/automatizacion-ia/" },
      { title: "Chatbots", desc: "AI assistants for WhatsApp and web, 24/7.", path: "servicios/chatbots/" },
      { title: "Web design", desc: "Fast sites, with technical SEO and conversion.", path: "servicios/diseno-web/" },
      { title: "SEO agency", desc: "Rankings on Google and in AI search engines.", path: "servicios/agencia-seo/" },
      { title: "Digital marketing", desc: "Strategy, ads and automation focused on sales.", path: "servicios/marketing-digital/" },
      { title: "AI agency", desc: "AI strategy, consulting and implementation.", path: "servicios/agencia-ia/" },
      { title: "AI consulting", desc: "Diagnosis, strategy and an AI roadmap — and we build it.", path: "servicios/consultoria-ia/" },
      { title: "Digital X-Ray", desc: "Audit and inventory of your tech stack.", path: "auditoria-de-sistemas/" },
    ],
  },
};

const c = CONTENT[locale] ?? CONTENT.es;
const withLocale = (path: string) => `/${locale}/${path}`;
---

<section id="servicios" class="py-24 px-4 bg-transparent">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14">
      <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold mb-4">
        {c.badge}
      </span>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
        {c.title}
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto">
        {c.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {c.items.map((item: any) => (
        <a
          href={withLocale(item.path)}
          class="group flex flex-col bg-[#0a0a0a] border border-white/5 rounded-3xl p-6 hover:border-orange-500/30 hover:-translate-y-1 transition-all duration-300"
        >
          <h3 class="text-xl font-semibold text-white mb-2 group-hover:text-orange-400 transition-colors">
            {item.title}
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed flex-1">
            {item.desc}
          </p>
          <span class="mt-5 inline-flex items-center gap-1 text-orange-400 text-sm font-medium">
            {c.cta}
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
