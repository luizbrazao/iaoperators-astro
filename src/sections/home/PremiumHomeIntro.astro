---
import type { Project } from "@/data/projects";
import { createT } from "@/i18n/t";
import SystemMapDocument from "@/components/editorial/SystemMapDocument.astro";
import copy from "@/i18n/locales/es/homeIntro.json";

interface Props { project: Project }
const { project } = Astro.props;
const t = await createT("es", { namespaces: ["projects"] });
const href = `/es/portfolio/${project.slugs.es}/`;
const metric = project.metrics?.[0];
---

<div class="premium-intro">
  <div class="intro-container">
    <section class="intro-hero" aria-labelledby="intro-title">
      <p class="eyebrow"><span class="accent-dot" aria-hidden="true"></span>{copy.eyebrow}</p>
      <h1 id="intro-title">{copy.title}{" "}<span>{copy.titleRest}</span></h1>
      <div class="hero-bottom">
        <div class="hero-signal">
          <div class="signal-mark" aria-hidden="true">
            <svg viewBox="0 0 80 80" fill="none" width="60" height="60"><path d="M13 54V25h28M39 55h28V26M22 58 58 22M38 22h20v20" stroke="currentColor" stroke-width="5" /></svg>
          </div>
          <div><p class="eyebrow">{copy.signalTitle}</p><p class="signal-copy">{copy.signalBody}<br />{copy.signalDetail}</p></div>
        </div>
        <div class="hero-description">
          <p>{copy.description}</p>
          <div class="hero-actions">
            <a class="primary-cta" href="/es/contact/">{copy.cta}<span class="arrow" aria-hidden="true">↗</span></a>
            <a class="text-cta" href="#proyecto-destacado">{copy.projectsCta}<span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="featured-project" id="proyecto-destacado" aria-labelledby="featured-heading">
      <div class="project-heading"><h2 id="featured-heading"><span class="eyebrow" aria-hidden="true">01 /</span> {copy.case.sectionTitle}</h2><a href="/es/portfolio/">{copy.case.all}<span class="arrow" aria-hidden="true">↗</span></a></div>
      <article>
        <a class="case-link" href={href} aria-labelledby="case-title" aria-describedby="case-description">
          <div class="case-visual">
            <div class="case-story">
              <p class="eyebrow">{project.categoryKey ? t(project.categoryKey) : project.category}</p>
              <p class="case-statement">{copy.case.statement}</p>
              <p class="case-context">{copy.case.context}</p>
              {metric && <div class="case-metric"><p class="metric-value">{metric.value}</p><p class="eyebrow">{t(metric.labelKey)}</p></div>}
            </div>
            <SystemMapDocument class="case-document" />
          </div>
          <div class="case-caption">
            <div><h3 id="case-title">{t(project.titleKey)}</h3><p class="eyebrow">{copy.case.caption}</p></div>
            <p id="case-description">{copy.case.description}</p>
            <span class="arrow case-arrow" aria-hidden="true">↗</span>
          </div>
          <span class="case-cta">{copy.case.cta} <span aria-hidden="true">→</span></span>
        </a>
      </article>
    </section>
  </div>
</div>

<style>
  .premium-intro { --intro-paper: #f3f1eb; --intro-ink: #22241f; --intro-muted: #666960; --intro-line: #d0d1c7; --intro-orange: #f16532; position: relative; background: var(--intro-paper); color: var(--intro-ink); font-family: "Manrope Intro", "Helvetica Neue", sans-serif; cursor: auto; }
  .premium-intro a { color: inherit; text-decoration: none; cursor: pointer; }
  .premium-intro a:focus-visible { outline: 3px solid #ae3810; outline-offset: 6px; }
  .intro-container { max-width: 1440px; margin-inline: auto; padding-inline: 64px; }
  .intro-hero { padding-block: 64px 62px; }
  .eyebrow { font-family: "SFMono-Regular", Consolas, monospace; font-size: 11px; line-height: 1.6; letter-spacing: .06em; text-transform: uppercase; }
  .intro-hero > .eyebrow { display: flex; align-items: center; gap: 12px; }
  .accent-dot { width: 7px; height: 7px; background: var(--intro-orange); flex: none; }
  .premium-intro h1 { font-size: clamp(52px, 7.45vw, 106px); font-weight: 500; letter-spacing: -.067em; line-height: 1.06; margin-block: 34px 40px; }
  h1 > span { display: block; max-width: 10.5em; color: #74796d; }
  .hero-bottom { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 50px; }
  .hero-description > p { font-size: 18px; line-height: 1.6; max-width: 550px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 22px; align-items: center; margin-top: 25px; font-size: 13px; font-weight: 500; }
  .premium-intro .primary-cta { display: inline-flex; gap: 28px; align-items: center; padding: 16px 21px; background: var(--intro-ink); color: var(--intro-paper); }
  .text-cta { display: inline-flex; align-items: center; gap: 8px; border-bottom: 1px solid var(--intro-line); padding-block: 12px 4px; }
  .arrow { display: inline-block; transition: transform .22s ease; }
  a:hover .arrow { transform: translate(3px, -3px); }
  .hero-signal { display: flex; gap: 20px; align-items: center; }
  .signal-mark { width: 86px; height: 86px; flex: none; background: var(--intro-orange); display: grid; place-items: center; }
  .hero-signal .eyebrow { max-width: 220px; margin-bottom: 8px; }
  .signal-copy { font-size: 12px; line-height: 1.6; }
  .featured-project { border-top: 1px solid var(--intro-line); padding-bottom: 42px; scroll-margin-top: 115px; }
  .project-heading { display: flex; justify-content: space-between; align-items: center; gap: 22px; padding-block: 28px; }
  .project-heading h2 { font-size: 14px; font-weight: 500; }
  .project-heading a { display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--intro-muted); min-height: 44px; }
  .case-link { display: block; }
  .case-visual { display: grid; grid-template-columns: 1fr 1.3fr; gap: 36px; align-items: center; min-height: 430px; padding: 44px; overflow: hidden; background: #252923; color: var(--intro-paper); }
  .case-story > .eyebrow { color: #c2cab9; }
  .case-statement { font-size: clamp(28px, 3.3vw, 44px); font-weight: 500; letter-spacing: -.05em; line-height: 1.17; margin-block: 28px 20px; max-width: 12em; }
  .case-context { font-size: 13px; line-height: 1.6; color: #b7c0ad; max-width: 32ch; }
  .case-metric { margin-top: 26px; }
  .metric-value { font-size: 90px; line-height: 1.1; letter-spacing: -.07em; font-variant-numeric: tabular-nums; }
  .case-metric .eyebrow { color: #c2cab9; margin-top: 8px; }
  /* El documento vive en SystemMapDocument.astro; aquí solo su caja en la home.
     :global porque el <figure> lo renderiza el hijo y no lleva el ámbito de este componente. */
  .case-visual :global(.case-document) { margin: 24px 10px; }
  .case-caption { display: grid; grid-template-columns: 1fr 1.1fr 30px; gap: 32px; padding-block: 23px; border-bottom: 1px solid var(--intro-line); }
  .case-caption h3 { font-size: 21px; font-weight: 500; letter-spacing: -.04em; line-height: 1.35; margin-bottom: 8px; }
  .case-caption > p { font-size: 13px; line-height: 1.6; color: var(--intro-muted); }
  .case-arrow { font-size: 25px; }
  .case-cta { display: inline-block; margin-top: 18px; font-size: 13px; text-decoration: underline; text-underline-offset: 5px; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .case-link:hover :global(.case-document) { transform: rotate(-1deg) translateY(-3px); } }
  @media (max-width: 1050px) { .intro-container { padding-inline: 35px; } .premium-intro h1 { font-size: 8vw; } .case-visual { padding: 30px; gap: 20px; } .metric-value { font-size: 70px; } }
  @media (max-width: 720px) {
    .intro-container { padding-inline: 22px; } .intro-hero { padding-block: 40px 42px; } .intro-hero > .eyebrow { font-size: 9px; }
    .premium-intro h1 { font-size: clamp(36px, 10.8vw, 74px); line-height: 1.09; letter-spacing: -.063em; margin-block: 26px 28px; }
    .hero-bottom { grid-template-columns: 1fr; gap: 30px; } .hero-description > p { font-size: 15px; max-width: 38ch; }
    .hero-signal { order: 2; border-top: 1px solid var(--intro-line); padding-top: 22px; } .signal-mark { width: 52px; height: 52px; } .signal-mark svg { width: 40px; height: 40px; }
    .hero-signal .eyebrow { font-size: 10px; margin-bottom: 4px; } .signal-copy { font-size: 11px; } .hero-actions { gap: 16px; font-size: 11px; } .premium-intro .primary-cta { padding: 14px 16px; gap: 18px; min-height: 44px; } .text-cta { min-height: 44px; }
    .project-heading { padding-block: 20px; gap: 16px; } .project-heading h2 { font-size: 12px; } .project-heading a { font-size: 11px; }
    .case-visual { grid-template-columns: 1fr; padding: 26px; gap: 12px; } .case-statement { font-size: 33px; margin-block: 20px; } .case-context { font-size: 12px; }
    .metric-value { font-size: 62px; } .case-visual :global(.case-document) { margin: 16px 0; }
    .case-caption { grid-template-columns: 1fr 24px; gap: 16px; padding-block: 20px; } .case-caption > p { grid-column: 1; grid-row: 2; } .case-arrow { grid-column: 2; grid-row: 1; } .case-caption h3 { font-size: 20px; } .featured-project { padding-bottom: 32px; }
  }
  @media (prefers-reduced-motion: reduce) { .premium-intro *, .premium-intro *::before, .premium-intro *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }
</style>
