---
// Banda ES-only en la home apuntando a la landing pilar de la Ley 10/2025.
// Se renderiza solo cuando locale === "es" (ver _home.astro): la obligación es española.
import { LEY } from "@/data/sectores-sac";

const deadline = new Date(`${LEY.plazoAdaptacion}T00:00:00+01:00`);
const diasRestantes = Math.max(
  0,
  Math.ceil((deadline.getTime() - Date.now()) / (1000 * 60 * 60 * 24)),
);
---

<section class="px-4 py-10">
  <div class="max-w-6xl mx-auto">
    <a
      href="/es/cumplimiento/ley-atencion-al-cliente/"
      class="group block rounded-3xl border border-orange-500/20 bg-[#0a0a0a] p-6 md:p-8 hover:border-orange-500/50 transition-all duration-300"
    >
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="shrink-0 text-center md:text-left">
          <div
            class="text-4xl md:text-5xl font-bold text-orange-400 tabular-nums"
            data-home-countdown
            data-deadline={LEY.plazoAdaptacion}
          >
            {diasRestantes}
          </div>
          <div class="text-xs text-gray-500 uppercase tracking-widest mt-1">días de plazo</div>
        </div>

        <div class="md:border-l md:border-white/10 md:pl-8 flex-1">
          <span class="inline-block px-3 py-1 rounded-full bg-orange-500/10 text-orange-400 text-xs font-semibold mb-3">
            Ley 10/2025 · Atención a la clientela
          </span>
          <h2 class="text-xl md:text-2xl font-semibold text-white mb-2">
            Si tu empresa está obligada, el 28 de diciembre de 2026 tiene que cumplir
          </h2>
          <p class="text-gray-400 text-sm md:text-base leading-relaxed">
            SLA de atención medibles, clave identificativa, trazabilidad y evidencia para la
            auditoría anual. Implementamos el sistema — no vendemos el informe.
          </p>
        </div>

        <div class="shrink-0">
          <span class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-orange-500/10 text-orange-400 border border-orange-500/30 font-medium text-sm group-hover:bg-orange-500 group-hover:text-black transition-all duration-300">
            Ver cómo se cumple ↗
          </span>
        </div>
      </div>
    </a>
  </div>
</section>

<script is:inline>
  (function () {
    var el = document.querySelector("[data-home-countdown]");
    if (!el) return;
    var deadline = new Date(el.getAttribute("data-deadline") + "T00:00:00+01:00").getTime();
    el.textContent = String(Math.max(0, Math.ceil((deadline - Date.now()) / 86400000)));
  })();
</script>
