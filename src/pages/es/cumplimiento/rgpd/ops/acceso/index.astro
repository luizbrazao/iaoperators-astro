---
// Zona protegida de RGPD Ops. Server-side en cada petición, noindex.
//
// Autorización (src/lib/rgpd-ops/auth.ts): cookie firmada válida, pedido
// pagado y con acceso activo en Supabase, y espacio de trabajo de ESE pedido.
// El contenido guiado y el snapshot del espacio solo se cargan aquí y solo se
// entregan a la island cuando la autorización es "ok".
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import RgpdWorkspace from "@/islands/RgpdWorkspace";
import RgpdAccessRequest from "@/islands/RgpdAccessRequest";
import { RGPD_OPS_CHANGELOG, RGPD_OPS_PRODUCT } from "@/data/rgpd-ops";
import { RGPD_BORRADOR } from "@/data/rgpd";
import {
  AEPD_TOOLS,
  MODULE_GUIDES,
  QUICK_ADD,
  REVIEW_CHECKLIST,
  RGPD_OPS_CONTENT_SENTINEL,
  WORKSPACE_DISCLAIMER,
} from "@/data/rgpd-ops-content";
import { getAuthorizedWorkspace } from "@/lib/rgpd-ops/auth";
import { errorCode, opsLog, requestIdFrom } from "@/lib/rgpd-ops/log";
import { touchLastAccess } from "@/lib/rgpd-ops/orders";
import { supabaseRepo, toClientSnapshot } from "@/lib/rgpd-ops/workspace";
import type { ClientSnapshot } from "@/lib/rgpd-ops/types";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-forms.css";
import "@/styles/editorial-kit.css";
import "@/styles/editorial-rgpd.css";

Astro.response.headers.set("cache-control", "private, no-store");
Astro.response.headers.set("x-robots-tag", "noindex, nofollow");
Astro.response.headers.set("referrer-policy", "same-origin");
Astro.response.headers.set("x-frame-options", "DENY");
Astro.response.headers.set("x-content-type-options", "nosniff");

const P = RGPD_OPS_PRODUCT;
const requestId = requestIdFrom(Astro.request);
const auth = await getAuthorizedWorkspace(Astro.cookies, Astro.url, requestId);
const estado = Astro.url.searchParams.get("estado") ?? "";

let snapshot: ClientSnapshot | null = null;
let loadFailed = false;
if (auth.status === "ok") {
  try {
    const snap = await supabaseRepo.snapshot(auth.workspaceId);
    snapshot = snap ? toClientSnapshot(snap) : null;
    if (!snapshot) loadFailed = true;
    await touchLastAccess(auth.order.id).catch(() => undefined);
  } catch (error) {
    loadFailed = true;
    opsLog({ request_id: requestId, order_id: auth.order.id, action: "workspace_page", status: "error", error_code: errorCode(error) });
  }
}

const fmt = (iso: string | null | undefined) =>
  iso ? new Intl.DateTimeFormat("es-ES", { day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Madrid" }).format(new Date(iso)) : "—";

const MENSAJES: Record<string, string> = {
  "enlace-invalido": "El enlace no es válido. Pide uno nuevo con el email de tu compra.",
  "enlace-caducado": "Este enlace ya se usó o ha caducado. Cada enlace sirve una sola vez: pide uno nuevo.",
  "acceso-no-disponible": "El acceso de este pedido no está activo (por ejemplo, porque se reembolsó o ha terminado el periodo de acceso). Si crees que es un error, escríbenos a info@iaoperators.com.",
  "demasiados-intentos": "Demasiados intentos seguidos. Espera unos minutos y vuelve a probar.",
  "no-disponible": "No hemos podido abrir tu acceso ahora mismo. Inténtalo de nuevo en unos minutos.",
  "sesion-cerrada": "Has cerrado la sesión en este navegador. Tu espacio sigue guardado.",
};
const mensaje = auth.status === "denied" ? MENSAJES["acceso-no-disponible"] : MENSAJES[estado];
if (auth.status === "unavailable" || loadFailed) Astro.response.status = 503;
---

<BaseLayout title={`Acceso · ${P.name} | IA Operators`} description={`Zona privada de ${P.name}.`} robots="noindex, nofollow" editorial>
  <div class="ed-container">
    {auth.status === "ok" && snapshot ? (
      <>
        <header class="pg-hero pg-hero-compact">
          <p class="ed-eyebrow">{P.name} · v{P.version}</p>
          <h1>Tu espacio de protección de datos</h1>
          <p class="pg-lead" style="margin-top:20px">
            Empieza por el perfil y las tareas iniciales del plan. Todo se guarda solo en tu espacio, en el servidor:
            puedes volver desde cualquier dispositivo con un enlace nuevo.
          </p>
        </header>
        <div data-rgo-content={RGPD_OPS_CONTENT_SENTINEL}>
          <RgpdWorkspace
            client:load
            initial={snapshot}
            guides={MODULE_GUIDES}
            reviewChecklist={REVIEW_CHECKLIST}
            quickAdd={QUICK_ADD}
            aepdTools={AEPD_TOOLS}
            productName={P.name}
            productVersion={P.version}
            normativeVerifiedAt={fmt(P.normativeBase.verifiedAt)}
            accessUntil={fmt(auth.order.access_expires_at)}
            disclaimer={WORKSPACE_DISCLAIMER}
            borrador={RGPD_BORRADOR}
            revisionHref={P.paths.revision}
            changelog={RGPD_OPS_CHANGELOG}
          />
        </div>
      </>
    ) : (
      <>
        <header class="pg-hero pg-hero-compact">
          <p class="ed-eyebrow">{P.name}</p>
          <h1>Acceso a tu espacio</h1>
          {mensaje && <p class="vk-status" role="status">{mensaje}</p>}
          {(auth.status === "unavailable" || loadFailed) && (
            <p class="vk-status" role="status">El acceso no está disponible en este momento. Inténtalo de nuevo en unos minutos.</p>
          )}
        </header>
        <section class="pg-section">
          <RgpdAccessRequest client:load />
          <p class="vk-note" style="margin-top:24px">
            ¿Aún no lo tienes? <a class="pg-inline-link" href={P.paths.landing}>Ver {P.name}</a>.
          </p>
        </section>
      </>
    )}
  </div>
</BaseLayout>
