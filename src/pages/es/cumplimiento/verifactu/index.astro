---
// Pilar de la Frente B — Verifactu. ES-only (obligación española).
// Ángulo: la SERP está copada por vendors de software de facturación cuya
// respuesta a todo es "migra a mi programa". El hueco es el que NO puede migrar.

import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  NORMA,
  DISCLAIMER,
  EXCLUSIONES,
  REQUISITOS,
  SANCIONES,
  SHARED,
  CASO_SLUGS,
  CASOS,
} from "@/data/verifactu";
import { ORG_REF } from "@/data/identidad";

const locale = "es";
const site = Astro.site?.toString() ?? "https://iaoperators.com";
const base = `/${locale}/cumplimiento/verifactu/`;
const pageUrl = new URL(base, site).toString();
const contactHref = `/${locale}/contact/`;
const sacHref = `/${locale}/cumplimiento/ley-atencion-al-cliente/`;

const deadline = new Date(`${NORMA.fechaSociedades}T00:00:00+01:00`);
const diasRestantes = Math.max(
  0,
  Math.ceil((deadline.getTime() - Date.now()) / (1000 * 60 * 60 * 24)),
);

const casos = CASO_SLUGS.map((slug) => ({ slug, ...CASOS[slug] }));

const meta = {
  title: "Verifactu para ERP, TPV y software propio | IA Operators",
  description:
    "Adaptamos tu ERP, TPV o software propio al RRSIF: registros, QR, declaración responsable y, si eliges VERI*FACTU, remisión a la AEAT.",
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: "Integración de Verifactu en sistemas de facturación propios y legados",
  serviceType: "Adaptación de sistemas de facturación al RRSIF y VERI*FACTU",
  provider: ORG_REF,
  areaServed: "ES",
  description: meta.description,
  url: pageUrl,
  inLanguage: "es-ES",
  about: {
    "@type": "Legislation",
    name: NORMA.nombre,
    legislationIdentifier: "BOE-A-2023-24840",
    legislationJurisdiction: "ES",
    url: NORMA.boeUrl,
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: new URL(`/${locale}/`, site).toString() },
    {
      "@type": "ListItem",
      position: 2,
      name: "Cumplimiento tecnológico",
      item: new URL(`/${locale}/cumplimiento/`, site).toString(),
    },
    { "@type": "ListItem", position: 3, name: "Verifactu", item: pageUrl },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: SHARED.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalUrl={pageUrl}
  alternates={[{ lang: "es", href: pageUrl }]}
  xDefaultUrl={pageUrl}
  jsonLd={[serviceJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <div class="bg-transparent text-white">
    <!-- HERO -->
    <section class="relative px-4 pt-28 pb-16">
      <div class="max-w-5xl mx-auto text-center">
        <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold mb-6">
          Verifactu (RRSIF) · {NORMA.fechaSociedadesLegible} sociedades · {NORMA.fechaRestoLegible} resto de obligados
        </span>
        <h1 class="text-4xl md:text-6xl font-medium tracking-tight leading-tight mb-6">
          Verifactu sin cambiar el software que hace funcionar tu negocio
        </h1>
        <p class="text-lg md:text-2xl text-gray-200 mb-8 max-w-3xl mx-auto">
          Adaptamos el cumplimiento del RRSIF a tu ERP, tu TPV o tu e-commerce actual, sin
          necesidad de migrar de software.
        </p>

        <div class="inline-flex items-center gap-3 px-5 py-3 rounded-2xl bg-[#0a0a0a] border border-orange-500/20 mb-3">
          <span
            id="vf-countdown"
            data-deadline={NORMA.fechaSociedades}
            class="text-3xl md:text-4xl font-bold text-orange-400 tabular-nums"
          >
            {diasRestantes}
          </span>
          <span class="text-left text-sm text-gray-400 leading-tight">
            días para el {NORMA.fechaSociedadesLegible}<br />(Impuesto sobre Sociedades)
          </span>
        </div>
        <p class="text-xs text-gray-500 mb-10">
          {NORMA.fechaRestoLegible} — resto de obligados
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={contactHref}
            class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-orange-500 text-black font-medium text-base hover:bg-orange-400 hover:scale-105 transition-all duration-300"
          >
            Auditoría de tu sistema ↗
          </a>
          <a
            href={`${base}test/`}
            class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-black text-orange-400 border border-orange-500/30 font-medium text-base hover:bg-orange-500/10 transition-all duration-300"
          >
            ¿Te aplica? Test de 2 min ↗
          </a>
        </div>
      </div>
    </section>

    <!-- RRSIF vs VERI*FACTU vs NO VERI*FACTU -->
    <section class="px-4 pb-16">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">RRSIF y VERI*FACTU no son exactamente lo mismo</h2>
        <p class="text-gray-300 leading-relaxed mb-4">
          El RRSIF es el reglamento que obliga a todo sistema de facturación afectado a generar
          registros íntegros, trazables e inalterables, con QR y declaración responsable del
          productor. Se cumple de dos formas posibles: VERI*FACTU o NO VERI*FACTU.
        </p>
        <p class="text-gray-300 leading-relaxed">
          VERI*FACTU remite esos registros a la AEAT de forma continuada, a cambio de simplificar
          algunas exigencias locales. NO VERI*FACTU no remite en el momento, pero exige firma
          electrónica, registro de eventos y más control por tu parte. En el lenguaje comercial
          «Verifactu» se usa a menudo para el conjunto; aquí distinguimos los tres términos porque
          afectan a decisiones técnicas distintas.
        </p>
      </div>
    </section>

    <!-- SUBPÁGINAS DEL PILAR -->
    <!-- Enlaces internos hub→hijos con ancla descriptiva (no exacta): el plan
         §7.7 y §8 piden texto de enlace claro, no correspondencia literal. -->
    <section class="px-4 pb-4">
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-4">
        <a
          href={`${base}plazos/`}
          class="group bg-[#0a0a0a] border border-white/5 rounded-2xl p-5 hover:border-orange-500/30 transition-all duration-300"
        >
          <h2 class="text-base font-semibold mb-1 group-hover:text-orange-400 transition-colors">
            Cuándo te obliga
          </h2>
          <p class="text-gray-400 text-sm">Las dos fechas de 2027 y a quién no le aplica.</p>
        </a>
        <a
          href={`${base}integracion/`}
          class="group bg-[#0a0a0a] border border-white/5 rounded-2xl p-5 hover:border-orange-500/30 transition-all duration-300"
        >
          <h2 class="text-base font-semibold mb-1 group-hover:text-orange-400 transition-colors">
            Cómo es el proyecto
          </h2>
          <p class="text-gray-400 text-sm">Vías de integración, fases, entregables y precio.</p>
        </a>
        <a
          href={`${base}api/`}
          class="group bg-[#0a0a0a] border border-white/5 rounded-2xl p-5 hover:border-orange-500/30 transition-all duration-300"
        >
          <h2 class="text-base font-semibold mb-1 group-hover:text-orange-400 transition-colors">
            El detalle técnico
          </h2>
          <p class="text-gray-400 text-sm">Arquitectura de la conexión con el servicio de la AEAT.</p>
        </a>
      </div>
    </section>

    <!-- ¿TE APLICA? -->
    <section class="px-4 py-20">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Primero: ¿te aplica?</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">
            Hay tres situaciones en las que el reglamento no te alcanza. Preferimos decírtelo antes
            que venderte un proyecto que no necesitas.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {EXCLUSIONES.map((item) => (
            <div class="bg-[#0a0a0a] border border-white/5 rounded-3xl p-6">
              <div class="text-xs font-semibold uppercase tracking-widest text-gray-500 mb-3">
                Quedas fuera si
              </div>
              <h3 class="text-lg font-semibold text-white mb-2">{item.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
        <p class="text-center text-sm text-gray-400 mt-8 max-w-2xl mx-auto leading-relaxed">
          Si no estás en ninguno de esos tres casos y emites facturas desde un sistema informático,
          la obligación llega el <strong class="text-white">{NORMA.fechaSociedadesLegible}</strong>
          si tributas por el Impuesto sobre Sociedades, y el
          <strong class="text-white">{NORMA.fechaRestoLegible}</strong> en el resto de casos.
        </p>
      </div>
    </section>

    <!-- DE LA NORMA AL SISTEMA -->
    <section class="px-4 py-24 bg-white/[0.02] border-y border-white/5">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-14">
          <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold mb-4">
            El núcleo del proyecto
          </span>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">De la norma al sistema</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">
            Cada exigencia del reglamento se traduce en una pieza de software. Y cada pieza tiene una
            trampa que solo aparece cuando el sistema ya está en producción.
          </p>
        </div>

        <div class="space-y-4">
          {REQUISITOS.map((r, idx) => (
            <div class="bg-[#0a0a0a] border border-white/5 rounded-3xl p-6 md:p-8 hover:border-orange-500/20 transition-all duration-300">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10">
                <div>
                  <div class="flex items-center gap-3 mb-3">
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-orange-500/10 text-orange-400 font-bold text-xs shrink-0">
                      {String(idx + 1).padStart(2, "0")}
                    </span>
                    <span class="text-xs font-semibold uppercase tracking-widest text-gray-500">
                      Lo que exige la norma
                    </span>
                  </div>
                  <p class="text-white text-base leading-relaxed">{r.norma}</p>
                </div>
                <div class="md:border-l md:border-white/5 md:pl-10">
                  <div class="text-xs font-semibold uppercase tracking-widest text-orange-400 mb-3">
                    Lo que hay que construir
                  </div>
                  <p class="text-gray-300 text-base leading-relaxed mb-3">{r.sistema}</p>
                  <p class="text-gray-500 text-sm leading-relaxed italic">{r.trampa}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <p class="text-center text-xs text-gray-500 mt-8">
          Requisitos contrastados con la
          <a
            href={NORMA.aeatUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 underline hover:text-orange-400 transition-colors"
          >
            documentación de la AEAT
          </a>
          y el texto del {NORMA.nombre}.
        </p>
      </div>
    </section>

    <!-- TODO SEO/PROOF: añadir caso real RRSIF/VERI*FACTU cuando exista uno publicable. -->
    <!-- CASOS -->
    <section id="casos" class="px-4 py-20 scroll-mt-24">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">¿Cuál es tu caso?</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">
            Cuatro situaciones donde integrar el cumplimiento en el sistema que ya tienes suele
            ser una alternativa más simple que migrar a un software estándar.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {casos.map((caso) => (
            <a
              href={`${base}${caso.slug}/`}
              class="group bg-[#0a0a0a] border border-white/5 rounded-3xl p-7 hover:border-orange-500/30 transition-all duration-300"
            >
              <h3 class="text-xl font-semibold text-white mb-2 group-hover:text-orange-400 transition-colors">
                {caso.nombreCorto}
              </h3>
              <p class="text-gray-400 text-sm leading-relaxed mb-4">{caso.intro}</p>
              <span class="text-orange-400 text-sm">Ver este caso →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ARQUITECTURA -->
    <section class="px-4 py-20 bg-white/[0.02] border-y border-white/5">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">{SHARED.arquitectura.title}</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">{SHARED.arquitectura.subtitle}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {SHARED.arquitectura.items.map((item, idx) => (
            <div class="bg-[#0a0a0a] border border-white/5 rounded-3xl p-6 hover:border-orange-500/30 transition-all duration-300">
              <div class="flex items-center justify-between gap-3 mb-4">
                <div class="flex items-center gap-3">
                  <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-orange-500/10 text-orange-400 font-bold text-sm">
                    {String(idx + 1).padStart(2, "0")}
                  </span>
                  <h3 class="text-lg font-semibold text-white">{item.title}</h3>
                </div>
                <span class="shrink-0 text-[10px] uppercase tracking-widest text-gray-500 border border-white/10 rounded-full px-2 py-1">
                  {item.modalidad}
                </span>
              </div>
              <p class="text-gray-400 text-sm leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESO -->
    <section class="px-4 py-24">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold mb-4">
            {SHARED.proceso.badge}
          </span>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">{SHARED.proceso.title}</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">{SHARED.proceso.subtitle}</p>
        </div>
        <ol class="space-y-6 max-w-4xl mx-auto">
          {SHARED.proceso.phases.map((phase) => (
            <li class="flex flex-col md:flex-row gap-6 bg-[#0a0a0a] border border-white/5 rounded-3xl p-6 md:p-8 hover:border-orange-500/20 transition-all duration-300">
              <div class="md:w-56 shrink-0">
                <div class="text-orange-400 text-xs font-semibold uppercase tracking-widest mb-1">
                  {phase.code} · {phase.plazo}
                </div>
                <h3 class="text-xl font-bold text-white">{phase.title}</h3>
              </div>
              <p class="text-gray-300 leading-relaxed flex-1">{phase.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- SANCIONES + PRECIO -->
    <section class="px-4 py-20 bg-white/[0.02] border-y border-white/5">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-12">
          {SHARED.precio.items.map((item) => (
            <div class="bg-[#0a0a0a] border border-white/5 rounded-3xl p-8 flex flex-col">
              <h3 class="text-lg font-semibold text-white mb-2">{item.title}</h3>
              <div class="text-2xl font-bold text-orange-400 mb-4">{item.precio}</div>
              <p class="text-gray-400 text-sm leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>

        <div class="max-w-3xl mx-auto text-center">
          <p class="text-xs uppercase tracking-widest text-gray-500 mb-4">
            Lo que hay al otro lado
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            {SANCIONES.map((s) => (
              <div class="flex-1 bg-[#0a0a0a] border border-white/5 rounded-2xl px-6 py-5">
                <div class="text-xl font-bold text-white mb-1">{s.importe}</div>
                <div class="text-gray-500 text-xs leading-relaxed">{s.quien}</div>
              </div>
            ))}
          </div>
          <p class="text-xs text-gray-600 mt-4 leading-relaxed">
            Régimen del artículo 201 bis de la Ley General Tributaria. Su aplicación a un caso
            concreto corresponde a tu asesoría.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="px-4 py-20">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">{SHARED.faq.title}</h2>
        <div class="space-y-3">
          {SHARED.faq.items.map((item) => (
            <details class="group bg-[#0a0a0a] border border-white/5 rounded-2xl px-6 py-4 hover:border-orange-500/20 transition-all duration-300">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <span class="text-white font-medium pr-4">{item.q}</span>
                <span class="text-orange-400 text-xl leading-none transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-gray-400 mt-3 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- PROFUNDIZAR: clúster de artículos -->
    <section class="px-4 py-20 bg-white/[0.02] border-y border-white/5">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-3 text-center">Los tres puntos donde se atascan los proyectos</h2>
        <p class="text-gray-400 text-center max-w-2xl mx-auto mb-12 leading-relaxed">
          No es el envío a la AEAT. Son estas tres decisiones, y conviene tomarlas antes de
          escribir código.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <a
            href="/es/blog/series-y-cadena-de-huellas-verifactu/"
            class="group bg-[#0a0a0a] border border-white/5 rounded-2xl p-6 hover:border-orange-500/30 transition-all duration-300"
          >
            <span class="text-xs text-orange-400 font-medium">Arquitectura</span>
            <h3 class="text-white font-semibold mt-2 mb-2 leading-snug">
              Cómo conviven las series con una única cadena de huellas
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Qué cambia cuando facturas desde varias cajas o tiendas a la vez, y cuántos
              sistemas de facturación tiene realmente tu operación.
            </p>
            <span class="inline-block text-orange-400 text-sm mt-4 group-hover:translate-x-1 transition-transform">Leer →</span>
          </a>
          <a
            href="/es/blog/qr-verifactu-ticket-termico-tpv/"
            class="group bg-[#0a0a0a] border border-white/5 rounded-2xl p-6 hover:border-orange-500/30 transition-all duration-300"
          >
            <span class="text-xs text-orange-400 font-medium">Impresión</span>
            <h3 class="text-white font-semibold mt-2 mb-2 leading-snug">
              Por qué el ticket de 58 mm rompe la implementación del QR
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              La norma pide entre 30 y 40 milímetros y el rollo deja 48 imprimibles. La
              aritmética de módulos que hay que hacer antes de comprar nada.
            </p>
            <span class="inline-block text-orange-400 text-sm mt-4 group-hover:translate-x-1 transition-transform">Leer →</span>
          </a>
          <a
            href="/es/blog/anulaciones-y-rectificativas-verifactu/"
            class="group bg-[#0a0a0a] border border-white/5 rounded-2xl p-6 hover:border-orange-500/30 transition-all duration-300"
          >
            <span class="text-xs text-orange-400 font-medium">Casuística</span>
            <h3 class="text-white font-semibold mt-2 mb-2 leading-snug">
              Anular no es borrar y rectificar no es editar
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Los dos caminos que la mayoría de sistemas resuelve con un solo botón, y lo que
              eso obliga a rehacer en el modelo de datos.
            </p>
            <span class="inline-block text-orange-400 text-sm mt-4 group-hover:translate-x-1 transition-transform">Leer →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="px-4 py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-5xl font-bold mb-4 text-white">
          Empieza por saber qué hay que tocar
        </h2>
        <p class="text-gray-400 text-lg mb-10 max-w-2xl mx-auto">
          La auditoría del sistema de facturación dura entre tres y cinco días y sale con el alcance
          y el precio cerrados. Si en la auditoría técnica vemos que no te aplica, te lo decimos
          ahí; la calificación fiscal de tu caso concreto sigue siendo cosa de tu asesoría.
        </p>
        <a
          href={contactHref}
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-orange-500 text-black font-medium text-lg hover:bg-orange-400 hover:scale-105 transition-all duration-300"
        >
          Hablar con un especialista ↗
        </a>

        <p class="text-sm text-gray-500 mt-10">
          ¿Buscabas la otra obligación con plazo?
          <a href={sacHref} class="text-orange-400 underline hover:text-orange-300">
            Ley 10/2025 de atención a la clientela
          </a>
        </p>

        <p class="text-xs text-gray-600 mt-8 max-w-2xl mx-auto leading-relaxed">{DISCLAIMER}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var el = document.getElementById("vf-countdown");
    if (!el) return;
    var deadline = new Date(el.getAttribute("data-deadline") + "T00:00:00+01:00").getTime();
    el.textContent = String(Math.max(0, Math.ceil((deadline - Date.now()) / 86400000)));
  })();
</script>
