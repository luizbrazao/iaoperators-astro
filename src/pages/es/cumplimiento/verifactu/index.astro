---
// Pilar de la Frente B — Verifactu. ES-only (obligación española).
// Ángulo: la SERP está copada por vendors de software de facturación cuya
// respuesta a todo es "migra a mi programa". El hueco es el que NO puede migrar.

import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  NORMA,
  DISCLAIMER,
  EXCLUSIONES,
  REQUISITOS,
  SANCIONES,
  SHARED,
  CASO_SLUGS,
  CASOS,
} from "@/data/verifactu";
import { ORG_REF } from "@/data/identidad";
import copy from "@/i18n/locales/es/pagesEditorial.json";
import "@/styles/editorial-pages.css";

const locale = "es";
const site = Astro.site?.toString() ?? "https://iaoperators.com";
const base = `/${locale}/cumplimiento/verifactu/`;
const pageUrl = new URL(base, site).toString();
const contactHref = `/${locale}/contact/`;
const sacHref = `/${locale}/cumplimiento/ley-atencion-al-cliente/`;

const deadline = new Date(`${NORMA.fechaSociedades}T00:00:00+01:00`);
const diasRestantes = Math.max(
  0,
  Math.ceil((deadline.getTime() - Date.now()) / (1000 * 60 * 60 * 24)),
);

// Rótulos de la versión editorial (oct/2026).
const L = copy.verifactu;

const casos = CASO_SLUGS.map((slug) => ({ slug, ...CASOS[slug] }));

const meta = {
  title: "Verifactu para ERP, TPV y software propio | IA Operators",
  description:
    "Adaptamos tu ERP, TPV o software propio al RRSIF: registros, QR, declaración responsable y, si eliges VERI*FACTU, remisión a la AEAT.",
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: "Integración de Verifactu en sistemas de facturación propios y legados",
  serviceType: "Adaptación de sistemas de facturación al RRSIF y VERI*FACTU",
  provider: ORG_REF,
  areaServed: "ES",
  description: meta.description,
  url: pageUrl,
  inLanguage: "es-ES",
  about: {
    "@type": "Legislation",
    name: NORMA.nombre,
    legislationIdentifier: "BOE-A-2023-24840",
    legislationJurisdiction: "ES",
    url: NORMA.boeUrl,
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: new URL(`/${locale}/`, site).toString() },
    {
      "@type": "ListItem",
      position: 2,
      name: "Cumplimiento tecnológico",
      item: new URL(`/${locale}/cumplimiento/`, site).toString(),
    },
    { "@type": "ListItem", position: 3, name: "Verifactu", item: pageUrl },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: SHARED.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalUrl={pageUrl}
  alternates={[{ lang: "es", href: pageUrl }]}
  xDefaultUrl={pageUrl}
  jsonLd={[serviceJsonLd, breadcrumbJsonLd, faqJsonLd]}
  editorial
>
  <div class="ed-container">
    <header class="pg-hero pg-hero-compact">
      <nav class="pf-crumbs ed-eyebrow" aria-label={copy.breadcrumb.label}>
        <ol>
          <li><a href="/es/">{copy.breadcrumb.home}</a></li>
          <li><a href="/es/cumplimiento/">{L.cumplimiento}</a></li>
          <li><span aria-current="page">{NORMA.nombreCorto}</span></li>
        </ol>
      </nav>
      <h1>Verifactu <span>sin cambiar el software que hace funcionar tu negocio</span></h1>
      <div class="pg-hero-bottom">
        <div class="pg-countdown">
          <p class="ed-eyebrow">Verifactu (RRSIF) · {NORMA.fechaSociedadesLegible} sociedades · {NORMA.fechaRestoLegible} resto de obligados</p>
          <p class="pg-countdown-value">
            <strong id="vf-countdown" data-deadline={NORMA.fechaSociedades}>{diasRestantes}</strong>
            <span>días para el {NORMA.fechaSociedadesLegible}<br />(Impuesto sobre Sociedades)</span>
          </p>
          <p class="pg-countdown-note">{NORMA.fechaRestoLegible} — resto de obligados</p>
        </div>
        <div>
          <p class="pg-lead pg-lead-strong">
            Adaptamos el cumplimiento del RRSIF a tu ERP, tu TPV o tu e-commerce actual, sin
            necesidad de migrar de software.
          </p>
          <div class="pg-actions">
            <a class="ed-button" href={contactHref}>Auditoría de tu sistema<span class="ed-arrow" aria-hidden="true">↗</span></a>
            <a class="ed-underlined" href={`${base}test/`}>¿Te aplica? Test de 2 min <span class="ed-arrow" aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </header>

    <section class="pg-section" aria-labelledby="rrsif-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.queEs}</p>
        <div>
          <h2 id="rrsif-title">RRSIF y VERI*FACTU no son exactamente lo mismo</h2>
          <div class="pg-prose">
            <p>
              El RRSIF es el reglamento que obliga a todo sistema de facturación afectado a generar
              registros íntegros, trazables e inalterables, con QR y declaración responsable del
              productor. Se cumple de dos formas posibles: VERI*FACTU o NO VERI*FACTU.
            </p>
            <p>
              VERI*FACTU remite esos registros a la AEAT de forma continuada, a cambio de simplificar
              algunas exigencias locales. NO VERI*FACTU no remite en el momento, pero exige firma
              electrónica, registro de eventos y más control por tu parte. En el lenguaje comercial
              «Verifactu» se usa a menudo para el conjunto; aquí distinguimos los tres términos porque
              afectan a decisiones técnicas distintas.
            </p>
          </div>
        </div>
      </div>
      <div class="pg-doors">
        <a href={`${base}plazos/`}><h2>Cuándo te obliga</h2><p>Las dos fechas de 2027 y a quién no le aplica.</p><span class="ed-arrow" aria-hidden="true">↗</span></a>
        <a href={`${base}integracion/`}><h2>Cómo es el proyecto</h2><p>Vías de integración, fases, entregables y precio.</p><span class="ed-arrow" aria-hidden="true">↗</span></a>
        <a href={`${base}api/`}><h2>El detalle técnico</h2><p>Arquitectura de la conexión con el servicio de la AEAT.</p><span class="ed-arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="pg-section" aria-labelledby="aplica-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.exclusiones}</p>
        <div>
          <h2 id="aplica-title">Primero: ¿te aplica?</h2>
          <div class="pg-prose">
            <p>
              Hay tres situaciones en las que el reglamento no te alcanza. Preferimos decírtelo antes
              que venderte un proyecto que no necesitas.
            </p>
          </div>
        </div>
      </div>
      <ol class="pg-columns">
        {EXCLUSIONES.map((item) => (
          <li><span class="ed-eyebrow">Quedas fuera si</span><h3>{item.title}</h3><p>{item.body}</p></li>
        ))}
      </ol>
      <p class="pg-callout">
        Si no estás en ninguno de esos tres casos y emites facturas desde un sistema informático,
        la obligación llega el <strong>{NORMA.fechaSociedadesLegible}</strong> si tributas por el
        Impuesto sobre Sociedades, y el <strong>{NORMA.fechaRestoLegible}</strong> en el resto de casos.
      </p>
    </section>

    <section class="pg-section" aria-labelledby="norma-sistema-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">El núcleo del proyecto</p>
        <div>
          <h2 id="norma-sistema-title">De la norma al sistema</h2>
          <div class="pg-prose">
            <p>
              Cada exigencia del reglamento se traduce en una pieza de software. Y cada pieza tiene una
              trampa que solo aparece cuando el sistema ya está en producción.
            </p>
          </div>
        </div>
      </div>
      <ol class="pg-patterns pg-obligations">
        {REQUISITOS.map((r, idx) => (
          <li>
            <span class="ed-eyebrow">{String(idx + 1).padStart(2, "0")}</span>
            <div class="pg-pattern-main">
              <p class="ed-eyebrow">Lo que exige la norma</p>
              <p class="pg-obligation-law">{r.norma}</p>
            </div>
            <div class="pg-pattern-risk">
              <p class="ed-eyebrow">Lo que hay que construir</p>
              <p class="pg-obligation-system">{r.sistema}</p>
              <p class="pg-obligation-risk">{r.trampa}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="pg-source">
        Requisitos contrastados con la{" "}
        <a href={NORMA.aeatUrl} target="_blank" rel="noopener noreferrer">documentación de la AEAT</a>{" "}
        y el texto del {NORMA.nombre}.
      </p>
    </section>

    <section id="casos" class="pg-section pg-section-flush pg-anchor" aria-labelledby="casos-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.casos}</p>
        <div>
          <h2 id="casos-title">¿Cuál es tu caso?</h2>
          <div class="pg-prose">
            <p>
              Cuatro situaciones donde integrar el cumplimiento en el sistema que ya tienes suele
              ser una alternativa más simple que migrar a un software estándar.
            </p>
          </div>
        </div>
      </div>
      <div class="pg-offers">
        {casos.map((caso, idx) => (
          <a class="ed-offer" href={`${base}${caso.slug}/`}>
            <span class="ed-eyebrow">{String(idx + 1).padStart(2, "0")}</span><h3>{caso.nombreCorto}</h3><p>{caso.intro}</p><span class="ed-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="pg-section" aria-labelledby="arquitectura-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.arquitectura}</p>
        <div>
          <h2 id="arquitectura-title">{SHARED.arquitectura.title}</h2>
          <div class="pg-prose"><p>{SHARED.arquitectura.subtitle}</p></div>
        </div>
      </div>
      <ol class="pg-columns">
        {SHARED.arquitectura.items.map((item, idx) => (
          <li><span class="ed-eyebrow">{String(idx + 1).padStart(2, "0")} · {item.modalidad}</span><h3>{item.title}</h3><p>{item.body}</p></li>
        ))}
      </ol>
    </section>
  </div>

  <section class="ed-method pg-method pg-process" aria-labelledby="proceso-title">
    <div class="ed-container">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{SHARED.proceso.badge}</p>
        <div>
          <h2 id="proceso-title">{SHARED.proceso.title}</h2>
          <p class="pg-method-lead">{SHARED.proceso.subtitle}</p>
        </div>
      </div>
      <ol class="ed-steps pg-steps-4">
        {SHARED.proceso.phases.map((phase) => (
          <li><span class="ed-eyebrow">{phase.code} · {phase.plazo}</span><h3>{phase.title}</h3><p>{phase.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <div class="ed-container">
    <section class="pg-section" aria-label={SHARED.alcance.title}>
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.alcance}</p>
        <div class="pg-prose"><p>{SHARED.alcance.subtitle}</p></div>
      </div>
      <ol class="pg-columns">
        {SHARED.alcance.items.map((item, idx) => (
          <li><span class="ed-eyebrow">{String(idx + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.body}</p></li>
        ))}
      </ol>
      <div class="pg-sanctions">
        <p class="ed-eyebrow">Lo que hay al otro lado</p>
        <ul class="pg-thresholds">
          {SANCIONES.map((s) => <li><strong>{s.importe}</strong><span>{s.quien}</span></li>)}
        </ul>
        <p class="pg-source">
          Régimen del artículo 201 bis de la Ley General Tributaria. Su aplicación a un caso
          concreto corresponde a tu asesoría.
        </p>
      </div>
    </section>

    <section class="pg-section pg-faq ed-faq" aria-labelledby="faq-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.faq}</p>
        <div>
          <h2 id="faq-title">{SHARED.faq.title}</h2>
          <div class="pg-faq-list">
            {SHARED.faq.items.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
          </div>
        </div>
      </div>
    </section>

    <section class="pg-section pg-section-flush pg-next" aria-labelledby="atascos-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.profundizar}</p>
        <div>
          <h2 id="atascos-title">Los tres puntos donde se atascan los proyectos</h2>
          <div class="pg-prose">
            <p>
              No es el envío a la AEAT. Son estas tres decisiones, y conviene tomarlas antes de
              escribir código.
            </p>
          </div>
        </div>
      </div>
      <div class="pg-offers">
        <a class="ed-offer" href="/es/blog/series-y-cadena-de-huellas-verifactu/">
          <span class="ed-eyebrow">Arquitectura</span>
          <h3>Cómo conviven las series con una única cadena de huellas</h3>
          <p>Qué cambia cuando facturas desde varias cajas o tiendas a la vez, y cuántos sistemas de facturación tiene realmente tu operación.</p>
          <span class="ed-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="ed-offer" href="/es/blog/qr-verifactu-ticket-termico-tpv/">
          <span class="ed-eyebrow">Impresión</span>
          <h3>Por qué el ticket de 58 mm rompe la implementación del QR</h3>
          <p>La norma pide entre 30 y 40 milímetros y el rollo deja 48 imprimibles. La aritmética de módulos que hay que hacer antes de comprar nada.</p>
          <span class="ed-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="ed-offer" href="/es/blog/anulaciones-y-rectificativas-verifactu/">
          <span class="ed-eyebrow">Casuística</span>
          <h3>Anular no es borrar y rectificar no es editar</h3>
          <p>Los dos caminos que la mayoría de sistemas resuelve con un solo botón, y lo que eso obliga a rehacer en el modelo de datos.</p>
          <span class="ed-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>

  <section class="ed-closing" aria-labelledby="vf-closing-title">
    <div class="ed-container">
      <p class="ed-eyebrow">{copy.closingLabel}</p>
      <h2 id="vf-closing-title" class="pg-closing-title">Empieza por saber qué hay que tocar</h2>
      <p class="pg-closing-copy">
        La auditoría del sistema de facturación dura entre tres y cinco días y sale con el alcance
        y el precio cerrados. Si en la auditoría técnica vemos que no te aplica, te lo decimos
        ahí; la calificación fiscal de tu caso concreto sigue siendo cosa de tu asesoría.
      </p>
      <a class="ed-button" href={contactHref}>Hablar con un especialista<span class="ed-arrow" aria-hidden="true">↗</span></a>
      <p class="pg-closing-aside">
        ¿Buscabas la otra obligación con plazo?{" "}
        <a href={sacHref}>Ley 10/2025 de atención a la clientela</a>
      </p>
      <p class="pg-disclaimer">{DISCLAIMER}</p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var el = document.getElementById("vf-countdown");
    if (!el) return;
    var deadline = new Date(el.getAttribute("data-deadline") + "T00:00:00+01:00").getTime();
    el.textContent = String(Math.max(0, Math.ceil((deadline - Date.now()) / 86400000)));
  })();
</script>
