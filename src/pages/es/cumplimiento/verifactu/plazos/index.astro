---
// Referencia de plazos de Verifactu. ES-only.
// Keyword primaria: "verifactu obligatorio" (secundarias: cuándo entra en vigor,
// verifactu 2027, verifactu autónomos). Intención informacional pura: la página
// responde "cuándo" con precisión y deriva al pilar para el "cómo".
//
// Regla de esta página: NINGUNA fecha se escribe a mano. Todas salen de NORMA
// en src/data/verifactu.ts, que es donde están las fuentes verificadas.

import BaseLayout from "@/layouts/BaseLayout.astro";
import { NORMA, DISCLAIMER, EXCLUSIONES, ANUNCIO, FACTURA_ELECTRONICA } from "@/data/verifactu";
import copy from "@/i18n/locales/es/pagesEditorial.json";
import "@/styles/editorial-pages.css";

// Rótulos de la versión editorial (oct/2026).
const L = copy.verifactu;

const locale = "es";
const site = Astro.site?.toString() ?? "https://iaoperators.com";
// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".
const siteRoot = site.replace(/\/$/, "");
const base = `/${locale}/cumplimiento/verifactu/`;
const pillarUrl = new URL(base, site).toString();
const pageUrl = new URL(`${base}plazos/`, site).toString();
const contactHref = `/${locale}/contact/`;

const hitos = [
  {
    fecha: NORMA.fechaFabricantesLegible,
    iso: NORMA.fechaFabricantes,
    quien: "Productores y comercializadores de software",
    que: "Los sistemas de facturación que se ofrezcan en el mercado deben poder funcionar ya de forma conforme. Es la fecha que casi nadie recuerda, y la que explica por qué tu proveedor lleva meses hablándote de esto.",
    pasado: true,
  },
  {
    fecha: NORMA.fechaSociedadesLegible,
    iso: NORMA.fechaSociedades,
    quien: "Contribuyentes del Impuesto sobre Sociedades",
    que: "Sociedades mercantiles y demás sujetos pasivos del Impuesto sobre Sociedades. Si tu empresa es una S.L. o una S.A., esta es tu fecha vigente.",
    pasado: false,
  },
  {
    fecha: NORMA.fechaRestoLegible,
    iso: NORMA.fechaResto,
    quien: "El resto de obligados tributarios",
    que: "Autónomos y demás contribuyentes que no tributan por el Impuesto sobre Sociedades. Seis meses más de margen, no una exención.",
    pasado: false,
  },
  {
    fecha: ANUNCIO.nuevaFechaLegible,
    iso: "",
    quien: "Todos los obligados (anunciado)",
    que: `Hacienda anunció el ${ANUNCIO.fechaLegible} que aplaza las obligaciones pendientes hasta ${ANUNCIO.nuevaFechaLegible}, para hacerlas coincidir con la factura electrónica obligatoria. Hasta que se publique en el BOE, las fechas de arriba siguen vigentes.`,
    pasado: false,
    anunciado: true,
  },
];

const meta = {
  title: "¿Cuándo es obligatorio Verifactu? Fechas y aplazamiento a 2028 | IA Operators",
  description: `Fechas vigentes de Verifactu (${NORMA.fechaSociedadesLegible} y ${NORMA.fechaRestoLegible}), el aplazamiento a ${ANUNCIO.nuevaFechaLegible} anunciado por Hacienda y pendiente del BOE, y a quién no le aplica.`,
};

const faq = [
  {
    q: "¿Cuándo es obligatorio Verifactu exactamente?",
    a: `Hoy, legalmente, el ${NORMA.fechaSociedadesLegible} para los contribuyentes del Impuesto sobre Sociedades y el ${NORMA.fechaRestoLegible} para el resto de obligados tributarios, autónomos incluidos, según el ${NORMA.aplazamiento}. El ${ANUNCIO.fechaLegible} Hacienda anunció su aplazamiento a ${ANUNCIO.nuevaFechaLegible}; esa será la fecha cuando la norma se publique en el BOE.`,
  },
  {
    q: "¿Verifactu se ha aplazado otra vez?",
    a: `Sí, está anunciado. El ${ANUNCIO.fechaLegible}, en una ${ANUNCIO.origen}, Hacienda comunicó que aplaza las obligaciones pendientes del Real Decreto 1007/2023 hasta ${ANUNCIO.nuevaFechaLegible}, para que coincidan con la factura electrónica obligatoria de las empresas y profesionales que facturan hasta 8 millones de euros. Mientras no se publique en el BOE, las fechas vigentes son las del ${NORMA.aplazamiento}. Los requisitos técnicos —integridad, conservación, accesibilidad, legibilidad, trazabilidad e inalterabilidad— se mantienen en términos sustancialmente equivalentes, así que el trabajo de adaptación no cambia: cambia el margen.`,
  },
  {
    q: "Soy autónomo, ¿me aplica y desde cuándo?",
    a: `Sí, salvo que estés en alguno de los supuestos de exclusión. Tu fecha vigente es el ${NORMA.fechaRestoLegible}, y con el aplazamiento anunciado pasaría a ${ANUNCIO.nuevaFechaLegible}. Si emites facturas con un programa informático —aunque sea una hoja de cálculo con macros o un software vertical de tu sector—, ese sistema tiene que cumplir.`,
  },
  {
    q: "¿Qué pasa si llego tarde?",
    a: "El régimen sancionador del artículo 201 bis de la Ley General Tributaria prevé 50.000 € por ejercicio para quien usa sistemas no conformes y 150.000 € por ejercicio para quien los produce o comercializa. La calificación de tu caso concreto corresponde a tu asesoría.",
  },
  {
    q: "¿Cuánto tiempo necesito para estar listo?",
    a: "Entre cuatro y siete semanas de proyecto contando la auditoría del sistema, según cuántos puntos de emisión tengas y qué casuística de series, rectificativas y anulaciones haya que cubrir. Lo que alarga los proyectos casi nunca es el envío a la AEAT: es descubrir tarde cómo factura realmente la empresa.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: meta.title,
    description: meta.description,
    url: pageUrl,
    inLanguage: "es-ES",
    about: {
      "@type": "Legislation",
      name: NORMA.nombre,
      legislationIdentifier: "BOE-A-2023-24840",
      legislationJurisdiction: "ES",
      url: NORMA.boeUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${siteRoot}/${locale}/` },
      { "@type": "ListItem", position: 2, name: "Verifactu", item: pillarUrl },
      { "@type": "ListItem", position: 3, name: "Plazos", item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalUrl={pageUrl}
  alternates={[{ lang: "es", href: pageUrl }]}
  xDefaultUrl={pageUrl}
  jsonLd={jsonLd}
  editorial
>
  <div class="ed-container">
    <header class="pg-hero pg-hero-compact">
      <nav class="pf-crumbs ed-eyebrow" aria-label={copy.breadcrumb.label}>
        <ol>
          <li><a href="/es/">{copy.breadcrumb.home}</a></li>
          <li><a href={base}>Verifactu</a></li>
          <li><span aria-current="page">Plazos</span></li>
        </ol>
      </nav>
      <h1>Cuándo te obliga <span>Verifactu</span></h1>
      <div class="pg-hero-bottom">
        <div class="pg-countdown">
          <p class="ed-eyebrow">Verifactu · aplazamiento anunciado el {ANUNCIO.fechaLegible}</p>
          <p class="pg-countdown-value">
            <strong>{ANUNCIO.nuevaFechaCorta}</strong>
            <span>octubre: nueva fecha anunciada<br />(pendiente de publicación en el BOE)</span>
          </p>
        </div>
        <p class="pg-lead pg-lead-strong">
          Dos fechas vigentes según cómo tribute tu empresa, un aplazamiento anunciado a
          octubre de 2028 que aún no está en el BOE, y una fecha ya pasada que explica por qué tu
          proveedor de software lleva meses insistiendo.
        </p>
      </div>
    </header>

    <section class="pg-section" aria-labelledby="fechas-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.calendario}</p>
        <h2 id="fechas-title">Las fechas</h2>
      </div>
      <ol class="pg-timeline pg-timeline-4">
        {hitos.map((h) => (
          <li class:list={{ "pg-timeline-past": h.pasado, "pg-timeline-announced": h.anunciado }}>
            <p class="pg-timeline-date">{h.fecha}</p>
            <p class="ed-eyebrow">{h.pasado ? "Ya en vigor" : h.anunciado ? "Anunciado · pendiente de BOE" : "Fecha vigente"}</p>
            <h3>{h.quien}</h3>
            <p>{h.que}</p>
          </li>
        ))}
      </ol>
      <p class="pg-source">
        Fechas vigentes tras el {NORMA.aplazamiento}. Aplazamiento a {ANUNCIO.nuevaFechaLegible}
        anunciado en {ANUNCIO.origen} del {ANUNCIO.fechaLegible}, pendiente de publicación en el
        BOE. Norma de referencia:{" "}
        <a href={NORMA.boeUrl} rel="noopener">{NORMA.nombre}</a>{" "}
        · Especificación técnica: {NORMA.ordenTecnica}.
      </p>
    </section>

    <section class="pg-section" aria-labelledby="no-aplica-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.exclusiones}</p>
        <div>
          <h2 id="no-aplica-title">A quién no le aplica</h2>
          <div class="pg-prose">
            <p>
              Decir a quién no le hace falta ahorra tiempo a todos. Si estás en uno de estos tres
              supuestos, puedes dejar de leer.
            </p>
          </div>
        </div>
      </div>
      <ol class="pg-columns">
        {EXCLUSIONES.map((e, idx) => (
          <li><span class="ed-eyebrow">{String(idx + 1).padStart(2, "0")}</span><h3>{e.title}</h3><p>{e.body}</p></li>
        ))}
      </ol>
    </section>

    <section class="pg-section" aria-labelledby="margen-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.margen}</p>
        <div>
          <h2 id="margen-title">Qué hacer con el margen que queda</h2>
          <div class="pg-prose">
            <p>
              El error de cálculo habitual es tratar esto como una actualización de software que se
              instala el mes anterior. El trabajo que consume el calendario no es enviar registros a
              la AEAT: es descubrir cuántos sitios de tu empresa emiten factura, con qué series, y
              qué pasa con las anulaciones y las rectificativas que nadie documentó nunca.
            </p>
            <p>
              Ese inventario es también lo que decide si te conviene la modalidad VERI*FACTU —remisión
              inmediata— o un sistema no verificable con firma, registro de eventos y gestión de
              alarmas. No es una preferencia: depende de si tus puntos de emisión tienen conectividad
              fiable.
            </p>
            <p>
              El aplazamiento anunciado da margen, pero no cambia el trabajo. Y se cruza con otra
              obligación: la factura electrónica entre empresas ({FACTURA_ELECTRONICA.rd}) empieza a
              contar desde la entrada en vigor de la {FACTURA_ELECTRONICA.orden}, el
              {" "}{FACTURA_ELECTRONICA.ordenVigorLegible}. Llega en {FACTURA_ELECTRONICA.grandesLegible}
              para quien supera 8 millones de euros de volumen de operaciones y en
              {" "}{FACTURA_ELECTRONICA.restoLegible} para el resto. Si tu sistema tiene que adaptarse a las
              dos, suele salir más barato hacerlo en un solo proyecto.
            </p>
          </div>
          <ul class="pg-linklist">
            <li><a href={`${base}test/`}>Comprobar mi caso en 2 minutos <span class="ed-arrow" aria-hidden="true">→</span></a></li>
            <li><a href={base}>Cómo se implementa <span class="ed-arrow" aria-hidden="true">→</span></a></li>
            <li><a href={`${base}api/`}>La integración con la API de la AEAT <span class="ed-arrow" aria-hidden="true">→</span></a></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="pg-section pg-faq ed-faq" aria-labelledby="faq-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.faq}</p>
        <div>
          <h2 id="faq-title">Preguntas frecuentes</h2>
          <div class="pg-faq-list">
            {faq.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="ed-closing" aria-labelledby="plazos-closing-title">
    <div class="ed-container">
      <p class="ed-eyebrow">{copy.closingLabel}</p>
      <h2 id="plazos-closing-title" class="pg-closing-title">¿Tu sistema llega a tiempo?</h2>
      <p class="pg-closing-copy">
        En una llamada corta te decimos si te aplica, qué modalidad te encaja y qué hay que
        construir. Si estás en el SII o tributas en territorio foral, te lo decimos ahí mismo.
      </p>
      <a class="ed-button" href={contactHref}>Hablar con un especialista<span class="ed-arrow" aria-hidden="true">↗</span></a>
      <p class="pg-disclaimer">{DISCLAIMER}</p>
    </div>
  </section>
</BaseLayout>


