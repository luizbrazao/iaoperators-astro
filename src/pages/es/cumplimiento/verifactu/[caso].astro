---
// Páginas por caso de la Frente B. ES-only.
// Misma regla anti-doorway que las sectoriales de la Ley 10/2025: la mayoría del
// contenido es propio (intro, escenario, por qué no migras, tres especificidades
// y FAQ), y lo compartido se resume enlazando al pilar.

export async function getStaticPaths() {
  return CASO_SLUGS.map((caso) => ({ params: { caso } }));
}

import BaseLayout from "@/layouts/BaseLayout.astro";
import { NORMA, DISCLAIMER, SHARED, CASOS, CASO_SLUGS, type CasoSlug } from "@/data/verifactu";

const locale = "es";
const slug = Astro.params.caso as CasoSlug;
const c = CASOS[slug];

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const base = `/${locale}/cumplimiento/verifactu/`;
const pillarUrl = new URL(base, site).toString();
const pageUrl = new URL(`${base}${slug}/`, site).toString();
const contactHref = `/${locale}/contact/`;

const deadline = new Date(`${NORMA.fechaSociedades}T00:00:00+01:00`);
const diasRestantes = Math.max(
  0,
  Math.ceil((deadline.getTime() - Date.now()) / (1000 * 60 * 60 * 24)),
);

const otros = CASO_SLUGS.filter((s) => s !== slug).map((s) => ({
  slug: s,
  nombreCorto: CASOS[s].nombreCorto,
}));

const providerSchema = {
  "@type": ["Organization", "ProfessionalService"],
  name: "IA Operators",
  url: site,
  logo: { "@type": "ImageObject", url: `${site}/favicon-32x32.png` },
  address: { "@type": "PostalAddress", addressLocality: "Málaga", addressCountry: "ES" },
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: c.h1,
  serviceType: "Tax compliance systems integration",
  provider: providerSchema,
  areaServed: "ES",
  audience: { "@type": "BusinessAudience", name: c.nombre },
  description: c.metaDescription,
  url: pageUrl,
  inLanguage: "es-ES",
  about: {
    "@type": "Legislation",
    name: NORMA.nombre,
    legislationIdentifier: "BOE-A-2023-24840",
    legislationJurisdiction: "ES",
    url: NORMA.boeUrl,
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${site}/${locale}/` },
    { "@type": "ListItem", position: 2, name: "Verifactu", item: pillarUrl },
    { "@type": "ListItem", position: 3, name: c.nombreCorto, item: pageUrl },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title={`${c.metaTitle} | IA Operators`}
  description={c.metaDescription}
  canonicalUrl={pageUrl}
  alternates={[{ lang: "es", href: pageUrl }]}
  xDefaultUrl={pageUrl}
  jsonLd={[serviceJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <div class="bg-transparent text-white">
    <!-- HERO -->
    <section class="px-4 pt-28 pb-14">
      <div class="max-w-4xl mx-auto text-center">
        <a
          href={base}
          class="inline-block text-xs text-gray-500 hover:text-orange-400 transition-colors mb-6"
        >
          ← Verifactu
        </a>
        <span class="block mb-5">
          <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold">
            {c.nombreCorto} · {NORMA.fechaSociedadesLegible}
          </span>
        </span>
        <h1 class="text-3xl md:text-5xl font-medium tracking-tight leading-tight mb-6">{c.h1}</h1>
        <p class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto">{c.intro}</p>
      </div>
    </section>

    <!-- ESCENARIO -->
    <section class="px-4 pb-16">
      <div class="max-w-3xl mx-auto">
        <div class="bg-[#0a0a0a] border-l-2 border-orange-500 rounded-r-2xl p-6 md:p-8">
          <div class="text-xs font-semibold uppercase tracking-widest text-orange-400 mb-3">
            El detalle que rompe la implementación
          </div>
          <p class="text-gray-200 text-lg leading-relaxed">{c.escenario}</p>
        </div>
      </div>
    </section>

    <!-- POR QUÉ NO MIGRAS -->
    <section class="px-4 pb-16">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Por qué migrar no es la respuesta</h2>
        <p class="text-gray-300 leading-relaxed mb-6">{c.porQueNoMigras}</p>
        <p class="text-gray-400 text-sm leading-relaxed">
          Quedan <span class="text-orange-400 font-semibold tabular-nums">{diasRestantes}</span> días
          para el 1 de enero de 2027, la fecha que aplica a los contribuyentes del Impuesto sobre
          Sociedades. Para el resto de obligados, el {NORMA.fechaRestoLegible}.
        </p>
      </div>
    </section>

    <!-- ESPECÍFICOS -->
    <section class="px-4 py-20 bg-white/[0.02] border-y border-white/5">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-3 text-center">
          Lo que cambia en tu caso
        </h2>
        <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
          El reglamento es el mismo para todos. Lo que cambia es dónde se rompe.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {c.especificos.map((item, idx) => (
            <div class="bg-[#0a0a0a] border border-white/5 rounded-3xl p-6 hover:border-orange-500/30 transition-all duration-300">
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-orange-500/10 text-orange-400 font-bold text-xs mb-4">
                {String(idx + 1).padStart(2, "0")}
              </span>
              <h3 class="text-lg font-semibold text-white mb-2">{item.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESO (corto) -->
    <section class="px-4 py-20">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Cómo lo abordamos</h2>
        <p class="text-gray-400 mb-8">
          El detalle completo de la arquitectura y de los requisitos está en la
          <a href={base} class="text-orange-400 underline hover:text-orange-300">página de Verifactu</a>.
        </p>
        <ol class="space-y-3">
          {SHARED.proceso.phases.map((phase) => (
            <li class="flex items-start gap-4 bg-white/[0.02] border border-white/5 rounded-2xl p-5">
              <span class="text-orange-400 text-xs font-semibold tabular-nums shrink-0 mt-1">
                {phase.code}
              </span>
              <div>
                <div class="text-white font-medium">
                  {phase.title}
                  <span class="text-gray-500 text-sm font-normal"> · {phase.plazo}</span>
                </div>
                <p class="text-gray-400 text-sm leading-relaxed mt-1">{phase.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- FAQ -->
    <section class="px-4 py-20 bg-white/[0.02] border-y border-white/5">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-10 text-center">Preguntas de este caso</h2>
        <div class="space-y-3">
          {c.faq.map((item) => (
            <details class="group bg-[#0a0a0a] border border-white/5 rounded-2xl px-6 py-4 hover:border-orange-500/20 transition-all duration-300">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <span class="text-white font-medium pr-4">{item.q}</span>
                <span class="text-orange-400 text-xl leading-none transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-gray-400 mt-3 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA + OTROS CASOS -->
    <section class="px-4 py-20">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl md:text-4xl font-bold mb-4">Empieza por la auditoría del sistema</h2>
        <p class="text-gray-400 mb-8">
          Tres a cinco días para saber exactamente qué hay que tocar, con alcance y precio cerrados.
        </p>
        <a
          href={contactHref}
          class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-orange-500 text-black font-medium hover:bg-orange-400 hover:scale-105 transition-all duration-300 mb-16"
        >
          Hablar con un especialista ↗
        </a>

        <div class="border-t border-white/5 pt-10">
          <p class="text-xs uppercase tracking-widest text-gray-600 mb-4">Otros casos</p>
          <div class="flex flex-wrap justify-center gap-2">
            {otros.map((o) => (
              <a
                href={`${base}${o.slug}/`}
                class="px-4 py-2 rounded-full bg-[#0a0a0a] border border-white/10 text-gray-300 text-sm hover:border-orange-500/30 hover:text-white transition-colors"
              >
                {o.nombreCorto}
              </a>
            ))}
          </div>
        </div>

        <p class="text-xs text-gray-600 mt-12 max-w-2xl mx-auto leading-relaxed">{DISCLAIMER}</p>
      </div>
    </section>
  </div>
</BaseLayout>
