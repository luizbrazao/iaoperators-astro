---
// Páginas por caso de la Frente B. ES-only.
// Misma regla anti-doorway que las sectoriales de la Ley 10/2025: la mayoría del
// contenido es propio (intro, escenario, por qué no migras, tres especificidades
// y FAQ), y lo compartido se resume enlazando al pilar.

export async function getStaticPaths() {
  return CASO_SLUGS.map((caso) => ({ params: { caso } }));
}

import BaseLayout from "@/layouts/BaseLayout.astro";
import { NORMA, DISCLAIMER, SHARED, CASOS, CASO_SLUGS, ANUNCIO, type CasoSlug } from "@/data/verifactu";
import copy from "@/i18n/locales/es/pagesEditorial.json";
import "@/styles/editorial-pages.css";

const locale = "es";
const slug = Astro.params.caso as CasoSlug;
const c = CASOS[slug];

const site = Astro.site?.toString() ?? "https://iaoperators.com";

// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".

const siteRoot = site.replace(/\/$/, "");
const base = `/${locale}/cumplimiento/verifactu/`;
const pillarUrl = new URL(base, site).toString();
const pageUrl = new URL(`${base}${slug}/`, site).toString();
const contactHref = `/${locale}/contact/`;


// Rótulos de la versión editorial; el H1 se parte tras "Verifactu" solo en el marcado.
const L = copy.verifactu;
const prefix = `${NORMA.nombreCorto} `;
const h1Lead = c.h1.startsWith(prefix) ? NORMA.nombreCorto : c.h1;
const h1Accent = c.h1.startsWith(prefix) ? c.h1.slice(prefix.length) : "";

const otros = CASO_SLUGS.filter((s) => s !== slug).map((s) => ({
  slug: s,
  nombreCorto: CASOS[s].nombreCorto,
}));

const providerSchema = {
  "@type": ["Organization", "ProfessionalService"],
  name: "IA Operators",
  url: site,
  logo: { "@type": "ImageObject", url: `${siteRoot}/favicon-32x32.png` },
  address: { "@type": "PostalAddress", addressLocality: "Málaga", addressCountry: "ES" },
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: c.h1,
  serviceType: "Tax compliance systems integration",
  provider: providerSchema,
  areaServed: "ES",
  audience: { "@type": "BusinessAudience", name: c.nombre },
  description: c.metaDescription,
  url: pageUrl,
  inLanguage: "es-ES",
  about: {
    "@type": "Legislation",
    name: NORMA.nombre,
    legislationIdentifier: "BOE-A-2023-24840",
    legislationJurisdiction: "ES",
    url: NORMA.boeUrl,
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${siteRoot}/${locale}/` },
    { "@type": "ListItem", position: 2, name: "Verifactu", item: pillarUrl },
    { "@type": "ListItem", position: 3, name: c.nombreCorto, item: pageUrl },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title={`${c.metaTitle} | IA Operators`}
  description={c.metaDescription}
  canonicalUrl={pageUrl}
  alternates={[{ lang: "es", href: pageUrl }]}
  xDefaultUrl={pageUrl}
  jsonLd={[serviceJsonLd, breadcrumbJsonLd, faqJsonLd]}
  editorial
>
  <div class="ed-container">
    <header class="pg-hero pg-hero-compact">
      <nav class="pf-crumbs ed-eyebrow" aria-label={copy.breadcrumb.label}>
        <ol>
          <li><a href="/es/">{copy.breadcrumb.home}</a></li>
          <li><a href={base}>{L.volver}</a></li>
          <li><span aria-current="page">{c.nombreCorto}</span></li>
        </ol>
      </nav>
      <h1>{h1Lead}{h1Accent && <> <span>{h1Accent}</span></>}</h1>
      <div class="pg-hero-bottom">
        <p class="ed-eyebrow">{c.nombreCorto} · aplazamiento anunciado a {ANUNCIO.nuevaFechaLegible}</p>
        <div>
          <p class="pg-lead">{c.intro}</p>
          <div class="pg-actions">
            <a class="ed-underlined" href={base}>Verifactu <span class="ed-arrow" aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </header>

    <section class="pg-section pg-signal" aria-label={L.escenario}>
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.escenario}</p>
        <p class="pg-signal-text">{c.escenario}</p>
      </div>
    </section>

    <section class="pg-section" aria-labelledby="migrar-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.porQue}</p>
        <div>
          <h2 id="migrar-title">Por qué migrar no es la respuesta</h2>
          <div class="pg-prose">
            <p>{c.porQueNoMigras}</p>
            <p>
              Las fechas vigentes son el {NORMA.fechaSociedadesLegible} para los contribuyentes del
              Impuesto sobre Sociedades y el {NORMA.fechaRestoLegible} para el resto. El
              {" "}{ANUNCIO.fechaLegible} Hacienda anunció su aplazamiento a {ANUNCIO.nuevaFechaLegible},
              pendiente de publicación en el BOE. Los requisitos no cambian: cambia el margen para
              hacerlo bien.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="pg-section" aria-labelledby="especificos-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{c.nombreCorto}</p>
        <div>
          <h2 id="especificos-title">Lo que cambia en tu caso</h2>
          <div class="pg-prose"><p>El reglamento es el mismo para todos. Lo que cambia es dónde se rompe.</p></div>
        </div>
      </div>
      <ol class="pg-columns">
        {c.especificos.map((item, idx) => (
          <li><span class="ed-eyebrow">{String(idx + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.body}</p></li>
        ))}
      </ol>
    </section>
  </div>

  <section class="ed-method pg-method pg-process" aria-labelledby="proceso-title">
    <div class="ed-container">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.proceso}</p>
        <div>
          <h2 id="proceso-title">Cómo lo abordamos</h2>
          <p class="pg-method-lead">
            El detalle completo de la arquitectura y de los requisitos está en la{" "}
            <a class="pg-inline-link" href={base}>página de Verifactu</a>.
          </p>
        </div>
      </div>
      <ol class="ed-steps pg-steps-4">
        {SHARED.proceso.phases.map((phase) => (
          <li><span class="ed-eyebrow">{phase.code} · {phase.plazo}</span><p class="pg-step-title">{phase.title}</p><p>{phase.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <div class="ed-container">
    <section class="pg-section pg-faq ed-faq" aria-labelledby="faq-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.faq}</p>
        <div>
          <h2 id="faq-title">Preguntas de este caso</h2>
          <div class="pg-faq-list">
            {c.faq.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="ed-closing" aria-labelledby="caso-closing-title">
    <div class="ed-container">
      <p class="ed-eyebrow">{copy.closingLabel}</p>
      <h2 id="caso-closing-title" class="pg-closing-title">Empieza por la auditoría del sistema</h2>
      <p class="pg-closing-copy">Tres a cinco días para saber exactamente qué hay que tocar, con alcance y precio cerrados.</p>
      <a class="ed-button" href={contactHref}>Hablar con un especialista<span class="ed-arrow" aria-hidden="true">↗</span></a>
      <nav class="pg-siblings" aria-label={L.otros}>
        <p class="ed-eyebrow">{L.otros}</p>
        <ul>{otros.map((o) => <li><a href={`${base}${o.slug}/`}>{o.nombreCorto}</a></li>)}</ul>
      </nav>
      <p class="pg-disclaimer">{DISCLAIMER}</p>
    </div>
  </section>
</BaseLayout>
