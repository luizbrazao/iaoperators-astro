---
// Test de cumplimiento de la Ley 10/2025 — ES-only, indexable.
// El resultado se calcula en el servidor y se pinta en la misma página (la island
// cambia de vista): evita una página /resultado/ vacía para el crawler y evita
// pasar el estado por URL.

import BaseLayout from "@/layouts/BaseLayout.astro";
import Assessment from "@/islands/Assessment";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-forms.css";
import { LEY } from "@/data/sectores-sac";

const locale = "es";
const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pillarUrl = new URL(`/${locale}/cumplimiento/ley-atencion-al-cliente/`, site).toString();
const pageUrl = new URL(`/${locale}/cumplimiento/ley-atencion-al-cliente/test/`, site).toString();

const deadline = new Date(`${LEY.plazoAdaptacion}T00:00:00+01:00`);
const diasRestantes = Math.max(
  0,
  Math.ceil((deadline.getTime() - Date.now()) / (1000 * 60 * 60 * 24)),
);

const meta = {
  title: "Test de cumplimiento de la Ley 10/2025 en 2 minutos | IA Operators",
  description:
    "Comprueba si tu empresa está obligada por la Ley 10/2025 de atención a la clientela y qué brechas tienes por obligación. 8 preguntas, resultado inmediato, sin dar email.",
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${site}/${locale}/` },
    { "@type": "ListItem", position: 2, name: "Ley de atención a la clientela", item: pillarUrl },
    { "@type": "ListItem", position: 3, name: "Test de cumplimiento", item: pageUrl },
  ],
};

const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: meta.title,
  description: meta.description,
  url: pageUrl,
  inLanguage: "es-ES",
  isPartOf: { "@type": "WebSite", name: "IA Operators", url: site },
  about: {
    "@type": "Legislation",
    name: LEY.nombre,
    legislationIdentifier: LEY.boeId,
    legislationJurisdiction: "ES",
    url: LEY.boeUrl,
  },
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalUrl={pageUrl}
  alternates={[{ lang: "es", href: pageUrl }]}
  xDefaultUrl={pageUrl}
  ogImage="/og/es/ley-atencion-al-cliente.png"
  ogImageAlt="Test de cumplimiento de la Ley 10/2025"
  jsonLd={[breadcrumbJsonLd, webPageJsonLd]}
  editorial
>
  {/* Diseño editorial (oct/2026). ES-only: mismos textos, H1/H2 y endpoints. */}
  <div class="ed-container">
    <header class="pg-hero">
      <nav class="pf-crumbs ed-eyebrow" aria-label="Ruta de navegación">
        <ol>
          <li><a href="/es/">Inicio</a></li>
          <li><a href={pillarUrl}>Ley 10/2025 de atención a la clientela</a></li>
          <li><span aria-current="page">Test de cumplimiento</span></li>
        </ol>
      </nav>
      <h1>¿Cumple tu atención a la clientela la Ley 10/2025?</h1>
      <div class="pg-hero-bottom">
        <p class="ed-eyebrow">Test · 8 preguntas · 2 min</p>
        <p class="pg-lead">
          Ocho preguntas. Te decimos si estás obligado, qué exige la norma en tu caso y dónde
          está tu brecha, obligación por obligación. Quedan
          <span class="as-countdown pg-tabular">{diasRestantes}</span> días de plazo.
        </p>
      </div>
    </header>

    <div class="as-layout">
      <div class="as-main">
        <Assessment client:load />
      </div>
      <aside class="as-notes" aria-label="Cómo funciona el test">
        <div>
          <h2>Reglas, no adivinanzas</h2>
          <p>El resultado sale de reglas deterministas sobre el texto publicado en el BOE. La misma
            respuesta da siempre el mismo veredicto, y cada brecha indica de qué pregunta sale.</p>
        </div>
        <div>
          <h2>Sin muro de email</h2>
          <p>Ves el resultado completo sin dejar datos. El email solo es necesario si quieres el
            informe ampliado con el checklist de evidencias.</p>
        </div>
        <div>
          <h2>No es asesoramiento jurídico</h2>
          <p>Somos ingeniería: traducimos el requisito en sistema. La interpretación legal del
            alcance corresponde a tu asesoría o despacho.</p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
