---
// Páginas sectoriales de la Frente A. ES-only.
//
// REGLA ANTI-DOORWAY: la mayor parte del contenido de cada página es único
// (intro, escenario operativo, alcance con su letra del art. 2.1, tres
// especificidades y tres FAQ propias). Lo compartido se muestra en versión
// corta y enlaza al pilar en vez de duplicarlo. Si en el futuro se añade un
// sector, la regla es la misma: si no hay materia propia que contar, no se
// crea la página.

export async function getStaticPaths() {
  return SECTOR_SLUGS.map((sector) => ({ params: { sector } }));
}

import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  LEY,
  DISCLAIMER,
  OBLIGACIONES,
  SHARED,
  SECTORES,
  SECTOR_SLUGS,
  type SectorSlug,
} from "@/data/sectores-sac";

const locale = "es";
const slug = Astro.params.sector as SectorSlug;
const c = SECTORES[slug];

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const base = `/${locale}/cumplimiento/ley-atencion-al-cliente/`;
const pillarUrl = new URL(base, site).toString();
const pageUrl = new URL(`${base}${slug}/`, site).toString();
const testHref = `${base}test/`;
const contactHref = `/${locale}/contact/`;

const deadline = new Date(`${LEY.plazoAdaptacion}T00:00:00+01:00`);
const diasRestantes = Math.max(
  0,
  Math.ceil((deadline.getTime() - Date.now()) / (1000 * 60 * 60 * 24)),
);

// Otros sectores, para enlace lateral (silo interno).
const otros = SECTOR_SLUGS.filter((s) => s !== slug).map((s) => ({
  slug: s,
  nombreCorto: SECTORES[s].nombreCorto,
}));

const providerSchema = {
  "@type": ["Organization", "ProfessionalService"],
  name: "IA Operators",
  url: site,
  logo: { "@type": "ImageObject", url: `${site}/favicon-32x32.png` },
  address: { "@type": "PostalAddress", addressLocality: "Málaga", addressCountry: "ES" },
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: c.h1,
  serviceType: "Regulatory compliance systems integration",
  provider: providerSchema,
  areaServed: "ES",
  audience: { "@type": "BusinessAudience", name: c.nombre },
  description: c.metaDescription,
  url: pageUrl,
  inLanguage: "es-ES",
  about: {
    "@type": "Legislation",
    name: LEY.nombre,
    legislationIdentifier: LEY.boeId,
    legislationJurisdiction: "ES",
    url: LEY.boeUrl,
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${site}/${locale}/` },
    { "@type": "ListItem", position: 2, name: "Ley de atención a la clientela", item: pillarUrl },
    { "@type": "ListItem", position: 3, name: c.nombreCorto, item: pageUrl },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title={`${c.metaTitle} | IA Operators`}
  description={c.metaDescription}
  canonicalUrl={pageUrl}
  alternates={[{ lang: "es", href: pageUrl }]}
  xDefaultUrl={pageUrl}
  ogImage="/og/es/ley-atencion-al-cliente.png"
  ogImageAlt={c.h1}
  jsonLd={[serviceJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <div class="bg-transparent text-white">
    <!-- HERO -->
    <section class="px-4 pt-28 pb-14">
      <div class="max-w-4xl mx-auto text-center">
        <a
          href={base}
          class="inline-block text-xs text-gray-500 hover:text-orange-400 transition-colors mb-6"
        >
          ← Ley 10/2025 de atención a la clientela
        </a>
        <span class="block mb-5">
          <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold">
            {c.nombreCorto} · Plazo {LEY.plazoAdaptacionLegible}
          </span>
        </span>
        <h1 class="text-3xl md:text-5xl font-medium tracking-tight leading-tight mb-6">
          {c.h1}
        </h1>
        <p class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto">{c.intro}</p>
      </div>
    </section>

    <!-- ESCENARIO -->
    <section class="px-4 pb-16">
      <div class="max-w-3xl mx-auto">
        <div class="bg-[#0a0a0a] border-l-2 border-orange-500 rounded-r-2xl p-6 md:p-8">
          <div class="text-xs font-semibold uppercase tracking-widest text-orange-400 mb-3">
            El día que se rompe
          </div>
          <p class="text-gray-200 text-lg leading-relaxed">{c.escenario}</p>
        </div>
      </div>
    </section>

    <!-- ALCANCE -->
    <section class="px-4 pb-16">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">¿Por qué estáis obligados?</h2>
        <p class="text-gray-300 leading-relaxed mb-6">{c.alcance}</p>
        <p class="text-gray-400 text-sm leading-relaxed">
          En los servicios básicos de interés general la obligación no depende del tamaño: no hay
          umbral de plantilla ni de facturación que os deje fuera. Quedan
          <span class="text-orange-400 font-semibold tabular-nums">{diasRestantes}</span> días para
          el fin del plazo de adaptación.
        </p>
      </div>
    </section>

    <!-- ESPECÍFICOS DEL SECTOR -->
    <section class="px-4 py-20 bg-white/[0.02] border-y border-white/5">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-3 text-center">
          Lo que cambia en {c.nombreCorto.toLowerCase()}
        </h2>
        <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
          Las obligaciones son las mismas para todos, pero no aprietan igual. Esto es lo que en
          vuestro caso decide si el sistema aguanta o no.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {c.especificos.map((item, idx) => (
            <div class="bg-[#0a0a0a] border border-white/5 rounded-3xl p-6 hover:border-orange-500/30 transition-all duration-300">
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-orange-500/10 text-orange-400 font-bold text-xs mb-4">
                {String(idx + 1).padStart(2, "0")}
              </span>
              <h3 class="text-lg font-semibold text-white mb-2">{item.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- OBLIGACIONES (versión corta, el detalle vive en el pilar) -->
    <section class="px-4 py-20">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Las obligaciones que os aplican</h2>
        <p class="text-gray-400 mb-8">
          El mapeo completo de cada obligación a lo que hay que construir está en la
          <a href={base} class="text-orange-400 underline hover:text-orange-300">página principal</a>.
        </p>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {OBLIGACIONES.map((o) => (
            <li class="flex items-start gap-3 bg-white/[0.02] border border-white/5 rounded-2xl p-4">
              <span class="text-orange-400 leading-none mt-1 shrink-0">▪</span>
              <span class="text-gray-300 text-sm leading-relaxed">{o.ley}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- QUÉ CONSTRUIMOS (corto) -->
    <section class="px-4 py-20 bg-white/[0.02] border-y border-white/5">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-3 text-center">Qué construimos</h2>
        <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">
          Sobre vuestros sistemas actuales, no sustituyéndolos.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {SHARED.arquitectura.items.slice(0, 3).map((item) => (
            <div class="bg-[#0a0a0a] border border-white/5 rounded-3xl p-6">
              <h3 class="text-lg font-semibold text-white mb-2">{item.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
        <div class="text-center mt-8">
          <a href={base} class="text-sm text-orange-400 underline hover:text-orange-300">
            Ver la arquitectura completa y el proceso de implementación ↗
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ SECTORIAL -->
    <section class="px-4 py-20">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-10 text-center">
          Preguntas de {c.nombreCorto.toLowerCase()}
        </h2>
        <div class="space-y-3">
          {c.faq.map((item) => (
            <details class="group bg-[#0a0a0a] border border-white/5 rounded-2xl px-6 py-4 hover:border-orange-500/20 transition-all duration-300">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <span class="text-white font-medium pr-4">{item.q}</span>
                <span class="text-orange-400 text-xl leading-none transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-gray-400 mt-3 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA + OTROS SECTORES -->
    <section class="px-4 py-20">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl md:text-4xl font-bold mb-4">
          ¿Dónde está vuestra brecha ahora mismo?
        </h2>
        <p class="text-gray-400 mb-8">
          Ocho preguntas, resultado inmediato y obligación por obligación. Sin dejar email.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-16">
          <a
            href={testHref}
            class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-orange-500 text-black font-medium hover:bg-orange-400 hover:scale-105 transition-all duration-300"
          >
            Test de cumplimiento · 2 min ↗
          </a>
          <a
            href={contactHref}
            class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-black text-orange-400 border border-orange-500/30 font-medium hover:bg-orange-500/10 transition-all duration-300"
          >
            Hablar con un especialista
          </a>
        </div>

        <div class="border-t border-white/5 pt-10">
          <p class="text-xs uppercase tracking-widest text-gray-600 mb-4">Otros sectores obligados</p>
          <div class="flex flex-wrap justify-center gap-2">
            {otros.map((o) => (
              <a
                href={`${base}${o.slug}/`}
                class="px-4 py-2 rounded-full bg-[#0a0a0a] border border-white/10 text-gray-300 text-sm hover:border-orange-500/30 hover:text-white transition-colors"
              >
                {o.nombreCorto}
              </a>
            ))}
          </div>
        </div>

        <p class="text-xs text-gray-600 mt-12 max-w-2xl mx-auto leading-relaxed">{DISCLAIMER}</p>
      </div>
    </section>
  </div>
</BaseLayout>
