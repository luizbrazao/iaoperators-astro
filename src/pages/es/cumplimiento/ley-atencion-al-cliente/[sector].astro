---
// Páginas sectoriales de la Frente A. ES-only.
//
// REGLA ANTI-DOORWAY: la mayor parte del contenido de cada página es único
// (intro, escenario operativo, alcance con su letra del art. 2.1, tres
// especificidades y tres FAQ propias). Lo compartido se muestra en versión
// corta y enlaza al pilar en vez de duplicarlo. Si en el futuro se añade un
// sector, la regla es la misma: si no hay materia propia que contar, no se
// crea la página.

export async function getStaticPaths() {
  return SECTOR_SLUGS.map((sector) => ({ params: { sector } }));
}

import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  LEY,
  DISCLAIMER,
  OBLIGACIONES,
  SHARED,
  SECTORES,
  SECTOR_SLUGS,
  type SectorSlug,
} from "@/data/sectores-sac";
import copy from "@/i18n/locales/es/pagesEditorial.json";
import "@/styles/editorial-pages.css";

const locale = "es";
const slug = Astro.params.sector as SectorSlug;
const c = SECTORES[slug];

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const base = `/${locale}/cumplimiento/ley-atencion-al-cliente/`;
const pillarUrl = new URL(base, site).toString();
const pageUrl = new URL(`${base}${slug}/`, site).toString();
const testHref = `${base}test/`;
const contactHref = `/${locale}/contact/`;

const deadline = new Date(`${LEY.plazoAdaptacion}T00:00:00+01:00`);
const diasRestantes = Math.max(
  0,
  Math.ceil((deadline.getTime() - Date.now()) / (1000 * 60 * 60 * 24)),
);

// Rótulos de la versión editorial; el H1 se parte tras "Ley 10/2025" solo en el marcado.
const L = copy.leySac;
const prefix = `${LEY.nombreCorto} `;
const h1Lead = c.h1.startsWith(prefix) ? LEY.nombreCorto : c.h1;
const h1Accent = c.h1.startsWith(prefix) ? c.h1.slice(prefix.length) : "";

// Otros sectores, para enlace lateral (silo interno).
const otros = SECTOR_SLUGS.filter((s) => s !== slug).map((s) => ({
  slug: s,
  nombreCorto: SECTORES[s].nombreCorto,
}));

const providerSchema = {
  "@type": ["Organization", "ProfessionalService"],
  name: "IA Operators",
  url: site,
  logo: { "@type": "ImageObject", url: `${site}/favicon-32x32.png` },
  address: { "@type": "PostalAddress", addressLocality: "Málaga", addressCountry: "ES" },
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: c.h1,
  serviceType: "Regulatory compliance systems integration",
  provider: providerSchema,
  areaServed: "ES",
  audience: { "@type": "BusinessAudience", name: c.nombre },
  description: c.metaDescription,
  url: pageUrl,
  inLanguage: "es-ES",
  about: {
    "@type": "Legislation",
    name: LEY.nombre,
    legislationIdentifier: LEY.boeId,
    legislationJurisdiction: "ES",
    url: LEY.boeUrl,
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${site}/${locale}/` },
    { "@type": "ListItem", position: 2, name: "Ley de atención a la clientela", item: pillarUrl },
    { "@type": "ListItem", position: 3, name: c.nombreCorto, item: pageUrl },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title={`${c.metaTitle} | IA Operators`}
  description={c.metaDescription}
  canonicalUrl={pageUrl}
  alternates={[{ lang: "es", href: pageUrl }]}
  xDefaultUrl={pageUrl}
  ogImage="/og/es/ley-atencion-al-cliente.png"
  ogImageAlt={c.h1}
  jsonLd={[serviceJsonLd, breadcrumbJsonLd, faqJsonLd]}
  editorial
>
  <div class="ed-container">
    <header class="pg-hero pg-hero-compact">
      <nav class="pf-crumbs ed-eyebrow" aria-label={copy.breadcrumb.label}>
        <ol>
          <li><a href="/es/">{copy.breadcrumb.home}</a></li>
          <li><a href={base}>{LEY.nombreCorto}</a></li>
          <li><span aria-current="page">{c.nombreCorto}</span></li>
        </ol>
      </nav>
      <h1>{h1Lead}{h1Accent && <> <span>{h1Accent}</span></>}</h1>
      <div class="pg-hero-bottom">
        <p class="ed-eyebrow">{c.nombreCorto} · Plazo {LEY.plazoAdaptacionLegible}</p>
        <div>
          <p class="pg-lead">{c.intro}</p>
          <div class="pg-actions">
            <a class="ed-underlined" href={base}>Ley 10/2025 de atención a la clientela <span class="ed-arrow" aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </header>

    <section class="pg-section pg-signal" aria-label={L.escenario}>
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.escenario}</p>
        <p class="pg-signal-text">{c.escenario}</p>
      </div>
    </section>

    <section class="pg-section" aria-labelledby="alcance-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.ambito}</p>
        <div>
          <h2 id="alcance-title">¿Por qué estáis obligados?</h2>
          <div class="pg-prose">
            <p>{c.alcance}</p>
            <p>
              En los servicios básicos de interés general la obligación no depende del tamaño: no hay
              umbral de plantilla ni de facturación que os deje fuera. Quedan
              <strong class="pg-tabular">{diasRestantes}</strong> días para el fin del plazo de adaptación.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="pg-section" aria-labelledby="especificos-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{c.nombreCorto}</p>
        <div>
          <h2 id="especificos-title">Lo que cambia en {c.nombreCorto.toLowerCase()}</h2>
          <div class="pg-prose">
            <p>
              Las obligaciones son las mismas para todos, pero no aprietan igual. Esto es lo que en
              vuestro caso decide si el sistema aguanta o no.
            </p>
          </div>
        </div>
      </div>
      <ol class="pg-columns">
        {c.especificos.map((item, idx) => (
          <li><span class="ed-eyebrow">{String(idx + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.body}</p></li>
        ))}
      </ol>
    </section>

    <section class="pg-section pg-section-flush" aria-labelledby="obligaciones-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.obligaciones}</p>
        <div>
          <h2 id="obligaciones-title">Las obligaciones que os aplican</h2>
          <div class="pg-prose">
            <p>
              El mapeo completo de cada obligación a lo que hay que construir está en la{" "}
              <a class="pg-inline-link" href={base}>página principal</a>.
            </p>
          </div>
        </div>
      </div>
      <ul class="pg-symptoms">{OBLIGACIONES.map((o) => <li>{o.ley}</li>)}</ul>
    </section>
  </div>

  <section class="ed-method pg-method pg-sector-build" aria-labelledby="construimos-title">
    <div class="ed-container">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.arquitectura}</p>
        <div>
          <h2 id="construimos-title">Qué construimos</h2>
          <p class="pg-method-lead">Sobre vuestros sistemas actuales, no sustituyéndolos.</p>
          <a class="ed-underlined" href={base}>Ver la arquitectura completa y el proceso de implementación <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <ol class="ed-steps">
        {SHARED.arquitectura.items.slice(0, 3).map((item, idx) => (
          <li><span class="ed-eyebrow">{String(idx + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <div class="ed-container">
    <section class="pg-section pg-faq ed-faq" aria-labelledby="faq-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.faq}</p>
        <div>
          <h2 id="faq-title">Preguntas de {c.nombreCorto.toLowerCase()}</h2>
          <div class="pg-faq-list">
            {c.faq.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="ed-closing" aria-labelledby="sector-closing-title">
    <div class="ed-container">
      <p class="ed-eyebrow">{copy.closingLabel}</p>
      <h2 id="sector-closing-title" class="pg-closing-title">¿Dónde está vuestra brecha ahora mismo?</h2>
      <p class="pg-closing-copy">Ocho preguntas, resultado inmediato y obligación por obligación. Sin dejar email.</p>
      <div class="pg-actions">
        <a class="ed-button" href={testHref}>Test de cumplimiento · 2 min<span class="ed-arrow" aria-hidden="true">↗</span></a>
        <a class="ed-underlined pg-underlined-ink" href={contactHref}>Hablar con un especialista</a>
      </div>
      <nav class="pg-siblings" aria-label={L.otros}>
        <p class="ed-eyebrow">{L.otros}</p>
        <ul>{otros.map((o) => <li><a href={`${base}${o.slug}/`}>{o.nombreCorto}</a></li>)}</ul>
      </nav>
      <p class="pg-disclaimer">{DISCLAIMER}</p>
    </div>
  </section>
</BaseLayout>
