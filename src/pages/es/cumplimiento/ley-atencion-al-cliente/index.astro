---
// Landing pilar — Frente A: cumplimiento de la Ley 10/2025 de atención a la clientela.
// ES-only a propósito: la obligación es española. Por eso vive fuera de src/pages/[locale]/
// y fuerza los alternates de hreflang para no emitir /pt/ y /en/ inexistentes.

import BaseLayout from "@/layouts/BaseLayout.astro";
import { LEY, DISCLAIMER, UMBRALES, OBLIGACIONES, SHARED, SECTOR_SLUGS, SECTORES } from "@/data/sectores-sac";
import { ORG_REF } from "@/data/identidad";
import copy from "@/i18n/locales/es/pagesEditorial.json";
import "@/styles/editorial-pages.css";

const locale = "es";
const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL(`/${locale}/cumplimiento/ley-atencion-al-cliente/`, site).toString();
const contactHref = `/${locale}/contact/`;
const base = `/${locale}/cumplimiento/ley-atencion-al-cliente/`;
const testHref = `${base}test/`;

// Cuenta atrás: valor calculado en build + corrección en cliente (script inline abajo),
// para que no quede obsoleto si pasan semanas entre despliegues.
const deadline = new Date(`${LEY.plazoAdaptacion}T00:00:00+01:00`);
const diasRestantes = Math.max(
  0,
  Math.ceil((deadline.getTime() - Date.now()) / (1000 * 60 * 60 * 24)),
);

const meta = {
  title: "Ley de atención al cliente (10/2025): adaptación técnica | IA Operators",
  description:
    "Qué exige la nueva Ley de atención al cliente (Ley 10/2025) a tus sistemas: atención personal en 3 minutos, 15 días hábiles y trazabilidad. Plazo: 28/12/2026.",
};

// Rótulos de la versión editorial (oct/2026).
const L = copy.leySac;

const sectoresList = SECTOR_SLUGS.map((slug) => ({ slug, ...SECTORES[slug] }));

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: "Implementación técnica de la Ley 10/2025 de atención a la clientela",
  serviceType: "Implementación técnica de la Ley 10/2025 de atención a la clientela",
  provider: ORG_REF,
  areaServed: "ES",
  description: meta.description,
  url: pageUrl,
  inLanguage: "es-ES",
  about: {
    "@type": "Legislation",
    name: LEY.nombre,
    legislationIdentifier: LEY.boeId,
    legislationJurisdiction: "ES",
    url: LEY.boeUrl,
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: new URL(`/${locale}/`, site).toString() },
    {
      "@type": "ListItem",
      position: 2,
      name: "Cumplimiento tecnológico",
      item: new URL(`/${locale}/cumplimiento/`, site).toString(),
    },
    { "@type": "ListItem", position: 3, name: "Ley de atención al cliente", item: pageUrl },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: SHARED.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const jsonLd = [serviceJsonLd, breadcrumbJsonLd, faqJsonLd];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalUrl={pageUrl}
  alternates={[{ lang: "es", href: pageUrl }]}
  xDefaultUrl={pageUrl}
  ogImage="/og/es/ley-atencion-al-cliente.png"
  ogImageAlt="Ley de atención al cliente (Ley 10/2025) — adaptación técnica de tus sistemas"
  jsonLd={jsonLd}
  editorial
>
  <div class="ed-container">
    <header class="pg-hero pg-hero-compact">
      <nav class="pf-crumbs ed-eyebrow" aria-label={copy.breadcrumb.label}>
        <ol>
          <li><a href="/es/">{copy.breadcrumb.home}</a></li>
          <li><a href="/es/cumplimiento/">{L.cumplimiento}</a></li>
          <li><span aria-current="page">{LEY.nombreCorto}</span></li>
        </ol>
      </nav>
      <h1>Ley de atención al cliente: <span>el 28 de diciembre de 2026 tus sistemas tienen que cumplirla</span></h1>
      <div class="pg-hero-bottom">
        <div class="pg-countdown">
          <p class="ed-eyebrow">{LEY.nombreCorto} · Plazo: {LEY.plazoAdaptacionLegible}</p>
          <p class="pg-countdown-value">
            <strong id="sac-countdown" data-deadline={LEY.plazoAdaptacion}>{diasRestantes}</strong>
            <span>días para<br />el fin del plazo</span>
          </p>
        </div>
        <div>
          <p class="pg-lead pg-lead-strong">
            La norma define requisitos de atención y calidad. Nosotros los traducimos a sistemas,
            flujos, medición y evidencia técnica para que puedas operar y demostrar lo implementado.
          </p>
          <div class="pg-actions">
            <a class="ed-button" href={testHref}>Test de cumplimiento · 2 min<span class="ed-arrow" aria-hidden="true">↗</span></a>
            <a class="ed-underlined" href={contactHref}>Diagnóstico de brecha <span class="ed-arrow" aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </header>

    <section id="obligado" class="pg-section pg-anchor" aria-labelledby="obligado-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.ambito}</p>
        <div>
          <h2 id="obligado-title">¿Está tu empresa obligada?</h2>
          <div class="pg-prose"><p>La ley distingue dos vías de entrada. Basta con encajar en una de ellas.</p></div>
        </div>
      </div>
      <div class="pg-fronts pg-fronts-tight">
        <article class="pg-front pg-front-dark">
          <p class="ed-eyebrow">Vía 1 · Por actividad</p>
          <h3>Servicios básicos de interés general</h3>
          <p class="pg-front-text">
            Obligados <strong>sin umbral de tamaño</strong>: da igual cuántas personas empleen o
            cuánto facturen. Aplica por la actividad que prestan en territorio español (art. 2.1).
          </p>
          <ul class="pg-front-links">
            {sectoresList.map((sector) => (
              <li><a href={`${base}${sector.slug}/`}>{sector.nombre}<span class="ed-arrow" aria-hidden="true">↗</span></a></li>
            ))}
          </ul>
          <p class="pg-front-note">
            Cada sector tiene su página con lo que cambia en su caso: plazos propios, escenarios
            de pico y la evidencia concreta que le van a pedir.
          </p>
          <p class="pg-front-note">
            En servicios financieros prevalece la normativa sectorial y la Ley 10/2025 opera con
            carácter supletorio; determinados artículos no resultan aplicables a este sector.
          </p>
        </article>
        <article class="pg-front">
          <p class="ed-eyebrow">Vía 2 · Por tamaño</p>
          <h3>Resto de sectores</h3>
          <p class="pg-front-text">
            Empresas y <strong>grupos de sociedades</strong> que vendan bienes o presten servicios
            distintos de los básicos, si alcanzan <strong>alguno</strong> de estos umbrales — son
            alternativos, no acumulativos (art. 2.2).
          </p>
          <ul class="pg-thresholds">
            {UMBRALES.map((u) => <li><strong>{u.valor}</strong><span>{u.unidad}</span></li>)}
          </ul>
          <p class="pg-front-note">
            El cómputo se hace también a nivel de grupo. Si tu matriz consolida por encima del
            umbral, la filial entra.
          </p>
        </article>
      </div>
      <div class="pg-actions pg-actions-center">
        <a class="ed-button" href={testHref}>Comprobarlo en 2 minutos<span class="ed-arrow" aria-hidden="true">↗</span></a>
        <p class="pg-action-note">Ocho preguntas. Resultado inmediato, sin dejar email.</p>
      </div>
    </section>

    <section class="pg-section" aria-labelledby="ley-sistema-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">El núcleo del proyecto</p>
        <div>
          <h2 id="ley-sistema-title">Qué exige la Ley de atención al cliente a tus sistemas</h2>
          <div class="pg-prose">
            <p>
              Cada obligación de la norma es, en la práctica, un requisito de arquitectura. Esto es lo
              que hay que construir para cumplir cada una — y para poder demostrarlo.
            </p>
          </div>
        </div>
      </div>
      <ol class="pg-patterns pg-obligations">
        {OBLIGACIONES.map((o, idx) => (
          <li>
            <span class="ed-eyebrow">{String(idx + 1).padStart(2, "0")}</span>
            <div class="pg-pattern-main">
              <p class="ed-eyebrow">Lo que exige la ley {o.articulo ? `· ${o.articulo}` : ""}</p>
              <p class="pg-obligation-law">{o.ley}</p>
            </div>
            <div class="pg-pattern-risk">
              <p class="ed-eyebrow">Lo que hay que construir</p>
              <p class="pg-obligation-system">{o.sistema}</p>
              <p class="pg-obligation-risk">{o.riesgo}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="pg-source">
        Referencias verificadas en el{" "}
        <a href={LEY.boeUrl} target="_blank" rel="noopener noreferrer">texto consolidado del BOE ({LEY.boeId})</a>.
      </p>
      <p class="pg-source">
        Para la atención telefónica: <a class="pg-inline-link" href="/es/servicios/agente-de-voz-ia/">agente de voz con IA con salida a persona medida</a>.
      </p>
    </section>

    <section class="pg-section" aria-labelledby="arquitectura-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.arquitectura}</p>
        <div>
          <h2 id="arquitectura-title">{SHARED.arquitectura.title}</h2>
          <div class="pg-prose"><p>{SHARED.arquitectura.subtitle}</p></div>
        </div>
      </div>
      <ol class="pg-columns">
        {SHARED.arquitectura.items.map((item, idx) => (
          <li><span class="ed-eyebrow">{String(idx + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.body}</p></li>
        ))}
      </ol>
    </section>
  </div>

  <section class="ed-method pg-method pg-process" aria-labelledby="proceso-title">
    <div class="ed-container">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{SHARED.proceso.badge}</p>
        <div>
          <h2 id="proceso-title">{SHARED.proceso.title}</h2>
          <p class="pg-method-lead">{SHARED.proceso.subtitle}</p>
        </div>
      </div>
      <ol class="ed-steps pg-steps-4">
        {SHARED.proceso.phases.map((phase) => (
          <li><span class="ed-eyebrow">{phase.code} · {phase.plazo}</span><h3>{phase.title}</h3><p>{phase.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <div class="ed-container">
    <section class="pg-section" aria-labelledby="alcance-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.alcance}</p>
        <div>
          <h2 id="alcance-title">{SHARED.alcance.title}</h2>
          <div class="pg-prose"><p>{SHARED.alcance.subtitle}</p></div>
        </div>
      </div>
      <ol class="pg-columns">
        {SHARED.alcance.items.map((item, idx) => (
          <li><span class="ed-eyebrow">{String(idx + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.body}</p></li>
        ))}
      </ol>
    </section>

    <section class="pg-section" aria-labelledby="por-que-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.porQue}</p>
        <div>
          <h2 id="por-que-title">{SHARED.porQue.title}</h2>
          <ul class="pg-principles pg-principles-2">
            {SHARED.porQue.items.map((item) => <li><h3>{item.title}</h3><p>{item.body}</p></li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="pg-section pg-faq ed-faq" aria-labelledby="faq-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.faq}</p>
        <div>
          <h2 id="faq-title">{SHARED.faq.title}</h2>
          <div class="pg-faq-list">
            {SHARED.faq.items.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="ed-closing" aria-labelledby="ley-closing-title">
    <div class="ed-container">
      <p class="ed-eyebrow">{copy.closingLabel}</p>
      <h2 id="ley-closing-title" class="pg-closing-title">
        Quedan <span class="pg-tabular" data-countdown-mirror>{diasRestantes}</span> días
      </h2>
      <p class="pg-closing-copy">
        Una llamada de 30 minutos para ver tus canales y tus tiempos actuales. Si hay encaje,
        salimos con el diagnóstico de brecha acotado y con precio cerrado.
      </p>
      <div class="pg-actions">
        <a class="ed-button" href={contactHref}>Hablar con un especialista<span class="ed-arrow" aria-hidden="true">↗</span></a>
        <a class="ed-underlined pg-underlined-ink" href={testHref}>Hacer el test antes</a>
      </div>
      <p class="pg-disclaimer">{DISCLAIMER}</p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var el = document.getElementById("sac-countdown");
    if (!el) return;
    var deadline = new Date(el.getAttribute("data-deadline") + "T00:00:00+01:00").getTime();
    var days = Math.max(0, Math.ceil((deadline - Date.now()) / 86400000));
    el.textContent = String(days);
    var mirrors = document.querySelectorAll("[data-countdown-mirror]");
    for (var i = 0; i < mirrors.length; i++) mirrors[i].textContent = String(days);
  })();
</script>
