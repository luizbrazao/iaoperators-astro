---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-forms.css";

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const canonical = new URL("/es/estudio/segunda-factura-ia/encuesta/gracias/", site).toString();
---

<BaseLayout
  title="Gracias por participar | La Segunda Factura de la IA 2026"
  description="Tu respuesta ha quedado registrada."
  canonicalUrl={canonical}
  robots="noindex,follow"
  editorial
>
  <div class="ed-container">
    <section class="sf-thanks">
      <p class="ed-eyebrow">Encuesta enviada</p>
      <h1>Gracias por participar</h1>
      <p class="pg-lead">
        Tu respuesta ya forma parte de la fase exploratoria del estudio. Si has dejado tu email, te avisaremos cuando publiquemos los resultados agregados.
      </p>
      <div class="pg-actions">
        <a class="ed-button" href="/es/blog/">Seguir leyendo<span class="ed-arrow" aria-hidden="true">↗</span></a>
        <a class="ed-underlined" href="/es/">Volver al sitio <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
