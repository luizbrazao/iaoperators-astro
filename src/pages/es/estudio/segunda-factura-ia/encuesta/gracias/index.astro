---
import BaseLayout from "@/layouts/BaseLayout.astro";

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const canonical = new URL("/es/estudio/segunda-factura-ia/encuesta/gracias/", site).toString();
---

<BaseLayout
  title="Gracias por participar | La Segunda Factura de la IA 2026"
  description="Tu respuesta ha quedado registrada."
  canonicalUrl={canonical}
  alternates={[{ lang: "es", href: canonical }]}
  xDefaultUrl={canonical}
  robots="noindex,follow"
>
  <section class="min-h-[70vh] px-4 pt-32 pb-20 text-white">
    <div class="mx-auto max-w-3xl rounded-[32px] border border-white/10 bg-linear-to-br from-white/[0.06] to-white/[0.02] p-8 text-center md:p-12">
      <span class="inline-flex rounded-full border border-orange-500/25 bg-orange-500/10 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.28em] text-orange-300">
        Encuesta enviada
      </span>
      <h1 class="mt-6 text-4xl font-semibold md:text-5xl">Gracias por participar</h1>
      <p class="mt-4 text-lg leading-relaxed text-white/70">
        Tu respuesta ya forma parte de la fase exploratoria del estudio. Si has dejado tu email, te avisaremos cuando publiquemos los resultados agregados.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a
          href="/es/"
          class="rounded-full border border-white/15 px-5 py-3 text-sm font-semibold text-white/82 transition hover:border-white/35"
        >
          Volver al sitio
        </a>
        <a
          href="/es/blog/"
          class="rounded-full bg-linear-to-r from-orange-500 to-amber-300 px-5 py-3 text-sm font-semibold text-black transition hover:brightness-110"
        >
          Seguir leyendo
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
