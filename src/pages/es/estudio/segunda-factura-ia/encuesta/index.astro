---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SurveyForm from "@/islands/SurveyForm";

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const canonical = new URL("/es/estudio/segunda-factura-ia/encuesta/", site).toString();
const ogImage = "/og/es/segunda-factura-ia-encuesta.png";

const pageTitle = "Encuesta | La Segunda Factura de la IA 2026";
const pageDescription =
  "Participa en la encuesta exploratoria de IA Operators sobre uso de IA en el trabajo, exposición de información interna, gobernanza y dependencia de proveedores.";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "IA Operators",
      item: `${site}/es/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Estudio",
      item: `${site}/es/estudio/segunda-factura-ia/encuesta/`,
    },
  ],
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: canonical,
  inLanguage: "es-ES",
  isPartOf: {
    "@type": "WebSite",
    name: "IA Operators",
    url: `${site}/es/`,
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonical}
  alternates={[{ lang: "es", href: canonical }]}
  xDefaultUrl={canonical}
  ogImage={ogImage}
  ogImageAlt="Encuesta La Segunda Factura de la IA 2026"
  jsonLd={[pageJsonLd, breadcrumbJsonLd]}
>
  <div class="min-h-screen bg-transparent text-white">
    <section class="px-4 pt-28 pb-10">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-10 xl:grid-cols-[1.1fr_0.9fr] xl:items-end">
          <div class="space-y-6">
            <span class="inline-flex rounded-full border border-orange-500/25 bg-orange-500/10 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.28em] text-orange-300">
              Estudio exploratorio 2026
            </span>
            <div class="space-y-4">
              <h1 class="max-w-4xl text-4xl font-semibold leading-tight md:text-6xl md:leading-none">
                La Segunda Factura de la IA 2026
              </h1>
              <p class="max-w-3xl text-lg leading-relaxed text-white/72 md:text-xl">
                Una encuesta breve para entender cómo empresas y profesionales están usando IA en el trabajo, qué controles existen y dónde aparecen los riesgos menos visibles: cuentas personales, documentos internos, dependencia de un único proveedor y Shadow AI.
              </p>
            </div>
          </div>

          <div class="rounded-[28px] border border-white/10 bg-linear-to-br from-white/[0.08] to-white/[0.02] p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-white/45">Qué obtendremos con esta fase</p>
            <ul class="mt-4 space-y-3 text-sm leading-relaxed text-white/78">
              <li class="rounded-2xl border border-white/8 bg-black/20 px-4 py-3">Datos sobre adopción real de IA en el trabajo.</li>
              <li class="rounded-2xl border border-white/8 bg-black/20 px-4 py-3">Indicadores sobre uso de cuentas personales, exposición documental y prácticas de anonimización.</li>
              <li class="rounded-2xl border border-white/8 bg-black/20 px-4 py-3">Una base metodológica para el estudio público posterior, sin publicar conclusiones antes de recoger muestra suficiente.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 pb-12">
      <div class="mx-auto max-w-6xl">
        <SurveyForm client:load locale="es" thankYouPath="/es/estudio/segunda-factura-ia/encuesta/gracias/" />
      </div>
    </section>

    <section class="px-4 pb-20">
      <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-3">
        <article class="rounded-[24px] border border-white/10 bg-white/[0.03] p-6">
          <h2 class="text-lg font-semibold text-white">Neutralidad metodológica</h2>
          <p class="mt-3 text-sm leading-relaxed text-white/68">
            Las preguntas están formuladas en lenguaje neutral, con opciones equilibradas y con “No lo sé” cuando corresponde. La encuesta no solicita secretos empresariales ni ejemplos identificables.
          </p>
        </article>
        <article class="rounded-[24px] border border-white/10 bg-white/[0.03] p-6">
          <h2 class="text-lg font-semibold text-white">Privacidad y tratamiento</h2>
          <p class="mt-3 text-sm leading-relaxed text-white/68">
            El email es opcional. Cuando se aporta, debe almacenarse separado de las respuestas comportamentales. Las respuestas individuales no se publicarán de forma aislada.
          </p>
        </article>
        <article class="rounded-[24px] border border-white/10 bg-white/[0.03] p-6">
          <h2 class="text-lg font-semibold text-white">Uso previsto</h2>
          <p class="mt-3 text-sm leading-relaxed text-white/68">
            Esta fase sirve para validar hipótesis, detectar segmentos relevantes y preparar un estudio público con datos originales, no para afirmar que representa a todas las empresas españolas.
          </p>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
