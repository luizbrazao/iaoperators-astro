---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SurveyForm from "@/islands/SurveyForm";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-forms.css";

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const canonical = new URL("/es/estudio/segunda-factura-ia/encuesta/", site).toString();
const ogImage = "/og/es/segunda-factura-ia-encuesta.png";

const alternates = [
  { lang: "es", href: canonical },
  { lang: "en", href: new URL("/en/estudio/segunda-factura-ia/encuesta/", site).toString() },
  { lang: "pt", href: new URL("/pt/estudio/segunda-factura-ia/encuesta/", site).toString() },
];
const xDefault = canonical;

const pageTitle = "Encuesta | La Segunda Factura de la IA 2026";
const pageDescription =
  "Participa en la encuesta exploratoria de IA Operators sobre uso de IA en el trabajo, exposición de información interna, gobernanza y dependencia de proveedores.";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "IA Operators",
      item: `${site}/es/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Estudio",
      item: `${site}/es/estudio/segunda-factura-ia/encuesta/`,
    },
  ],
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: canonical,
  inLanguage: "es-ES",
  isPartOf: {
    "@type": "WebSite",
    name: "IA Operators",
    url: `${site}/es/`,
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonical}
  alternates={alternates}
  xDefaultUrl={xDefault}
  ogImage={ogImage}
  ogImageAlt="Encuesta La Segunda Factura de la IA 2026"
  jsonLd={[pageJsonLd, breadcrumbJsonLd]}
  editorial
>
  {/* Diseño editorial (oct/2026). Mismos textos y H1/H2; la island usa variant="editorial". */}
  <div class="ed-container">
    <header class="pg-hero">
      <nav class="pf-crumbs ed-eyebrow" aria-label="Ruta de navegación">
        <ol>
          <li><a href="/es/">Inicio</a></li>
          <li><span aria-current="page">Estudio</span></li>
        </ol>
      </nav>
      <h1>La Segunda Factura de la IA 2026</h1>
      <div class="pg-hero-bottom">
        <p class="ed-eyebrow">Estudio exploratorio 2026</p>
        <p class="pg-lead">
          Una encuesta breve para entender cómo empresas y profesionales están usando IA en el trabajo, qué controles existen y dónde aparecen los riesgos menos visibles: cuentas personales, documentos internos, dependencia de un único proveedor y Shadow AI.
        </p>
      </div>
    </header>

    <section class="pg-section" aria-label="Qué obtendremos con esta fase">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">Qué obtendremos con esta fase</p>
        <ul class="pg-checklist">
          <li>Datos sobre adopción real de IA en el trabajo.</li>
          <li>Indicadores sobre uso de cuentas personales, exposición documental y prácticas de anonimización.</li>
          <li>Una base metodológica para el estudio público posterior, sin publicar conclusiones antes de recoger muestra suficiente.</li>
        </ul>
      </div>
    </section>

    <div class="sf-section">
      <SurveyForm client:load locale="es" variant="editorial" thankYouPath="/es/estudio/segunda-factura-ia/encuesta/gracias/" />
    </div>

    <section class="pg-section sf-cols-section" aria-label="Metodología y privacidad">
      <ul class="pg-columns sf-cols">
        <li>
          <h2>Neutralidad metodológica</h2>
          <p>Las preguntas están formuladas en lenguaje neutral, con opciones equilibradas y con “No lo sé” cuando corresponde. La encuesta no solicita secretos empresariales ni ejemplos identificables.</p>
        </li>
        <li>
          <h2>Privacidad y tratamiento</h2>
          <p>El email es opcional. Cuando se aporta, debe almacenarse separado de las respuestas comportamentales. Las respuestas individuales no se publicarán de forma aislada.</p>
        </li>
        <li>
          <h2>Uso previsto</h2>
          <p>Esta fase sirve para validar hipótesis, detectar segmentos relevantes y preparar un estudio público con datos originales, no para afirmar que representa a todas las empresas españolas.</p>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
