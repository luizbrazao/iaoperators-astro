---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SurveyForm from "@/islands/SurveyForm";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-forms.css";

const site = Astro.site?.toString() ?? "https://iaoperators.com";

// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".

const siteRoot = site.replace(/\/$/, "");
const canonical = new URL("/pt/estudio/segunda-factura-ia/encuesta/", site).toString();
const ogImage = "/og/pt/segunda-factura-ia-encuesta.png";

const alternates = [
  { lang: "es", href: new URL("/es/estudio/segunda-factura-ia/encuesta/", site).toString() },
  { lang: "en", href: new URL("/en/estudio/segunda-factura-ia/encuesta/", site).toString() },
  { lang: "pt", href: canonical },
];
const xDefault = new URL("/es/estudio/segunda-factura-ia/encuesta/", site).toString();

const pageTitle = "Pesquisa | A Segunda Fatura da IA 2026";
const pageDescription =
  "Participe da pesquisa exploratória da IA Operators sobre uso de IA no trabalho, exposição de informação interna, governança e dependência de fornecedores.";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "IA Operators",
      item: `${siteRoot}/pt/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Estudo",
      item: `${siteRoot}/pt/estudio/segunda-factura-ia/encuesta/`,
    },
  ],
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: canonical,
  inLanguage: "pt-BR",
  isPartOf: {
    "@type": "WebSite",
    name: "IA Operators",
    url: `${siteRoot}/pt/`,
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonical}
  alternates={alternates}
  xDefaultUrl={xDefault}
  ogImage={ogImage}
  ogImageAlt="Pesquisa A Segunda Fatura da IA 2026"
  jsonLd={[pageJsonLd, breadcrumbJsonLd]}
  editorial
>
  <div class="ed-container">
    <header class="pg-hero">
      <nav class="pf-crumbs ed-eyebrow" aria-label="Trilha de navegação">
        <ol>
          <li><a href="/pt/">Início</a></li>
          <li><span aria-current="page">Estudo</span></li>
        </ol>
      </nav>
      <h1>A Segunda Fatura da IA 2026</h1>
      <div class="pg-hero-bottom">
        <p class="ed-eyebrow">Estudo exploratório 2026</p>
        <p class="pg-lead">
          Uma pesquisa breve para entender como empresas e profissionais estão usando IA no trabalho, que controles existem e onde aparecem os riscos menos visíveis: contas pessoais, documentos internos, dependência de um único fornecedor e Shadow AI.
        </p>
      </div>
    </header>

    <section class="pg-section" aria-label="O que vamos obter com esta fase">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">O que vamos obter com esta fase</p>
        <ul class="pg-checklist">
          <li>Dados sobre a adoção real de IA no trabalho.</li>
          <li>Indicadores sobre uso de contas pessoais, exposição documental e práticas de anonimização.</li>
          <li>Uma base metodológica para o estudo público posterior, sem publicar conclusões antes de reunir amostra suficiente.</li>
        </ul>
      </div>
    </section>

    <div class="sf-section">
      <SurveyForm client:load locale="pt" variant="editorial" thankYouPath="/pt/estudio/segunda-factura-ia/encuesta/gracias/" />
    </div>

    <section class="pg-section sf-cols-section" aria-label="Metodologia e privacidade">
      <ul class="pg-columns sf-cols">
        <li>
          <h2>Neutralidade metodológica</h2>
          <p>As perguntas são formuladas em linguagem neutra, com opções equilibradas e com “Não sei” quando cabível. A pesquisa não solicita segredos empresariais nem exemplos identificáveis.</p>
        </li>
        <li>
          <h2>Privacidade e tratamento</h2>
          <p>O e-mail é opcional. Quando fornecido, deve ser armazenado separado das respostas comportamentais. As respostas individuais não serão publicadas de forma isolada.</p>
        </li>
        <li>
          <h2>Uso previsto</h2>
          <p>Esta fase serve para validar hipóteses, detectar segmentos relevantes e preparar um estudo público com dados originais, não para afirmar que representa todas as empresas.</p>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
