---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-forms.css";

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const canonical = new URL("/pt/estudio/segunda-factura-ia/encuesta/gracias/", site).toString();
---

<BaseLayout
  title="Obrigado por participar | A Segunda Fatura da IA 2026"
  description="A sua resposta foi registrada."
  canonicalUrl={canonical}
  robots="noindex,follow"
  editorial
>
  <div class="ed-container">
    <section class="sf-thanks">
      <p class="ed-eyebrow">Pesquisa enviada</p>
      <h1>Obrigado por participar</h1>
      <p class="pg-lead">
        A sua resposta já faz parte da fase exploratória do estudo. Se você deixou o seu e-mail, avisaremos quando publicarmos os resultados agregados.
      </p>
      <div class="pg-actions">
        <a class="ed-button" href="/pt/blog/">Continuar lendo<span class="ed-arrow" aria-hidden="true">↗</span></a>
        <a class="ed-underlined" href="/pt/">Voltar ao site <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
