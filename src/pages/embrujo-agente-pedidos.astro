---
// Propuesta comercial Embrujo · Agente de gestión de pedidos · noindex,nofollow
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Agente de Gestión de Pedidos Contra Reembolso · IA Operators</title>
    <style>
      :root {
        --bg: #ffffff;
        --bg-alt: #f9fafb;
        --primary: #ff6900;
        --primary-soft: #fff4ed;
        --primary-border: rgba(255, 105, 0, 0.4);
        --text: #111827;
        --text-muted: #6b7280;
        --text-light: #9ca3af;
        --border: #e5e7eb;
        --positive: #16a34a;
        --positive-bg: #f0fdf4;
        --negative-bg: #fef2f2;
        --negative: #dc2626;
        --shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.1);
        --radius: 12px;
        --radius-sm: 8px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }

      h1 {
        font-size: clamp(1.8rem, 4vw, 3rem);
        font-weight: 800;
        line-height: 1.15;
      }
      h2 {
        font-size: clamp(1.4rem, 2.5vw, 2rem);
        font-weight: 700;
        line-height: 1.2;
      }
      h3 {
        font-size: 1.15rem;
        font-weight: 600;
      }
      h4 {
        font-size: 1rem;
        font-weight: 600;
      }
      p {
        color: var(--text-muted);
      }
      strong {
        color: var(--text);
      }

      /* NAV */
      .nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: #fff;
        border-bottom: 1px solid var(--border);
        padding: 0 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 56px;
        box-shadow: 0 1px 8px rgba(0, 0, 0, 0.06);
      }
      .nav-logo {
        height: 40px;
      }
      .nav-links {
        display: flex;
        gap: 1.5rem;
        list-style: none;
      }
      .nav-links a {
        text-decoration: none;
        color: var(--text);
        font-size: 0.82rem;
        font-weight: 500;
        transition: color 0.2s;
        white-space: nowrap;
      }
      .nav-links a:hover {
        color: var(--primary);
      }

      /* HERO */
      .hero {
        background-image: url("/propostas/Capa-propostas.png");
        background-size: cover;
        background-position: center;
        color: white;
        padding: 4rem 2rem 0;
        position: relative;
        overflow: hidden;
      }
      .hero-inner {
        max-width: 1100px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
      }
      .hero h1 {
        color: white;
        margin-bottom: 1rem;
      }
      .hero-subtitle {
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.85);
        margin-bottom: 2.5rem;
        max-width: 680px;
      }
      .hero-band {
        background: rgba(0, 0, 0, 0.2);
        margin: 2rem -2rem 0;
        padding: 0.85rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .hero-band span {
        color: rgba(255, 255, 255, 0.9);
        font-size: 0.875rem;
      }
      .badge-proposal {
        background: var(--primary);
        color: white;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.3rem 0.9rem;
        border-radius: 999px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      /* SECTIONS */
      .section {
        padding: 4rem 2rem;
      }
      .section-alt {
        background: var(--bg-alt);
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
      }
      .section-label {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--primary);
        margin-bottom: 0.5rem;
      }
      .section-title {
        color: var(--text);
        margin-bottom: 0.4rem;
      }
      .section-subtitle {
        color: var(--text-muted);
        font-size: 0.97rem;
        margin-bottom: 2rem;
        max-width: 680px;
      }

      /* CALLOUT */
      .callout {
        border-left: 4px solid var(--primary);
        background: var(--primary-soft);
        border-radius: 0 var(--radius) var(--radius) 0;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.1rem;
        font-style: italic;
        color: var(--text);
        line-height: 1.65;
      }

      /* ARCH FLOW */
      .arch-flow {
        background: white;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 2rem;
        margin-bottom: 2rem;
      }
      .arch-nodes {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
      }
      .arch-node {
        background: var(--bg-alt);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 0.6rem 1.2rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text);
      }
      .arch-node.accent {
        background: var(--primary-soft);
        border-color: var(--primary-border);
        color: var(--primary);
      }
      .arch-arrow {
        color: var(--text-muted);
        font-size: 1.25rem;
        font-weight: 700;
      }
      .arch-notes {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .arch-note {
        display: flex;
        gap: 0.6rem;
        font-size: 0.88rem;
        color: var(--text-muted);
        align-items: flex-start;
      }
      .arch-note strong {
        color: var(--text);
        flex-shrink: 0;
      }
      .arch-note::before {
        content: "→";
        color: var(--primary);
        font-weight: 700;
        flex-shrink: 0;
        margin-top: 2px;
      }

      /* METRICS */
      .metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .metric-card {
        background: white;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
        border-top: 3px solid var(--primary);
        padding: 1.5rem 1rem;
        text-align: center;
      }
      .metric-number {
        font-size: 3.5rem;
        font-weight: 800;
        color: var(--primary);
        line-height: 1;
        margin-bottom: 0.4rem;
      }
      .metric-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        font-weight: 500;
        line-height: 1.4;
      }

      /* MODULE CARDS (alcance) */
      .module-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .module-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 1.5rem;
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
        transition:
          box-shadow 0.2s,
          border-color 0.2s;
      }
      .module-card:hover {
        box-shadow: var(--shadow-md);
        border-color: var(--primary-border);
      }
      .module-num {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
        font-size: 1rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 3px 10px rgba(255, 105, 0, 0.3);
      }
      .module-body h4 {
        color: var(--text);
        margin-bottom: 0.35rem;
      }
      .module-body p {
        font-size: 0.9rem;
        line-height: 1.55;
      }
      .module-body ul {
        list-style: none;
        margin-top: 0.6rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .module-body ul li {
        font-size: 0.875rem;
        color: var(--text-muted);
        display: flex;
        gap: 0.5rem;
      }
      .module-body ul li::before {
        content: "→";
        color: var(--primary);
        font-weight: 700;
        flex-shrink: 0;
      }

      /* TIMELINE */
      .timeline {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        position: relative;
        margin-top: 2rem;
      }
      .timeline::before {
        content: "";
        position: absolute;
        top: 28px;
        left: 56px;
        right: 56px;
        height: 2px;
        background: var(--border);
        z-index: 0;
      }
      .timeline-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 1;
        padding: 0 0.5rem;
      }
      .timeline-node {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
        font-size: 1rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        box-shadow: 0 4px 14px rgba(255, 105, 0, 0.35);
        flex-shrink: 0;
      }
      .timeline-node-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--primary);
        margin-bottom: 0.5rem;
      }
      .timeline-content {
        background: white;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 1rem;
        text-align: center;
        width: 100%;
      }
      .timeline-content h4 {
        color: var(--text);
        font-size: 0.85rem;
        margin-bottom: 0.3rem;
      }
      .timeline-content p {
        font-size: 0.78rem;
        color: var(--text-muted);
        line-height: 1.45;
      }
      .timeline-deliverable {
        display: inline-block;
        background: var(--primary-soft);
        color: var(--primary);
        font-size: 0.68rem;
        font-weight: 600;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        margin-top: 0.6rem;
      }

      /* DELIVERABLES */
      .deliverables-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
        margin-top: 1.5rem;
      }
      .deliverable-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 1.5rem;
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        transition:
          box-shadow 0.2s,
          border-color 0.2s;
      }
      .deliverable-card:hover {
        box-shadow: var(--shadow-md);
        border-color: var(--primary-border);
      }
      .deliverable-icon {
        font-size: 1.75rem;
        line-height: 1;
        flex-shrink: 0;
      }
      .deliverable-content h4 {
        color: var(--text);
        margin-bottom: 0.3rem;
      }
      .deliverable-content p {
        font-size: 0.85rem;
        line-height: 1.5;
      }

      /* INVESTMENT */
      .price-display {
        background: var(--primary-soft);
        border: 1px solid var(--primary-border);
        border-radius: var(--radius);
        padding: 2rem;
        text-align: center;
        margin-top: 1.5rem;
      }
      .price-old {
        font-size: 1.1rem;
        color: var(--text-light);
        text-decoration: line-through;
        margin-bottom: 0.25rem;
      }
      .price-main {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 800;
        color: var(--primary);
        letter-spacing: -0.03em;
        line-height: 1;
        margin-bottom: 0.4rem;
      }
      .price-sub {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 1rem;
      }
      .discount-badge {
        display: inline-block;
        background: var(--positive-bg);
        border: 1px solid rgba(22, 163, 74, 0.3);
        color: var(--positive);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.3rem 1rem;
        border-radius: 999px;
      }

      .payment-milestones {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .payment-milestone {
        background: white;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 1.25rem;
        text-align: center;
        box-shadow: var(--shadow);
      }
      .payment-milestone.highlight {
        border-color: var(--primary-border);
      }
      .payment-milestone .pct {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        margin-bottom: 0.4rem;
      }
      .payment-milestone .amount {
        font-weight: 700;
        font-size: 1.4rem;
        letter-spacing: -0.02em;
        margin-bottom: 0.3rem;
      }
      .payment-milestone.highlight .amount {
        color: var(--primary);
      }
      .payment-milestone .label {
        font-size: 0.78rem;
        color: var(--text-muted);
        line-height: 1.4;
      }

      .tax-note {
        font-size: 0.82rem;
        color: var(--text-muted);
        border-top: 1px solid var(--border);
        padding-top: 1rem;
        margin-top: 1.5rem;
        line-height: 1.6;
      }

      /* INCLUDE GRID */
      .include-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-top: 1.5rem;
      }
      .include-col {
        border-radius: var(--radius);
        padding: 1.75rem;
      }
      .include-col.yes {
        background: var(--positive-bg);
        border-left: 4px solid var(--positive);
      }
      .include-col.no {
        background: var(--bg-alt);
        border-left: 4px solid var(--text-light);
      }
      .include-col h3 {
        margin-bottom: 1rem;
        font-size: 1rem;
      }
      .include-col.yes h3 {
        color: var(--positive);
      }
      .include-col.no h3 {
        color: var(--text-muted);
      }
      .include-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }
      .include-list li {
        display: flex;
        gap: 0.6rem;
        font-size: 0.88rem;
        align-items: flex-start;
        color: var(--text);
      }
      .check-yes {
        color: var(--positive);
        font-weight: 700;
        flex-shrink: 0;
        margin-top: 1px;
      }
      .check-no {
        color: var(--text-light);
        font-weight: 700;
        flex-shrink: 0;
        margin-top: 1px;
      }

      /* STEPS */
      .steps-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .step-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        background: white;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.25rem 1.5rem;
        box-shadow: var(--shadow);
        transition: border-color 0.2s;
      }
      .step-item:hover {
        border-color: var(--primary-border);
      }
      .step-num {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
        font-size: 1rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 3px 10px rgba(255, 105, 0, 0.3);
      }
      .step-content h4 {
        color: var(--text);
        margin-bottom: 0.25rem;
      }
      .step-content p {
        font-size: 0.88rem;
      }
      .validity-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--primary-soft);
        color: var(--primary);
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.55rem 1.5rem;
        border-radius: 999px;
        border: 1px solid var(--primary-border);
        margin-top: 1.75rem;
      }

      /* FOOTER */
      .footer {
        background: #111827;
        color: var(--text-light);
        padding: 3rem 2rem 2rem;
        text-align: center;
      }
      .footer-logo {
        height: 40px;
        margin-bottom: 1.25rem;
        display: inline-block;
        opacity: 0.9;
        transition: opacity 0.2s;
      }
      .footer-logo:hover {
        opacity: 1;
      }
      .footer-links {
        display: flex;
        gap: 1.75rem;
        justify-content: center;
        margin: 0.75rem 0 1.25rem;
        flex-wrap: wrap;
      }
      .footer-links a {
        color: var(--text-light);
        text-decoration: none;
        font-size: 0.875rem;
        transition: color 0.2s;
      }
      .footer-links a:hover {
        color: var(--primary);
      }
      .footer-line {
        width: 40px;
        height: 2px;
        background: var(--primary);
        margin: 0 auto 1rem;
        border-radius: 2px;
      }
      .footer-disclaimer {
        font-size: 0.78rem;
        color: #4b5563;
      }

      /* FADE IN */
      .fade-in {
        opacity: 0;
        transform: translateY(18px);
        transition:
          opacity 0.55s ease,
          transform 0.55s ease;
      }
      .fade-in.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* RESPONSIVE */
      @media (max-width: 960px) {
        .metrics-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .deliverables-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .payment-milestones {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 680px) {
        .nav-links {
          display: none;
        }
        .metrics-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .deliverables-grid {
          grid-template-columns: 1fr;
        }
        .include-grid {
          grid-template-columns: 1fr;
        }
        .timeline {
          flex-direction: column;
          align-items: stretch;
          gap: 1.25rem;
        }
        .timeline::before {
          display: none;
        }
        .timeline-item {
          flex-direction: row;
          align-items: flex-start;
          gap: 1rem;
          padding: 0;
        }
        .timeline-content {
          text-align: left;
          flex: 1;
        }
        .timeline-node {
          margin-bottom: 0;
        }
        .hero-band {
          flex-direction: column;
          align-items: flex-start;
        }
        .arch-nodes {
          justify-content: flex-start;
        }
      }

      @media print {
        .nav {
          position: static;
          box-shadow: none;
        }
        .hero {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
        .footer {
          background: #f3f4f6 !important;
        }
        .footer * {
          color: #374151 !important;
        }
        .footer-logo {
          opacity: 1 !important;
        }
        .fade-in {
          opacity: 1 !important;
          transform: none !important;
        }
        .section {
          padding: 2rem 1.5rem;
        }
      }

      /* EXTRA · propuesta Embrujo */
      .payment-milestones.four {
        grid-template-columns: repeat(4, 1fr);
      }
      .table-wrap {
        overflow-x: auto;
        margin-top: 1.5rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        background: white;
      }
      .cost-table {
        width: 100%;
        border-collapse: collapse;
      }
      .cost-table th,
      .cost-table td {
        text-align: left;
        padding: 0.9rem 1.1rem;
        border-bottom: 1px solid var(--border);
        font-size: 0.88rem;
        vertical-align: top;
      }
      .cost-table th {
        background: var(--bg-alt);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
      }
      .cost-table tr:last-child td {
        border-bottom: none;
      }
      .cost-table td:first-child {
        font-weight: 600;
        color: var(--text);
      }
      .cost-table td.cost {
        font-weight: 700;
        color: var(--primary);
        white-space: nowrap;
      }
      .cost-table td.desc {
        color: var(--text-muted);
      }
      .ref-link {
        display: inline-block;
        margin-top: 0.5rem;
        color: var(--primary);
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
      }
      .ref-link:hover {
        text-decoration: underline;
      }
      .include-col.warn {
        background: #fffbeb;
        border-left: 4px solid #d97706;
      }
      .include-col.warn h3 {
        color: #b45309;
      }
      .check-warn {
        color: #d97706;
        font-weight: 700;
        flex-shrink: 0;
        margin-top: 1px;
      }
      .plain-note {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-top: 1.5rem;
        max-width: 760px;
      }
      @media (max-width: 960px) {
        .payment-milestones.four {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 680px) {
        .payment-milestones.four {
          grid-template-columns: 1fr;
