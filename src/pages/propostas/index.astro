---
// Índice de propostas comerciais — noindex,nofollow (acesso interno)
const proposals = [
  {
    slug: "pablo-tovar",
    client: "Pablo Tovar Martínez",
    title: "Auditoría de Presencia Digital e Inteligencia Artificial",
    date: "Mayo 2026",
    amount: "2.000 EUR + IVA",
    status: "Enviada",
  },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex,nofollow">
  <title>Propostas Comerciales · IA Operators</title>
  <style>
    :root {
      --primary: #FF6900;
      --primary-soft: #FFF4ED;
      --primary-border: rgba(255, 105, 0, 0.4);
      --text: #111827;
      --text-muted: #6B7280;
      --border: #E5E7EB;
      --bg: #F9FAFB;
      --shadow: 0 1px 4px rgba(0,0,0,0.08);
      --radius: 12px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 3rem 2rem;
    }
    .container { max-width: 860px; margin: 0 auto; }
    .header {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-bottom: 2.5rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--border);
    }
    .header img { height: 36px; }
    .header-text h1 { font-size: 1.5rem; font-weight: 700; color: var(--text); }
    .header-text p { font-size: 0.875rem; color: var(--text-muted); margin-top: 0.2rem; }
    .badge-internal {
      margin-left: auto;
      background: var(--primary-soft);
      color: var(--primary);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.3rem 0.9rem;
      border-radius: 999px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border: 1px solid var(--primary-border);
      white-space: nowrap;
    }
    .proposals-list { display: flex; flex-direction: column; gap: 1rem; }
    .proposal-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .proposal-card:hover {
      border-color: var(--primary-border);
      box-shadow: 0 4px 16px rgba(255,105,0,0.12);
    }
    .proposal-index {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--primary);
      opacity: 0.35;
      line-height: 1;
      flex-shrink: 0;
      width: 2rem;
      text-align: center;
    }
    .proposal-info { flex: 1; min-width: 0; }
    .proposal-client { font-weight: 700; font-size: 1rem; color: var(--text); }
    .proposal-title { font-size: 0.875rem; color: var(--text-muted); margin-top: 0.2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .proposal-meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-shrink: 0;
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    .proposal-amount { font-weight: 700; color: var(--text); font-size: 0.95rem; }
    .proposal-date { font-size: 0.78rem; color: var(--text-muted); }
    .status-badge {
      font-size: 0.68rem;
      font-weight: 600;
      padding: 0.2rem 0.65rem;
      border-radius: 999px;
      background: #ECFDF5;
      color: #059669;
      border: 1px solid #A7F3D0;
    }
    .arrow { color: var(--primary); font-size: 1.2rem; flex-shrink: 0; }
    .empty {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--text-muted);
      font-size: 0.95rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <img src="/propostas/Logo-IAOperators.png" alt="IA Operators">
      <div class="header-text">
        <h1>Propostas Comerciales</h1>
        <p>Acceso interno · No indexado</p>
      </div>
      <span class="badge-internal">Uso interno</span>
    </div>

    {proposals.length === 0 ? (
      <div class="empty">No hay propostas registradas todavía.</div>
    ) : (
      <div class="proposals-list">
        {proposals.map((p, i) => (
          <a href={`/propostas/${p.slug}`} class="proposal-card">
            <div class="proposal-index">{i + 1}</div>
            <div class="proposal-info">
              <div class="proposal-client">{p.client}</div>
              <div class="proposal-title">{p.title}</div>
            </div>
            <div class="proposal-meta">
              <span class="proposal-date">{p.date}</span>
              <span class="proposal-amount">{p.amount}</span>
              <span class="status-badge">{p.status}</span>
            </div>
            <span class="arrow">→</span>
          </a>
        ))}
      </div>
    )}
  </div>
</body>
</html>
