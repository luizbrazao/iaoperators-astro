---
export async function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "pt" } },
    { params: { locale: "en" } },
  ];
}

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocale, ui } from "../../../i18n/ui";
import ContactForm from "../../../islands/ContactForm.jsx";
import { getPagesEditorial } from "@/i18n/editorialCopy";
import "../../../styles/editorial-pages.css";

const locale = getLocale((Astro.params.locale as string) ?? Astro.currentLocale ?? "es");
const dict = (ui as any)?.[locale] ?? (ui as any)?.es ?? (ui as any)?.en ?? (ui as any)?.pt ?? {};
const contact = (dict as any)?.contact ?? (dict as any)?.home?.contact ?? {};

const t = {
  badge: contact?.badge ?? "Contact",
  title: contact?.title ?? "Let’s talk",
  subtitle: contact?.subtitle ?? "Tell us what you want to build.",
};

// Diseño editorial (ES desde oct/2026, EN/PT desde el 08/oct/2026). Canales y
// FAQ los pinta la página; la isla solo pinta el formulario.
const crumbs = getPagesEditorial(locale).breadcrumb;
const side = {
  whatsapp: contact?.whatsapp ?? "WhatsApp",
  email: contact?.email ?? "Email",
  office: contact?.office ?? "Office",
  faq: contact?.faq ?? "FAQ",
  whatsappHref: `https://wa.me/34662423523?text=${encodeURIComponent(contact?.whatsappText ?? "")}`,
  faqs: [1, 2, 3]
    .map((n) => ({ q: contact?.[`faq${n}q`], a: contact?.[`faq${n}a`] }))
    .filter((item) => item.q && item.a),
};

const metaTitle = contact?.metaTitle ?? `${t.title} | IA Operators`;
const metaDescription = contact?.metaDescription ?? t.subtitle;

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL(`/${locale}/contact/`, site).toString();

const contactJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: metaTitle,
  description: metaDescription,
  url: pageUrl,
  mainEntity: {
    "@type": ["Organization", "ProfessionalService"],
    name: "IA Operators",
    url: site,
    telephone: "+34662423523",
    email: "info@iaoperators.com",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Málaga",
      addressCountry: "ES",
    },
    contactPoint: {
      "@type": "ContactPoint",
      telephone: "+34662423523",
      contactType: "sales",
      availableLanguage: ["Spanish", "Portuguese", "English"],
    },
  },
};
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={contactJsonLd} editorial>
  <div class="ed-container">
    <header class="pg-hero ct-hero">
      <nav class="pf-crumbs ed-eyebrow" aria-label={crumbs.label}>
        <ol>
          <li><a href={`/${locale}/`}>{crumbs.home}</a></li>
          <li><span aria-current="page">{t.badge}</span></li>
        </ol>
      </nav>
      <h1>{t.title}</h1>
      <div class="pg-hero-bottom">
        <p class="ed-eyebrow">{t.badge}</p>
        <p class="pg-lead">{t.subtitle}</p>
      </div>
    </header>

    <section class="pg-section ct-section">
      <div class="ct-grid">
        <ContactForm client:load locale={locale} variant="editorial" />
        <aside class="ct-aside">
          <ul class="ct-channels">
            <li>
              <a href={side.whatsappHref} target="_blank" rel="noopener noreferrer">
                <span class="ed-eyebrow">{side.whatsapp}</span>
                <strong>+34 662 423 523</strong>
                <span class="ed-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a href="mailto:info@iaoperators.com">
                <span class="ed-eyebrow">{side.email}</span>
                <strong>info@iaoperators.com</strong>
                <span class="ed-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <div>
                <span class="ed-eyebrow">{side.office}</span>
                <strong>Málaga, ES</strong>
              </div>
            </li>
          </ul>
          {side.faqs.length > 0 && (
            <div class="ed-faq ct-faq">
              <h2 class="ed-eyebrow">{side.faq}</h2>
              {side.faqs.map((item) => (
                <details>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))}
            </div>
          )}
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>
