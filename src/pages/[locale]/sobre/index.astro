    legalCta: "Ver los datos identificativos",
    legalContact: "Para cualquier otro asunto",
    ctaTitle: "¿Hablamos de tu operación?",
    ctaText:
      "Cuenta el proceso que hoy te consume tiempo. Si no es un caso para nosotros, lo decimos en la primera conversación.",
    ctaButton: "Escribir a IA Operators",
  },
  pt: {
    seoTitle: "Sobre a IA Operators — agência de IA e automação em Málaga",
    metaDesc:
      "O que é a IA Operators, quando nasceu, que problema resolve e que tipo de empresa atende. Agência de inteligência artificial e automação com base em Málaga, Espanha.",
    breadcrumbHome: "Início",
