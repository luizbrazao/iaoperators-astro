---
// Página de entidad de la EMPRESA (Organization).
//
// Deliberadamente separada de /[locale]/autores/luiz-fernando-brazao/, que es
// la entidad Person y sostiene el E-E-A-T del blog. Aquí se responde "¿puedo
// confiar en esta empresa?"; allí, "¿quién escribió esto?". Ambas comparten
// grafo a través de los `@id` de src/data/identidad.ts: esta página declara
// `founder` y la de autor declara `worksFor`.
//
// El contenido es inline (no i18n/locales/*.json) siguiendo la convención de
// las páginas construidas desde julio de 2026: página de autor, las siete
// landings de servicio y todo el silo /es/cumplimiento/.

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocale, locales } from "../../../i18n/ui";
import Reconocimientos from "@/components/Reconocimientos.astro";
import {
  ORG_ID,
  ORG_NAME,
  WEBSITE_REF,
  CONTACT,
  FOUNDING_DATE,
  PERSON_NAME,
  aboutUrl,
  authorUrl,
  localeUrl,
  organizationNode,
  type Loc,
} from "@/data/identidad";

export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));

const locale = getLocale(Astro.params.locale);
const loc: Loc = locale;

const canonicalUrl = aboutUrl(locale);
const alternates = locales.map((lang) => ({ lang, href: aboutUrl(lang) }));
const xDefaultUrl = aboutUrl("es");

const withLocale = (path: string) => `/${locale}/${path}`.replace(/\/+$/, "/");

const links = {
  methodology: withLocale("metodologia/"),
  portfolio: withLocale("portfolio/"),
  author: withLocale("autores/luiz-fernando-brazao/"),
  terms: withLocale("terminos-y-condiciones/"),
  services: withLocale("servicios/"),
  contact: withLocale("contact/"),
};

// ─── Contenido ───────────────────────────────────────────────────────────────
// Regla dura: ninguna frase de aquí se repite en el bloque de la home
// (home.json → testimonial) ni en /metodologia ni en la página de autor.

type Section = { title: string; paragraphs: string[] };
type OutLink = { title: string; text: string; cta: string; href: string };
type Fact = { label: string; value: string };

interface Content {
  seoTitle: string;
  metaDesc: string;
  breadcrumbHome: string;
  breadcrumbCurrent: string;
  h1: string;
  lead: string;
  sections: Section[];
  factsTitle: string;
  facts: Fact[];
  outLinksTitle: string;
  outLinks: OutLink[];
  legalTitle: string;
  legalText: string;
  legalCta: string;
  legalContact: string;
  ctaTitle: string;
  ctaText: string;
  ctaButton: string;
}

const CONTENT: Record<Loc, Content> = {
  es: {
    seoTitle: "Sobre IA Operators — agencia de IA y automatización en Málaga",
    metaDesc:
      "Qué es IA Operators, cuándo nació, qué problema resuelve y a qué tipo de empresa sirve. Agencia de inteligencia artificial y automatización con base en Málaga, España.",
