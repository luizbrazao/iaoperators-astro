const C = CONTENT[loc];

// Los hrefs dependen del idioma, así que se inyectan aquí y no en el diccionario.
const outLinks: OutLink[] = [
  { ...C.outLinks[0], href: links.methodology },
  { ...C.outLinks[1], href: links.portfolio },
  { ...C.outLinks[2], href: links.author },
];

// ─── JSON-LD ─────────────────────────────────────────────────────────────────
// Esta es LA página de la entidad Organization: es la única que emite
// `mainEntityOfPage`. El resto del sitio emite el mismo `@id` sin reclamarlo.

const pageId = `${canonicalUrl}#webpage`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": pageId,
    url: canonicalUrl,
    name: C.seoTitle,
    description: C.metaDesc,
    inLanguage: locale,
    isPartOf: WEBSITE_REF,
    about: { "@id": ORG_ID },
    mainEntity: { "@id": ORG_ID },
  },
  organizationNode({
    locale,
    description: C.metaDesc,
    mainEntityOfPage: canonicalUrl,
  }),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: C.breadcrumbHome,
        item: localeUrl(locale),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: C.breadcrumbCurrent,
        item: canonicalUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={`${C.seoTitle} | ${ORG_NAME}`}
  ogTitle={C.h1}
  description={C.metaDesc}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  xDefaultUrl={xDefaultUrl}
  jsonLd={jsonLd}
>
  <div class="pt-32 pb-20 px-4">
    <div class="max-w-4xl mx-auto">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-gray-400">
        <ol class="flex flex-wrap items-center gap-1">
          <li>
            <a href={`/${locale}/`} class="hover:text-orange-400 transition-colors">
              {C.breadcrumbHome}
            </a>
          </li>
          <li class="text-gray-700">/</li>
          <li class="text-gray-400" aria-current="page">{C.breadcrumbCurrent}</li>
        </ol>
      </nav>

      <!-- Encabezado -->
      <header class="mb-14">
        <h1 class="text-3xl md:text-5xl font-bold text-white leading-tight">
          {C.h1}
        </h1>
        <p class="text-lg text-gray-300 leading-relaxed mt-5 max-w-3xl">{C.lead}</p>
      </header>

      <!-- Secciones narrativas -->
      {C.sections.map((section) => (
        <section class="mb-14">
          <h2 class="text-2xl font-bold text-white mb-5 border-l-4 border-orange-500 pl-4">
            {section.title}
          </h2>
          <div class="space-y-4 text-gray-300 leading-relaxed max-w-3xl">
            {section.paragraphs.map((text) => (
              <p>{text}</p>
            ))}
          </div>
        </section>
      ))}

      <!-- Ficha de datos -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-orange-500 pl-4">
          {C.factsTitle}
        </h2>
        <dl class="grid sm:grid-cols-2 gap-px rounded-2xl overflow-hidden bg-white/5 border border-white/5">
          {C.facts.map((fact) => (
            <div class="bg-[#0a0a0a] p-5">
              <dt class="text-xs uppercase tracking-widest text-gray-500 mb-1.5">
                {fact.label}
              </dt>
              <dd class="text-white text-sm font-medium">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- Enlaces de salida -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-orange-500 pl-4">
          {C.outLinksTitle}
        </h2>
        <div class="grid sm:grid-cols-3 gap-5">
          {outLinks.map((item) => (
            <a
              href={item.href}
              class="group flex flex-col p-5 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-orange-500/30 transition-all"
            >
              <h3 class="text-white font-semibold leading-snug mb-2 group-hover:text-orange-300 transition-colors">
                {item.title}
              </h3>
              <p class="text-gray-400 text-sm leading-relaxed grow">{item.text}</p>
              <span class="mt-4 text-orange-400 text-xs font-semibold">
                {item.cta} →
              </span>
            </a>
          ))}
        </div>
      </section>

      <!-- Identificación legal: se enlaza, no se duplica -->
      <section class="mb-16 p-6 rounded-2xl bg-white/[0.03] border border-white/5">
        <h2 class="text-xl font-bold text-white mb-3 border-l-4 border-orange-500 pl-3">
          {C.legalTitle}
        </h2>
        <p class="text-gray-300 text-sm leading-relaxed max-w-3xl">{C.legalText}</p>
        <a
          href={links.terms}
          class="inline-flex items-center gap-1.5 mt-4 text-sm text-orange-400 hover:text-orange-300 transition-colors font-semibold"
        >
          {C.legalCta} →
        </a>
        <p class="text-gray-400 text-sm mt-4">
          {C.legalContact}:{" "}
          <a href={`mailto:${CONTACT.email}`} class="underline hover:text-orange-400">
            {CONTACT.email}
          </a>{" "}
          ·{" "}
          <a href={`tel:${CONTACT.phone}`} class="underline hover:text-orange-400">
            {CONTACT.phoneDisplay}
          </a>
        </p>
      </section>

      <!-- Reconocimientos: sólo en esta página -->
      <Reconocimientos locale={locale} />

      <!-- CTA final -->
      <section class="p-8 rounded-3xl bg-linear-to-b from-white/[0.06] to-transparent border border-white/10 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">{C.ctaTitle}</h2>
        <p class="text-gray-400 leading-relaxed max-w-2xl mx-auto">{C.ctaText}</p>
        <a
          href={links.contact}
          class="inline-block mt-6 px-6 py-3 rounded-full bg-orange-500 text-white font-semibold hover:bg-orange-400 transition-colors"
        >
          {C.ctaButton}
        </a>
      </section>
    </div>
  </div>
</BaseLayout>
