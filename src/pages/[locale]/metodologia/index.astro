---
export async function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "pt" } },
    { params: { locale: "en" } },
  ];
}

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocale, ui } from "../../../i18n/ui";
import { organizationNode, ORG_REF } from "@/data/identidad";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-about.css";

const locale = getLocale((Astro.params.locale as string) ?? Astro.currentLocale ?? "es");
const dict = (ui as any)?.[locale] ?? {};
const m = (dict as any)?.methodology ?? {};

const meta = m?.meta ?? {};
const hero = m?.hero ?? {};
const principles = m?.principles ?? {};
const pillars = m?.pillars ?? {};
const flow = m?.flow ?? {};
const differentiator = m?.differentiator ?? {};
const faq = m?.faq ?? {};
const finalCta = m?.finalCta ?? {};

const contactHref = `/${locale}/contact/`;
const withLocale = (path: string) => `/${locale}${path}`;

const site = Astro.site?.toString() ?? "https://iaoperators.com";

// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".

const siteRoot = site.replace(/\/$/, "");
const pageUrl = new URL(`/${locale}/metodologia/`, site).toString();

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: meta?.title,
  description: meta?.description,
  url: pageUrl,
  isPartOf: {
    "@type": "WebSite",
    name: "IA Operators",
    url: site,
  },
  about: ORG_REF,
};

// Mismo @id que la home y que /[locale]/sobre/: una entidad, no tres nodos.
const organizationJsonLd = organizationNode({
  locale,
  description: meta?.description,
});

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: locale === "pt" ? "Início" : locale === "en" ? "Home" : "Inicio", item: `${siteRoot}/${locale}/` },
    { "@type": "ListItem", position: 2, name: hero?.badge ?? "Metodología", item: pageUrl },
  ],
};

const faqJsonLd = Array.isArray(faq?.items) && faq.items.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.items.map((item: any) => ({
        "@type": "Question",
        name: item?.q,
        acceptedAnswer: { "@type": "Answer", text: item?.a },
      })),
    }
  : null;

// ES editorial: el titular "X — Y" se parte en dos líneas (la segunda en gris).
const [titleMain, titleTail] = String(hero?.title ?? "").split(/\s+—\s+/);
const pad = (n: number) => String(n).padStart(2, "0");

const jsonLd = [aboutJsonLd, organizationJsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];
---

<BaseLayout
  title={meta?.title ?? "Metodología"}
  description={meta?.description}
  jsonLd={jsonLd}
  editorial={locale === "es"}
>
  {/* ES: diseño editorial (oct/2026). Mismos textos y enlaces; EN y PT siguen
      con la plantilla oscura. */}
  {locale === "es" ? (
    <Fragment>
      <div class="ed-container">
        <header class="pg-hero">
          <nav class="pf-crumbs ed-eyebrow" aria-label="Ruta de navegación">
            <ol>
              <li><a href="/es/">Inicio</a></li>
              <li><span aria-current="page">{hero?.badge}</span></li>
            </ol>
          </nav>
          <h1>{titleMain}{titleTail && <Fragment> <span>{titleTail}</span></Fragment>}</h1>
          <div class="pg-hero-bottom">
            <p class="ed-eyebrow">{hero?.badge}</p>
            <div class="mt-hero-copy">
              <p class="pg-lead">{hero?.subtitle}</p>
              {hero?.intro && <p class="pg-lead-muted">{hero.intro}</p>}
              <div class="pg-actions">
                <a class="ed-button" href={contactHref}>{hero?.cta}<span class="ed-arrow" aria-hidden="true">↗</span></a>
              </div>
            </div>
          </div>
        </header>

        {principles?.items?.length > 0 && (
          <section class="pg-section" aria-labelledby="mt-principios">
            <div class="ed-section-intro">
              <p class="ed-eyebrow">{principles.badge}</p>
              <div>
                <h2 id="mt-principios">{principles.title}</h2>
                {principles.subtitle && <p class="pg-lead-muted">{principles.subtitle}</p>}
              </div>
            </div>
            <ol class="pg-phases mt-principles">
              {principles.items.map((item: any, i: number) => (
                <li>
                  <span class="ed-eyebrow">{pad(i + 1)}</span>
                  <h3>{item?.title}</h3>
                  <p>{item?.body}</p>
                </li>
              ))}
            </ol>
          </section>
        )}

        {pillars?.items?.length > 0 && (
          <section class="pg-section mt-before-band" aria-labelledby="mt-productos">
            <div class="ed-section-intro">
              <p class="ed-eyebrow">{pillars.badge}</p>
              <div>
                <h2 id="mt-productos">{pillars.title}</h2>
                {pillars.subtitle && <p class="pg-lead-muted">{pillars.subtitle}</p>}
              </div>
            </div>
            <ul class="pg-doors mt-doors">
              {pillars.items.map((item: any) => (
                <li>
                  <a href={withLocale(item?.href ?? "/")}>
                    <span class="ed-eyebrow sb-door-label">{item?.code}{item?.duration ? ` · ${item.duration}` : ""}</span>
                    <h3>{item?.title}</h3>
                    <p>{item?.summary}</p>
                    <span class="sb-door-cta">{item?.linkLabel}</span>
                    <span class="ed-arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      {flow?.steps?.length > 0 && (
        <section class="ed-method pg-method pg-process" aria-labelledby="mt-ciclo">
          <div class="ed-container">
            <div class="ed-section-intro">
              <p class="ed-eyebrow">{flow.badge}</p>
              <div>
                <h2 id="mt-ciclo">{flow.title}</h2>
                {flow.subtitle && <p class="pg-method-lead">{flow.subtitle}</p>}
              </div>
            </div>
            <ol class="ed-steps pg-steps-4">
              {flow.steps.map((step: any) => (
                <li><span class="ed-eyebrow">{step?.code}</span><h3>{step?.title}</h3><p>{step?.body}</p></li>
              ))}
            </ol>
          </div>
        </section>
      )}

      <div class="ed-container">
        {differentiator?.columns?.length > 0 && (
          <section class="pg-section" aria-labelledby="mt-modelo">
            <div class="ed-section-intro">
              <p class="ed-eyebrow">Comparativa</p>
              <div>
                <h2 id="mt-modelo">{differentiator.title}</h2>
                {differentiator.subtitle && <p class="pg-lead-muted">{differentiator.subtitle}</p>}
              </div>
            </div>
            <div class="mt-compare">
              {differentiator.columns.map((col: any) => (
                <div class:list={["mt-col", { "mt-col-accent": col?.tone === "accent" }]}>
                  <h3>{col?.title}</h3>
                  <ul>
                    {(col?.items ?? []).map((it: string) => <li>{it}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )}

        {faq?.items?.length > 0 && (
          <section class="pg-section pg-faq ed-faq" aria-labelledby="mt-faq">
            <div class="ed-section-intro">
              <p class="ed-eyebrow">Preguntas</p>
              <div>
                <h2 id="mt-faq">{faq.title}</h2>
                <div class="pg-faq-list">
                  {faq.items.map((item: any) => <details><summary>{item?.q}</summary><p>{item?.a}</p></details>)}
                </div>
              </div>
            </div>
          </section>
        )}
      </div>

      {finalCta?.title && (
        <section class="ed-closing" aria-labelledby="mt-closing">
          <div class="ed-container">
            <p class="ed-eyebrow">Siguiente paso</p>
            <h2 id="mt-closing" class="pg-closing-title">{finalCta.title}</h2>
            {finalCta.subtitle && <p class="pg-closing-copy">{finalCta.subtitle}</p>}
            <a class="ed-button" href={contactHref}>{finalCta.cta}<span class="ed-arrow" aria-hidden="true">↗</span></a>
          </div>
        </section>
      )}
    </Fragment>
  ) : (
  <div class="bg-transparent text-white">
    <!-- HERO -->
    <section class="relative px-4 pt-28 pb-20">
      <div class="max-w-5xl mx-auto text-center">
        {hero?.badge && (
          <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold mb-6">
            {hero.badge}
          </span>
        )}
        <h1 class="text-4xl md:text-6xl font-medium tracking-tight leading-tight mb-6">
          {hero?.title}
        </h1>
        {hero?.subtitle && (
          <p class="text-lg md:text-2xl text-gray-200 mb-6 max-w-3xl mx-auto">
            {hero.subtitle}
          </p>
        )}
        {hero?.intro && (
          <p class="text-base md:text-lg text-gray-400 mb-10 max-w-3xl mx-auto leading-relaxed">
            {hero.intro}
          </p>
        )}
        <a
          href={contactHref}
          class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-orange-500 text-black font-medium text-base hover:bg-orange-400 hover:scale-105 transition-all duration-300"
        >
          {hero?.cta} ↗
        </a>
      </div>
    </section>

    <!-- PRINCIPLES -->
    {principles?.items && principles.items.length > 0 && (
      <section class="px-4 py-20">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            {principles?.badge && (
              <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold mb-4">
                {principles.badge}
              </span>
            )}
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              {principles?.title}
            </h2>
            {principles?.subtitle && (
              <p class="text-gray-400 max-w-2xl mx-auto">
                {principles.subtitle}
              </p>
            )}
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {principles.items.map((item: any, idx: number) => (
              <div class="bg-[#0a0a0a] border border-white/5 rounded-3xl p-6 hover:border-orange-500/30 transition-all duration-300">
                <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-orange-500/10 text-orange-400 font-bold text-sm">
                    0{idx + 1}
                  </span>
                  <h3 class="text-lg font-semibold text-white">{item?.title}</h3>
                </div>
                <p class="text-gray-400 text-sm leading-relaxed">{item?.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- PILLARS (3 products) -->
    {pillars?.items && pillars.items.length > 0 && (
      <section class="px-4 py-24 bg-white/[0.02] border-y border-white/5">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            {pillars?.badge && (
              <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold mb-4">
                {pillars.badge}
              </span>
            )}
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              {pillars?.title}
            </h2>
            {pillars?.subtitle && (
              <p class="text-gray-400 max-w-2xl mx-auto">
                {pillars.subtitle}
              </p>
            )}
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {pillars.items.map((item: any) => (
              <a
                href={withLocale(item?.href ?? "/")}
                class="group block bg-[#0a0a0a] border border-white/5 rounded-3xl p-6 hover:border-orange-500/40 hover:bg-white/[0.03] transition-all duration-300"
              >
                <div class="text-orange-400 text-sm font-bold mb-3">{item?.code}</div>
                <h3 class="text-2xl font-bold text-white mb-3">{item?.title}</h3>
                <p class="text-gray-400 text-sm leading-relaxed mb-6">{item?.summary}</p>
                <div class="flex items-center gap-4 text-xs text-gray-400 mb-6">
                  {item?.duration && (
                    <span class="flex items-center gap-1.5">
                      <span class="text-orange-400">●</span> {item.duration}
                    </span>
                  )}
                  {item?.price && (
                    <span class="flex items-center gap-1.5">
                      <span class="text-orange-400">●</span> {item.price}
                    </span>
                  )}
                </div>
                <span class="inline-flex items-center gap-1 text-orange-400 text-sm font-medium group-hover:gap-2 transition-all">
                  {item?.linkLabel} <span>→</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FLOW -->
    {flow?.steps && flow.steps.length > 0 && (
      <section class="px-4 py-24">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            {flow?.badge && (
              <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold mb-4">
                {flow.badge}
              </span>
            )}
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              {flow?.title}
            </h2>
            {flow?.subtitle && (
              <p class="text-gray-400 max-w-2xl mx-auto">
                {flow.subtitle}
              </p>
            )}
          </div>
          <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
            {flow.steps.map((step: any, idx: number) => (
              <li class="relative bg-[#0a0a0a] border border-white/5 rounded-3xl p-6">
                <div class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-3">
                  {step?.code}
                </div>
                <h3 class="text-xl font-bold text-white mb-3">{step?.title}</h3>
                <p class="text-gray-400 text-sm leading-relaxed">{step?.body}</p>
                {idx < flow.steps.length - 1 && (
                  <span class="hidden lg:block absolute -right-3 top-1/2 -translate-y-1/2 text-orange-400 text-2xl z-10" aria-hidden="true">→</span>
                )}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <!-- DIFFERENTIATOR -->
    {differentiator?.columns && differentiator.columns.length > 0 && (
      <section class="px-4 py-24 bg-white/[0.02] border-y border-white/5">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              {differentiator?.title}
            </h2>
            {differentiator?.subtitle && (
              <p class="text-gray-400 max-w-2xl mx-auto">
                {differentiator.subtitle}
              </p>
            )}
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {differentiator.columns.map((col: any) => {
              const isAccent = col?.tone === "accent";
              return (
                <div
                  class:list={[
                    "rounded-3xl p-6 border transition-all duration-300",
                    isAccent
                      ? "bg-gradient-to-br from-orange-500/10 to-transparent border-orange-500/30"
                      : "bg-[#0a0a0a] border-white/5 opacity-80",
                  ]}
                >
                  <h3
                    class:list={[
                      "text-lg font-bold mb-5",
                      isAccent ? "text-white" : "text-gray-400",
                    ]}
                  >
                    {col?.title}
                  </h3>
                  <ul class="space-y-3">
                    {(col?.items ?? []).map((it: string) => (
                      <li class="flex items-start gap-3 text-sm">
                        <span class={isAccent ? "text-orange-400 mt-0.5" : "text-gray-400 mt-0.5"}>
                          {isAccent ? "✓" : "—"}
                        </span>
                        <span class={isAccent ? "text-gray-200" : "text-gray-400"}>
                          {it}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- FAQ -->
    {faq?.items && faq.items.length > 0 && (
      <section class="px-4 py-20">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">
            {faq?.title}
          </h2>
          <div class="space-y-3">
            {faq.items.map((item: any) => (
              <details class="group bg-[#0a0a0a] border border-white/5 rounded-2xl px-6 py-4 hover:border-orange-500/20 transition-all duration-300">
                <summary class="flex items-center justify-between cursor-pointer list-none">
                  <span class="text-white font-medium pr-4">{item?.q}</span>
                  <span class="text-orange-400 text-xl leading-none transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="text-gray-400 mt-3 leading-relaxed">{item?.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FINAL CTA -->
    {finalCta?.title && (
      <section class="px-4 py-24">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-5xl font-bold mb-4 text-white">
            {finalCta.title}
          </h2>
          {finalCta?.subtitle && (
            <p class="text-gray-400 text-lg mb-10 max-w-2xl mx-auto">
              {finalCta.subtitle}
            </p>
          )}
          <a
            href={contactHref}
            class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-orange-500 text-black font-medium text-lg hover:bg-orange-400 hover:scale-105 transition-all duration-300"
          >
            {finalCta?.cta} ↗
          </a>
        </div>
      </section>
    )}
  </div>
  )}
</BaseLayout>
