---
import { projects } from "../../../data/projects";
import type { Project } from "../../../data/projects";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { createT } from "../../../i18n/t";
import PortfolioIndexEditorial from "@/components/editorial/PortfolioIndexEditorial.astro";

export async function getStaticPaths() {
  const locales = ["es", "pt", "en"];
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale!;
const t = await createT(locale, { namespaces: ["portfolio", "projects"] });

const headerTitle = t("portfolio:header.title");
const headerHighlight = t("portfolio:header.highlight");
const pageTitle = `${headerTitle} ${headerHighlight} — IA Operators`;
const pageDescription = t("portfolio:header.subtitle");


const site = Astro.site?.toString() ?? "https://iaoperators.com";

// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".

const siteRoot = site.replace(/\/$/, "");
const portfolioUrl = new URL(`/${locale}/portfolio/`, site).toString();
const homeLabel = locale === "pt" ? "Início" : locale === "en" ? "Home" : "Inicio";

const portfolioJsonLd: any[] = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: pageTitle,
    description: pageDescription,
    url: portfolioUrl,
    inLanguage: locale,
    publisher: {
      "@type": "Organization",
      name: "IA Operators",
      url: site,
      logo: { "@type": "ImageObject", url: `${siteRoot}/favicon-32x32.png` },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: pageTitle,
    url: portfolioUrl,
    numberOfItems: projects.length,
    itemListElement: projects.map((p: Project, idx: number) => ({
      "@type": "ListItem",
      position: idx + 1,
      url: new URL(`/${locale}/portfolio/${p.slugs[locale as "es" | "en" | "pt"]}/`, site).toString(),
      name: t(p.titleKey),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: homeLabel, item: new URL(`/${locale}/`, site).toString() },
      { "@type": "ListItem", position: 2, name: "Portfolio", item: portfolioUrl },
    ],
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={portfolioJsonLd} editorial>
  <PortfolioIndexEditorial locale={locale} />
</BaseLayout>
