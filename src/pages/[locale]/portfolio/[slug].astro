---
import { projects } from "../../../data/projects";
import type { Project, ProjectMetric, ProjectPillar } from "../../../data/projects";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { createT } from "../../../i18n/t";

export async function getStaticPaths() {
  const locales = ["es", "pt", "en"];

  return locales.flatMap((locale) =>
    projects.map((p: Project) => ({
      params: { locale, slug: p.slug },
      props: { project: p },
    }))
  );
}

type Props = { project: Project };
const { project } = Astro.props;

const locale = Astro.params.locale!;
const slug = Astro.params.slug!;

// createT agora é async (porque carregamos JSON com import dinâmico)
const t = await createT(locale, { namespaces: ["portfolio", "projects"] });

const liveLink = project.links?.find((l) => l.external)?.href;

const stackLike = [
  ...project.pillars.map((p: ProjectPillar) => t(p.titleKey)),
  ...(project.securityKeys?.length ? ["AES-GCM / RLS"] : []),
].slice(0, 8);

const tx = (key: string, fallback: string) => {
  const value = t(key);
  return value === key ? fallback : value;
};

const resolveLinkHref = (href: string, external?: boolean) => {
  if (external) return href;
  if (/^(https?:)?\/\//.test(href)) return href;
  if (href.startsWith(`/${locale}/`) || href === `/${locale}`) return href;
  if (href.startsWith("#") || href.startsWith("?")) return href;
  if (href.startsWith("/")) return `/${locale}${href}`;
  return `/${locale}/${href}`;
};

const primaryMetric = project.metrics?.[0];
const pageTitle = `${t(project.titleKey)} — IA Operators`;
const pageDescription = t(project.taglineKey);

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const projectUrl = new URL(`/${locale}/portfolio/${slug}/`, site).toString();
const portfolioUrl = new URL(`/${locale}/portfolio/`, site).toString();
const homeLabel = locale === "pt" ? "Início" : locale === "en" ? "Home" : "Inicio";

const ogImageUrl = project.ogImage
  ? new URL(project.ogImage, site).toString()
  : project.heroImage
    ? new URL(project.heroImage, site).toString()
    : undefined;

const faqJsonLd = project.faq?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: project.faq.map((item) => ({
        "@type": "Question",
        name: t(item.qKey),
        acceptedAnswer: { "@type": "Answer", text: t(item.aKey) },
      })),
    }
  : null;

const portfolioSlugJsonLd: any[] = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: pageTitle,
    description: pageDescription,
    url: projectUrl,
    inLanguage: locale,
    datePublished: project.publishedAt,
    dateModified: project.updatedAt ?? project.publishedAt,
    image: ogImageUrl,
    author: {
      "@type": "Organization",
      name: "IA Operators",
      url: site,
    },
    publisher: {
      "@type": "Organization",
      name: "IA Operators",
      url: site,
      logo: {
        "@type": "ImageObject",
        url: new URL("/android-chrome-512x512.png", site).toString(),
        width: 512,
        height: 512,
      },
    },
    about: {
      "@type": "Service",
      name: t(project.titleKey),
      description: pageDescription,
      provider: { "@type": "Organization", name: "IA Operators", url: site },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: homeLabel, item: new URL(`/${locale}/`, site).toString() },
      { "@type": "ListItem", position: 2, name: "Portfolio", item: portfolioUrl },
      { "@type": "ListItem", position: 3, name: t(project.titleKey), item: projectUrl },
    ],
  },
  ...(faqJsonLd ? [faqJsonLd] : []),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={project.ogImage ?? project.heroImage ?? undefined}
  ogType="article"
  ogPublishedTime={project.publishedAt}
  ogModifiedTime={project.updatedAt ?? project.publishedAt}
  jsonLd={portfolioSlugJsonLd}
>
  <section class="bg-transparent text-white pt-28 pb-20 px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Top nav -->
      <div class="mb-8 flex flex-wrap items-center justify-between gap-3">
        <a
          href={`/${locale}/portfolio/`}
          class="inline-flex items-center gap-2 text-gray-300 hover:text-white transition"
        >
          <span class="text-xl">←</span>
          <span class="text-xs sm:text-sm font-semibold">{t("portfolio:actions.back") ?? "Voltar ao portfolio"}</span>
        </a>

        {liveLink && (
          <a
            href={liveLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-green-500/10 border border-green-500/20 text-green-300 text-sm font-bold hover:bg-green-500/15 transition"
          >
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75" />
              <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500" />
            </span>
            {t("portfolio:actions.live")}
          </a>
        )}
      </div>

      <!-- Hero -->
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="max-w-full truncate bg-black/70 backdrop-blur-md border border-white/10 text-orange-500 text-[10px] sm:text-xs font-bold px-4 py-2 rounded-full uppercase tracking-wider">
            {project.categoryKey ? t(project.categoryKey) : project.category}
          </span>

          <span class="bg-white/5 border border-white/10 text-gray-300 text-xs font-semibold px-4 py-2 rounded-full">
            {slug}
          </span>
        </div>

        <h1 class="text-3xl md:text-5xl font-bold leading-tight text-white mb-4">
          {t(project.titleKey)}
        </h1>

        <p class="text-gray-400 text-lg leading-relaxed max-w-3xl">
          {t(project.taglineKey)}
        </p>

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-4xl">
          <div class="rounded-xl border border-white/10 bg-[#0A0A0A] p-4">
            <div class="text-xs uppercase tracking-wider font-bold text-gray-500 mb-1">
              {tx("portfolio:actions.challenge", "Challenge")}
            </div>
            <p class="text-sm text-gray-300 line-clamp-2">{t(project.problemKey)}</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-[#0A0A0A] p-4">
            <div class="text-xs uppercase tracking-wider font-bold text-gray-500 mb-1">
              {t("portfolio:actions.impact")}
            </div>
            <p class="text-sm text-gray-100 line-clamp-2">{t(project.impactKey)}</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-[#0A0A0A] p-4">
            <div class="text-xs uppercase tracking-wider font-bold text-gray-500 mb-1">
              {tx("portfolio:proof.liveProjects", "Signal")}
            </div>
            <p class="text-sm text-gray-100">
              {primaryMetric ? `${primaryMetric.value} • ${t(primaryMetric.labelKey)}` : tx("portfolio:actions.live", "Live")}
            </p>
          </div>
        </div>
      </header>

      <!-- Hero image -->
      {project.heroImage && (
        <div class="mb-12 relative rounded-3xl overflow-hidden border border-white/10 shadow-2xl aspect-16/8 bg-[#111]">
          <img
            src={project.heroImage}
            alt={project.gallery?.[0]?.altKey ? t(project.gallery[0].altKey) : `${t(project.titleKey)} — IA Operators`}
            loading="lazy"
            class="w-full h-full object-cover opacity-95"
          />
          <div class="absolute inset-0 bg-linear-to-t from-[#050505] via-transparent to-transparent opacity-70" />
        </div>
      )}

      <!-- Content grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <!-- Main -->
        <div class="lg:col-span-2">
          <!-- Problem / Engineering / Impact -->
          <section class="space-y-10">
            <div class="bg-[#0A0A0A] border border-white/10 rounded-3xl p-8">
              <div class="text-xs uppercase tracking-wider font-bold text-orange-400 mb-2">01</div>
              <h2 class="text-2xl font-bold mb-4 text-white">{t("portfolio:project.sections.gap.title") ?? "Problem"}</h2>
              <p class="text-gray-300 leading-relaxed">{t(project.problemKey)}</p>
            </div>

            {project.contextKey && (
              <div class="bg-[#0A0A0A] border border-white/10 rounded-3xl p-8 border-l-4 border-l-white/20">
                <h2 class="text-2xl font-bold mb-4 text-white">
                  {locale === "pt"
                    ? "O custo real da desintegração"
                    : locale === "en"
                    ? "The real cost of disintegration"
                    : "El coste real de la desintegración"}
                </h2>
                {t(project.contextKey).split("\n\n").map((para: string) => (
                  <p class="text-gray-300 leading-relaxed mb-4 last:mb-0">{para}</p>
                ))}
              </div>
            )}

            <div class="bg-[#0A0A0A] border border-white/10 rounded-3xl p-8">
              <div class="text-xs uppercase tracking-wider font-bold text-orange-400 mb-2">02</div>
              <h2 class="text-2xl font-bold mb-4 text-white">{t("portfolio:project.sections.engineering.title") ?? "Engineering"}</h2>
              <p class="text-gray-300 leading-relaxed">{t(project.engineeringIntroKey)}</p>
            </div>

            <div class="bg-[#111] border border-white/10 rounded-3xl p-8 border-l-4 border-l-orange-500">
              <div class="text-xs uppercase tracking-wider font-bold text-orange-400 mb-2">03</div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-orange-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                <div>
                  <span class="text-gray-500 text-xs uppercase font-bold tracking-wider block mb-1">{t("portfolio:actions.impact")}</span>
                  <p class="text-white text-base font-medium">{t(project.impactKey)}</p>
                </div>
              </div>
            </div>
          </section>

          <!-- What it does / How it works -->
          <section class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-[#0A0A0A] border border-white/10 rounded-3xl p-8">
              <h3 class="text-xl font-bold mb-4">{t("projects:sections.whatItDoes.title") ?? "What it does"}</h3>
              <ul class="space-y-2 text-gray-300">
                {project.whatItDoesKeys.map((k) => (
                  <li class="flex gap-3">
                    <span class="mt-2 w-2 h-2 rounded-full bg-orange-500/90 shrink-0" />
                    <span class="leading-relaxed">{t(k)}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="bg-[#0A0A0A] border border-white/10 rounded-3xl p-8">
              <h3 class="text-xl font-bold mb-4">{t("portfolio:project.sections.howItWorks.title") ?? "How it works"}</h3>
              <ol class="space-y-2 text-gray-300 list-decimal list-inside">
                {project.howItWorksKeys.map((k) => (
                  <li class="leading-relaxed">{t(k)}</li>
                ))}
              </ol>
            </div>
          </section>

          <!-- Pillars -->
          <section class="mt-12 bg-[#0A0A0A] border border-white/10 rounded-3xl p-8">
            <h3 class="text-xl font-bold mb-6">{t("projects:sections.pillars.title") ?? "Pillars"}</h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {project.pillars.map((pillar) => (
                <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <h4 class="font-bold text-white mb-2">{t(pillar.titleKey)}</h4>
                  <p class="text-gray-300 text-sm leading-relaxed mb-4">{t(pillar.descriptionKey)}</p>

                  {pillar.bulletsKeys?.length ? (
                    <ul class="space-y-2 text-gray-300 text-sm">
                      {pillar.bulletsKeys.map((bk) => (
                        <li class="flex gap-3">
                          <span class="mt-2 w-2 h-2 rounded-full bg-orange-500/80 shrink-0" />
                          <span>{t(bk)}</span>
                        </li>
                      ))}
                    </ul>
                  ) : null}
                </div>
              ))}
            </div>
          </section>

          <!-- Testimonial -->
          {project.testimonial && (
            <section class="mt-12 relative bg-[#0A0A0A] border border-white/10 rounded-3xl p-8 overflow-hidden">
              <span class="absolute top-4 right-6 text-7xl text-orange-500/10 font-serif leading-none select-none" aria-hidden="true">"</span>
              <blockquote class="relative">
                <p class="text-white text-lg leading-relaxed font-medium mb-6">
                  "{t(project.testimonial.quoteKey)}"
                </p>
                <footer class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-orange-500/20 border border-orange-500/30 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5 text-orange-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                    </svg>
                  </div>
                  <div>
                    <cite class="not-italic font-bold text-white text-sm">{t(project.testimonial.authorKey)}</cite>
                    <p class="text-gray-400 text-xs mt-0.5">{t(project.testimonial.roleKey)}</p>
                  </div>
                </footer>
              </blockquote>
            </section>
          )}

          <!-- Security -->
          <section class="mt-12 bg-[#0A0A0A] border border-white/10 rounded-3xl p-8">
            <h3 class="text-xl font-bold mb-4">{t("portfolio:project.sections.security.title") ?? "Security"}</h3>
            <div class="flex flex-wrap gap-2 mb-6">
              {stackLike.map((tech) => (
                <span
                  class:list={[
                    "text-xs px-3 py-1.5 rounded border",
                    tech.toLowerCase().includes("security") ||
                    tech.toLowerCase().includes("aes") ||
                    tech.toLowerCase().includes("rls")
                      ? "bg-green-900/20 border-green-800 text-green-400"
                      : "bg-white/5 border-white/10 text-gray-300",
                  ]}
                >
                  {tech}
                </span>
              ))}
            </div>

            <ul class="space-y-2 text-gray-300">
              {project.securityKeys.map((k) => (
                <li class="flex gap-3">
                  <span class="mt-2 w-2 h-2 rounded-full bg-green-400/90 shrink-0" />
                  <span class="leading-relaxed">{t(k)}</span>
                </li>
              ))}
            </ul>
          </section>

          <!-- Para quién es -->
          {project.forWho && (
            <section class="mt-12 bg-[#0A0A0A] border border-white/10 rounded-3xl p-8">
              <h2 class="text-2xl font-bold mb-6 text-white">
                {locale === "pt"
                  ? "Para quem é (e para quem não é)"
                  : locale === "en"
                  ? "Who it's for (and who it's not)"
                  : "Para quién es (y para quién no es)"}
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div>
                  <div class="text-xs uppercase tracking-wider font-bold text-green-400 mb-3">
                    {locale === "pt" ? "Ideal para" : locale === "en" ? "Ideal for" : "Ideal para"}
                  </div>
                  <ul class="space-y-3">
                    {project.forWho.yesKeys.map((k) => (
                      <li class="flex gap-3">
                        <span class="mt-0.5 text-green-400 shrink-0">✓</span>
                        <span class="text-gray-300 text-sm leading-relaxed">{t(k)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <div class="text-xs uppercase tracking-wider font-bold text-red-400 mb-3">
                    {locale === "pt" ? "Não indicado para" : locale === "en" ? "Not for" : "No es para"}
                  </div>
                  <ul class="space-y-3">
                    {project.forWho.noKeys.map((k) => (
                      <li class="flex gap-3">
                        <span class="mt-0.5 text-red-400 shrink-0">✕</span>
                        <span class="text-gray-300 text-sm leading-relaxed">{t(k)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </section>
          )}

          <!-- IA Readiness -->
          {project.iaReadinessKey && (
            <section class="mt-12 bg-gradient-to-br from-orange-500/10 to-transparent border border-orange-500/20 rounded-3xl p-8">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-8 h-8 rounded-full bg-orange-500/20 border border-orange-500/30 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.346.346a3.001 3.001 0 00-.877 2.121V19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-.879a3.001 3.001 0 00-.877-2.121l-.347-.346z" />
                  </svg>
                </div>
                <h2 class="text-xl font-bold text-white">
                  {locale === "pt"
                    ? "Radiografia Digital: o passo antes da IA"
                    : locale === "en"
                    ? "Digital X-Ray: the step before AI"
                    : "Radiografía Digital: el paso previo a la IA"}
                </h2>
              </div>
              <p class="text-gray-300 leading-relaxed">{t(project.iaReadinessKey)}</p>
            </section>
          )}

          <!-- FAQ -->
          {project.faq?.length && (
            <section class="mt-12 bg-[#0A0A0A] border border-white/10 rounded-3xl p-8">
              <h2 class="text-2xl font-bold mb-6 text-white">
                {locale === "pt"
                  ? "Perguntas frequentes"
                  : locale === "en"
                  ? "Frequently asked questions"
                  : "Preguntas frecuentes"}
              </h2>
              <div class="space-y-0 divide-y divide-white/5">
                {project.faq.map((item) => (
                  <details class="group py-5 first:pt-0 last:pb-0">
                    <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
                      <h3 class="font-semibold text-white group-open:text-orange-400 transition-colors">
                        {t(item.qKey)}
                      </h3>
                      <span class="text-gray-400 group-open:text-orange-400 shrink-0 transition-colors text-lg leading-none">
                        <span class="group-open:hidden">+</span>
                        <span class="hidden group-open:inline">−</span>
                      </span>
                    </summary>
                    <p class="mt-3 text-gray-300 leading-relaxed text-sm">
                      {t(item.aKey)}
                    </p>
                  </details>
                ))}
              </div>
            </section>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="space-y-8">
          <section class="lg:sticky lg:top-24 bg-orange-500/10 border border-orange-500/30 rounded-3xl p-6">
            <h3 class="text-lg font-bold text-white mb-2">
              {tx("portfolio:cta.title", "Want this outcome in your operation?")}
            </h3>
            <p class="text-sm text-gray-300 mb-4">
              {tx("portfolio:cta.subtitle", "We can design and deploy an AI-first workflow for your business.")}
            </p>
            <div class="flex flex-col gap-2">
              <a
                href={`/${locale}/contact/`}
                class="inline-flex items-center justify-center rounded-xl bg-orange-600 hover:bg-orange-500 px-4 py-3 font-semibold text-white transition-all"
              >
                {tx("portfolio:actions.startProject", "Start a project")}
              </a>
              {liveLink && (
                <a
                  href={liveLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center rounded-xl border border-white/20 bg-white/5 hover:bg-white/10 px-4 py-3 font-semibold text-white transition-all"
                >
                  {t("portfolio:actions.live")}
                </a>
              )}
            </div>
          </section>

          <!-- Metrics -->
          {project.metrics?.length ? (
            <section class="bg-[#0A0A0A] border border-white/10 rounded-3xl p-8">
              <h3 class="text-xl font-bold mb-6">{t("projects:sections.metrics.title") ?? "Metrics"}</h3>

              <div class="grid grid-cols-2 gap-4">
                {project.metrics.map((m: ProjectMetric) => (
                  <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="text-2xl font-extrabold text-white">{m.value}</div>
                    <div class="text-gray-400 text-xs uppercase tracking-wider font-bold mt-1">
                      {t(m.labelKey)}
                    </div>
                    {m.noteKey && <div class="text-gray-400 text-xs mt-2">{t(m.noteKey)}</div>}
                  </div>
                ))}
              </div>
            </section>
          ) : null}

          <!-- Pricing -->
          {project.pricing ? (
            <section class="bg-[#0A0A0A] border border-white/10 rounded-3xl p-8">
              <h3 class="text-xl font-bold mb-6">{t("portfolio:project.sections.pricing.title") ?? "Pricing"}</h3>

              <div class="space-y-4">
                {project.pricing.monthly ? (
                  <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-gray-300 font-semibold">{t("portfolio:project.pricing.monthly") ?? "Monthly"}</span>
                      <span class="text-white font-extrabold">{project.pricing.monthly.price}</span>
                    </div>

                    {project.pricing.monthly.detailsKeys?.length ? (
                      <ul class="space-y-2 text-gray-300 text-sm mt-3">
                        {project.pricing.monthly.detailsKeys.map((k) => (
                          <li class="flex gap-3">
                            <span class="mt-2 w-2 h-2 rounded-full bg-orange-500/80 shrink-0" />
                            <span>{t(k)}</span>
                          </li>
                        ))}
                      </ul>
                    ) : null}
                  </div>
                ) : null}

                {project.pricing.annual ? (
                  <div class="rounded-2xl border border-orange-500/30 bg-orange-500/5 p-5">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-orange-200 font-semibold">{t("portfolio:project.pricing.annual") ?? "Annual"}</span>
                      <span class="text-white font-extrabold">{project.pricing.annual.price}</span>
                    </div>

                    {project.pricing.annual.detailsKeys?.length ? (
                      <ul class="space-y-2 text-gray-200 text-sm mt-3">
                        {project.pricing.annual.detailsKeys.map((k) => (
                          <li class="flex gap-3">
                            <span class="mt-2 w-2 h-2 rounded-full bg-orange-400 shrink-0" />
                            <span>{t(k)}</span>
                          </li>
                        ))}
                      </ul>
                    ) : null}
                  </div>
                ) : null}

                {project.pricing.trialKey ? (
                  <div class="text-gray-400 text-sm mt-2">{t(project.pricing.trialKey)}</div>
                ) : null}
              </div>
            </section>
          ) : null}

          <!-- Links -->
          <section class="bg-[#0A0A0A] border border-white/10 rounded-3xl p-8">
            <h3 class="text-xl font-bold mb-4">{t("projects:sections.links.title") ?? "Links"}</h3>
            <div class="flex flex-col gap-3">
              {project.links.map((l) => (
                <a
                  href={resolveLinkHref(l.href, l.external)}
                  target={l.external ? "_blank" : undefined}
                  rel={l.external ? "noopener noreferrer" : undefined}
                  class="inline-flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition"
                >
                  <span class="font-semibold">{l.labelKey ? t(l.labelKey) : l.label}</span>
                  <span class="text-gray-400 text-sm">{l.external ? "↗" : "→"}</span>
                </a>
              ))}
            </div>
          </section>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
