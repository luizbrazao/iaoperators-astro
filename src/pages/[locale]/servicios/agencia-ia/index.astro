---
export async function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "pt" } },
    { params: { locale: "en" } },
  ];
}

import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getLocale } from "../../../../i18n/ui";

const locale = getLocale((Astro.params.locale as string) ?? Astro.currentLocale ?? "es");

// Alvo: ES agencia de inteligencia artificial / consultoría ia / ia para empresas
// PT agência de inteligência artificial / consultoria de ia
// EN ai agency / ai consulting
const CONTENT: Record<string, any> = {
  es: {
    meta: {
      title: "Agencia de inteligencia artificial para empresas | IA Operators",
      description:
        "Agencia de inteligencia artificial: diseñamos, construimos e integramos agentes, automatizaciones y asistentes sobre los sistemas que ya usas. Hasta producción.",
    },
    breadcrumb: "Agencia de IA",
    // Ver la nota del mismo campo en consultoria-ia: el schema lleva el nombre
    // del servicio, no el titular del hero.
    serviceName: "Agencia de inteligencia artificial",
    serviceType: "Artificial intelligence development and implementation",
    hero: {
      badge: "Agencia de IA",
      title: "Agencia de inteligencia artificial para empresas",
      subtitle:
        "Diseñamos, construimos e integramos soluciones de IA sobre los sistemas que tu empresa ya utiliza: agentes que ejecutan, automatizaciones que aguantan producción y asistentes conectados a la operación real. Somos el equipo que lo construye.",
      cta: "Hablar de tu proyecto ↗",
    },
