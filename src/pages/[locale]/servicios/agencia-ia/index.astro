        { code: "02", title: "Diseño técnico", body: "Arquitectura de la solución, contratos de datos, puntos de integración, modelo de permisos y estrategia de pruebas." },
        { code: "03", title: "Construcción", body: "Implementación con tipado, validación en los bordes e idempotencia. Entregas parciales que ya se pueden probar contra el proceso real." },
        { code: "04", title: "Producción y evolución", body: "Despliegue, observabilidad, control de errores y de coste, y mantenimiento cuando cambia un modelo, una API o el propio proceso." },
      ],
    },
    tech: {
      title: "La tecnología que usamos",
      subtitle: "LLM-first, multi-agente y lista para producción.",
      items: ["OpenAI / Claude", "LangChain", "n8n", "Supabase", "Multi-agente", "WhatsApp Cloud API", "Webhooks & APIs", "Node / TypeScript"],
    },
