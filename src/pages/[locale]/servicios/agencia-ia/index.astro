---
export async function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "pt" } },
    { params: { locale: "en" } },
  ];
}

import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getLocale } from "../../../../i18n/ui";

const locale = getLocale((Astro.params.locale as string) ?? Astro.currentLocale ?? "es");

