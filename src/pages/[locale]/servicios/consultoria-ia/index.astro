    },
    finalCta: {
      title: "Por onde sua empresa deveria começar com IA?",
      subtitle: "Numa call de 30 minutos, um consultor de IA te diz onde está seu melhor primeiro caso — sem enrolação e sem compromisso.",
      cta: "Falar com um consultor",
    },
  },

  en: {
    meta: {
      title: "AI consulting for businesses | IA Operators",
