const c = CONTENT[locale] ?? CONTENT.es;
const contactHref = `/${locale}/contact/`;

const site = Astro.site?.toString() ?? "https://iaoperators.com";

// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".

const siteRoot = site.replace(/\/$/, "");
const pageUrl = new URL(`/${locale}/servicios/consultoria-ia/`, site).toString();

const providerSchema = {
  "@type": ["Organization", "ProfessionalService"],
  name: "IA Operators",
  url: site,
  logo: { "@type": "ImageObject", url: `${siteRoot}/favicon-32x32.png` },
  address: { "@type": "PostalAddress", addressLocality: "Málaga", addressCountry: "ES" },
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  // `serviceName` permite que el H1 sea una frase de posicionamiento sin
  // arrastrar el schema. EN/PT no lo definen y siguen usando el H1, así que su
  // JSON-LD no cambia.
  name: c.serviceName ?? c.hero.title,
  serviceType: "Artificial intelligence consulting",
  provider: providerSchema,
  areaServed: ["ES", "PT", "BR", "US", "GB"],
  description: c.meta.description,
  url: pageUrl,
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: locale === "pt" ? "Início" : locale === "en" ? "Home" : "Inicio", item: `${siteRoot}/${locale}/` },
    { "@type": "ListItem", position: 2, name: c.breadcrumb, item: pageUrl },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.faq.items.map((item: any) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a.replace(/<[^>]+>/g, "") },
  })),
};

const jsonLd = [serviceJsonLd, breadcrumbJsonLd, faqJsonLd];
---

<BaseLayout title={c.meta.title} description={c.meta.description} jsonLd={jsonLd} editorial>
  <ServicioIAEditorial
    c={c}
    contactHref={contactHref}
    faqHtml
  />
</BaseLayout>
