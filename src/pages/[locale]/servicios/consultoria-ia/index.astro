        { title: "Data & process audit", body: "We check whether your data and flows are ready for AI — and what's missing if they're not." },
        { title: "Build vs. buy", body: "We tell you honestly what to build custom, what to buy, and what not to do yet." },
        { title: "Business case & ROI", body: "We estimate cost, return and risk for each initiative so you decide with numbers." },
        { title: "From strategy to production", body: "We don't stop at the report: we can implement the roadmap all the way to running." },
      ],
    },
    process: {
      badge: "How we work",
      title: "Diagnose, strategy and build — no hand-offs",
      subtitle: "The same team that defines the strategy builds it. With AI, but no hype.",
      phases: [
        { code: "01", title: "We diagnose", body: "We understand your business, processes and data. Where it hurts and where AI can genuinely help." },
        { code: "02", title: "We prioritize", body: "We build the roadmap: initiatives ordered by impact, effort and expected return." },
        { code: "03", title: "We build", body: "Here's the difference: we implement the first case to production, not leave it in a PDF." },
        { code: "04", title: "We measure & scale", body: "We measure real results, iterate and extend AI to new processes." },
      ],
    },
