        { title: "Da estratégia à produção", body: "Não paramos no relatório: podemos implementar o roadmap até deixar funcionando." },
      ],
    },
    process: {
      badge: "Como trabalhamos",
      title: "Diagnóstico, estratégia e execução — sem hand-offs",
      subtitle: "O mesmo time que define a estratégia constrói. Com IA, mas sem enrolação.",
