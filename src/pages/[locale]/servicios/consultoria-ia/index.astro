---
export async function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "pt" } },
    { params: { locale: "en" } },
  ];
}

import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getLocale } from "../../../../i18n/ui";
import ServicioIAEditorial from "@/components/editorial/ServicioIAEditorial.astro";

const locale = getLocale((Astro.params.locale as string) ?? Astro.currentLocale ?? "es");

// Alvo: ES consultoría de inteligencia artificial / consultor de ia / consultoría ia
// PT consultoria de inteligência artificial / consultor de ia
// EN ai consulting / ai consultant
const CONTENT: Record<string, any> = {
  es: {
    meta: {
      title: "Consultoría de IA para empresas: dónde aplicarla | IA Operators",
      description:
        "Consultoría de inteligencia artificial para empresas: diagnóstico de oportunidades, priorización por impacto y ROI, y un roadmap de IA ejecutable.",
    },
    breadcrumb: "Consultoría de IA",
    // `serviceName` existe para que el JSON-LD Service lleve el nombre del
    // servicio y no el titular del hero, que ahora es una frase de
    // posicionamiento. Sin este campo, cambiar el H1 cambiaría el schema.
    serviceName: "Consultoría de inteligencia artificial",
    hero: {
      badge: "Consultoría de IA",
      title: "Consultoría de inteligencia artificial para empresas",
      // El H1 lleva la intención de búsqueda; el posicionamiento comercial baja
