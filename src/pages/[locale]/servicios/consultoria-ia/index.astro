        { code: "03", title: "Construímos", body: "Aqui está a diferença: implementamos o primeiro caso até a produção, não deixamos num PDF." },
        { code: "04", title: "Medimos e escalamos", body: "Medimos resultados reais, iteramos e ampliamos a IA para novos processos." },
      ],
    },
