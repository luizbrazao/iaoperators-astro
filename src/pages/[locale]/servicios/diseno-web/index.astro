---
export async function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "pt" } },
    { params: { locale: "en" } },
  ];
}

import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getLocale } from "../../../../i18n/ui";
import RelatedCases from "@/components/RelatedCases.astro";

const locale = getLocale((Astro.params.locale as string) ?? Astro.currentLocale ?? "es");

// Alvo de keywords: ES diseño web / agencia de diseño web / desarrollo web
// PT criação de sites / desenvolvimento web / design de sites
// EN web design agency / web design / website development
