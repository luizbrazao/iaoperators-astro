const c = CONTENT[locale] ?? CONTENT.es;
const contactHref = `/${locale}/contact/`;

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL(`/${locale}/servicios/diseno-web/`, site).toString();

const providerSchema = {
  "@type": ["Organization", "ProfessionalService"],
  name: "IA Operators",
  url: site,
  logo: { "@type": "ImageObject", url: `${site}/favicon-32x32.png` },
  address: { "@type": "PostalAddress", addressLocality: "Málaga", addressCountry: "ES" },
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: c.hero.title,
  serviceType: "Web design and development",
  provider: providerSchema,
  areaServed: ["ES", "PT", "BR", "US", "GB"],
  description: c.meta.description,
  url: pageUrl,
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: locale === "pt" ? "Início" : locale === "en" ? "Home" : "Inicio", item: `${site}/${locale}/` },
    { "@type": "ListItem", position: 2, name: c.breadcrumb, item: pageUrl },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.faq.items.map((item: any) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const jsonLd = [serviceJsonLd, breadcrumbJsonLd, faqJsonLd];
---

<BaseLayout title={c.meta.title} description={c.meta.description} jsonLd={jsonLd}>
  <div class="bg-transparent text-white">
    <!-- HERO -->
    <section class="relative px-4 pt-28 pb-20">
      <div class="max-w-5xl mx-auto text-center">
        <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold mb-6">
          {c.hero.badge}
        </span>
        <h1 class="text-4xl md:text-6xl font-medium tracking-tight leading-tight mb-6">
          {c.hero.title}
        </h1>
        <p class="text-lg md:text-2xl text-gray-200 mb-10 max-w-3xl mx-auto">
          {c.hero.subtitle}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={contactHref}
            class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-orange-500 text-black font-medium text-base hover:bg-orange-400 hover:scale-105 transition-all duration-300"
          >
            {c.hero.cta}
          </a>
          <a
            href="#servicios"
            class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-black text-orange-400 border border-orange-500/30 font-medium text-base hover:bg-orange-500/10 transition-all duration-300"
          >
            {c.services.title}
          </a>
        </div>
      </div>
    </section>

    <!-- PROBLEM -->
    <section class="px-4 py-20">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-center">{c.problem.title}</h2>
        <p class="text-gray-400 text-center mb-12 max-w-2xl mx-auto">{c.problem.subtitle}</p>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {c.problem.items.map((item: string) => (
            <li class="flex items-start gap-3 bg-[#0a0a0a] border border-white/5 rounded-2xl p-5">
              <span class="text-orange-400 text-xl leading-none mt-0.5">✕</span>
              <p class="text-gray-200 text-base leading-relaxed">{item}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="servicios" class="px-4 py-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">{c.services.title}</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">{c.services.subtitle}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {c.services.items.map((item: any, idx: number) => (
            <div class="bg-[#0a0a0a] border border-white/5 rounded-3xl p-6 hover:border-orange-500/30 transition-all duration-300">
              <div class="flex items-center gap-3 mb-4">
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-orange-500/10 text-orange-400 font-bold text-sm">
                  0{idx + 1}
                </span>
                <h3 class="text-xl font-semibold text-white">{item.title}</h3>
              </div>
              <p class="text-gray-400 text-sm leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="px-4 py-24 bg-white/[0.02] border-y border-white/5">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold mb-4">
            {c.process.badge}
          </span>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">{c.process.title}</h2>
          <p class="text-gray-400 max-w-2xl mx-auto">{c.process.subtitle}</p>
        </div>
        <ol class="space-y-6 max-w-4xl mx-auto">
          {c.process.phases.map((phase: any) => (
            <li class="flex flex-col md:flex-row gap-6 bg-[#0a0a0a] border border-white/5 rounded-3xl p-6 md:p-8 hover:border-orange-500/20 transition-all duration-300">
              <div class="md:w-52 shrink-0">
                <div class="text-orange-400 text-xs font-semibold uppercase tracking-widest mb-1">{phase.code}</div>
                <h3 class="text-xl font-bold text-white">{phase.title}</h3>
              </div>
              <p class="text-gray-300 leading-relaxed flex-1">{phase.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- TECH -->
    <section class="px-4 py-20">
      <div class="max-w-5xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-3">{c.tech.title}</h2>
        <p class="text-gray-400 mb-10 max-w-2xl mx-auto">{c.tech.subtitle}</p>
        <div class="flex flex-wrap justify-center gap-3">
          {c.tech.items.map((item: string) => (
            <span class="px-5 py-2 rounded-full bg-[#0a0a0a] border border-white/10 text-gray-200 text-sm font-medium hover:border-orange-500/30 transition-colors">
              {item}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Prueba contextual: los casos que respaldan esta página.
         La lista sale de `provesFor` en src/data/projects.ts, no de aquí. -->
    <RelatedCases path="servicios/diseno-web/" locale={locale} />

    <!-- FAQ -->
    <section class="px-4 py-20">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center">{c.faq.title}</h2>
        <div class="space-y-3">
          {c.faq.items.map((item: any) => (
            <details class="group bg-[#0a0a0a] border border-white/5 rounded-2xl px-6 py-4 hover:border-orange-500/20 transition-all duration-300">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <span class="text-white font-medium pr-4">{item.q}</span>
                <span class="text-orange-400 text-xl leading-none transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-gray-400 mt-3 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="px-4 py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-5xl font-bold mb-4 text-white">{c.finalCta.title}</h2>
        <p class="text-gray-400 text-lg mb-10 max-w-2xl mx-auto">{c.finalCta.subtitle}</p>
        <a
          href={contactHref}
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-orange-500 text-black font-medium text-lg hover:bg-orange-400 hover:scale-105 transition-all duration-300"
        >
          {c.finalCta.cta} ↗
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
