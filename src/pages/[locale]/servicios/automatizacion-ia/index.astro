      items: [
        { title: "Automação de processos", body: "Fluxos que conectam suas apps e executam tarefas repetitivas sem intervenção: cadastros, validações, notificações e sincronização de dados." },
        { title: "Agentes de IA", body: "Agentes e sistemas multi-agente que raciocinam, decidem e agem sobre suas ferramentas: classificam, respondem, resumem e escalam quando preciso." },
        { title: "Integrações API sob medida", body: "Conectamos CRM, ERP, WhatsApp, e-mail e qualquer SaaS com API. Arquitetura API-first, sem gambiarras manuais." },
        { title: "Chatbots e assistentes virtuais", body: "Assistentes no WhatsApp e web que atendem, qualificam e agendam 24/7, integrados à sua operação real." },
        { title: "Automação de vendas e CRM", body: "Captação, follow-up e nurturing automáticos: o lead entra, é qualificado e chega quente ao comercial." },
        { title: "Relatórios e insights", body: "Dashboards e relatórios que se atualizam sozinhos, com a IA resumindo o que importa para decidir." },
      ],
    },
    process: {
      badge: "Como trabalhamos",
      title: "Diagnóstico, design e execução — sem hand-offs",
      subtitle: "A mesma equipe que entende o processo constrói a automação. Com IA, mas sem enrolação.",
      phases: [
        { code: "01", title: "Diagnosticamos", body: "Mapeamos o processo real, os sistemas envolvidos e onde se perde tempo. Priorizamos por impacto vs. esforço." },
        { code: "02", title: "Desenhamos", body: "Definimos a arquitetura do fluxo: o que automatizar, com quais ferramentas e com quais pontos de controle humano." },
        { code: "03", title: "Construímos", body: "Implementamos com n8n, LangChain, integrações API e sistemas sob medida. Com tipagem, validação e idempotência." },
        { code: "04", title: "Operamos e escalamos", body: "Monitoramos, medimos resultados e ampliamos a automação para novos processos sobre uma base sólida." },
      ],
    },
    tech: {
      title: "A tecnologia que usamos",
      subtitle: "LLM-first, API-first e pronta para produção.",
      items: ["n8n", "LangChain", "OpenAI / Claude", "Supabase", "WhatsApp Cloud API", "Convex", "Webhooks & APIs", "Node / TypeScript"],
    },
    faq: {
      title: "Perguntas frequentes",
      items: [
        { q: "Que processos posso automatizar com IA?", a: "Quase qualquer processo repetitivo baseado em regras ou texto: atendimento, qualificação de leads, entrada de dados, geração de relatórios, follow-up comercial ou classificação de e-mails e documentos. No diagnóstico priorizamos os de maior impacto." },
