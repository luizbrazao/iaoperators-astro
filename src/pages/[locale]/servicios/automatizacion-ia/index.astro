      title: "Your team wastes hours on tasks an AI could do alone",
      subtitle: "If this sounds familiar, there's room to automate right now:",
      items: [
        "Data someone copies and pastes between apps every day.",
        "Manual replies and follow-ups that go cold or get lost.",
        "Reports built by hand in spreadsheets.",
        "Critical processes that depend on a single person.",
        "Tools that don't talk to each other (CRM, ERP, WhatsApp, email).",
        "Leads that come in and no one answers in time.",
      ],
    },
    services: {
      title: "What we automate with AI",
      subtitle: "From the repetitive task to the autonomous agent. We build what actually moves the needle.",
      items: [
        { title: "Process automation", body: "Workflows that connect your apps and run repetitive tasks with no manual work: onboarding, validations, notifications and data sync." },
        { title: "AI agents", body: "Agents and multi-agent systems that reason, decide and act on your tools: classify, reply, summarize and escalate when needed." },
        { title: "Custom API integrations", body: "We connect CRM, ERP, WhatsApp, email and any SaaS with an API. API-first architecture, no manual patches." },
        { title: "Chatbots & virtual assistants", body: "WhatsApp and web assistants that support, qualify and book 24/7, integrated with your real operation." },
        { title: "Sales & CRM automation", body: "Automatic capture, follow-up and nurturing: the lead comes in, gets qualified and reaches sales warm." },
        { title: "Reporting & insights", body: "Dashboards and reports that update themselves, with AI summarizing what matters for decisions." },
      ],
    },
    process: {
      badge: "How we work",
      title: "Diagnose, design and build — no hand-offs",
      subtitle: "The same team that understands the process builds the automation. With AI, but no hype.",
      phases: [
        { code: "01", title: "We diagnose", body: "We map the real process, the systems involved and where time is lost. We prioritize by impact vs. effort." },
        { code: "02", title: "We design", body: "We define the workflow architecture: what to automate, with which tools and where humans stay in the loop." },
        { code: "03", title: "We build", body: "We implement with n8n, LangChain, API integrations and custom systems — typed, validated and idempotent." },
        { code: "04", title: "We run & scale", body: "We monitor, measure results and extend automation to new processes on a solid base." },
      ],
    },
    tech: {
      title: "The tech we use",
      subtitle: "LLM-first, API-first and production-ready.",
      items: ["n8n", "LangChain", "OpenAI / Claude", "Supabase", "WhatsApp Cloud API", "Convex", "Webhooks & APIs", "Node / TypeScript"],
    },
    faq: {
      title: "Frequently asked questions",
      items: [
        { q: "What processes can I automate with AI?", a: "Almost any repetitive, rule- or text-based process: customer support, lead qualification, data entry, reporting, sales follow-up or email and document classification. In the diagnosis we prioritize the highest-impact ones." },
        { q: "Do you use no-code tools or custom development?", a: "Whatever the problem needs. We start with n8n and LLM-first flows when they add speed, and drop to custom code (Node/TypeScript, APIs) when we need control, scale or complex logic. We avoid rigid rules if an AI solves it better." },
        { q: "n8n, Make or Zapier?", a: "We mostly work with n8n for its flexibility, self-hosting and cost at scale. We integrate Make or Zapier if they're already in your stack. We choose by architecture, not by trend." },
