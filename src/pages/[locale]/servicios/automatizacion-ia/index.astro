---
export async function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "pt" } },
    { params: { locale: "en" } },
  ];
}

import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getLocale } from "../../../../i18n/ui";
import RelatedCases from "@/components/RelatedCases.astro";

const locale = getLocale((Astro.params.locale as string) ?? Astro.currentLocale ?? "es");

// Conteúdo localizado inline (self-contained). Alvo de keywords por mercado:
// ES: automatización con inteligencia artificial / de procesos / agente de ia / agencia de ia
// PT: automação com inteligência artificial / de processos / agentes de IA
// EN: ai automation agency / ai automation / workflow automation / custom ai solutions / n8n
const CONTENT: Record<string, any> = {
  es: {
    meta: {
      title: "Automatización con IA para empresas | IA Operators",
      description:
        "Automatizamos los procesos de tu empresa con IA: agentes, flujos con n8n e integraciones API a medida. Diagnóstico, diseño e implementación real — sin humo.",
    },
    breadcrumb: "Automatización con IA",
    hero: {
      badge: "Automatización con IA",
      title: "Automatización con inteligencia artificial para tu empresa",
      subtitle:
        "Convertimos procesos manuales y repetitivos en flujos automáticos con IA: agentes, integraciones API y sistemas a medida que trabajan mientras tú creces.",
      cta: "Hablar con un especialista ↗",
    },
    problem: {
      title: "Tu equipo pierde horas en tareas que una IA haría sola",
      subtitle: "Si reconoces esto, hay margen inmediato de automatización:",
      items: [
        "Datos que alguien copia y pega entre aplicaciones cada día.",
        "Respuestas y seguimientos manuales que se enfrían o se pierden.",
        "Informes que se montan a mano en hojas de cálculo.",
        "Procesos críticos que dependen de una sola persona.",
        "Herramientas que no se hablan entre sí (CRM, ERP, WhatsApp, email).",
        "Leads que llegan y nadie atiende a tiempo.",
      ],
    },
    services: {
      title: "Qué automatizamos con IA",
      subtitle:
        "Del proceso repetitivo al agente autónomo. Construimos lo que de verdad mueve la aguja.",
      items: [
        { title: "Automatización de procesos", body: "Flujos que conectan tus apps y ejecutan tareas repetitivas sin intervención: altas, validaciones, notificaciones y sincronización de datos." },
        { title: "Agentes de IA", body: "Agentes y sistemas multi-agente que razonan, deciden y actúan sobre tus herramientas: clasifican, responden, resumen y escalan cuando hace falta." },
        { title: "Integraciones API a medida", body: "Conectamos CRM, ERP, WhatsApp, email y cualquier SaaS con API. Arquitectura API-first, sin parches manuales." },
        { title: "Chatbots y asistentes virtuales", body: "Asistentes en WhatsApp y web que atienden, cualifican y reservan 24/7, integrados con tu operación real." },
        { title: "Automatización de ventas y CRM", body: "Captación, seguimiento y nurturing automáticos: el lead entra, se cualifica y llega caliente al comercial." },
        { title: "Reporting e insights", body: "Dashboards y reportes que se actualizan solos, con la IA resumiendo lo que importa para decidir." },
      ],
    },
    process: {
      badge: "Cómo trabajamos",
      title: "Diagnóstico, diseño y ejecución — sin hand-offs",
      subtitle: "El mismo equipo que entiende el proceso construye la automatización. Con IA, pero sin humo.",
      phases: [
        { code: "01", title: "Diagnosticamos", body: "Mapeamos el proceso real, los sistemas implicados y dónde se pierde tiempo. Priorizamos por impacto vs. esfuerzo." },
        { code: "02", title: "Diseñamos", body: "Definimos la arquitectura del flujo: qué automatizar, con qué herramientas y con qué puntos de control humano." },
        { code: "03", title: "Construimos", body: "Implementamos con n8n, LangChain, integraciones API y sistemas a medida. Con tipado, validación e idempotencia." },
        { code: "04", title: "Operamos y escalamos", body: "Monitorizamos, medimos resultados y ampliamos la automatización a nuevos procesos sobre una base sólida." },
      ],
    },
    tech: {
      title: "La tecnología que usamos",
      subtitle: "LLM-first, API-first y lista para producción.",
      items: ["n8n", "LangChain", "OpenAI / Claude", "Supabase", "WhatsApp Cloud API", "Convex", "Webhooks & APIs", "Node / TypeScript"],
    },
    faq: {
      title: "Preguntas frecuentes",
      items: [
        { q: "¿Qué procesos puedo automatizar con IA?", a: "Casi cualquier proceso repetitivo basado en reglas o en texto: atención al cliente, cualificación de leads, entrada de datos, generación de informes, seguimiento comercial o clasificación de correos y documentos. En el diagnóstico priorizamos los de mayor impacto." },
        { q: "¿Usáis herramientas no-code o desarrollo a medida?", a: "Lo que el problema pida. Empezamos con n8n y flujos LLM-first cuando aportan velocidad, y bajamos a código a medida (Node/TypeScript, APIs) cuando hace falta control, escala o lógica compleja. Evitamos reglas rígidas si una IA lo resuelve mejor." },
        { q: "¿n8n, Make o Zapier?", a: "Trabajamos sobre todo con n8n por su flexibilidad, self-hosting y coste a escala. Integramos Make o Zapier si ya forman parte de tu stack. Elegimos por arquitectura, no por moda." },
        { q: "¿Es seguro para los datos de mi empresa?", a: "Sí. Diseñamos con estado persistente controlado, permisos mínimos y, cuando el caso lo exige, modelos privados o self-hosted para que tus datos no salgan de tu entorno." },
        { q: "¿Cuánto tarda una automatización?", a: "Un primer flujo de valor suele estar en producción en semanas, no meses. Trabajamos por fases: entregamos algo funcionando pronto y ampliamos desde ahí." },
        { q: "¿Cómo empezamos?", a: "Una llamada de 30 minutos para entender tu proceso. Si hay encaje, te proponemos un primer caso de automatización con alcance y resultado claros." },
      ],
    },
    finalCta: {
      title: "¿Qué proceso te gustaría dejar de hacer a mano?",
      subtitle: "Cuéntanos tu caso en una llamada de 30 minutos. Si hay margen de automatización, lo verás enseguida.",
      cta: "Hablar con un especialista",
    },
  },

  pt: {
    meta: {
      title: "Automação com IA para empresas | IA Operators",
      description:
        "Automatizamos os processos da sua empresa com IA: agentes, fluxos com n8n e integrações API sob medida. Diagnóstico, design e implementação real — sem enrolação.",
    },
    breadcrumb: "Automação com IA",
    hero: {
      badge: "Automação com IA",
      title: "Automação com inteligência artificial para a sua empresa",
      subtitle:
        "Transformamos processos manuais e repetitivos em fluxos automáticos com IA: agentes, integrações API e sistemas sob medida que trabalham enquanto você cresce.",
      cta: "Falar com um especialista ↗",
    },
    problem: {
      title: "Sua equipe perde horas em tarefas que uma IA faria sozinha",
      subtitle: "Se você reconhece isto, há margem imediata de automação:",
      items: [
        "Dados que alguém copia e cola entre aplicações todos os dias.",
        "Respostas e follow-ups manuais que esfriam ou se perdem.",
        "Relatórios montados à mão em planilhas.",
