---
// Hub de servicios. Resuelve la deuda de UX del dropdown de diez ítems: el menú
// pasa a ser un panel de dos columnas con enlace aquí, y esta página es el
// destino canónico que lista el catálogo completo.
//
// Fase 1 del reposicionamiento (2026-08-10): el catálogo se reagrupa en tres
// bloques con jerarquía explícita (arquitectura → IA → digitales complementarios)
// y, en ES, la página abre con los tres pilares de la empresa. Ninguna URL
// cambia; lo que cambia es qué se lee primero y con qué peso.

export async function getStaticPaths() {
  return [{ params: { locale: "es" } }, { params: { locale: "pt" } }, { params: { locale: "en" } }];
}

import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocale } from "@/i18n/ui";
import { getServiceGroups, getHubMeta } from "@/data/servicios";
import { getPilares } from "@/data/navegacion";
import { getPagesEditorial } from "@/i18n/editorialCopy";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-servicios.css";

const locale = getLocale((Astro.params.locale as string) ?? Astro.currentLocale ?? "es");
const meta = getHubMeta(locale);
const groups = getServiceGroups(locale);
// Los pilares del idioma: tres en ES (integración · cumplimiento ·
// arquitectura) y dos en EN/PT, donde el silo de cumplimiento no existe. El
// bloque deja de ser ES-only en ago/2026 y la rejilla se ajusta a la cuenta.
const pilares = getPilares(locale);
const PILARES_TITLE: Record<string, string> = {
  es: "Los tres pilares",
  en: "The two pillars",
  pt: "Os dois pilares",
};
const pilaresTitle = PILARES_TITLE[locale] ?? PILARES_TITLE.es;
const copy = getPagesEditorial(locale);
const L = copy.servicios;

const site = Astro.site?.toString() ?? "https://iaoperators.com";

// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".

const siteRoot = site.replace(/\/$/, "");
const pageUrl = new URL(`/${locale}/servicios/`, site).toString();
const contactHref = `/${locale}/contact/`;

const ctaLabel =
  locale === "pt" ? "Falar com um especialista" : locale === "en" ? "Talk to a specialist" : "Hablar con un especialista";
const homeLabel = locale === "pt" ? "Início" : locale === "en" ? "Home" : "Inicio";
const breadcrumbLabel = locale === "pt" ? "Serviços" : locale === "en" ? "Services" : "Servicios";

const allItems = groups.flatMap((g) => g.items);

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: meta.title,
  description: meta.description,
  url: pageUrl,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: allItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      url: new URL(item.href, site).toString(),
    })),
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: homeLabel, item: `${siteRoot}/${locale}/` },
    { "@type": "ListItem", position: 2, name: breadcrumbLabel, item: pageUrl },
  ],
};
---

<BaseLayout
  title={`${meta.title} | IA Operators`}
  description={meta.description}
  jsonLd={[collectionJsonLd, breadcrumbJsonLd]}
  editorial
>
  <Fragment>
    <div class="ed-container">
      <header class="pg-hero">
        <nav class="pf-crumbs ed-eyebrow" aria-label={copy.breadcrumb.label}>
          <ol>
            <li><a href={`/${locale}/`}>{homeLabel}</a></li>
            <li><span aria-current="page">{breadcrumbLabel}</span></li>
          </ol>
        </nav>
        <h1>{meta.h1}</h1>
        <div class="pg-hero-bottom">
          <p class="ed-eyebrow">{breadcrumbLabel} · {allItems.length}</p>
          <p class="pg-lead">{meta.intro}</p>
        </div>
      </header>

      {pilares.length > 0 && (
        <section class="pg-section" aria-labelledby="sv-pilares">
          <h2 id="sv-pilares" class="ed-eyebrow sv-kicker">{pilaresTitle}</h2>
          <ul class="pg-doors sv-doors">
            {pilares.map((pilar, i) => (
              <li>
                <a href={pilar.href}>
                  <span class="ed-eyebrow">{String(i + 1).padStart(2, "0")}</span>
                  <h3>{pilar.label}</h3>
                  <p>{pilar.tagline}</p>
                  <span class="ed-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {groups.map((group, gi) => (
        <section class:list={["pg-section", { "sv-last": gi === groups.length - 1 }]} aria-labelledby={`sv-grupo-${gi + 1}`}>
          <div class="ed-section-intro">
            <p class="ed-eyebrow">{group.items.length} {L.count}</p>
            <div>
              <h2 id={`sv-grupo-${gi + 1}`}>{group.title}</h2>
              {group.intro && <p class="pg-lead-muted">{group.intro}</p>}
            </div>
          </div>
          <div class="pg-offers">
            {group.items.map((item) => (
              <a class="ed-offer" href={item.href}>
                <span class="ed-eyebrow">{item.num}</span>
                <h3>{item.label}</h3>
                <p>{item.desc}</p>
                <span class="ed-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <section class="ed-closing" aria-label={L.contactAria}>
      <div class="ed-container">
        <p class="ed-eyebrow">{L.next}</p>
        <p class="pg-closing-statement">{L.hubClosing}</p>
        <a class="ed-button" href={contactHref}>{ctaLabel}<span class="ed-arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>
  </Fragment>
</BaseLayout>
