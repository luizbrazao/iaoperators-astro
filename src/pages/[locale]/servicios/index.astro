---
// Hub de servicios. Resuelve la deuda de UX del dropdown de diez ítems: el menú
// pasa a ser un panel de dos columnas con enlace aquí, y esta página es el
// destino canónico que lista el catálogo completo.
//
// Fase 1 del reposicionamiento (2026-08-10): el catálogo se reagrupa en tres
// bloques con jerarquía explícita (arquitectura → IA → digitales complementarios)
// y, en ES, la página abre con los tres pilares de la empresa. Ninguna URL
// cambia; lo que cambia es qué se lee primero y con qué peso.

export async function getStaticPaths() {
  return [{ params: { locale: "es" } }, { params: { locale: "pt" } }, { params: { locale: "en" } }];
}

import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocale } from "@/i18n/ui";
import { getServiceGroups, getHubMeta } from "@/data/servicios";
import { getPilaresEs } from "@/data/navegacion";

const locale = getLocale((Astro.params.locale as string) ?? Astro.currentLocale ?? "es");
const meta = getHubMeta(locale);
const groups = getServiceGroups(locale);
const isEs = locale === "es";
const pilares = isEs ? getPilaresEs() : [];

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL(`/${locale}/servicios/`, site).toString();
const contactHref = `/${locale}/contact/`;

const ctaLabel =
  locale === "pt" ? "Falar com um especialista" : locale === "en" ? "Talk to a specialist" : "Hablar con un especialista";
const homeLabel = locale === "pt" ? "Início" : locale === "en" ? "Home" : "Inicio";
const breadcrumbLabel = locale === "pt" ? "Serviços" : locale === "en" ? "Services" : "Servicios";

const allItems = groups.flatMap((g) => g.items);

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: meta.title,
  description: meta.description,
  url: pageUrl,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: allItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      url: new URL(item.href, site).toString(),
    })),
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: homeLabel, item: `${site}/${locale}/` },
    { "@type": "ListItem", position: 2, name: breadcrumbLabel, item: pageUrl },
  ],
};
---

<BaseLayout
  title={`${meta.title} | IA Operators`}
  description={meta.description}
  jsonLd={[collectionJsonLd, breadcrumbJsonLd]}
>
  <div class="bg-transparent text-white">
    <section class="px-4 pt-28 pb-16">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-6xl font-medium tracking-tight leading-tight mb-6">
          {meta.h1}
        </h1>
        <p class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto">{meta.intro}</p>
      </div>
    </section>

    {isEs && (
      <section class="px-4 pb-16">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-orange-400 mb-6">
            Los tres pilares
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            {pilares.map((pilar) => (
              <a
                href={pilar.href}
                class="group bg-[#0a0a0a] border border-orange-500/20 rounded-3xl p-7 hover:border-orange-500/50 transition-all duration-300 flex flex-col"
              >
                <h3 class="text-xl font-semibold text-white mb-2 group-hover:text-orange-400 transition-colors">
                  {pilar.label}
                </h3>
                <p class="text-gray-400 text-sm leading-relaxed flex-1">{pilar.tagline}</p>
                <span class="text-orange-400 text-sm mt-4 group-hover:translate-x-1 transition-transform inline-block">
                  →
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {groups.map((group) => (
      <section class="px-4 pb-16">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-orange-400 mb-2">
            {group.title}
          </h2>
          <p class="text-gray-400 text-sm mb-6 max-w-2xl">{group.intro}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {group.items.map((item) => (
              <a
                href={item.href}
                class="group bg-[#0a0a0a] border border-white/5 rounded-3xl p-6 hover:border-orange-500/30 transition-all duration-300 flex flex-col"
              >
                <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-orange-500/10 text-orange-400 font-bold text-xs mb-4">
                  {item.num}
                </span>
                <h3 class="text-lg font-semibold text-white mb-2 group-hover:text-orange-400 transition-colors">
                  {item.label}
                </h3>
                <p class="text-gray-400 text-sm leading-relaxed flex-1">{item.desc}</p>
                <span class="text-orange-400 text-sm mt-4 opacity-0 group-hover:opacity-100 transition-opacity">
                  →
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section class="px-4 py-20">
      <div class="max-w-3xl mx-auto text-center">
        <a
          href={contactHref}
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-orange-500 text-black font-medium text-lg hover:bg-orange-400 hover:scale-105 transition-all duration-300"
        >
          {ctaLabel} ↗
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
