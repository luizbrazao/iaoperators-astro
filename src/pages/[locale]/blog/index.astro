---
export async function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "pt" } },
    { params: { locale: "en" } },
  ];
}

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocale, ui } from "../../../i18n/ui";
import { fetchBlogPosts } from "../../../lib/blog";
import { SITE, ORG_REF, WEBSITE_REF } from "@/data/identidad";
import { getPagesEditorial } from "@/i18n/editorialCopy";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-blog.css";

const locale = getLocale((Astro.params.locale as string) ?? Astro.currentLocale ?? "es");

const dict =
  (ui as any)?.[locale] ??
  (ui as any)?.es ??
  (ui as any)?.en ??
  (ui as any)?.pt ??
  {};

const blogDict = (dict as any)?.blog ?? (dict as any)?.home?.blog ?? {};
const categoriesDict = (dict as any)?.categories ?? {};

const withLocale = (path: string) => `/${locale}/${path}`.replace(/\/+$/, "/");

// ===== Categorias (igual ao projeto antigo)
const CATEGORY_KEYS = ["all", "tools", "lawyers", "architects", "accounting", "restaurants", "beauty-salons", "privacy", "compliance", "others"] as const;

function normalizeCategoryId(raw?: string | null) {
  const v = (raw ?? "").toLowerCase().trim();

  if (CATEGORY_KEYS.includes(v as (typeof CATEGORY_KEYS)[number])) return v;
  if (v === "all" || v === "todos") return "all";
  if (v === "herramientas" || v === "tools" || v === "ferramentas") return "tools";
  if (v === "ia para abogados" || v === "ai for lawyers" || v === "ia para advogados") return "lawyers";
  if (v === "ia para arquitectos" || v === "ai for architects" || v === "ia para arquitetos") return "architects";
  if (v === "ia para contabilidad" || v === "ai for accounting" || v === "ia para contabilidade") return "accounting";
  if (v === "ia para restaurantes" || v === "ai for restaurants") return "restaurants";
  if (v === "ia para salones de belleza" || v === "ia para salões de beleza" || v === "ai for beauty salons") return "beauty-salons";
  if (v === "privacidad y gobernanza de ia" || v === "privacidade e governança de ia" || v === "ai privacy & governance") return "privacy";
  if (v === "cumplimiento normativo" || v === "compliance normativo" || v === "regulatory compliance") return "compliance";
  if (v === "otros" || v === "others" || v === "outros") return "others";

  return "others";
}

const posts = (await fetchBlogPosts(locale)) ?? [];
const preparedPosts = posts.map((p: any) => ({
  ...p,
  __catId: normalizeCategoryId(p.category),
}));

// textos com fallback
const t = {
  badge: blogDict?.badge ?? "Blog",
  title: blogDict?.title ?? "Blog",
  description: blogDict?.description ?? "Artigos e guias práticos.",
  readMore: blogDict?.readMore ?? "Read more",
  empty: blogDict?.empty ?? "Nenhum post encontrado.",
  viewAll: blogDict?.viewAll ?? "Ver todos",
  // Párrafo visible bajo el H1. Se separa de `description` porque esa cadena
  // alimenta la meta description, que necesita ~150 caracteres, mientras el
  // párrafo necesita espacio para decir algo. EN y PT no definen `intro` y
  // caen en `description`, exactamente como antes de este cambio.
  intro: blogDict?.intro ?? blogDict?.description ?? "Artigos e guias práticos.",
};

// ===== JSON-LD (solo ES) =====
//
// El índice del blog era el único hub del sitio sin datos estructurados,
// mientras /es/servicios/ y /es/cumplimiento/ ya emiten CollectionPage.
// Aquí el tipo correcto no es CollectionPage sino `Blog`: los 57 artículos ya
// declaran `isPartOf: { "@type": "Blog", url: ".../es/blog/" }`, así que esta
// URL solo estaba afirmando ser una página cualquiera mientras cada post decía
// pertenecer a un Blog que no se declaraba en ningún sitio. El nodo cierra ese
// hueco y reutiliza el nombre exacto que emiten los posts.
//
// No se listan los 57 artículos: ninguna página del proyecto enumera su
// colección completa en el schema, y `blogPost` con 57 entradas sería inventar
// un patrón nuevo para repetir lo que ya está en el HTML y en el sitemap.
//
// ES-only a propósito: esta tarea reposiciona /es/blog/. EN y PT reciben
// `undefined` y su HTML no cambia.
const blogJsonLd =
  locale === "es"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "Blog",
          "@id": `${SITE}/es/blog/#blog`,
          name: "Blog de IA Operators",
          url: `${SITE}/es/blog/`,
          description: t.description,
          inLanguage: "es",
          publisher: ORG_REF,
          isPartOf: WEBSITE_REF,
        },
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/es/` },
            { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/es/blog/` },
          ],
        },
      ]
    : undefined;

// <title> del SERP: distinto del H1 "Blog" (evita duplicado H1=title) y con
// longitud/keywords óptimas (evita "título demasiado corto").
const BLOG_SEO_TITLE: Record<string, string> = {
  es: "Blog de IA, automatización y n8n para empresas | IA Operators",
  en: "AI, automation & n8n blog for businesses | IA Operators",
  pt: "Blog de IA, automação e n8n para empresas | IA Operators",
};
const pageTitle = BLOG_SEO_TITLE[locale] ?? BLOG_SEO_TITLE.es;

const categoryLabel = (key: string) =>
  ((categoriesDict as any)?.[key]) ||
  ({
    all: "All",
    tools: "Tools",
    lawyers: "Lawyers",
    architects: "Architects",
    accounting: "Accounting",
    restaurants: "Restaurants",
    "beauty-salons": "Beauty Salons",
    others: "Others",
  } as any)[key] ||
  key;

// ===== Diseño editorial (ES desde oct/2026, EN/PT desde el 08/oct/2026) =====
// Mismos textos, enlaces y JSON-LD. El primer artículo (el más reciente) va
// destacado con su imagen; el resto, en lista tipográfica. El filtro solo
// muestra categorías con artículos, con su recuento.
const crumbs = getPagesEditorial(locale).breadcrumb;
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString(locale, { year: "numeric", month: "short", day: "numeric" });
const catCounts = preparedPosts.reduce((acc: Record<string, number>, p: any) => {
  acc[p.__catId] = (acc[p.__catId] ?? 0) + 1;
  return acc;
}, {});
const filterKeys = CATEGORY_KEYS.filter((k) => k === "all" || (catCounts[k] ?? 0) > 0);
const [featured, ...restPosts] = preparedPosts;
---

<BaseLayout title={pageTitle} description={t.description} jsonLd={blogJsonLd} editorial>
  <div class="ed-container bl">
    <header class="pg-hero">
      <nav class="pf-crumbs ed-eyebrow" aria-label={crumbs.label}>
        <ol>
          <li><a href={`/${locale}/`}>{crumbs.home}</a></li>
          <li><span aria-current="page">{t.badge}</span></li>
        </ol>
      </nav>
      <h1>{t.title}</h1>
      <div class="pg-hero-bottom">
        <p class="ed-eyebrow">{t.badge} · {preparedPosts.length}</p>
        <p class="pg-lead">{t.intro}</p>
      </div>
    </header>

    {preparedPosts.length > 0 ? (
      <Fragment>
        <div class="bl-filter" id="blogCategoryBar" role="group" aria-label={categoryLabel("all")}>
          {filterKeys.map((catId) => (
            <button type="button" class="bl-chip" data-cat={catId} aria-pressed={catId === "all" ? "true" : "false"}>
              {categoryLabel(catId)}
              <span class="bl-count">{catId === "all" ? preparedPosts.length : catCounts[catId]}</span>
            </button>
          ))}
        </div>

        <div class="bl-posts" id="blogGrid">
          {featured && (
            <a href={withLocale(`blog/${featured.slug}/`)} class:list={["bl-feature", { "bl-feature-solo": !featured.imageUrl }]} data-cat={featured.__catId}>
              <div class="bl-feature-copy">
                <p class="ed-eyebrow">{categoryLabel(featured.__catId)} · <time datetime={featured.date}>{fmtDate(featured.date)}</time></p>
                <h2>{featured.title}</h2>
                <p class="bl-desc">{featured.description}</p>
                <span class="ed-underlined">{t.readMore}</span>
              </div>
              {featured.imageUrl && (
                <div class="bl-feature-img">
                  <img src={featured.imageUrl} alt={featured.imageAlt ?? featured.title} loading="eager" decoding="async" />
                </div>
              )}
            </a>
          )}
          <ol class="bl-list">
            {restPosts.map((post: any) => (
              <li data-cat={post.__catId}>
                <a href={withLocale(`blog/${post.slug}/`)} class="bl-item">
                  <time class="ed-eyebrow" datetime={post.date}>{fmtDate(post.date)}</time>
                  <div class="bl-item-copy">
                    <h2>{post.title}</h2>
                    <p class="bl-desc">{post.description}</p>
                  </div>
                  <span class="ed-eyebrow bl-cat">{categoryLabel(post.__catId)}</span>
                  <span class="ed-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>
        </div>

        <div class="bl-empty" id="blogEmpty" hidden>
          <p>{t.empty}</p>
          <button type="button" class="ed-underlined" id="blogViewAll">{t.viewAll}</button>
        </div>
      </Fragment>
    ) : (
      <p class="bl-empty">{t.empty}</p>
    )}

    <script is:inline>
      (function () {
        var bar = document.getElementById("blogCategoryBar");
        var grid = document.getElementById("blogGrid");
        var empty = document.getElementById("blogEmpty");
        var viewAll = document.getElementById("blogViewAll");
        if (!bar || !grid) return;
        var buttons = Array.prototype.slice.call(bar.querySelectorAll("button[data-cat]"));
        var items = Array.prototype.slice.call(grid.querySelectorAll("[data-cat]"));
        function apply(cat) {
          buttons.forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.cat === cat ? "true" : "false"); });
          var visible = 0;
          items.forEach(function (el) {
            var show = cat === "all" || (el.dataset.cat || "others") === cat;
            el.hidden = !show;
            if (show) visible++;
          });
          grid.classList.toggle("is-filtered", cat !== "all");
          if (empty) empty.hidden = visible !== 0;
        }
        buttons.forEach(function (b) { b.addEventListener("click", function () { apply(b.dataset.cat || "all"); }); });
        if (viewAll) viewAll.addEventListener("click", function () { apply("all"); });
      })();
    </script>
  </div>
</BaseLayout>
