---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ui, getLocale, type Locale } from "../../../i18n/ui";
import { fetchBlogEntry } from "../../../lib/blog";

export async function getStaticPaths() {
  const locales: Locale[] = ["es", "pt", "en"];
  const paths: { params: { locale: string; slug: string } }[] = [];

  for (const loc of locales) {
    const entries = await getCollection("blog", ({ id, data }) => {
      return id.startsWith(`${loc}/`) && !data.draft;
    });

    for (const entry of entries) {
      const slug = entry.id
        .replace(`${loc}/`, "")
        .replace(/\.(md|mdx)$/, "");
      paths.push({ params: { locale: loc, slug } });
    }
  }

  return paths;
}

// ─── Data fetching ─────────────────────────────────────────────────────────

const { locale: localeParam, slug } = Astro.params;
const locale = getLocale(localeParam as string);
const defaultLocale: Locale = "es";

const entry = await fetchBlogEntry(slug as string, locale);

if (!entry) {
  // Fail loudly at build time — this should never happen if getStaticPaths is correct
  throw new Error(
    `[blog] Content entry not found: ${locale}/${slug}\n` +
      `Make sure the file src/content/blog/${locale}/${slug}.md exists and is not a draft.`,
  );
}

const { Content } = await render(entry);

// ─── Related posts (mismo locale, prioriza misma categoría) ──────────────────
const relatedPool = await getCollection("blog", ({ id, data }) => id.startsWith(`${locale}/`) && !data.draft);
const relSlug = (p) => p.id.replace(`${locale}/`, "").replace(/\.(md|mdx)$/, "");
const relSame = relatedPool.filter((p) => p.id !== entry.id && p.data.category === entry.data.category);
const relOther = relatedPool.filter((p) => p.id !== entry.id && p.data.category !== entry.data.category);
const relatedPosts = [...relSame, ...relOther].slice(0, 3).map((p) => ({
  title: p.data.title,
  href: `/${locale}/blog/${relSlug(p)}/`,
  description: p.data.description,
}));
const relatedLabel = locale === "en" ? "Related posts" : "Posts relacionados";


// ─── SEO / Meta ────────────────────────────────────────────────────────────

const dict = ui[locale];
const blogPostDict = (dict as any)?.blogPost ?? {};
const homeLabelByLocale: Record<Locale, string> = {
  es: "Inicio",
  pt: "Início",
  en: "Home",
};
const homeLabel = homeLabelByLocale[locale] ?? "Home";
const blogLabel = "Blog";

const site = (Astro.site?.toString() ?? "https://iaoperators.com").replace(/\/$/, "");
const canonicalPath = Astro.url.pathname.replace(/\/?$/, "/");
const canonicalUrl = new URL(canonicalPath, site).toString();

function entrySlugByLocale(id: string, lang: Locale): string {
  return id.replace(`${lang}/`, "").replace(/\.(md|mdx)$/, "");
}

function entryClusterKey(e: any, lang: Locale): string {
  return e.data.translationKey ?? `slug:${entrySlugByLocale(e.id, lang)}`;
}

const currentClusterKey = entryClusterKey(entry, locale);
const localeAlternates: Array<{ lang: Locale; href: string }> = [];

for (const lang of ["es", "pt", "en"] as const) {
  const entries = await getCollection("blog", ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft);
  const matched = entries.find((candidate) => entryClusterKey(candidate, lang) === currentClusterKey);
  if (!matched) continue;
  const localizedSlug = entrySlugByLocale(matched.id, lang);
  const href = new URL(`/${lang}/blog/${localizedSlug}/`, site).toString();
  localeAlternates.push({ lang, href });
}

const canonicalFromAlternates =
  localeAlternates.find((item) => item.lang === locale)?.href ?? canonicalUrl;
const xDefaultUrl =
  localeAlternates.find((item) => item.lang === defaultLocale)?.href ?? canonicalFromAlternates;

const title = entry.data.title;
// <title> del SERP: usa seoTitle (corto) si existe; si no, el título del post.
// Sin sufijo de marca — la marca ya va en og:site_name — para no truncar en Google.
const pageTitle = entry.data.seoTitle ?? title;
const description = entry.data.description;
const articleKeywords = entry.data.tags ?? [];
const wordCount = entry.body ? entry.body.trim().split(/\s+/).filter(Boolean).length : undefined;
const updatedAt = entry.data.updatedAt;

// ─── Category labels ─────────────────────────────────────────────────────────
const CATEGORY_LABELS: Record<string, Record<string, string>> = {
  es: { tools: "Herramientas", lawyers: "IA para abogados", architects: "IA para arquitectos", accounting: "IA para contabilidad", restaurants: "IA para restaurantes", "beauty-salons": "IA para salones", privacy: "Privacidad y gobernanza de IA", others: "Blog" },
  pt: { tools: "Ferramentas", lawyers: "IA para advogados", architects: "IA para arquitetos", accounting: "IA para contabilidade", restaurants: "IA para restaurantes", "beauty-salons": "IA para salões", privacy: "Privacidade e governança de IA", others: "Blog" },
  en: { tools: "Tools", lawyers: "AI for Lawyers", architects: "AI for Architects", accounting: "AI for Accounting", restaurants: "AI for Restaurants", "beauty-salons": "AI for Beauty", privacy: "AI Privacy & Governance", others: "Blog" },
};
const categoryLabel = CATEGORY_LABELS[locale]?.[entry.data.category] ?? entry.data.category;

// Reading time from raw markdown body
const readMinutes = Math.max(3, Math.ceil((entry.body?.length ?? 0) / 1500));
const readingTimeLabel = (blogPostDict?.readingTime ?? "{{minutes}} min").replace(
  "{{minutes}}",
  String(readMinutes),
);

// Date formatting
const parsedDate = entry.data.date;
const formattedDate = parsedDate.toLocaleDateString(locale, {
  year: "numeric",
  month: "long",
  day: "numeric",
});

function toIsoWithOffset(date: Date, offsetMinutes: number): string {
  const adjusted = new Date(date.getTime() + offsetMinutes * 60000);
  const iso = adjusted.toISOString();
  const sign = offsetMinutes >= 0 ? "+" : "-";
  const abs = Math.abs(offsetMinutes);
  const hh = String(Math.floor(abs / 60)).padStart(2, "0");
  const mm = String(abs % 60).padStart(2, "0");
  return iso.replace("Z", `${sign}${hh}:${mm}`);
}

const ogPublishedTime = toIsoWithOffset(parsedDate, 60);
const ogModifiedTime = toIsoWithOffset(parsedDate, 60);

// ─── Structured data (JSON-LD) ─────────────────────────────────────────────

const faqItems = entry.data.faq ?? [];

const isPersonAuthor = entry.data.author && entry.data.author !== "IA Operators";
const authorSchema = isPersonAuthor
  ? { "@type": "Person", name: entry.data.author, jobTitle: entry.data.authorTitle ?? "Fundador, IA Operators", url: entry.data.authorUrl ?? site, ...(entry.data.authorSameAs?.length ? { sameAs: entry.data.authorSameAs } : {}) }
  : { "@type": "Organization", name: "IA Operators", url: site };

const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: parsedDate.toISOString(),
  dateModified: (updatedAt ?? parsedDate).toISOString(),
  inLanguage: locale,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalFromAlternates,
  },
  image: entry.data.imageSchema?.length
    ? entry.data.imageSchema.map((u) => new URL(u, site).toString())
    : entry.data.image
      ? [new URL(entry.data.image, site).toString()]
      : undefined,
  articleSection: entry.data.articleSection,
  keywords: articleKeywords.length ? articleKeywords.join(", ") : undefined,
  wordCount,
  author: authorSchema,
  publisher: {
    "@type": "Organization",
    name: "IA Operators",
    url: site,
    logo: {
      "@type": "ImageObject",
      url: `${site}/favicon-32x32.png`,
    },
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: homeLabel, item: `${site}/${locale}/` },
    { "@type": "ListItem", position: 2, name: blogLabel, item: `${site}/${locale}/blog/` },
    { "@type": "ListItem", position: 3, name: title, item: canonicalFromAlternates },
  ],
};

const faqJsonLd =
  faqItems.length > 0 && entry.data.faqSchema !== false
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map((item) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
      }
    : null;

const jsonLd = [blogPostingJsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];

// Share URLs
const shareLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalFromAlternates)}`;
const shareX = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalFromAlternates)}`;
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonicalUrl={canonicalFromAlternates}
  alternates={localeAlternates}
  xDefaultUrl={xDefaultUrl}
  jsonLd={jsonLd}
  ogImage={entry.data.image ?? `/og/${locale}/${slug}.png`}
  ogImageAlt={entry.data.imageAlt ?? title}
  ogType="article"
  ogPublishedTime={ogPublishedTime}
  ogModifiedTime={ogModifiedTime}
>
  <!-- Back button (fixed desktop) -->
  <div class="fixed top-24 left-4 z-40 hidden xl:block">
    <a
      href={`/${locale}/blog/`}
      class="flex items-center justify-center w-10 h-10 rounded-full bg-white/5 border border-white/10 text-gray-400 hover:text-white hover:bg-white/10 transition-all hover:-translate-x-1"
      aria-label={blogPostDict?.back ?? "Volver al Blog"}
      title={blogPostDict?.back ?? "Volver al Blog"}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="opacity-90">
        <path
          d="M15 18l-6-6 6-6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
  </div>

  <div class="pt-32 pb-20 px-4">
    <article class="max-w-4xl mx-auto" itemscope itemtype="https://schema.org/BlogPosting">

      <!-- Visible breadcrumb nav -->
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-gray-400">
        <ol class="flex flex-wrap items-center gap-1">
          <li><a href={`/${locale}/`} class="hover:text-orange-400 transition-colors">{homeLabel}</a></li>
          <li class="text-gray-700">/</li>
          <li><a href={`/${locale}/blog/`} class="hover:text-orange-400 transition-colors">{blogLabel}</a></li>
          <li class="text-gray-700">/</li>
          <li class="text-gray-400 truncate max-w-[200px]" aria-current="page">{title}</li>
        </ol>
      </nav>

      <!-- Article header -->
      <header class="text-center mb-12">
        <div class="flex justify-center mb-6">
          <span
            class="px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-bold uppercase tracking-wider"
          >
            {categoryLabel}
          </span>
        </div>

        <h1
          itemprop="headline"
          class="text-3xl md:text-5xl lg:text-6xl font-bold leading-tight mb-8 text-white"
        >
          {title}
        </h1>

        <div
          class="flex flex-wrap items-center justify-center gap-6 text-sm text-gray-400 border-b border-white/10 pb-8 mx-auto max-w-2xl"
        >
          <!-- Date -->
          <div class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-orange-500">
              <path
                d="M8 2v3M16 2v3M3 9h18M5 5h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <time itemprop="datePublished" datetime={parsedDate.toISOString()}>{formattedDate}</time>
          </div>

          {updatedAt && (
            <div class="flex items-center gap-2 text-orange-400/80">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-orange-400">
                <path d="M23 4v6h-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M1 20v-6h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <time itemprop="dateModified" datetime={updatedAt.toISOString()}>
                {blogPostDict?.updatedLabel ?? "Actualizado"}: {updatedAt.toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric" })}
              </time>
            </div>
          )}

          <!-- Reading time -->
          <div class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-orange-500">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" />
              <path
                d="M12 6v6l4 2"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
            <span>{readingTimeLabel}</span>
          </div>

          <!-- Author -->
          <div class="flex items-center gap-2" itemprop="author" itemscope itemtype="https://schema.org/Organization">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-orange-500">
              <path
                d="M20 21a8 8 0 10-16 0"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
              <path
                d="M12 13a4 4 0 100-8 4 4 0 000 8z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
            <span itemprop="name">{entry.data.author ?? "IA Operators"}</span>
          </div>
        </div>
      </header>

      <!-- Cover image -->
      {entry.data.image && (
        <div class="mb-12 relative rounded-3xl overflow-hidden border border-white/10 shadow-2xl aspect-video">
          <img
            src={entry.data.image}
            alt={entry.data.imageAlt ?? title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
            itemprop="image"
          />
          <div class="absolute inset-0 bg-linear-to-t from-[#050505] via-transparent to-transparent opacity-60" />
        </div>
      )}

      <!-- Article body (Markdown rendered) -->
      <div
        class="px-2 md:px-8"
        itemprop="articleBody"
      >
        <div
          class="
            prose prose-invert prose-lg max-w-none
            prose-headings:text-white prose-headings:font-bold prose-headings:leading-tight
            prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:border-l-4 prose-h2:border-orange-500 prose-h2:pl-4
            prose-h3:text-2xl prose-h3:text-orange-100/90 prose-h3:mt-8
            prose-p:text-gray-300 prose-p:leading-relaxed prose-p:mb-6
            prose-a:text-orange-500 prose-a:font-semibold prose-a:no-underline
            hover:prose-a:text-orange-400 hover:prose-a:underline
            prose-ul:text-gray-300 prose-li:marker:text-orange-500
            prose-strong:text-white prose-strong:font-bold
            prose-blockquote:border-l-orange-500 prose-blockquote:bg-white/5 prose-blockquote:py-2 prose-blockquote:px-6
            prose-blockquote:rounded-r-lg prose-blockquote:text-gray-200 prose-blockquote:italic
            prose-img:rounded-2xl prose-img:shadow-xl prose-img:border prose-img:border-white/10
            prose-table:text-gray-300 prose-th:text-white prose-th:border-white/20 prose-td:border-white/10
            prose-code:text-orange-300 prose-code:bg-white/5 prose-code:rounded prose-code:px-1
          "
        >
          <Content />
        </div>
      </div>

      <!-- FAQ section (typed frontmatter array) -->
      {faqItems.length > 0 && (
        <div class="px-2 md:px-8 mt-16">
          <h2 class="text-2xl font-bold text-white mb-8 border-l-4 border-orange-500 pl-4">
            {blogPostDict?.faqTitle ?? "Preguntas frecuentes"}
          </h2>
          <div class="space-y-4">
            {faqItems.map((item) => (
              <details class="group border border-white/10 rounded-2xl overflow-hidden bg-white/[0.02]">
                <summary class="flex items-center justify-between px-6 py-4 cursor-pointer text-white font-medium hover:bg-white/5 transition-colors list-none">
                  <span>{item.q}</span>
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    class="shrink-0 ml-4 text-orange-500 transition-transform group-open:rotate-180"
                  >
                    <path
                      d="M6 9l6 6 6-6"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </summary>
                <div class="px-6 pb-5 pt-2 text-gray-300 text-sm leading-relaxed border-t border-white/10">
                  {item.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      )}

      <!-- CTA block -->
      <div class="mx-2 md:mx-8 mt-16 rounded-3xl border border-orange-500/20 bg-gradient-to-br from-orange-500/8 to-transparent p-8 md:p-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-orange-400 mb-3">
          {locale === "pt" ? "Próximos passos" : locale === "en" ? "Next steps" : "Próximos pasos"}
        </p>
        <h3 class="text-2xl md:text-3xl font-bold text-white mb-3 leading-tight">
          {locale === "pt"
            ? "Pronto para agir?"
            : locale === "en"
            ? "Ready to act?"
            : "¿Listo para actuar?"}
        </h3>
        <p class="text-gray-400 mb-6 max-w-xl">
          {locale === "pt"
            ? "Diagnóstico, priorização e execução — sem hand-offs. O mesmo time que mapeia o problema constrói a solução."
            : locale === "en"
            ? "Diagnosis, prioritization and execution — no hand-offs. The same team that maps the problem builds the solution."
            : "Diagnóstico, priorización y ejecución — sin hand-offs. El mismo equipo que mapea el problema construye la solución."}
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={`/${locale}/contact/`}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-orange-500 text-black font-semibold text-sm hover:bg-orange-400 transition-all hover:scale-105"
          >
            {locale === "pt" ? "Falar com um especialista" : locale === "en" ? "Talk to a specialist" : "Hablar con un especialista"} ↗
          </a>
          <a
            href={`/${locale}/auditoria-de-sistemas/`}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/5 border border-white/10 text-gray-300 font-medium text-sm hover:border-orange-500/30 hover:text-white transition-all"
          >
            Radiografía Digital
          </a>
          <a
            href={`/${locale}/roadmap-tecnologico/`}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/5 border border-white/10 text-gray-300 font-medium text-sm hover:border-orange-500/30 hover:text-white transition-all"
          >
            Roadmap Tecnológico
          </a>
          <a
            href={`/${locale}/implementacion/`}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/5 border border-white/10 text-gray-300 font-medium text-sm hover:border-orange-500/30 hover:text-white transition-all"
          >
            {locale === "pt" ? "Implementação" : locale === "en" ? "Implementation" : "Implementación"}
          </a>
        </div>
      </div>

      <!-- Author bio -->
      <div class="mx-2 md:mx-8 mt-12 flex items-start gap-5 p-6 rounded-2xl bg-white/[0.03] border border-white/5">
        <img
          src="https://framerusercontent.com/images/F57rOWtJqaFD6Xm3xWmqp6bM.png"
          alt="Luiz Brazão"
          width="64"
          height="64"
          class="w-14 h-14 rounded-full object-cover shrink-0"
          loading="lazy"
          decoding="async"
        />
        <div>
          <p class="font-semibold text-white text-sm mb-0.5">
            {entry.data.author ?? "Luiz Brazão"}
          </p>
          <p class="text-orange-400 text-xs mb-2">
            {locale === "pt" ? "Fundador, IA Operators" : locale === "en" ? "Founder, IA Operators" : "Fundador, IA Operators"}
          </p>
          <p class="text-gray-400 text-sm leading-relaxed">
            {locale === "pt"
              ? "Anos liderando equipes em empresas de médio e grande porte. Criou a IA Operators para diagnosticar ecossistemas tecnológicos, priorizar o que move o ponteiro e construir soluções — sem hand-offs entre quem pensa e quem executa."
              : locale === "en"
              ? "Years leading teams across mid-size and large companies. Founded IA Operators to diagnose technology ecosystems, prioritize what moves the needle, and build solutions — no hand-offs between those who think and those who build."
              : "Años liderando equipos en empresas medianas y grandes. Creó IA Operators para diagnosticar ecosistemas tecnológicos, priorizar lo que mueve la aguja y construir soluciones — sin hand-offs entre quien piensa y quien ejecuta."}
          </p>
          <a
            href="https://www.linkedin.com/in/ferbrazao/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 mt-3 text-xs text-orange-400 hover:text-orange-300 transition-colors"
          >
            LinkedIn ↗
          </a>
        </div>
      </div>

      <!-- Share footer -->
      <div class="mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-6 px-8">
        <div class="text-gray-400 text-sm">{blogPostDict?.shareTitle ?? "Compartilhar"}</div>

        <div class="flex gap-4">
          <!-- Copy link -->
          <button
            type="button"
            class="p-3 rounded-full bg-[#151515] hover:bg-orange-500 hover:text-white transition-all text-gray-400"
            title={blogPostDict?.copyLink ?? "Copiar link"}
            data-copy-link={canonicalFromAlternates}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path
                d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M16 6l-4-4-4 4"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M12 2v14"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <!-- LinkedIn -->
          <a
            href={shareLinkedIn}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 rounded-full bg-[#151515] hover:bg-[#0077b5] hover:text-white transition-all text-gray-400"
            title={blogPostDict?.shareLinkedIn ?? "Compartilhar no LinkedIn"}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path
                d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4V9h4v2a4 4 0 014-3z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path d="M2 9h4v12H2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M4 4a2 2 0 110 4 2 2 0 010-4z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>

          <!-- X / Twitter -->
          <a
            href={shareX}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 rounded-full bg-[#151515] hover:bg-black hover:text-white transition-all text-gray-400 border border-transparent hover:border-white/20"
            title={blogPostDict?.shareTwitter ?? "Compartilhar no X/Twitter"}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </a>
        </div>
      </div>
      {relatedPosts.length > 0 && (
        <aside class="mt-16 pt-10 border-t border-white/10">
          <h2 class="text-2xl font-bold mb-6 text-white">{relatedLabel}</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPosts.map((r) => (
              <a href={r.href} class="block bg-[#0a0a0a] border border-white/5 rounded-2xl p-5 hover:border-orange-500/30 transition-all duration-300">
                <h3 class="text-base font-semibold text-white mb-2 leading-snug">{r.title}</h3>
                <p class="text-gray-400 text-sm leading-relaxed">{r.description}</p>
              </a>
            ))}
          </div>
        </aside>
      )}

    </article>
  </div>

  <script is:inline>
    (function () {
      const btn = document.querySelector("button[data-copy-link]");
      if (!btn) return;
      btn.addEventListener("click", async () => {
        const url = btn.getAttribute("data-copy-link") || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          btn.classList.add("text-white");
          setTimeout(() => btn.classList.remove("text-white"), 900);
        } catch (_) {
          const input = document.createElement("input");
          input.value = url;
          document.body.appendChild(input);
          input.select();
          document.execCommand("copy");
          document.body.removeChild(input);
        }
      });
    })();
  </script>
</BaseLayout>
