---
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ui, getLocale, type Locale } from "../../../i18n/ui";
import { fetchBlogEntry } from "../../../lib/blog";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { PERSON_AVATAR } from "../../../data/identidad";
import "../../../styles/editorial-pages.css";
import "../../../styles/editorial-blog.css";

export async function getStaticPaths() {
  const locales: Locale[] = ["es", "pt", "en"];
  const paths: { params: { locale: string; slug: string } }[] = [];

  for (const loc of locales) {
    const entries = await getCollection("blog", ({ id, data }) => {
      return id.startsWith(`${loc}/`) && !data.draft;
    });

    for (const entry of entries) {
      const slug = entry.id
        .replace(`${loc}/`, "")
        .replace(/\.(md|mdx)$/, "");
      paths.push({ params: { locale: loc, slug } });
    }
  }

  return paths;
}

// ─── Data fetching ─────────────────────────────────────────────────────────

const { locale: localeParam, slug } = Astro.params;
const locale = getLocale(localeParam as string);
const defaultLocale: Locale = "es";

const entry = await fetchBlogEntry(slug as string, locale);

if (!entry) {
  // Fail loudly at build time — this should never happen if getStaticPaths is correct
  throw new Error(
    `[blog] Content entry not found: ${locale}/${slug}\n` +
      `Make sure the file src/content/blog/${locale}/${slug}.md exists and is not a draft.`,
  );
}

const { Content } = await render(entry);

// ─── Related posts ───────────────────────────────────────────────────────────
// Relevancia semántica: tags compartidos > misma categoría > recencia.
// Antes se listaban los primeros posts de la categoría en orden de fichero,
// lo que daba resultados casi aleatorios en categorías grandes como `tools`.
const relatedPool = await getCollection("blog", ({ id, data }) => id.startsWith(`${locale}/`) && !data.draft);
const relSlug = (p: { id: string }) => p.id.replace(`${locale}/`, "").replace(/\.(md|mdx)$/, "");
const normalizeTag = (tag: string) => tag.toLowerCase().trim();
const currentTags = new Set((entry.data.tags ?? []).map(normalizeTag));
const relatedScore = (p: (typeof relatedPool)[number]) => {
  const shared = (p.data.tags ?? []).filter((tag) => currentTags.has(normalizeTag(tag))).length;
  const sameCategory = p.data.category === entry.data.category ? 1 : 0;
  return shared * 3 + sameCategory * 2;
};
const relatedRanked = relatedPool
  .filter((p) => p.id !== entry.id)
  .map((p) => ({ post: p, score: relatedScore(p) }))
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.post.data.date.getTime() - a.post.data.date.getTime(),
  );
// Selección manual (frontmatter `related`) primero; el resto de huecos se
// completa por relevancia y, si no la hay, por lo más reciente del idioma, para
// no dejar ningún post sin enlaces internos.
const manualRelated = (entry.data.related ?? []).map((wanted) => {
  const match = relatedPool.find((p) => relSlug(p) === wanted);
  if (!match) {
    throw new Error(
      `[blog] related: no existe "${wanted}" en ${locale}/ (referenciado desde ${entry.id})`,
    );
  }
  return match;
});
const manualIds = new Set(manualRelated.map((p) => p.id));
const relatedPosts = [
  ...manualRelated,
  ...relatedRanked.map(({ post }) => post).filter((p) => !manualIds.has(p.id)),
]
  .slice(0, 3)
  .map((p) => ({
    title: p.data.title,
    href: `/${locale}/blog/${relSlug(p)}/`,
    description: p.data.description,
  }));
const relatedLabel = locale === "en" ? "Related posts" : "Posts relacionados";


// ─── SEO / Meta ────────────────────────────────────────────────────────────

const dict = ui[locale];
const blogPostDict = (dict as any)?.blogPost ?? {};
const homeLabelByLocale: Record<Locale, string> = {
  es: "Inicio",
  pt: "Início",
  en: "Home",
};
const homeLabel = homeLabelByLocale[locale] ?? "Home";
const blogLabel = "Blog";

const site = (Astro.site?.toString() ?? "https://iaoperators.com").replace(/\/$/, "");

// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".

const siteRoot = site.replace(/\/$/, "");
const canonicalPath = Astro.url.pathname.replace(/\/?$/, "/");
const canonicalUrl = new URL(canonicalPath, site).toString();

function entrySlugByLocale(id: string, lang: Locale): string {
  return id.replace(`${lang}/`, "").replace(/\.(md|mdx)$/, "");
}

function entryClusterKey(e: any, lang: Locale): string {
  return e.data.translationKey ?? `slug:${entrySlugByLocale(e.id, lang)}`;
}

const currentClusterKey = entryClusterKey(entry, locale);
const localeAlternates: Array<{ lang: Locale; href: string }> = [];

for (const lang of ["es", "pt", "en"] as const) {
  const entries = await getCollection("blog", ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft);
  const matched = entries.find((candidate) => entryClusterKey(candidate, lang) === currentClusterKey);
  if (!matched) continue;
  const localizedSlug = entrySlugByLocale(matched.id, lang);
  const href = new URL(`/${lang}/blog/${localizedSlug}/`, site).toString();
  localeAlternates.push({ lang, href });
}

const canonicalFromAlternates =
  localeAlternates.find((item) => item.lang === locale)?.href ?? canonicalUrl;
const xDefaultUrl =
  localeAlternates.find((item) => item.lang === defaultLocale)?.href ?? canonicalFromAlternates;

const title = entry.data.title;
// <title> del SERP: usa seoTitle (corto) si existe; si no, el título del post.
// Sin sufijo de marca — la marca ya va en og:site_name — para no truncar en Google.
const pageTitle = entry.data.seoTitle ?? title;
const description = entry.data.description;
const articleKeywords = entry.data.tags ?? [];
const wordCount = entry.body ? entry.body.trim().split(/\s+/).filter(Boolean).length : undefined;
const updatedAt = entry.data.updatedAt;

// ─── Category labels ─────────────────────────────────────────────────────────
const CATEGORY_LABELS: Record<string, Record<string, string>> = {
  es: { tools: "Herramientas", lawyers: "IA para abogados", architects: "IA para arquitectos", accounting: "IA para contabilidad", restaurants: "IA para restaurantes", "beauty-salons": "IA para salones", privacy: "Privacidad y gobernanza de IA", compliance: "Cumplimiento normativo", others: "Blog" },
  pt: { tools: "Ferramentas", lawyers: "IA para advogados", architects: "IA para arquitetos", accounting: "IA para contabilidade", restaurants: "IA para restaurantes", "beauty-salons": "IA para salões", privacy: "Privacidade e governança de IA", compliance: "Compliance normativo", others: "Blog" },
  en: { tools: "Tools", lawyers: "AI for Lawyers", architects: "AI for Architects", accounting: "AI for Accounting", restaurants: "AI for Restaurants", "beauty-salons": "AI for Beauty", privacy: "AI Privacy & Governance", compliance: "Regulatory compliance", others: "Blog" },
};
const categoryLabel = CATEGORY_LABELS[locale]?.[entry.data.category] ?? entry.data.category;

// Reading time from raw markdown body
const readMinutes = Math.max(3, Math.ceil((entry.body?.length ?? 0) / 1500));
const readingTimeLabel = (blogPostDict?.readingTime ?? "{{minutes}} min").replace(
  "{{minutes}}",
  String(readMinutes),
);

// Date formatting
const parsedDate = entry.data.date;
const formattedDate = parsedDate.toLocaleDateString(locale, {
  year: "numeric",
  month: "long",
  day: "numeric",
});

function toIsoWithOffset(date: Date, offsetMinutes: number): string {
  const adjusted = new Date(date.getTime() + offsetMinutes * 60000);
  const iso = adjusted.toISOString();
  const sign = offsetMinutes >= 0 ? "+" : "-";
  const abs = Math.abs(offsetMinutes);
  const hh = String(Math.floor(abs / 60)).padStart(2, "0");
  const mm = String(abs % 60).padStart(2, "0");
  return iso.replace("Z", `${sign}${hh}:${mm}`);
}

const ogPublishedTime = parsedDate.toISOString();
const ogModifiedTime = (updatedAt ?? parsedDate).toISOString();

// ─── Structured data (JSON-LD) ─────────────────────────────────────────────

const faqItems = entry.data.faq ?? [];

const BLOG_NAME: Record<Locale, string> = {
  es: "Blog de IA Operators",
  pt: "Blog da IA Operators",
  en: "IA Operators Blog",
};

const isPersonAuthor = entry.data.author && entry.data.author !== "IA Operators";
const authorSchema = isPersonAuthor
  ? { "@type": "Person", name: entry.data.author, jobTitle: entry.data.authorTitle ?? "Fundador, IA Operators", url: entry.data.authorUrl ?? site, ...(entry.data.authorSameAs?.length ? { sameAs: entry.data.authorSameAs } : {}) }
  : { "@type": "Organization", name: "IA Operators", url: site };

const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: parsedDate.toISOString(),
  dateModified: (updatedAt ?? parsedDate).toISOString(),
  inLanguage: locale,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalFromAlternates,
  },
  image: entry.data.imageSchema?.length
    ? entry.data.imageSchema.map((u) => new URL(u, site).toString())
    : entry.data.image
      ? [new URL(entry.data.image, site).toString()]
      : undefined,
  articleSection: entry.data.articleSection,
  keywords: articleKeywords.length ? articleKeywords.join(", ") : undefined,
  wordCount,
  isPartOf: {
    "@type": "Blog",
    name: BLOG_NAME[locale] ?? BLOG_NAME.es,
    url: `${siteRoot}/${locale}/blog/`,
  },
  ...(entry.data.about?.length
    ? {
        about: entry.data.about.map((item) => ({
          "@type": item.type,
          name: item.name,
        })),
      }
    : {}),
  author: authorSchema,
  publisher: {
    "@type": "Organization",
    name: "IA Operators",
    url: site,
    logo: {
      "@type": "ImageObject",
      url: `${siteRoot}/android-chrome-512x512.png`,
      width: 512,
      height: 512,
    },
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: homeLabel, item: `${siteRoot}/${locale}/` },
    { "@type": "ListItem", position: 2, name: blogLabel, item: `${siteRoot}/${locale}/blog/` },
    { "@type": "ListItem", position: 3, name: title, item: canonicalFromAlternates },
  ],
};

const faqJsonLd =
  faqItems.length > 0 && entry.data.faqSchema !== false
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqItems.map((item) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
      }
    : null;

const jsonLd = [blogPostingJsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];

// ─── CTA final ───────────────────────────────────────────────────────────────
// Copy por defecto (genérico, igual que antes) con override por frontmatter
// para alinear la llamada a la acción con el tema del artículo.
const DEFAULT_CTA: Record<Locale, { title: string; text: string; label: string; href: string }> = {
  es: {
    title: "¿Listo para actuar?",
    text: "Diagnóstico, priorización y ejecución — sin hand-offs. El mismo equipo que mapea el problema construye la solución.",
    label: "Hablar con un especialista",
    href: `/${locale}/contact/`,
  },
  pt: {
    title: "Pronto para agir?",
    text: "Diagnóstico, priorização e execução — sem hand-offs. O mesmo time que mapeia o problema constrói a solução.",
    label: "Falar com um especialista",
    href: `/${locale}/contact/`,
  },
  en: {
    title: "Ready to act?",
    text: "Diagnosis, prioritization and execution — no hand-offs. The same team that maps the problem builds the solution.",
    label: "Talk to a specialist",
    href: `/${locale}/contact/`,
  },
};
const ctaDefaults = DEFAULT_CTA[locale] ?? DEFAULT_CTA.es;
const ctaTitle = entry.data.ctaTitle ?? ctaDefaults.title;
const ctaText = entry.data.ctaText ?? ctaDefaults.text;
const ctaPrimaryLabel = entry.data.ctaPrimaryLabel ?? ctaDefaults.label;
const ctaPrimaryHref = entry.data.ctaPrimaryHref ?? ctaDefaults.href;

// Enlaces secundarios: se omite el que ya es la acción principal para no
// competir con ella ni duplicar destino.
const ctaSecondaryLinks = [
  { href: `/${locale}/contact/`, label: ctaDefaults.label },
  { href: `/${locale}/auditoria-de-sistemas/`, label: locale === "pt" ? "Radiografia Digital" : locale === "en" ? "Digital X-Ray" : "Radiografía Digital" },
  { href: `/${locale}/roadmap-tecnologico/`, label: locale === "en" ? "Technology Roadmap" : "Roadmap Tecnológico" },
  {
    href: `/${locale}/implementacion/`,
    label: locale === "pt" ? "Implementação" : locale === "en" ? "Implementation" : "Implementación",
  },
].filter((link) => link.href !== ctaPrimaryHref);

// Share URLs
const shareLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalFromAlternates)}`;
// Diseño editorial (ES desde oct/2026, EN/PT desde el 08/oct/2026). Los textos
// de la ficha del autor son los mismos que tenía la plantilla oscura por idioma.
const ED = ({
  es: {
    crumbs: "Ruta de navegación",
    next: "Próximos pasos",
    copied: "Copiado",
    authorTitle: "Fundador, IA Operators",
    authorBio: "Años liderando equipos en empresas medianas y grandes. Creó IA Operators para diagnosticar ecosistemas tecnológicos, priorizar lo que mueve la aguja y construir soluciones — sin hand-offs entre quien piensa y quien ejecuta.",
  },
  en: {
    crumbs: "Breadcrumb",
    next: "Next steps",
    copied: "Copied",
    authorTitle: "Founder, IA Operators",
    authorBio: "Years leading teams across mid-size and large companies. Founded IA Operators to diagnose technology ecosystems, prioritize what moves the needle, and build solutions — no hand-offs between those who think and those who build.",
  },
  pt: {
    crumbs: "Trilha de navegação",
    next: "Próximos passos",
    copied: "Copiado",
    authorTitle: "Fundador, IA Operators",
    authorBio: "Anos liderando equipes em empresas de médio e grande porte. Criou a IA Operators para diagnosticar ecossistemas tecnológicos, priorizar o que move o ponteiro e construir soluções — sem hand-offs entre quem pensa e quem executa.",
  },
} as const)[locale as "es" | "en" | "pt"];
const authorName = entry.data.author ?? "IA Operators";
// Portada en la variante editorial: si es una ruta local que no existe en
// public/ (p. ej. /blog/ia-para-arquitectos.jpg), no se pinta el hueco roto.
const coverSrc = entry.data.cover ?? entry.data.image;
const coverOk =
  !!entry.data.image &&
  (!!entry.data.optimizeImage ||
    !coverSrc?.startsWith("/") ||
    existsSync(join(process.cwd(), "public", decodeURIComponent(coverSrc.split("?")[0]))));
const shareX = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalFromAlternates)}`;
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonicalUrl={canonicalFromAlternates}
  alternates={localeAlternates}
  xDefaultUrl={xDefaultUrl}
  jsonLd={jsonLd}
  ogTitle={entry.data.ogTitle ?? pageTitle}
  ogImage={entry.data.ogImage ?? entry.data.image ?? `/og/${locale}/${slug}.png`}
  ogImageAlt={entry.data.imageAlt ?? title}
  ogImageWidth={entry.data.ogImageWidth}
  ogImageHeight={entry.data.ogImageHeight}
  ogType="article"
  ogPublishedTime={ogPublishedTime}
  ogModifiedTime={ogModifiedTime}
  editorial
>
  <div class="ed-container bp">
    <header class="bp-hero">
      <nav class="pf-crumbs ed-eyebrow" aria-label={ED.crumbs}>
        <ol>
          <li><a href={`/${locale}/`}>{homeLabel}</a></li>
          <li><a href={`/${locale}/blog/`}>{blogLabel}</a></li>
          <li><span aria-current="page">{title}</span></li>
        </ol>
      </nav>
      <p class="ed-eyebrow bp-cat">{categoryLabel}</p>
      <h1>{title}</h1>
      <p class="ed-eyebrow bp-meta">
        <time datetime={parsedDate.toISOString()}>{formattedDate}</time>
        {updatedAt && (
          <span>{blogPostDict?.updatedLabel ?? "Actualizado"}: <time datetime={updatedAt.toISOString()}>{updatedAt.toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric" })}</time></span>
        )}
        <span>{readingTimeLabel}</span>
        {entry.data.authorUrl ? <a href={entry.data.authorUrl} rel="author">{authorName}</a> : <span>{authorName}</span>}
      </p>
    </header>

    {entry.data.image && entry.data.optimizeImage && (
      <figure class="bp-cover">
        <Picture
          src={entry.data.image}
          widths={[480, 768, 1200]}
          sizes={entry.data.imageSizes ?? "(max-width: 768px) 100vw, 1100px"}
          formats={["avif", "webp"]}
          fallbackFormat="png"
          inferSize={true}
          alt={entry.data.imageAlt ?? title}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    )}
    {coverOk && !entry.data.optimizeImage && (
      <figure class="bp-cover">
        <picture>
          {entry.data.imageSrcsetAvif && <source type="image/avif" srcset={entry.data.imageSrcsetAvif} sizes={entry.data.imageSizes ?? "(max-width: 768px) 100vw, 1100px"} />}
          {entry.data.imageSrcsetWebp && <source type="image/webp" srcset={entry.data.imageSrcsetWebp} sizes={entry.data.imageSizes ?? "(max-width: 768px) 100vw, 1100px"} />}
          <img
            src={entry.data.cover ?? entry.data.image}
            srcset={entry.data.imageSrcset}
            sizes={entry.data.imageSizes ?? "(max-width: 768px) 100vw, 1100px"}
            width={entry.data.imageWidth}
            height={entry.data.imageHeight}
            alt={entry.data.imageAlt ?? title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </figure>
    )}

    <div class="bp-body">
      <aside class="bp-side">
        <a class="bp-back ed-eyebrow" href={`/${locale}/blog/`}><span aria-hidden="true">←</span> {blogPostDict?.back ?? "Volver al Blog"}</a>
        <div class="bp-share">
          <p>{blogPostDict?.shareTitle ?? "Compartir"}</p>
          <div class="bp-share-links">
            <button type="button" class="ed-underlined" data-copy-link={canonicalFromAlternates} data-copied={ED.copied} aria-label={blogPostDict?.copyLink ?? "Copiar link"}>{blogPostDict?.copyLink ?? "Copiar link"}</button>
            <a class="ed-underlined" href={shareLinkedIn} target="_blank" rel="noopener noreferrer" title={blogPostDict?.shareLinkedIn ?? "Compartir en LinkedIn"}>LinkedIn <span class="ed-arrow" aria-hidden="true">↗</span></a>
            <a class="ed-underlined" href={shareX} target="_blank" rel="noopener noreferrer" title={blogPostDict?.shareTwitter ?? "Compartir en X"}>X <span class="ed-arrow" aria-hidden="true">↗</span></a>
          </div>
        </div>
      </aside>

      <div class="bp-main">
        <div class="bp-prose">
          <Content />
        </div>

        {faqItems.length > 0 && (
          <section class="bp-faq ed-faq" aria-labelledby="preguntas-frecuentes">
            <h2 id="preguntas-frecuentes">{blogPostDict?.faqTitle ?? "Preguntas frecuentes"}</h2>
            {faqItems.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </section>
        )}

        <div class="bp-cta">
          <p class="ed-eyebrow">{ED.next}</p>
          <p class="bp-cta-title">{ctaTitle}</p>
          <p class="bp-cta-text">{ctaText}</p>
          <div class="bp-cta-actions">
            <a class="ed-button" href={ctaPrimaryHref}>{ctaPrimaryLabel}<span class="ed-arrow" aria-hidden="true">↗</span></a>
            {ctaSecondaryLinks.map((link) => <a class="ed-underlined" href={link.href}>{link.label}</a>)}
          </div>
        </div>

        <div class="bp-author">
          <img src={PERSON_AVATAR} alt="Luiz Brazão" width="64" height="64" loading="lazy" decoding="async" />
          <div>
            <p class="bp-author-name">
              {entry.data.authorUrl
                ? <a href={entry.data.authorUrl} rel="author">{entry.data.author ?? "Luiz Brazão"}</a>
                : (entry.data.author ?? "Luiz Brazão")}
            </p>
            <p class="ed-eyebrow">{entry.data.authorTitle ?? ED.authorTitle}</p>
            <p class="bp-author-bio">{entry.data.authorBio ?? ED.authorBio}</p>
            <a class="ed-underlined" href="https://www.linkedin.com/in/ferbrazao/" target="_blank" rel="noopener noreferrer">LinkedIn <span class="ed-arrow" aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </div>

    {relatedPosts.length > 0 && (
      <aside class="bp-related" aria-labelledby="bp-related-title">
        <h2 id="bp-related-title" class="ed-eyebrow">{relatedLabel}</h2>
        <ol class="bl-list">
          {relatedPosts.map((rp) => (
            <li>
              <a href={rp.href} class="bl-item bl-item-compact">
                <div class="bl-item-copy">
                  <h3>{rp.title}</h3>
                  <p class="bl-desc">{rp.description}</p>
                </div>
                <span class="ed-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    )}
  </div>

  <script is:inline>
    (function () {
      const btn = document.querySelector("button[data-copy-link]");
      if (!btn) return;
      btn.addEventListener("click", async () => {
        const url = btn.getAttribute("data-copy-link") || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          btn.classList.add("text-white");
          setTimeout(() => btn.classList.remove("text-white"), 900);
          // Botón de texto: se confirma con el propio texto, en el idioma de la página.
          if (btn.classList.contains("ed-underlined")) {
            const label = btn.textContent;
            btn.textContent = btn.getAttribute("data-copied") || "Copiado";
            setTimeout(() => { btn.textContent = label; }, 1400);
          }
        } catch (_) {
          const input = document.createElement("input");
          input.value = url;
          document.body.appendChild(input);
          input.select();
          document.execCommand("copy");
          document.body.removeChild(input);
        }
      });
    })();
  </script>
</BaseLayout>
