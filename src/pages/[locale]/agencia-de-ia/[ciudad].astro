---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocale } from "../../../i18n/ui";
import { CIUDADES, CIUDAD_SLUGS, SHARED } from "../../../data/ciudades-ia";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-servicios.css";

// Solo ES: la intención de búsqueda local es en español. Añadir ciudad = añadir entrada en ciudades-ia.ts.
export async function getStaticPaths() {
  return CIUDAD_SLUGS.map((ciudad) => ({ params: { locale: "es", ciudad } }));
}

const locale = getLocale((Astro.params.locale as string) ?? "es");
const ciudad = Astro.params.ciudad as string;
const city = CIUDADES[ciudad] ?? CIUDADES.madrid;
const s = SHARED;

const contactHref = `/${locale}/contact/`;
const serviceHref = `/${locale}/servicios/agencia-ia/`;
const pilarHref = `/${locale}/blog/que-es-una-agencia-de-ia/`;

const site = Astro.site?.toString() ?? "https://iaoperators.com";

// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".

const siteRoot = site.replace(/\/$/, "");
const pageUrl = new URL(`/${locale}/agencia-de-ia/${ciudad}/`, site).toString();

// hreflang solo ES (no existen versiones pt/en de esta página)
const alternates = [{ lang: "es", href: pageUrl }];

const faqItems = [...city.faqLocal, ...s.genericFaq];

const providerSchema = {
  "@type": ["Organization", "ProfessionalService"],
  name: "IA Operators",
  url: site,
  logo: { "@type": "ImageObject", url: `${siteRoot}/favicon-32x32.png` },
  address: { "@type": "PostalAddress", addressLocality: "Málaga", addressCountry: "ES" },
  areaServed: { "@type": "City", name: city.name },
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: city.heroTitle,
  serviceType: "Artificial intelligence agency and automation",
  provider: providerSchema,
  areaServed: { "@type": "City", name: city.name },
  description: city.meta.description,
  url: pageUrl,
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${siteRoot}/${locale}/` },
    { "@type": "ListItem", position: 2, name: s.labels.breadcrumbBase, item: `${siteRoot}/${locale}/servicios/agencia-ia/` },
    { "@type": "ListItem", position: 3, name: city.name, item: pageUrl },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item: any) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const jsonLd = [serviceJsonLd, breadcrumbJsonLd, faqJsonLd];
const clean = (t: unknown) => String(t ?? "").replace(/\s*[↗→]\s*$/u, "");
const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout title={city.meta.title} description={city.meta.description} jsonLd={jsonLd} alternates={alternates} editorial>
  {/* Diseño editorial (oct/2026). ES-only: mismos textos, H1/H2/H3 y enlaces. */}
  <div class="ed-container">
    <header class="pg-hero">
      <nav class="pf-crumbs ed-eyebrow" aria-label="Ruta de navegación">
        <ol>
          <li><a href="/es/">Inicio</a></li>
          <li><a href={serviceHref}>{s.labels.breadcrumbBase}</a></li>
          <li><span aria-current="page">{city.name}</span></li>
        </ol>
      </nav>
      <h1>{city.heroTitle}</h1>
      <div class="pg-hero-bottom">
        <p class="ed-eyebrow">Agencia de IA · {city.name}</p>
        <div>
          <p class="pg-lead">{city.heroSubtitle}</p>
          <div class="pg-actions">
            <a class="ed-button" href={contactHref}>{clean(s.labels.heroCta)}<span class="ed-arrow" aria-hidden="true">↗</span></a>
            <a class="ed-underlined" href="#servicios">{s.labels.servicesAnchor} <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </div>
    </header>

    <section class="pg-section" aria-label={`IA para empresas en ${city.name}`}>
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{city.name}</p>
        <div class="pg-prose">
          {city.intro.map((p: string) => <p>{p}</p>)}
          <p>
            ¿No tienes claro qué es una agencia de IA o cómo elegir una? Te lo explicamos en esta <a class="pg-inline-link" href={pilarHref}>guía práctica</a>, y aquí puedes ver nuestro servicio general de <a class="pg-inline-link" href={serviceHref}>agencia de IA</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="pg-section" aria-labelledby="ciudad-sectores">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">Sectores</p>
        <h2 id="ciudad-sectores">{city.sectorsTitle}</h2>
      </div>
      <ul class="pg-columns sv-services">
        {city.sectors.map((item: any, i: number) => (
          <li>
            <span class="ed-eyebrow">{pad(i + 1)}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="servicios" class="pg-section sv-before-band" aria-labelledby="ciudad-servicios">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">Servicios</p>
        <div>
          <h2 id="ciudad-servicios">{s.services.title}</h2>
          {s.services.subtitle && <p class="pg-lead-muted">{s.services.subtitle}</p>}
        </div>
      </div>
      <ol class="pg-phases">
        {s.services.items.map((item: any, i: number) => (
          <li>
            <span class="ed-eyebrow">{pad(i + 1)}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <section class="ed-method pg-method pg-process" aria-labelledby="ciudad-proceso">
    <div class="ed-container">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{s.process.badge}</p>
        <h2 id="ciudad-proceso">{s.process.title}</h2>
      </div>
      <ol class:list={["ed-steps", { "pg-steps-4": s.process.phases.length === 4 }]}>
        {s.process.phases.map((phase: any) => (
          <li><span class="ed-eyebrow">{phase.code}</span><h3>{phase.title}</h3><p>{phase.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <div class="ed-container">
    <section class="pg-section sv-tech-section" aria-labelledby="ciudad-local">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">En {city.name}</p>
        <div>
          <h2 id="ciudad-local">{city.localAngle.title}</h2>
          <div class="pg-prose"><p>{city.localAngle.body}</p></div>
          <p class="ed-eyebrow sv-tech-label">{s.tech.title}</p>
          <ul class="pg-tech">
            {s.tech.items.map((item: string) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="pg-section pg-faq ed-faq" aria-labelledby="ciudad-faq">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">Preguntas</p>
        <div>
          <h2 id="ciudad-faq">Preguntas frecuentes</h2>
          <div class="pg-faq-list">
            {faqItems.map((item: any) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="ed-closing" aria-labelledby="ciudad-closing">
    <div class="ed-container">
      <p class="ed-eyebrow">Siguiente paso</p>
      <h2 id="ciudad-closing" class="pg-closing-title">¿Dónde podría la IA quitarte trabajo en {city.name}?</h2>
      <p class="pg-closing-copy">En una llamada de 30 minutos identificamos tu mejor primer caso de IA — sin humo y sin compromiso.</p>
      <a class="ed-button" href={contactHref}>{clean(s.finalCta.cta)}<span class="ed-arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
