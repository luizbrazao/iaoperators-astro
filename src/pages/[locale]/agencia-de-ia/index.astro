---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocale } from "../../../i18n/ui";
import { CIUDADES, CIUDAD_SLUGS } from "../../../data/ciudades-ia";

export async function getStaticPaths() {
  return [{ params: { locale: "es" } }];
}

const locale = getLocale((Astro.params.locale as string) ?? "es");
const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL(`/${locale}/agencia-de-ia/`, site).toString();
const alternates = [{ lang: "es", href: pageUrl }];

const serviceHref = `/${locale}/servicios/agencia-ia/`;
const contactHref = `/${locale}/contact/`;

const ciudades = CIUDAD_SLUGS.map((slug) => ({ slug, ...CIUDADES[slug] }));

const meta = {
  title: "Agencia de IA por ciudades en España | IA Operators",
  description: "Agencia de IA para empresas en Madrid, Barcelona y Valencia: automatización, agentes y chatbots con IA. Estrategia e implementación, sin humo.",
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${site}/${locale}/` },
    { "@type": "ListItem", position: 2, name: "Agencia de IA", item: `${site}/${locale}/servicios/agencia-ia/` },
    { "@type": "ListItem", position: 3, name: "Por ciudades", item: pageUrl },
  ],
};
---

<BaseLayout title={meta.title} description={meta.description} jsonLd={[breadcrumbJsonLd]} alternates={alternates}>
  <div class="bg-transparent text-white">
    <section class="relative px-4 pt-28 pb-16">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-1 rounded-full bg-white/10 border border-white/10 text-orange-400 text-xs font-semibold mb-6">Agencia de IA</span>
        <h1 class="text-4xl md:text-6xl font-medium tracking-tight leading-tight mb-6">Agencia de IA por ciudades</h1>
        <p class="text-lg md:text-2xl text-gray-200 mb-4 max-w-3xl mx-auto">
          Automatización con IA para empresas de toda España. Elige tu ciudad o mira nuestro <a href={serviceHref} class="text-orange-400 hover:underline">servicio de agencia de IA</a>.
        </p>
      </div>
    </section>

    <section class="px-4 pb-24">
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {ciudades.map((c: any) => (
          <a href={`/${locale}/agencia-de-ia/${c.slug}/`} class="block bg-[#0a0a0a] border border-white/5 rounded-3xl p-7 hover:border-orange-500/30 hover:scale-[1.02] transition-all duration-300">
            <h2 class="text-2xl font-semibold text-white mb-2">{c.name}</h2>
            <p class="text-gray-400 text-sm leading-relaxed mb-4">{c.heroSubtitle}</p>
            <span class="text-orange-400 text-sm font-medium">Ver agencia de IA en {c.name} ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="px-4 py-20 text-center">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">¿Tu ciudad no está en la lista?</h2>
        <p class="text-gray-400 text-lg mb-8">Trabajamos en remoto con empresas de toda España. Cuéntanos qué te quita tiempo y te decimos si tiene sentido automatizarlo.</p>
        <a href={contactHref} class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-orange-500 text-black font-medium text-lg hover:bg-orange-400 hover:scale-105 transition-all duration-300">Hablar con un especialista ↗</a>
      </div>
    </section>
  </div>
</BaseLayout>
