---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocale } from "../../../i18n/ui";
import { CIUDADES, CIUDAD_SLUGS } from "../../../data/ciudades-ia";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-servicios.css";

export async function getStaticPaths() {
  return [{ params: { locale: "es" } }];
}

const locale = getLocale((Astro.params.locale as string) ?? "es");
const site = Astro.site?.toString() ?? "https://iaoperators.com";
// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".
const siteRoot = site.replace(/\/$/, "");
const pageUrl = new URL(`/${locale}/agencia-de-ia/`, site).toString();
const alternates = [{ lang: "es", href: pageUrl }];

const serviceHref = `/${locale}/servicios/agencia-ia/`;
const contactHref = `/${locale}/contact/`;

const ciudades = CIUDAD_SLUGS.map((slug) => ({ slug, ...CIUDADES[slug] }));

const meta = {
  title: "Agencia de IA por ciudades en España | IA Operators",
  description: "Agencia de IA para empresas en Madrid, Barcelona y Valencia: automatización, agentes y chatbots con IA. Estrategia e implementación, sin humo.",
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${siteRoot}/${locale}/` },
    { "@type": "ListItem", position: 2, name: "Agencia de IA", item: `${siteRoot}/${locale}/servicios/agencia-ia/` },
    { "@type": "ListItem", position: 3, name: "Por ciudades", item: pageUrl },
  ],
};
---

<BaseLayout title={meta.title} description={meta.description} jsonLd={[breadcrumbJsonLd]} alternates={alternates} editorial>
  {/* Diseño editorial (oct/2026). ES-only: mismos textos, H1/H2 y enlaces. */}
  <div class="ed-container">
    <header class="pg-hero">
      <nav class="pf-crumbs ed-eyebrow" aria-label="Ruta de navegación">
        <ol>
          <li><a href="/es/">Inicio</a></li>
          <li><a href={serviceHref}>Agencia de IA</a></li>
          <li><span aria-current="page">Por ciudades</span></li>
        </ol>
      </nav>
      <h1>Agencia de IA por ciudades</h1>
      <div class="pg-hero-bottom">
        <p class="ed-eyebrow">Agencia de IA · {ciudades.length} ciudades</p>
        <p class="pg-lead">
          Automatización con IA para empresas de toda España. Elige tu ciudad o mira nuestro <a class="pg-inline-link" href={serviceHref}>servicio de agencia de IA</a>.
        </p>
      </div>
    </header>

    <section class="pg-section sv-last" aria-label="Ciudades">
      <ul class="pg-doors sv-doors sv-doors-flush">
        {ciudades.map((c: any, i: number) => (
          <li>
            <a href={`/${locale}/agencia-de-ia/${c.slug}/`}>
              <span class="ed-eyebrow">{String(i + 1).padStart(2, "0")}</span>
              <h2>{c.name}</h2>
              <p>{c.heroSubtitle}</p>
              <span class="sb-door-cta">Ver agencia de IA en {c.name}</span>
              <span class="ed-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section class="ed-closing" aria-labelledby="ciudades-closing">
    <div class="ed-container">
      <p class="ed-eyebrow">Siguiente paso</p>
      <h2 id="ciudades-closing" class="pg-closing-title">¿Tu ciudad no está en la lista?</h2>
      <p class="pg-closing-copy">Trabajamos en remoto con empresas de toda España. Cuéntanos qué te quita tiempo y te decimos si tiene sentido automatizarlo.</p>
      <a class="ed-button" href={contactHref}>Hablar con un especialista<span class="ed-arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
