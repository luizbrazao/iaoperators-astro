---
export async function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "pt" } },
    { params: { locale: "en" } },
  ];
}

import BaseLayout from "../../../layouts/BaseLayout.astro";
import ServicioArquitecturaEditorial from "@/components/editorial/ServicioArquitecturaEditorial.astro";
import { getLocale, ui } from "../../../i18n/ui";

const locale = getLocale((Astro.params.locale as string) ?? Astro.currentLocale ?? "es");
const dict = (ui as any)?.[locale] ?? {};
const roadmap = (dict as any)?.roadmap ?? {};

const meta = roadmap?.meta ?? {};
const hero = roadmap?.hero ?? {};
const faq = roadmap?.faq ?? {};

const contactHref = `/${locale}/contact/`;


const site = Astro.site?.toString() ?? "https://iaoperators.com";

// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".

const siteRoot = site.replace(/\/$/, "");
const pageUrl = new URL(`/${locale}/roadmap-tecnologico/`, site).toString();

const providerSchema = {
  "@type": ["Organization", "ProfessionalService"],
  name: "IA Operators",
  url: site,
  logo: { "@type": "ImageObject", url: `${siteRoot}/favicon-32x32.png` },
  address: { "@type": "PostalAddress", addressLocality: "Málaga", addressCountry: "ES" },
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Roadmap Tecnológico",
  alternateName: ["Technology Roadmap"],
  serviceType: "Technology architecture and implementation roadmap",
  provider: providerSchema,
  areaServed: ["ES", "PT", "BR"],
  description: meta?.description,
  url: pageUrl,
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: locale === "pt" ? "Início" : locale === "en" ? "Home" : "Inicio", item: `${siteRoot}/${locale}/` },
    { "@type": "ListItem", position: 2, name: hero?.badge ?? "Roadmap Tecnológico", item: pageUrl },
  ],
};

const faqJsonLd = Array.isArray(faq?.items) && faq.items.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.items.map((item: any) => ({
        "@type": "Question",
        name: item?.q,
        acceptedAnswer: { "@type": "Answer", text: item?.a },
      })),
    }
  : null;

const jsonLd = [serviceJsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];
---

<BaseLayout
  title={meta?.title ?? "Roadmap Tecnológico"}
  description={meta?.description}
  jsonLd={jsonLd}
  editorial
>
  <ServicioArquitecturaEditorial d={roadmap} current="roadmap" contactHref={contactHref} heroSecondaryHref="#entregables" deliverablesId="entregables" />
</BaseLayout>
