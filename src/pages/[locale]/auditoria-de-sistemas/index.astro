---
export async function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "pt" } },
    { params: { locale: "en" } },
  ];
}

import BaseLayout from "../../../layouts/BaseLayout.astro";
import ServicioArquitecturaEditorial from "@/components/editorial/ServicioArquitecturaEditorial.astro";
import { getLocale, ui } from "../../../i18n/ui";
import { integracionHref, casoHref } from "@/data/integracion";

const locale = getLocale((Astro.params.locale as string) ?? Astro.currentLocale ?? "es");
const dict = (ui as any)?.[locale] ?? {};
const audit = (dict as any)?.audit ?? {};

const meta = audit?.meta ?? {};
const hero = audit?.hero ?? {};
const faq = audit?.faq ?? {};

const contactHref = `/${locale}/contact/`;


// "Qué viene después": enlaza la Radiografía con los pasos siguientes. Antes
// era solo ES porque el silo de integración no existía en EN/PT; desde el
// 08/oct/2026 los tres idiomas lo tienen.
const NEXT = {
  es: {
    title: "Qué viene después del diagnóstico",
    body: "La Radiografía responde a «qué tengo». Estas son las dos preguntas siguientes, y quien las ejecuta es el mismo equipo.",
    items: [
      { title: "Qué hago primero", body: "El roadmap ordena las iniciativas que salen del diagnóstico por impacto y esfuerzo, con ROI estimado por fase.", cta: "Roadmap tecnológico →" },
      { title: "Conectar lo que ya existe", body: "La conclusión más frecuente del inventario no es que falte software: es que los sistemas correctos no se hablan entre ellos.", cta: "Integración de sistemas →" },
      { title: "Y si hay un sistema intocable", body: "Cuando el inventario descubre software antiguo del que depende la operación, se moderniza alrededor en lugar de reemplazarlo.", cta: "Sistemas legados →" },
    ],
  },
  en: {
    title: "What comes after the diagnosis",
    body: "The Digital X-Ray answers “what do I have”. These are the questions that come next, and the same team executes them.",
    items: [
      { title: "What do I do first", body: "The roadmap orders the initiatives that come out of the diagnosis by impact and effort, with estimated ROI per phase.", cta: "Technology roadmap →" },
      { title: "Connect what already exists", body: "The most common conclusion of the inventory isn't missing software: it's that the right systems don't talk to each other.", cta: "Systems integration →" },
      { title: "And if there's a system you can't touch", body: "When the inventory uncovers old software the operation depends on, we modernize around it instead of replacing it.", cta: "Legacy systems →" },
    ],
  },
  pt: {
    title: "O que vem depois do diagnóstico",
    body: "A Radiografia responde a “o que eu tenho”. Estas são as perguntas seguintes, e quem as executa é a mesma equipe.",
    items: [
      { title: "O que faço primeiro", body: "O roadmap ordena as iniciativas que saem do diagnóstico por impacto e esforço, com ROI estimado por fase.", cta: "Roadmap tecnológico →" },
      { title: "Conectar o que já existe", body: "A conclusão mais frequente do inventário não é que falte software: é que os sistemas certos não conversam entre si.", cta: "Integração de sistemas →" },
      { title: "E se houver um sistema intocável", body: "Quando o inventário encontra um software antigo do qual a operação depende, modernizamos ao redor dele em vez de substituí-lo.", cta: "Sistemas legados →" },
    ],
  },
}[locale as "es" | "en" | "pt"];
const NEXT_HREFS = [`/${locale}/roadmap-tecnologico/`, integracionHref(locale), casoHref(locale, "sistemas-legados")];
const next = { ...NEXT, items: NEXT.items.map((item, index) => ({ ...item, href: NEXT_HREFS[index] })) };

const site = Astro.site?.toString() ?? "https://iaoperators.com";

// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".

const siteRoot = site.replace(/\/$/, "");
const pageUrl = new URL(`/${locale}/auditoria-de-sistemas/`, site).toString();

const providerSchema = {
  "@type": ["Organization", "ProfessionalService"],
  name: "IA Operators",
  url: site,
  logo: { "@type": "ImageObject", url: `${siteRoot}/favicon-32x32.png` },
  address: { "@type": "PostalAddress", addressLocality: "Málaga", addressCountry: "ES" },
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Radiografía Digital",
  alternateName: ["Digital X-Ray", "Radiografia Digital"],
  serviceType: "Technology audit and systems inventory",
  provider: providerSchema,
  areaServed: ["ES", "PT", "BR"],
  description: meta?.description,
  url: pageUrl,
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: locale === "pt" ? "Início" : locale === "en" ? "Home" : "Inicio", item: `${siteRoot}/${locale}/` },
    { "@type": "ListItem", position: 2, name: hero?.badge ?? "Auditoría de sistemas", item: pageUrl },
  ],
};

const faqJsonLd = Array.isArray(faq?.items) && faq.items.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.items.map((item: any) => ({
        "@type": "Question",
        name: item?.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item?.a,
        },
      })),
    }
  : null;

const jsonLd = [serviceJsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];
---

<BaseLayout
  title={meta?.title ?? "Radiografía Digital"}
  description={meta?.description}
  jsonLd={jsonLd}
  editorial
>
  <ServicioArquitecturaEditorial d={audit} current="audit" contactHref={contactHref} heroSecondaryHref="#metodologia" methodologyId="metodologia" relatedPath="auditoria-de-sistemas/" next={next} />
</BaseLayout>
