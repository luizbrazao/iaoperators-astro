---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocale, locales } from "../../../i18n/ui";
import { getPagesEditorial } from "@/i18n/editorialCopy";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-legal.css";

// ✅ obrigatório em rotas dinâmicas
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));

const locale = getLocale(Astro.params.locale);

// ✅ carrega terms.json de cada idioma e seleciona o atual
const termsByLocale = import.meta.glob("../../../i18n/locales/*/terms.json", {
  eager: true,
});

type JsonModule = { default: Record<string, unknown> };

const key = `../../../i18n/locales/${locale}/terms.json`;
const terms = ((termsByLocale[key] as JsonModule | undefined)?.default ??
  (termsByLocale["../../../i18n/locales/es/terms.json"] as JsonModule | undefined)?.default ??
  (termsByLocale["../../../i18n/locales/en/terms.json"] as JsonModule | undefined)?.default ??
  (termsByLocale["../../../i18n/locales/pt/terms.json"] as JsonModule | undefined)?.default ??
  {}) as Record<string, unknown>;

// getter seguro + tipado
function t(path: string, fallback: string = ""): string {
  const value = path
    .split(".")
    .reduce<unknown>((acc: unknown, k: string) => {
      if (acc && typeof acc === "object" && k in (acc as Record<string, unknown>)) {
        return (acc as Record<string, unknown>)[k];
      }
      return undefined;
    }, terms);

  return typeof value === "string" ? value : fallback;
}

const pageTitle = `${t("terms.title", "Términos y Condiciones")} | IA Operators`;

// Datos identificativos del titular (LSSI-CE art. 10) — razón social visible
// para la verificación de empresa en Meta Business y otros validadores.
const legal = {
  name: "Luiz Fernando Costa Brazao",
  taxId: "Y8219331L",
  city: "Málaga, España",
  email: "info@iaoperators.com",
  brand: "IA Operators",
};

const LEGAL_LABELS_ES = {
  heading: "Titular del sitio web",
  name: "Razón social",
  taxId: "NIF/CIF",
  brand: "Nombre comercial",
  city: "Domicilio fiscal",
  email: "Correo electrónico",
};

const legalLabels =
  ({
    es: LEGAL_LABELS_ES,
    en: {
      heading: "Website owner",
      name: "Legal name",
      taxId: "Tax ID (NIF/CIF)",
      brand: "Trade name",
      city: "Registered address",
      email: "Email",
    },
    pt: {
      heading: "Titular do site",
      name: "Razão social",
      taxId: "NIF/CIF",
      brand: "Nome comercial",
      city: "Domicílio fiscal",
      email: "E-mail",
    },
  } as Record<string, typeof LEGAL_LABELS_ES>)[locale] ?? LEGAL_LABELS_ES;

// Rótulos del diseño editorial (ES desde oct/2026, EN/PT desde el 08/oct/2026).
const crumbs = getPagesEditorial(locale).breadcrumb;
const legalInfoLabel = ({ es: "Información legal", en: "Legal information", pt: "Informação legal" } as Record<string, string>)[locale] ?? "Información legal";

// meta description única por idioma (evita duplicados com la página de privacidad)
const metaDescription =
  ({
    es: "Términos y condiciones de uso de los servicios de IA Operators: alcance, responsabilidades del usuario, propiedad intelectual y limitación de responsabilidad.",
    en: "Terms and conditions for using IA Operators' services: scope, user responsibilities, intellectual property and limitation of liability.",
    pt: "Termos e condições de uso dos serviços da IA Operators: âmbito, responsabilidades do utilizador, propriedade intelectual e limitação de responsabilidade.",
  } as Record<string, string>)[locale] ??
  "Términos y condiciones de uso de los servicios de IA Operators.";
---

<BaseLayout title={pageTitle} description={metaDescription} robots="index,follow" editorial>
  <div class="ed-container lg-body">
    <header class="pg-hero">
      <nav class="pf-crumbs ed-eyebrow" aria-label={crumbs.label}>
        <ol>
          <li><a href={`/${locale}/`}>{crumbs.home}</a></li>
          <li><span aria-current="page">{t("terms.title", "Términos y Condiciones")}</span></li>
        </ol>
      </nav>
      <h1>{t("terms.title", "Términos y Condiciones")}</h1>
      <div class="pg-hero-bottom">
        <p class="ed-eyebrow">{legalInfoLabel}</p>
        <p class="pg-lead">{t("terms.intro", "")}</p>
      </div>
    </header>

    <section class="lg-id" itemscope itemtype="https://schema.org/Organization">
      <h2>{legalLabels.heading}</h2>
      <dl>
        <dt class="ed-eyebrow">{legalLabels.name}</dt>
        <dd itemprop="legalName">{legal.name}</dd>
        <dt class="ed-eyebrow">{legalLabels.taxId}</dt>
        <dd itemprop="taxID">{legal.taxId}</dd>
        <dt class="ed-eyebrow">{legalLabels.brand}</dt>
        <dd itemprop="name">{legal.brand}</dd>
        <dt class="ed-eyebrow">{legalLabels.city}</dt>
        <dd itemprop="address">{legal.city}</dd>
        <dt class="ed-eyebrow">{legalLabels.email}</dt>
        <dd><a href={`mailto:${legal.email}`} itemprop="email">{legal.email}</a></dd>
      </dl>
    </section>

    <div class="lg-blocks">
      <section class="lg-block">
        <h2>{t("terms.acceptance.title", "Aceptación")}</h2>
        <p>{t("terms.acceptance.text", "")}</p>
      </section>
      <section class="lg-block">
        <h2>{t("terms.services.title", "Servicios")}</h2>
        <ul>
          <li>{t("terms.services.items.automation", "")}</li>
          <li>{t("terms.services.items.integration", "")}</li>
          <li>{t("terms.services.items.support", "")}</li>
        </ul>
      </section>
      <section class="lg-block">
        <h2>{t("terms.userResponsibilities.title", "Responsabilidades del usuario")}</h2>
        <ul>
          <li>{t("terms.userResponsibilities.items.accurateInfo", "")}</li>
          <li>{t("terms.userResponsibilities.items.legalUse", "")}</li>
          <li>{t("terms.userResponsibilities.items.credentials", "")}</li>
        </ul>
      </section>
      <section class="lg-block">
        <h2>{t("terms.intellectualProperty.title", "Propiedad intelectual")}</h2>
        <p>{t("terms.intellectualProperty.text", "")}</p>
      </section>
      <section class="lg-block">
        <h2>{t("terms.liability.title", "Responsabilidad")}</h2>
        <ul>
          <li>{t("terms.liability.items.indirectDamages", "")}</li>
          <li>{t("terms.liability.items.misuse", "")}</li>
          <li>{t("terms.liability.items.downtime", "")}</li>
        </ul>
      </section>
      <section class="lg-block">
        <h2>{t("terms.modifications.title", "Modificaciones")}</h2>
        <p>{t("terms.modifications.text", "")}</p>
      </section>
      <section class="lg-block">
        <h3>{t("contact.title", "Contacto")}</h3>
        <p>{t("contact.text", "Escríbenos a")} <a href="mailto:info@iaoperators.com">info@iaoperators.com</a></p>
      </section>
    </div>
  </div>
</BaseLayout>
