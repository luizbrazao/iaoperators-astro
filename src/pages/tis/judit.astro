---
import PresenterVideo from "../../components/PresenterVideo.astro";
// Landing personalizada para Judit Segura, directora de Desarrollo Corporativo
// e Innovación de Spirit Hotels & Apartments (Spirit Hospitality Global
// Business, Bilbao; empresa familiar, Segura Hostelería). Creada el 13/11/2026.
// Privada: noindex,nofollow y fuera del sitemap ("/tis/" en NOINDEX_PATHS).
//
// Sesión de TIS 07/10/2026, 15:30, «AI in hotel marketing: intelligent
// segmentation or noise automation?», moderada por Francisca García (Casa
// 1800), con Juanma García (One Shot Hotels). Verificado contra la
// transcripción oficial del vídeo de TIS. Solo se usa lo que con seguridad
// dijo Judit, parafraseado salvo citas cortas:
//   - 02:36-05:03: el límite es si aportamos valor al cliente. Hace unos años
//     eligieron una solución de WhatsApp sin pensar en el flujo de
//     comunicación; el cliente recibía mensajes repetidos por varios canales;
//     «llegaba mucho más ruido de una forma mucho más rápida». Mantra: la
//     tecnología detrás de la estrategia. «Más marketing, pero no mejor
//     marketing».
//   - 10:26-12:53: una cadena pequeña no compite en inversión («matemática
//     pura»); su ventaja es la agilidad frente a las OTAs; son seis
//     establecimientos. Método: detectar la necesidad, analizar, elegir
//     herramienta, probar en un hotel; si funciona se escala, si no se
//     retira. Agentes para tareas para las que «no tienes manos». Ferias y
//     LinkedIn llenos de empresas; no todas encajan con tu tipo de cliente y
//     de hotel. «Nadie conoce al cliente como nosotros».
//   - 21:17-22:09: desbordados de datos, cada plataforma los da a su manera.
//     «Me encantaría juntar los datos del PMS con los de no sé qué. Luego no
//     hay integraciones…». Francisca: «Que cojan el testigo, que aquí hay
//     potencial de negocio».
//   - No se usa el cierre (24:38 y 26:28): atribución dudosa.
// Resumen oficial de Spirit sobre TIS: «La tecnología tiene que ir siempre
// detrás de la estrategia. Primero tenemos que tener claro qué queremos
// conseguir y después seleccionar la herramienta. Nunca al revés.»
// Spirit recogió el premio CEPYME500 2026 el 30/09/2026 en la Bolsa de Madrid.
//
// Concepto: «datos tenéis de sobra; lo que falta es juntarlos», aplicado con
// su propio método (probar en un hotel, medir, escalar o retirar). Enlace
// suave a /es/hoteles/reservas-directas-ia/ en la sección de agilidad frente
// a las OTAs.
//
// Comportamiento compartido en src/scripts/prospect-landing.ts.

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  // Vídeo de Luiz con fondo blanco, fundido con la página (PresenterVideo).
  src: "/video/luiz-tis.mp4",
  poster: "/video/luiz-tis-poster.jpg",
  duracion: "1 min 24 s",
};

const wa = (t: string) => `https://wa.me/34662423523?text=${encodeURIComponent(t)}`;
const CONTACT_HREF = wa("Hola Luiz, soy Judit Segura, de Spirit Hotels. He visto la página que preparaste después de TIS y me gustaría hablarlo.");
const INTRO_HREF = wa("Hola Luiz, soy Judit Segura, de Spirit Hotels. Te pongo en contacto con la persona que lleva los sistemas y los datos: ");
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/judit/", site).toString();
const ogImage = new URL("/og/judit.png", site).toString();
const title = "Judit Segura × IA Operators | Radiografía Digital";
const description = "Después de la mesa de IA en marketing hotelero en TIS: juntar los datos del PMS con los del resto, probando primero en un hotel. Una reflexión preparada por IA Operators para Judit Segura y Spirit Hotels.";

const pad = (n: number) => String(n).padStart(2, "0");

// Ejemplo ilustrativo del ruido: el mismo mensaje por tres canales.
const ruido = [
  { c: "WhatsApp", h: "10:02", t: "Hola, te recordamos que tu reserva empieza el viernes.", dup: false },
  { c: "Email", h: "10:02", t: "Te recordamos que tu reserva empieza el viernes.", dup: true },
  { c: "SMS", h: "10:03", t: "Recordatorio: tu reserva empieza el viernes.", dup: true },
];

// Su método, tal y como lo contó en la mesa.
const metodo = ["Detectar", "Probar en uno", "Medir", "Corregir", "Escalar"];

// Islas de datos (ilustrativo, no describe los sistemas de Spirit).
const islas = [
  { k: "PMS", d: "estancias y ocupación" },
  { k: "Channel manager", d: "canal y antelación" },
  { k: "CRM", d: "historial del huésped" },
  { k: "Revenue", d: "precio y pick-up" },
  { k: "Reseñas", d: "lo que opina" },
  { k: "Mensajería", d: "lo que pregunta" },
];

// Cuatro preguntas que se desprenden de su intervención.
const filtro = [
  { q: "¿Qué queremos conseguir?", d: "La estrategia primero. Si no está clara, ninguna herramienta lo arregla." },
  { q: "¿Encaja con nuestro cliente y nuestro hotel?", d: "Lo que funciona en una cadena enorme no tiene por qué funcionar en la vuestra." },
  { q: "¿Se puede probar en un hotel?", d: "Con un alcance pequeño y una forma clara de medirlo." },
  { q: "¿Aporta valor al cliente?", d: "Ese es el límite. Si solo añade mensajes, sobra." },
];

const pasos = [
  "Elegimos una pregunta de negocio que hoy no podéis contestar sin montar un Excel a mano.",
  "Inventariamos los sistemas que tocan esos datos y quién depende de cada uno.",
  "Marcamos dónde el dato se exporta, se copia, se espera o se corrige, y cuánto tiempo cuesta.",
  "Decidimos qué unión merece integrarse, cuál basta con ordenar y cuál puede esperar. Con cifras.",
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Datos tenéis de sobra. Lo que falta es juntarlos. Una idea para Judit Segura y Spirit Hotels." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f6f5f1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-link top-link-x" href="/es/hoteles/" data-cta="nav_hoteles">Hoteles</a>
          <a class="top-link top-link-x" href="/es/hoteles/reservas-directas-ia/" data-cta="nav_reservas_directas">Reservas directas</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header" data-cta-event="click_contact">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="label">Después de «IA en marketing hotelero» · TIS 2026</p>
        <h1 id="hero-title" class="greeting">Judit, en TIS dijiste que os gustaría ir <b>más rápido de lo que van los datos y las integraciones</b>.</h1>
        <p class="big">Datos tenéis de sobra.<span>Lo que falta es juntarlos.</span></p>

        <div class="hero-grid">
          <PresenterVideo src={VIDEO.src} poster={VIDEO.poster} label="Vídeo de Luiz Brazão para Judit Segura" duracion={VIDEO.duracion} />

          <div class="hero-copy">
            <p>Enhorabuena por el CEPYME500.</p>
            <p>Te escuché en la mesa que moderó Francisca García. Contaste que estáis desbordados de datos, que cada plataforma los da a su manera y que te encantaría juntar los del PMS con los de otras herramientas. Pero luego no hay integraciones.</p>
            <p>Francisca lo recogió al momento: ahí hay potencial de negocio.</p>
            <p class="hero-strong">Me gustaría proponerte algo que encaja con vuestra forma de trabajar: probarlo en un solo hotel, medirlo y decidir.</p>
          </div>
        </div>
      </section>

      <!-- Ruido -->
      <section id="ruido" class="section wrap" aria-labelledby="ru-title">
        <div class="split">
          <p class="label label-accent" data-reveal>01 · El ruido</p>
          <div>
            <h2 id="ru-title" class="h2" data-reveal>Más marketing no siempre es mejor marketing.</h2>
            <div class="two">
              <div>
                <p class="lede" data-reveal>Lo contaste sin rodeos: hace unos años elegisteis una solución de WhatsApp sin pensar antes en el flujo de comunicación. El cliente acababa recibiendo los mensajes repetidos por varios canales.</p>
                <p class="statement" data-reveal>
                  <span class="muted">Llegaba mucho más ruido.</span>
                  <span>Y mucho más rápido.</span>
                </p>
              </div>
              <figure class="noise" data-reveal aria-label="Ejemplo ilustrativo: el mismo recordatorio por tres canales en un minuto">
                <p class="noise-head">Bandeja del huésped</p>
                {ruido.map((m, i) => (
                  <p class:list={["bubble", { dup: m.dup }]} style={`--i:${i}`}><small><span>{m.c}</span><span>{m.h}</span></small>{m.t}</p>
                ))}
                <figcaption>Ejemplo ilustrativo.</figcaption>
              </figure>
            </div>
            <figure class="quote quote-day" data-reveal>
              <blockquote>«La tecnología tiene que ir siempre detrás de la estrategia. Primero tenemos que tener claro qué queremos conseguir y después seleccionar la herramienta. Nunca al revés.»</blockquote>
              <figcaption>Spirit Hotels · resumen de TIS 2026</figcaption>
            </figure>
            <p class="prose-line" data-reveal>Por eso esta página no empieza por una herramienta.</p>
          </div>
        </div>
      </section>

      <!-- Método -->
      <section id="metodo" class="panel" aria-labelledby="me-title">
        <div class="wrap section">
          <div class="split">
            <p class="label" data-reveal>02 · Tu método</p>
            <div>
              <h2 id="me-title" class="h2" data-reveal>Probar en un hotel. Si funciona, escalar. Si no, retirar.</h2>
              <p class="lede" data-reveal>Lo explicaste como la ventaja de una cadena independiente. Competir en inversión con los grandes no se puede, es matemática pura. Pero sois seis establecimientos y podéis moveros mucho más rápido.</p>
              <figure class="pilot" data-reveal aria-label="Seis hoteles: se prueba en uno y, si funciona, se lleva al resto">
                <div class="p-hotels">{[0, 1, 2, 3, 4, 5].map((i) => <i class:list={{ first: i === 0, later: i > 0 }} style={`--i:${i}`}></i>)}</div>
                <ol class="p-steps">{metodo.map((m, i) => <li class:list={{ hot: i === 1 }}><span>{pad(i + 1)}</span>{m}</li>)}</ol>
                <figcaption>Un hotel primero. Los otros cinco, solo si aporta valor.</figcaption>
              </figure>
              <p class="prose-line prose-ink" data-reveal>Y lo cerraste con una idea que ninguna herramienta compra: nadie conoce a vuestro cliente como vosotros.</p>
              <p class="prose-line" data-reveal>Esa agilidad también cuenta frente a las OTAs. Es la idea detrás de nuestro asistente para reservas directas: conversación con el huésped que acaba en vuestra web, diseñada a partir del flujo de comunicación y no al revés. <a class="inline-link" href="/es/hoteles/reservas-directas-ia/" data-cta="reservas_directas">Ver cómo lo planteamos</a></p>
            </div>
          </div>
        </div>
      </section>

      <!-- Datos -->
      <section id="datos" class="night" aria-labelledby="da-title">
        <div class="wrap section">
          <p class="label label-night" data-reveal>03 · Los datos</p>
          <h2 id="da-title" class="h2 h2-wide" data-reveal>«Me encantaría juntar los datos del PMS con los de no sé qué.»</h2>
          <div class="split split-tight">
            <span></span>
            <div>
              <p class="lede lede-night" data-reveal>Y a continuación, el problema: luego no hay integraciones. La cabeza va más rápido que los datos.</p>
              <figure class="islands" data-reveal aria-label="Ejemplo ilustrativo: seis sistemas con datos que no se cruzan y una pregunta de negocio">
                <div class="isl-grid">{islas.map((s, i) => <div class="isl" style={`--i:${i}`}><b>{s.k}</b><span>{s.d}</span></div>)}</div>
                <p class="isl-q"><small>La pregunta que nadie puede contestar sin un Excel</small>¿Quién repite, por qué canal llegó la primera vez y qué le hizo volver?</p>
                <figcaption>Ejemplo ilustrativo. No describe los sistemas de Spirit.</figcaption>
              </figure>
              <p class="prose-line prose-night" data-reveal>Cada sistema hace bien lo suyo. El valor está en el cruce, y el cruce es justo lo que no viene de serie.</p>
              <figure class="quote" data-reveal>
                <blockquote>«Que cojan el testigo, que aquí hay potencial de negocio.»</blockquote>
                <figcaption>Francisca García, moderando la mesa</figcaption>
              </figure>
            </div>
          </div>
          <p class="huge" data-reveal>Recojo el testigo.</p>
        </div>
      </section>

      <!-- Elegir -->
      <section id="elegir" class="section wrap" aria-labelledby="el-title">
        <div class="split">
          <p class="label" data-reveal>04 · Elegir bien</p>
          <div>
            <h2 id="el-title" class="h2" data-reveal>Las ferias y LinkedIn están llenos de empresas.</h2>
            <p class="lede" data-reveal>También lo dijiste: no todas encajan con vuestro tipo de cliente ni con vuestro tipo de hotel. Te escribo precisamente por LinkedIn, así que lo tomo como una advertencia justa.</p>
            <p class="prose-line" data-reveal>Estas son las preguntas que me llevé de tu intervención. Me parecen un buen filtro para cualquiera que llame a vuestra puerta, empezando por mí.</p>
            <ol class="filter" data-reveal>
              {filtro.map((f, i) => (
                <li class:list={{ "filter-last": i === filtro.length - 1 }}>
                  <span class="n">{pad(i + 1)}</span>
                  <div>
                    <p class="filter-q">{f.q}</p>
                    <p class="filter-d">{f.d}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="statement" data-reveal>
              <span class="muted">Se pueden crear agentes para las tareas para las que no tenéis manos.</span>
              <span>Siempre detrás de la estrategia.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Radiografía -->
      <section id="radiografia" class="panel" aria-labelledby="rd-title">
        <div class="wrap section">
          <div class="split">
            <p class="label label-accent" data-reveal>05 · Radiografía Digital</p>
            <div>
              <h2 id="rd-title" class="h2" data-reveal>Ver dónde se rompen los datos antes de comprar otra herramienta.</h2>
              <p class="lede" data-reveal>Una Radiografía Digital no evalúa proveedores ni propone una plataforma. Sigue un dato real de un hotel a través de los sistemas que lo tocan.</p>
              <ol class="steps" data-reveal>{pasos.map((p, i) => <li><span class="n">{pad(i + 1)}</span>{p}</li>)}</ol>
              <p class="prose-line" data-reveal>El resultado no es una lista de ideas. Es saber qué integración merece la pena, qué basta con ordenar y qué puede esperar, con su coste al lado.</p>
              <p class="prose-line" data-reveal>En una cadena de cuatro hoteles en Menorca, la dirección declaraba unas 25 herramientas. Encontramos 47, y un 23 % del gasto en SaaS que se podía recortar. <a class="inline-link" href="/es/portfolio/radiografia-cadena-hotelera-menorca/" data-cta="case">Ver el caso</a></p>
              <ul class="nots" data-reveal>
                <li>No vendemos un PMS, un CRM ni un RMS.</li>
                <li>No tenemos una plataforma que colocar.</li>
                <li>No sustituimos a vuestro equipo: le damos el mapa.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Propuesta -->
      <section id="propuesta" class="section wrap" aria-labelledby="pr-title">
        <div class="split">
          <p class="label label-accent" data-reveal>Una idea concreta</p>
          <div>
            <h2 id="pr-title" class="h2 h2-pair" data-reveal><span>No empecemos por los seis hoteles.</span><span class="h2-accent">Empecemos por uno.</span></h2>
            <p class="lede" data-reveal>Uno de vuestros establecimientos y una sola pregunta de datos. Lo probamos, lo medimos y decidís si se lleva al resto o se retira. Tu método, aplicado a nuestro trabajo.</p>
            <p class="prose-line" data-reveal>Lo haríamos con las personas de marketing y revenue que trabajan esos datos cada día, con la estrategia delante.</p>
            <p class="worth" data-reveal>¿Qué dos datos os gustaría ver juntos?</p>
          </div>
        </div>
      </section>

      <!-- Cierre -->
      <section id="cierre" class="closing wrap" aria-labelledby="ci-title">
        <p class="cl-1" data-reveal>Primero la estrategia.</p>
        <h2 id="ci-title" class="cl-big" data-reveal>Después, las uniones.</h2>
        <p class="cl-3" data-reveal>Y la herramienta, solo si hace falta. Ese es el trabajo que me gustaría enseñarte, o enseñar a quien lleve los datos en Spirit.</p>
      </section>

      <!-- CTA -->
      <section id="hablar" class="cta" aria-labelledby="cta-title">
        <div class="wrap section">
          <h2 id="cta-title" class="h2 cta-title" data-reveal>Si te parece una conversación útil, seguimos.</h2>
          <p class="cta-copy" data-reveal>En 20 minutos puedo enseñarte cómo hacemos una Radiografía Digital y un ejemplo real en una cadena hotelera.</p>
          <div class="cta-row" data-reveal>
            <div class="buttons">
              <a class="button" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="final" data-cta-event="click_contact">Hablar con Luiz <span aria-hidden="true">↗</span></a>
              <a class="button button-ghost" href={INTRO_HREF} target="_blank" rel="noopener" data-cta="intro" data-cta-event="click_introduction">Presentarme a la persona adecuada <span aria-hidden="true">↗</span></a>
            </div>
            <div class="signature">
              <p class="signature-name">Luiz Brazão</p>
              <p class="signature-role">Founder, IA Operators</p>
              <a class="signature-site" href="https://iaoperators.com/es/" data-cta="site">iaoperators.com</a>
            </div>
          </div>
        </div>
      </section>
    </main>


    <footer class="foot">
      <div class="wrap foot-inner">
        <span class="foot-brand"><img src="/brand/ia-operators-logo.png" alt="IA Operators" width="453" height="82" loading="lazy" /></span>
        <a href="/es/auditoria-de-sistemas/">Radiografía Digital</a>
        <a href="https://iaoperators.com/es/">iaoperators.com</a>
      </div>
    </footer>

    <div class="consent" data-consent hidden role="region" aria-label="Cookies">
      <p>Usamos cookies para medir y mejorar la experiencia. Puedes aceptar o rechazar. <a href="/es/politica-de-privacidad/">Política de Privacidad</a>.</p>
      <div class="consent-actions">
        <button type="button" data-consent-reject>Rechazar</button>
        <button type="button" class="consent-accept" data-consent-accept>Aceptar</button>
      </div>
    </div>

    <script>
      import { initProspectLanding } from "../../scripts/prospect-landing";
      initProspectLanding({ landing: "judit", gtmId: document.body.dataset.gtm ?? "", videoTitle: "judit_luiz", scrollMarks: [50, 90] });
    </script>

    <style is:global>
      @font-face {
        font-family: "Manrope JG";
        src: url("/fonts/manrope-latin-variable.woff2") format("woff2");
        font-weight: 200 800;
        font-display: swap;
      }
      :root {
        --paper: #f6f5f1;
        --panel: #ecebe5;
        --ink: #15171a;
        --text: #2c2f33;
        --muted: #62666b;
        --soft: #9a9da1;
        --line: #dfded8;
        --line-strong: #c3c2bb;
        --slate: #24425a;
        --slate-soft: #9fb2c1;
        --orange: #f16532;
        --orange-ink: #b4441a;
        --night: #121417;
        --night-text: #f1f1ee;
        --night-line: #2b2f34;
        --gutter: 20px;
        --ease: cubic-bezier(.2, .7, .2, 1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 72px; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Manrope JG", "Helvetica Neue", Arial, sans-serif; font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums; }
      h1, h2, h3, p, ol, ul, dl, dd, figure, blockquote { margin: 0; }
      ol, ul { padding: 0; list-style: none; }
      a { color: inherit; text-decoration: none; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
      .wrap { width: 100%; max-width: 1240px; margin-inline: auto; padding-inline: var(--gutter); }
      .label { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .label::before { content: ""; width: 7px; height: 7px; background: var(--slate); }
      .label-accent::before { background: var(--orange); }
      .label-night { color: #9a9ea3; }
      .label-night::before { background: var(--slate-soft); }
      .muted { color: var(--soft); }

      /* Cabecera */
      .top { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid transparent; transition: background-color .3s ease, border-color .3s ease; }
      .top.is-scrolled { background: rgba(246, 245, 241, .9); border-bottom-color: var(--line); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
      .top-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 60px; }
      .wordmark img { display: block; width: auto; height: 22px; }
      .foot-brand img { display: block; width: auto; height: 18px; }
      .top-nav { display: flex; align-items: center; gap: 22px; font-size: 13px; }
      .top-link { display: none; color: var(--muted); }
      .top-link:hover { color: var(--ink); }
      .top-cta { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; background: var(--slate); color: var(--night-text); font-weight: 600; white-space: nowrap; transition: background-color .2s ease; }
      .top-cta:hover { background: var(--ink); }

      /* Hero */
      .hero { padding-top: 18px; padding-bottom: 72px; }
      .greeting { margin-top: 14px; max-width: 24em; font-size: clamp(19px, 2.2vw, 28px); font-weight: 500; letter-spacing: -.028em; line-height: 1.28; color: var(--text); }
      .greeting b { font-weight: 700; color: var(--slate); }
      .big { display: grid; gap: 2px; margin-top: 18px; max-width: 13em; font-size: clamp(34px, 6.6vw, 94px); font-weight: 500; letter-spacing: -.058em; line-height: 1; color: var(--soft); }
      .big span { color: var(--ink); }
      .hero-grid { display: grid; gap: 28px; margin-top: 28px; }
      .hero-copy { display: grid; gap: 10px; align-content: start; color: var(--muted); }
      .hero-copy p { max-width: 32em; }
      .hero-strong { margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--line-strong); font-size: clamp(20px, 2vw, 25px); font-weight: 500; letter-spacing: -.03em; line-height: 1.28; color: var(--ink); }

      /* Secciones */
      .section { padding-block: 88px; }
      .panel { background: var(--panel); }
      .night { background: var(--night); color: var(--night-text); }
      .split { display: grid; gap: 18px; }
      .split > .label { align-self: start; padding-top: 10px; }
      .split-tight { margin-top: 40px; }
      .h2 { margin-top: 0; font-size: clamp(30px, 4.4vw, 58px); font-weight: 500; letter-spacing: -.05em; line-height: 1.07; max-width: 15em; }
      section > .wrap > .h2, .section > .h2 { margin-top: 16px; }
      .h2-wide { max-width: 19em; }
      .h2-pair { display: grid; gap: 4px; }
      .h2-accent { color: var(--orange-ink); }
      .lede { margin-top: 20px; max-width: 30em; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.45; letter-spacing: -.018em; color: var(--text); }
      .prose-line { margin-top: 22px; max-width: 36em; color: var(--muted); }
      .prose-ink { color: var(--text); font-size: 18px; }
      .prose-night { color: #b9bcc0; }
      .statement { display: grid; gap: 2px; margin-top: 40px; font-size: clamp(25px, 3.2vw, 42px); font-weight: 500; letter-spacing: -.045em; line-height: 1.12; max-width: 17em; }
      .statement::before { content: ""; display: block; width: 40px; height: 3px; margin-bottom: 16px; background: var(--orange); }
      .huge { margin-top: 72px; font-size: clamp(36px, 7vw, 100px); font-weight: 500; letter-spacing: -.062em; line-height: 1; max-width: 12em; }
      .n { flex: 0 0 26px; font-size: 12px; font-weight: 650; color: var(--soft); }

      /* Filtro */
      .filter { margin-top: 36px; border-top: 1px solid var(--ink); }
      .filter li { display: flex; gap: 14px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); }
      .filter-q { font-size: clamp(21px, 2.3vw, 30px); font-weight: 500; letter-spacing: -.035em; line-height: 1.18; }
      .filter-d { margin-top: 4px; max-width: 36em; font-size: 16px; color: var(--muted); }
      .filter-last .n { color: var(--orange); }
      .filter-last .filter-q { color: var(--slate); }

      /* Citas */
      .quote blockquote { font-size: clamp(21px, 2.3vw, 29px); font-weight: 400; letter-spacing: -.03em; line-height: 1.3; max-width: 24em; }
      .quote figcaption { margin-top: 10px; font-size: 13px; color: #9a9ea3; }
      .night .huge { color: var(--night-text); }

      /* Radiografía */
      .steps { margin-top: 28px; border-top: 1px solid var(--line-strong); }
      .steps li { display: flex; gap: 14px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line-strong); font-size: clamp(18px, 1.7vw, 21px); letter-spacing: -.02em; }
      .nots { margin-top: 28px; }
      .nots li { padding: 8px 0; font-size: 16px; color: var(--muted); }
      .nots li::before { content: "·"; margin-right: 10px; color: var(--slate); font-weight: 700; }

      /* Propuesta */
      .worth { margin-top: 10px; font-size: clamp(38px, 6.6vw, 90px); font-weight: 500; letter-spacing: -.06em; line-height: 1; color: var(--orange-ink); }

      /* Ruido */
      .two { display: grid; gap: 40px; }
      .noise { display: grid; gap: 10px; align-self: start; width: 100%; max-width: 360px; padding: 18px; border: 1px solid var(--line-strong); border-radius: 22px; background: var(--paper); }
      .noise-head { padding-bottom: 8px; border-bottom: 1px solid var(--line); font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .bubble { padding: 10px 12px; border-radius: 12px 12px 12px 4px; background: var(--panel); font-size: 15px; line-height: 1.4; }
      .bubble small { display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 11px; font-weight: 650; letter-spacing: .06em; text-transform: uppercase; color: var(--slate); }
      .bubble.dup { background: rgba(241, 101, 50, .08); }
      .bubble.dup small { color: var(--orange-ink); }
      .noise figcaption { font-size: 13px; color: var(--soft); }
      .quote-day { margin-top: 48px; padding-left: 18px; border-left: 3px solid var(--slate); }
      .quote-day figcaption { color: var(--muted); }

      /* Método */
      .pilot { display: grid; gap: 22px; margin-top: 36px; }
      .p-hotels { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; max-width: 480px; }
      .p-hotels i { position: relative; aspect-ratio: 1; border: 1px solid var(--slate); border-radius: 6px; background: var(--paper); }
      .p-hotels i::after { content: ""; position: absolute; inset: 34%; border-radius: 50%; background: var(--slate); }
      .p-hotels i.first { border-color: var(--orange); box-shadow: 0 0 0 4px rgba(241, 101, 50, .14); }
      .p-hotels i.first::after { background: var(--orange); }
      .p-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; max-width: 640px; }
      .p-steps li { padding: 8px 4px; border: 1px solid var(--slate-soft); border-radius: 6px; background: var(--paper); text-align: center; font-size: 12px; font-weight: 600; line-height: 1.25; color: var(--slate); }
      .p-steps li span { display: block; margin-bottom: 2px; font-size: 10px; color: var(--soft); }
      .p-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }
      .pilot figcaption { font-size: 14px; color: var(--muted); }

      /* Datos */
      .lede-night { color: var(--night-text); }
      .islands { display: grid; gap: 14px; margin-top: 36px; }
      .isl-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
      .isl { padding: 14px; border: 1px dashed #4a5058; border-radius: 10px; }
      .isl b { display: block; font-size: 17px; font-weight: 600; letter-spacing: -.02em; color: var(--night-text); }
      .isl span { display: block; margin-top: 4px; font-size: 13px; color: #9a9ea3; }
      .isl-q { padding: 16px 18px; border: 1px solid var(--orange); border-radius: 10px; font-size: clamp(18px, 1.8vw, 22px); letter-spacing: -.02em; line-height: 1.35; color: var(--night-text); }
      .isl-q small { display: block; margin-bottom: 6px; font-size: 11px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: var(--orange); }
      .islands figcaption { font-size: 13px; color: #7d8187; }
      .night .quote { margin-top: 40px; }
      .prose-line + .worth { margin-top: 36px; }

      /* Cierre */
      .closing { padding-block: 120px 128px; }
      .cl-1 { font-size: clamp(28px, 3.6vw, 48px); font-weight: 500; letter-spacing: -.045em; color: var(--soft); }
      .cl-big { margin-top: 10px; max-width: 10em; font-size: clamp(52px, 11vw, 160px); font-weight: 500; letter-spacing: -.07em; line-height: .95; }
      .cl-3 { margin-top: 56px; max-width: 30em; font-size: clamp(19px, 1.8vw, 23px); letter-spacing: -.02em; color: var(--text); }

      /* CTA */
      .cta { border-top: 1px solid var(--line); }
      .cta-title { max-width: 14em; }
      .cta-copy { margin-top: 20px; max-width: 32em; font-size: 18px; color: var(--muted); }
      .cta-row { display: grid; gap: 36px; margin-top: 40px; }
      .buttons { display: grid; gap: 10px; justify-items: start; }
      .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 56px; padding: 0 24px; background: var(--slate); color: var(--night-text); font-size: 16px; font-weight: 600; transition: background-color .2s ease, color .2s ease; }
      .button:hover { background: var(--ink); }
      .button-ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
      .button-ghost:hover { background: var(--ink); color: var(--paper); }
      .signature { padding-top: 18px; border-top: 1px solid var(--line); max-width: 280px; }
      .signature-name { font-size: 18px; font-weight: 650; letter-spacing: -.02em; }
      .signature-role { font-size: 14px; color: var(--muted); }
      .signature-site { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--slate); }

      /* Pie y consentimiento */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding-block: 26px 30px; font-size: 13px; color: var(--muted); }
      .foot-brand { margin-right: auto; }
      .foot a:hover { color: var(--ink); }
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; background: var(--night); color: var(--night-text); font-size: 13px; line-height: 1.5; border: 1px solid #3a3d42; box-shadow: 0 10px 30px rgba(0, 0, 0, .18); }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; }
      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 38px; padding: 0 16px; border: 1px solid #3a3d42; background: transparent; color: var(--night-text); font: inherit; cursor: pointer; }
      .consent .consent-accept { background: var(--night-text); color: var(--night); border-color: var(--night-text); }

      /* Movimiento */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }

      .js .noise .bubble { opacity: 0; transform: translateY(6px); transition: opacity .45s ease calc(.3s + var(--i) * 320ms), transform .45s var(--ease) calc(.3s + var(--i) * 320ms); }
      .js .noise.is-in .bubble { opacity: 1; transform: none; }
      .js .pilot .p-hotels i.later { border-color: var(--line-strong); transition: border-color .4s ease calc(1.1s + var(--i) * 120ms); }
      .js .pilot .p-hotels i.later::after { background: var(--line-strong); transition: background-color .4s ease calc(1.1s + var(--i) * 120ms); }
      .js .pilot.is-in .p-hotels i.later { border-color: var(--slate); }
      .js .pilot.is-in .p-hotels i.later::after { background: var(--slate); }
      .js .islands .isl { opacity: .3; transition: opacity .5s ease calc(.2s + var(--i) * 90ms); }
      .js .islands.is-in .isl { opacity: 1; }

      @media (min-width: 420px) {
        .top-link { display: inline; }
        .p-steps li { font-size: 13px; }
      }
      .top-nav .top-link-x { display: none; }
      @media (min-width: 900px) {
        .top-nav .top-link-x { display: inline; }
      }
      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .isl-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .cta-row { grid-template-columns: auto 1fr; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }
      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 40px; padding-bottom: 116px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 52px; align-items: start; }
        .section { padding-block: 128px; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .two { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; margin-top: 8px; }
        .closing { padding-block: 180px 190px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .noise .bubble, .js .islands .isl { opacity: 1; transform: none; transition: none; }
        .js .pilot .p-hotels i.later { border-color: var(--slate); transition: none; }
        .js .pilot .p-hotels i.later::after { background: var(--slate); transition: none; }
        .top, .button, .top-cta { transition: none; }
      }
      .inline-link { color: var(--slate); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
      .inline-link:hover { color: var(--ink); }
    </style>
  </body>
</html>
