      .mx-h span { display: none; font-size: 11px; color: var(--muted); }
      .mx-a { justify-self: start; font-size: 14px; font-weight: 600; color: var(--text); }
      .mx-c i { display: block; width: 18px; height: 18px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--line-strong); position: relative; }
      .mx-c i::after { content: ""; position: absolute; inset: 5px; border-radius: 50%; background: var(--petrol); }
      .defs { display: grid; gap: 0; margin-top: 22px; border-top: 1px solid var(--line); }
      .defs div { display: grid; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--line); }
      .defs dt { font-weight: 650; letter-spacing: -.01em; }
      .defs dt b { display: inline-block; width: 22px; font-size: 13px; color: var(--petrol); }
      .defs dd { padding-left: 22px; font-size: 15px; color: var(--muted); }

      /* 04 · Patrones */
      .patterns { display: grid; margin-top: 32px; border-top: 1px solid var(--line-strong); }
      .patterns li { display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line-strong); font-size: clamp(18px, 1.7vw, 22px); letter-spacing: -.02em; }
      .patterns li .mono { font-size: 11px; color: var(--amber); }

      /* 05 · Piloto */
      .dark { background: var(--dark); color: var(--dark-text); }
      .pilot-sub { margin-top: 10px; font-size: clamp(26px, 3.4vw, 46px); font-weight: 500; letter-spacing: -.045em; line-height: 1.1; color: #8fc3c9; }
      .slots { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
      .slots li { display: grid; gap: 4px; padding: 12px 8px 10px; border-radius: 6px; background: var(--dark-2); box-shadow: inset 0 0 0 1px #3a474c; }
      .slots li .mono { font-size: 11px; color: var(--dark-text); }
      .slots li small { font-size: 10px; color: var(--dark-muted); }
      .slots li.opt { background: transparent; box-shadow: none; border: 1px dashed #4a575c; }
      .slots li.opt .mono { color: var(--dark-muted); }
      .steps { display: grid; border-top: 1px solid var(--dark-line); }
      .steps li { display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--dark-line); font-size: clamp(18px, 1.7vw, 22px); letter-spacing: -.02em; }
      .steps li .mono { font-size: 11px; color: var(--dark-muted); }
      .steps li:nth-child(3) { color: #8fc3c9; }
      .pilot-out { display: grid; gap: 4px; margin-top: 22px; padding: 16px; border-radius: 6px; background: var(--petrol); font-size: clamp(19px, 1.8vw, 24px); font-weight: 600; letter-spacing: -.025em; color: #fff; }
      .pilot-out .mono { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; color: rgba(255, 255, 255, .65); }

      /* 06 · Comparar */
      .q-k { margin-top: 34px; }
      .questions { display: grid; margin-top: 12px; border-top: 1px solid var(--line); }
      .questions li { display: grid; grid-template-columns: 36px minmax(0, 1fr); align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: clamp(18px, 1.7vw, 22px); letter-spacing: -.02em; line-height: 1.35; }
      .questions li .mono { font-size: 11px; color: var(--petrol); }

      /* 07 · Mapa */
      .map-grid { display: grid; gap: 36px; margin-top: 40px; }
      .pipe { display: grid; gap: 22px; position: relative; align-content: start; }
      .pipe li { position: relative; display: grid; gap: 4px; padding: 12px 14px; border-radius: 6px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line-strong); font-size: 17px; font-weight: 600; letter-spacing: -.02em; }
      .pipe li:not(:last-child)::after { content: ""; position: absolute; left: 24px; top: 100%; height: 22px; width: 1px; background: var(--line-strong); }
      .pipe li .mono { font-size: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
      .pipe-chips { display: flex; flex-wrap: wrap; gap: 5px; }
      .pipe-chips b { padding: 2px 6px; border-radius: 4px; background: var(--paper-2); font-size: 11px; font-weight: 500; color: var(--text); }
      .pipe-out { background: var(--petrol) !important; box-shadow: none !important; color: #fff; }
      .pipe-out .mono { color: rgba(255, 255, 255, .65) !important; }
      .field-map { padding: 18px 14px; border: 1px solid var(--line-strong); border-radius: 8px; background: var(--paper); }
      .field-map .frow-track i:not(.f) { background: var(--paper); }
      .caveat { max-width: 36em; padding: 14px 16px; border-left: 2px solid var(--petrol); background: var(--paper); font-size: 15px; line-height: 1.55; color: var(--text); }
      .caveat b { font-weight: 650; color: var(--ink); }

      /* 08 · Resultado */
      .outs { display: grid; margin-top: 14px; border-top: 1px solid var(--line); }
      .outs li { position: relative; padding: 12px 0 12px 24px; border-bottom: 1px solid var(--line); font-size: clamp(18px, 1.7vw, 22px); letter-spacing: -.02em; line-height: 1.35; }
      .outs li::before { content: ""; position: absolute; left: 2px; top: 1.15em; width: 8px; height: 8px; border-radius: 50%; background: var(--petrol); }
      .outs-last { margin-top: 26px; font-size: clamp(24px, 2.8vw, 38px); font-weight: 500; letter-spacing: -.045em; line-height: 1.15; color: var(--petrol); }
      .outs-last b { font-weight: 700; color: var(--amber); }

      /* 09 · Ecosistema */
      .eco { display: grid; gap: 14px; margin-top: 44px; }
      .eco-g { padding: 16px; border-radius: 8px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line-strong); }
      .eco-ith { background: var(--petrol); box-shadow: none; color: #fff; }
      .eco-k { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
      .eco-ith .eco-k { color: rgba(255, 255, 255, .65); }
      .eco ol { display: grid; margin-top: 10px; }
      .eco li { position: relative; padding: 8px 0 8px 22px; font-size: clamp(18px, 1.8vw, 23px); font-weight: 500; letter-spacing: -.025em; }
      .eco li::before { content: ""; position: absolute; left: 2px; top: 50%; width: 8px; height: 8px; margin-top: -4px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px currentColor; }
      .eco li:not(:last-child)::after { content: ""; position: absolute; left: 5.5px; top: calc(50% + 6px); height: calc(100% - 12px); width: 1px; background: currentColor; opacity: .35; }
      .eco > figcaption { margin-bottom: 2px; }

      /* 10 · Hotel */
      .talk { display: grid; gap: 10px; margin-top: 28px; }
      .talk p { display: grid; gap: 6px; padding: 18px 16px; border-radius: 8px; font-size: clamp(20px, 2.2vw, 30px); font-weight: 500; letter-spacing: -.035em; line-height: 1.2; }
      .talk .mono { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; font-weight: 500; }
      .talk-a { color: var(--soft); box-shadow: inset 0 0 0 1px var(--line); }
      .talk-a .mono { color: var(--soft); }
      .talk-b { background: var(--petrol); color: #fff; }
      .talk-b .mono { color: rgba(255, 255, 255, .65); }

      /* 11 · Ficha */
      .ficha { margin-top: 22px; padding: 16px; border-radius: 8px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line-strong); }
      .ficha figcaption { font-size: 11px; color: var(--muted); }
      .ficha dl { display: grid; margin-top: 10px; }
      .ficha div { display: grid; gap: 2px; padding: 10px 0; border-top: 1px dashed var(--line-strong); }
      .ficha dt { font-weight: 650; letter-spacing: -.01em; }
      .ficha dd { font-size: 14px; color: var(--soft); }

      /* 12 · Primer paso */
      .one { display: flex; align-items: center; gap: 18px; margin-top: 44px; font-size: clamp(72px, 15vw, 210px); font-weight: 500; letter-spacing: -.07em; line-height: .9; color: var(--petrol); }
      .one-dot { flex: 0 0 auto; width: .14em; height: .14em; border-radius: 50%; background: var(--petrol); }
      .small-steps { display: grid; border-top: 1px solid var(--line); }
      .small-steps li { display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: clamp(19px, 1.8vw, 24px); font-weight: 500; letter-spacing: -.025em; }
      .small-steps li .mono { font-size: 11px; color: var(--soft); }
      .then { display: grid; gap: 6px; margin-top: 28px; }
      .then span { color: var(--muted); }
      .then b { font-size: clamp(22px, 2.4vw, 32px); font-weight: 500; letter-spacing: -.04em; line-height: 1.2; }

      /* Experiencia */
      .exp { display: grid; gap: 28px; }
      .exp p { margin-top: 12px; max-width: 34em; color: var(--text); }
      .link { display: inline-flex; gap: 6px; margin-top: 14px; font-weight: 600; color: var(--petrol); border-bottom: 1px solid currentColor; }
      .who { padding: 16px; border-radius: 8px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line); }
      .who p { margin-top: 0; }
      .who-name { font-size: 18px; font-weight: 650; letter-spacing: -.02em; }
      .who-role { font-size: 13px; color: var(--muted); }
      .who p:last-child { margin-top: 10px; font-size: 15px; color: var(--text); }

      /* CTA */
      .cta-q { margin-top: 14px; max-width: 11em; font-size: clamp(40px, 7.4vw, 110px); font-weight: 500; letter-spacing: -.06em; line-height: .98; color: var(--petrol); }
      .cta-row { display: grid; gap: 40px; margin-top: 30px; }
      .cta-row .lede { margin-top: 0; }
      .button { display: inline-flex; align-items: center; gap: 22px; min-height: 52px; margin-top: 26px; padding: 0 22px; border-radius: 6px; background: var(--petrol); color: #fff; font-weight: 650; transition: background-color .2s ease; }
      .button:hover { background: var(--ink); }
      .signature { padding-top: 16px; border-top: 1px solid var(--line-strong); }
      .signature-name { font-weight: 650; letter-spacing: -.02em; }
      .signature-role { font-size: 14px; color: var(--muted); }
      .signature-site { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--petrol); }

      /* Pie y consentimiento */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding-block: 26px 30px; font-size: 13px; color: var(--muted); }
      .foot-brand { margin-right: auto; font-weight: 650; color: var(--ink); letter-spacing: -.02em; }
      .foot a:hover { color: var(--ink); }
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; background: var(--dark); color: var(--dark-text); font-size: 13px; line-height: 1.5; border-radius: 8px; border: 1px solid #3a4448; box-shadow: 0 10px 30px rgba(0, 0, 0, .16); }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; }
      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 38px; padding: 0 16px; border: 1px solid #3a4448; border-radius: 6px; background: transparent; color: var(--dark-text); font: inherit; cursor: pointer; }
      .consent .consent-accept { background: var(--dark-text); color: var(--dark); border-color: var(--dark-text); }

      /* Movimiento discreto */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }
      .js .flow li { opacity: .25; transition: opacity .5s ease calc(.2s + var(--i) * 160ms); }
      .js .flow.is-in li { opacity: 1; }
      .js .mx-c i::after { transform: scale(0); transition: transform .35s var(--ease) calc(.3s + var(--i) * 45ms); }
      .js .mx.is-in .mx-c i::after { transform: scale(1); }
      .js .slots li { opacity: 0; transition: opacity .5s ease calc(.15s + var(--i) * 120ms); }
      .js .slots.is-in li { opacity: 1; }
      .js .field-map .frow-track i { transition: left 1.3s var(--ease) calc(.25s + var(--r) * 110ms), background-color .4s ease 1.4s, box-shadow .4s ease 1.4s; }
      .js .field-map:not(.is-in) .frow-track i { left: var(--sx); }
      .js .field-map:not(.is-in) .frow-track i.f:not(.p) { background: var(--amber); box-shadow: none; }
      .js .field-map .band { transition: opacity .6s ease 1.5s; }
      .js .field-map:not(.is-in) .band { opacity: 0; }

      @media (max-width: 559px) {
        .band b { display: none; }
      }

      @media (min-width: 420px) {
        .top-link { display: inline; }
      }

      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .field { --lab: 40px; }
        .mx { padding: 22px 24px; }
        .mx-h span { display: block; }
        .mx-a { font-size: 15px; }
        .defs { grid-template-columns: 1fr 1fr; column-gap: 28px; }
        .nosi { grid-template-columns: 1fr 1fr; gap: 28px; }
        .slots { gap: 10px; }
        .slots li { padding: 16px 12px 12px; }
        .slots li .mono { font-size: 12px; }
        .talk { grid-template-columns: 1fr 1fr; }
        .ficha dl { grid-template-columns: 1fr 1fr; column-gap: 24px; }
        .eco { grid-template-columns: 1fr 1fr; }
        .eco > figcaption { grid-column: 1 / -1; }
        .exp { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px; align-items: start; }
        .cta-row { grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }

      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 36px; padding-bottom: 112px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 44px; align-items: start; }
        .hero-foot { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: end; margin-top: 80px; }
        .section { padding-block: 124px; }
        .section-tight { padding-block: 88px; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .split + .split, .flow + .split, .one + .split, .map-grid + .split, .eco + .split { margin-top: 56px; }
        .eco { margin-left: calc((100% - 48px) / 3 + 48px); }
        .huge { margin-top: 72px; }
        .map-grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; align-items: start; margin-top: 64px; }
        .eco { grid-template-columns: 1fr 1fr; position: relative; }
        .one { margin-left: calc((100% - 48px) / 3 + 48px); }
        .cta-q { margin-top: 18px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .flow li, .js .slots li { opacity: 1; transition: none; }
        .js .mx-c i::after { transform: none; transition: none; }
        .js .field-map .frow-track i, .js .field-map .band { transition: none; }
        .js .field-map:not(.is-in) .frow-track i { left: var(--ax); }
        .js .field-map:not(.is-in) .frow-track i.f:not(.p) { background: transparent; box-shadow: inset 0 0 0 1.5px var(--amber); }
        .js .field-map:not(.is-in) .band { opacity: 1; }
        .video-play, .top, .button, .top-cta { transition: none; }
      }
    </style>
  </body>
</html>
