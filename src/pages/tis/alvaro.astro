---
// Landing personalizada para Álvaro Carrillo de Albornoz, director general del
// Instituto Tecnológico Hotelero (ITH). Se llega por el QR de una tarjeta
// entregada en mano. Privada: noindex,nofollow y fuera del sitemap.
//
// No vende una auditoría a ITH. Propone una metodología complementaria
// (Radiografía Digital) para una etapa concreta: descubrir y estructurar
// problemas operativos antes de seleccionar o probar soluciones. Propuesta:
// un piloto colaborativo con 3–5 hoteles y, antes, una primera prueba con 1.
//
// Lenguaje visual: laboratorio de investigación. Puntos, muestras, mapas de
// proceso y patrones que aparecen al comparar. Petróleo para el método, ámbar
// solo para la fricción. Etiquetas en monoespaciada ("Fig.", "H-A").
//
// Verificado a 04/10/2026:
// - Álvaro Carrillo de Albornoz dirige ITH desde 2008 (ithotelero.com/quienes-somos).
// - Pedro Fernández, responsable de Transformación Digital e IA de ITH, en
//   Hosteltur (17/09/2026): elegir la herramienta antes de identificar la
//   necesidad puede acabar "buscando un problema que justifique su implantación".
// - Proyectos ITH: Robotics Club, TechYroom (soluciones en entornos reales), etc.

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  youtube: "wVUZuLMHoyg", // https://youtu.be/wVUZuLMHoyg
  src: "",
  poster: "",
  type: "video/mp4",
  orientation: "horizontal" as "horizontal" | "vertical",
  duracion: "1 min 24 s",
};

const CONTACT_HREF = `https://wa.me/34662423523?text=${encodeURIComponent(
  "Hola Luiz, soy Álvaro Carrillo, de ITH. He visto la propuesta de la Radiografía Digital Hotelera y me gustaría hablarlo.",
)}`;
const CASE_HREF = "/es/portfolio/radiografia-cadena-hotelera-menorca/";
const QUOTE_SRC = "https://www.hosteltur.com/178682_nueva-etapa-de-la-ia-en-los-hoteles-el-verdadero-reto-no-es-tecnologico.html";
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/alvaro/", site).toString();
const ogImage = new URL("/og/alvaro.png", site).toString();
const title = "Álvaro Carrillo × IA Operators | Radiografía Digital Hotelera";
const description = "Una propuesta de piloto de Radiografía Digital Hotelera preparada por IA Operators para ITH.";

const pad = (n: number) => String(n).padStart(2, "0");

const pasoAntes = [
  "entrar en varios hoteles con una misma metodología,",
  "observar cómo funciona realmente el trabajo,",
  "detectar fricciones operativas,",
  "y descubrir qué problemas se repiten.",
];

const soluciones = [
  "IA generativa", "agentes", "automatización", "robotización", "PMS", "CRM", "RMS",
  "business intelligence", "guest experience", "integraciones",
];

const flujo = ["Operación", "Fricción", "Impacto", "Prioridad", "Solución"];

const no = ["No seleccionamos startups.", "No representamos plataformas.", "No buscamos justificar una tecnología."];
const si = ["Seguimos procesos.", "Buscamos trabajo innecesario.", "Y priorizamos oportunidades."];

const areas = ["Captación", "Atención", "Operación", "Gestión"];
const senales = [
  { k: "R", n: "Repetición", d: "Una tarea que se hace una y otra vez." },
  { k: "T", n: "Transferencia", d: "Información o trabajo que pasa entre personas o sistemas." },
  { k: "E", n: "Espera", d: "Un proceso parado a la espera de alguien o de un dato." },
  { k: "I", n: "Inconsistencia", d: "El mismo proceso hecho de formas distintas, o que depende de la memoria de alguien." },
];

const noDeberia = [
  "copiar información",
  "volver a introducir datos",
  "buscar documentos",
  "perseguir aprobaciones",
  "responder una y otra vez la misma pregunta",
  "pasar información de un sistema a otro",
  "preparar informes a mano",
  "comprobar estados constantemente",
];

const muestra = ["A", "B", "C", "D", "E"];
const enCadaHotel = [
  "entrevistaríamos a personas de distintas áreas",
  "mapearíamos los procesos",
  "aplicaríamos el mismo Framework 4×4",
  "identificaríamos fricciones",
  "clasificaríamos las oportunidades",
  "y elaboraríamos una Radiografía individual",
];

const preguntas = [
  "¿Qué fricciones aparecen en varios hoteles?",
  "¿Qué áreas concentran más tareas repetitivas?",
  "¿Dónde hay más dependencia de transferencias manuales?",
  "¿Qué tipos de proceso acumulan más espera?",
  "¿Dónde aparece la IA como solución potencial de verdad?",
  "¿Dónde una integración sencilla resolvería más que la IA?",
  "¿Dónde el problema es de proceso y no de tecnología?",
];

const resultados = [
  "Radiografías individuales para cada hotel participante",
  "un mapa anonimizado de los patrones observados",
  "oportunidades clasificadas por impacto y esfuerzo",
  "casos reales para debatir con el ecosistema tecnológico",
  "pistas sobre dónde tienen sentido la automatización y la IA",
];

const ecoRadiografia = ["Problema identificado", "Prioridad", "Necesidad concreta"];
const ecoIth = ["Ecosistema ITH", "Soluciones", "Piloto"];

const ficha = [
  { k: "Problema", h: "qué ocurre y a quién afecta" },
  { k: "Proceso", h: "dónde aparece, paso a paso" },
  { k: "Frecuencia", h: "cuántas veces y cuándo" },
  { k: "Contexto", h: "tipo de hotel, equipo, temporada" },
  { k: "Impacto potencial", h: "tiempo, errores, esperas" },
  { k: "Restricciones", h: "lo que no se puede tocar" },
  { k: "Sistemas implicados", h: "PMS, CRM, hojas, correo…" },
];

const primerPaso = ["Aplicar la metodología.", "Ver qué encontramos.", "Revisar juntos el resultado."];
const revisado = ["procesos", "sistemas", "aplicaciones", "integraciones", "datos", "oportunidades de automatización"];

// Campo de puntos: cinco operaciones (H-A … H-E) con pasos y fricciones.
// Ilustrativo. En el hero aparecen desalineadas; en el mapa, con la misma
// metodología, las fricciones de las columnas 2, 5 y 6 se alinean.
const COLS = 8;
const patrones = [2, 5, 6];
const hoteles = [
  { k: "A", steps: [0, 1, 2, 3, 4, 5, 6, 7], fr: [2, 5], s: 0.74, o: 5 },
  { k: "B", steps: [0, 1, 2, 3, 5, 6, 7], fr: [2, 6], s: 0.9, o: 0 },
  { k: "C", steps: [0, 2, 3, 4, 5, 6], fr: [3, 5, 6], s: 0.62, o: 24 },
  { k: "D", steps: [0, 1, 2, 4, 5, 7], fr: [2, 5], s: 0.82, o: 13 },
  { k: "E", steps: [0, 1, 2, 3, 4, 6, 7], fr: [0, 2, 6], s: 0.7, o: 9 },
];
const jit = [1.5, -1, 2, -1.5, 0.5, -2, 1, 0];
const clamp = (v: number) => Math.min(100, Math.max(0, v));
const field = hoteles.map((h, hi) => ({
  k: h.k,
  nodes: h.steps.map((c) => ({
    ax: (c / (COLS - 1)) * 100,
    sx: clamp(h.o + (c / (COLS - 1)) * 100 * h.s + jit[(c + hi * 3) % 8]),
    f: h.fr.includes(c),
    p: h.fr.includes(c) && patrones.includes(c),
  })),
}));
const bands = patrones.map((c) => (c / (COLS - 1)) * 100);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="¿Y si buscamos los problemas antes de buscar las soluciones? Radiografía Digital Hotelera: un piloto con 3–5 hoteles." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f5f4ef" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#piloto">El piloto</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="mono eyebrow">Una idea para Álvaro Carrillo e ITH</p>
        <p class="greeting">Álvaro, tengo una propuesta que empieza antes de la tecnología.</p>
        <h1 id="hero-title" class="question">¿Y si buscamos los problemas antes de buscar las soluciones?</h1>
        <p class="sample">
          <span class="sample-dots" aria-hidden="true">{muestra.map((m, i) => <i class:list={{ opt: i > 2 }}></i>)}</span>
          <span>3–5 hoteles. Una misma metodología.</span>
        </p>

        <div class="hero-grid">
          <div class:list={["video", `video-${VIDEO.orientation}`]} data-video data-youtube={VIDEO.youtube || undefined}>
            {VIDEO.src && (
              <video class="video-el" preload="none" playsinline controls poster={VIDEO.poster || undefined} aria-label="Vídeo de Luiz Brazão para Álvaro Carrillo">
                <source src={VIDEO.src} type={VIDEO.type} />
              </video>
            )}
            <button class="video-cover" type="button" data-video-play aria-label={`Reproducir el vídeo de Luiz Brazão, ${VIDEO.duracion}`}>
              <span class="video-grid" aria-hidden="true"></span>
              <span class="video-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
              </span>
              <span class="video-meta">
                <span class="video-time">▶ {VIDEO.duracion}</span>
                <span class="video-who">Luiz Brazão · IA Operators</span>
              </span>
            </button>
            <p class="video-note" data-video-note hidden>El vídeo estará disponible en breve.</p>
          </div>

          <div class="hero-copy">
            <p>ITH lleva años acercando innovación, tecnología y proyectos piloto al sector hotelero.</p>
            <p>La idea que quiero proponerte empieza un paso antes:</p>
            <ol class="hero-steps">{pasoAntes.map((p) => <li>{p}</li>)}</ol>
          </div>
        </div>

        <div class="hero-foot">
          <p class="first"><span>Primero el problema.</span><span class="first-b">Después la tecnología.</span></p>
          <figure class="field field-hero" aria-label="Ilustración: cinco operaciones de hotel vistas por separado, con fricciones dispersas">
            <figcaption class="mono fig">Fig. 00 · Cinco operaciones vistas por separado</figcaption>
            <div class="field-body" aria-hidden="true">
              {field.map((r, ri) => (
                <div class="frow" style={`--r:${ri}`}>
                  <span class="frow-k mono">H-{r.k}</span>
                  <span class="frow-track">{r.nodes.map((n) => <i class:list={{ f: n.f, p: n.p }} style={`--sx:${n.sx.toFixed(1)}%;--ax:${n.ax.toFixed(1)}%`}></i>)}</span>
                </div>
              ))}
            </div>
            <p class="fig-note">Ilustración. Vistas una a una, las fricciones parecen sueltas.</p>
          </figure>
        </div>
      </section>

      <!-- 01 · La pregunta -->
      <section id="pregunta" class="section wrap" aria-labelledby="pregunta-title">
        <div class="split">
          <p class="mono label" data-reveal>01 · La pregunta</p>
          <div>
            <h2 id="pregunta-title" class="h2 h2-pair" data-reveal>
              <span>El sector no necesita más casos de uso inventados.</span>
              <span class="h2-accent">Necesita problemas que merezcan ser resueltos.</span>
            </h2>
            <p class="lede" data-reveal>Hoy hay cientos de soluciones para hoteles:</p>
            <ul class="tags" data-reveal aria-label="Soluciones disponibles">{soluciones.map((s) => <li>{s}</li>)}</ul>
            <p class="lede" data-reveal>Que una tecnología sea interesante no significa que responda a la prioridad operativa de un hotel concreto. Por eso la pregunta previa podría ser otra.</p>
            <ol class="qs" data-reveal>
              <li><span class="mono">1</span>¿Dónde está la fricción?</li>
              <li><span class="mono">2</span>¿Qué impacto tiene?</li>
              <li><span class="mono">3</span><span>Y solo entonces: <b>¿qué tecnología tiene sentido?</b></span></li>
            </ol>
          </div>
        </div>

        <figure class="flow" data-reveal aria-label="Secuencia: operación, fricción, impacto, prioridad, solución">
          <figcaption class="mono fig">Fig. 01 · El orden de las preguntas</figcaption>
          <ol>{flujo.map((f, i) => <li class:list={{ "is-fr": i === 1, "is-sol": i === flujo.length - 1 }} style={`--i:${i}`}><span class="mono">{pad(i + 1)}</span>{f}</li>)}</ol>
        </figure>

        <div class="split">
          <span></span>
          <blockquote class="cite" data-reveal>
            <p>Coincide con algo que Pedro Fernández, responsable de Transformación Digital e IA de ITH, planteaba hace poco: si se elige primero la herramienta, se corre el riesgo de «<em>terminar buscando un problema que justifique su implantación</em>».</p>
            <footer class="mono"><a href={QUOTE_SRC} target="_blank" rel="noopener">Hosteltur, 17/09/2026</a></footer>
          </blockquote>
        </div>
      </section>

      <!-- 02 · Encaje -->
      <section id="encaje" class="band-2" aria-labelledby="encaje-title">
        <div class="section wrap">
          <div class="split">
            <p class="mono label" data-reveal>02 · Encaje</p>
            <div>
              <h2 id="encaje-title" class="h2" data-reveal>No es otro laboratorio de tecnología.</h2>
              <p class="lede" data-reveal>ITH ya tiene experiencia, ecosistema y capacidad para acercar soluciones innovadoras a los hoteles y probarlas en escenarios reales. La Radiografía Digital se ocupa de otra pregunta:</p>
            </div>
          </div>
          <p class="huge" data-reveal>¿Qué problema debería llegar al laboratorio?</p>
          <div class="split">
            <span></span>
            <div class="nosi" data-reveal>
              <ul class="nosi-no">{no.map((t) => <li>{t}</li>)}</ul>
              <ul class="nosi-si">{si.map((t) => <li>{t}</li>)}</ul>
            </div>
          </div>
        </div>
      </section>

      <!-- 03 · Método -->
      <section id="metodo" class="section wrap" aria-labelledby="metodo-title">
        <div class="split">
          <p class="mono label" data-reveal>03 · Método</p>
          <div>
            <h2 id="metodo-title" class="h2" data-reveal>¿Qué observamos?</h2>
            <p class="lede" data-reveal>Cuatro áreas del negocio y cuatro señales de fricción. Es el Framework 4×4 de IA Operators.</p>

            <figure class="mx" data-reveal>
              <figcaption class="mono fig">Fig. 02 · Framework 4×4 de IA Operators</figcaption>
              <div class="mx-grid" role="img" aria-label="Matriz de cuatro por cuatro: Captación, Atención, Operación y Gestión cruzadas con Repetición, Transferencia, Espera e Inconsistencia.">
                <span></span>
                {senales.map((s) => <span class="mx-h"><b class="mono">{s.k}</b><span>{s.n}</span></span>)}
                {areas.map((a, ai) => (
                  <>
                    <span class="mx-a">{a}</span>
                    {senales.map((_, si) => <span class="mx-c" style={`--i:${ai * 4 + si}`}><i></i></span>)}
                  </>
                ))}
              </div>
              <p class="fig-note">16 puntos de observación por hotel.</p>
            </figure>

            <dl class="defs" data-reveal>
              {senales.map((s) => (
                <div><dt><b class="mono">{s.k}</b>{s.n}</dt><dd>{s.d}</dd></div>
              ))}
            </dl>
          </div>
        </div>
      </section>

      <!-- 04 · Enfoque -->
      <section id="enfoque" class="band-2" aria-labelledby="enfoque-title">
        <div class="section wrap">
          <p class="mono label" data-reveal>04 · Enfoque</p>
          <h2 id="enfoque-title" class="h2 h2-pair h2-wide" data-reveal>
            <span class="muted">No preguntamos primero qué se puede automatizar.</span>
            <span>Preguntamos qué trabajo no debería existir.</span>
          </h2>
          <div class="split">
            <span></span>
            <div>
              <ul class="patterns" data-reveal>{noDeberia.map((t, i) => <li style={`--i:${i}`}><span class="mono">P{pad(i + 1)}</span>{t}</li>)}</ul>
              <p class="note" data-reveal>Son patrones que la metodología busca. No damos por hecho que existan en ningún hotel concreto.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 05 · El piloto -->
      <section id="piloto" class="dark" aria-labelledby="piloto-title">
        <div class="section wrap">
          <div class="split">
            <p class="mono label label-ink" data-reveal>05 · Una propuesta para ITH</p>
            <div data-view="pilot">
              <h2 id="piloto-title" class="h2 h2-ink" data-reveal>Radiografía Digital Hotelera</h2>
              <p class="pilot-sub" data-reveal>Un piloto con 3–5 hoteles.</p>
              <p class="note note-ink" data-reveal>3–5 es una cifra de partida para conversar, no algo acordado.</p>
            </div>
          </div>

          <div class="split">
            <p class="mono label label-ink" data-reveal>Muestra</p>
            <div>
              <ol class="slots" data-reveal aria-label="Muestra de tres a cinco hoteles">
                {muestra.map((m, i) => (
                  <li class:list={{ opt: i > 2 }} style={`--i:${i}`}>
                    <span class="mono">Hotel {m}</span>
                    <small>{i > 2 ? "opcional" : " "}</small>
                  </li>
                ))}
              </ol>
              <p class="lede lede-ink" data-reveal>La muestra se definiría junto con ITH. Podría incluir hoteles independientes, pequeñas cadenas u operaciones con características distintas.</p>
            </div>
          </div>

          <div class="split">
            <p class="mono label label-ink" data-reveal>En cada hotel</p>
            <div>
              <ol class="steps" data-reveal>{enCadaHotel.map((t, i) => <li style={`--i:${i}`}><span class="mono">{pad(i + 1)}</span>{t}</li>)}</ol>
              <p class="pilot-out" data-reveal><span class="mono">Salida</span>Una Radiografía individual por hotel.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 06 · Comparar -->
      <section id="comparar" class="section wrap" aria-labelledby="comparar-title">
        <div class="split">
          <p class="mono label" data-reveal>06 · Segunda capa</p>
          <div>
            <p class="pre" data-reveal>Después viene la parte interesante.</p>
            <h2 id="comparar-title" class="mega" data-reveal>Comparar.</h2>
            <p class="lede" data-reveal>Con los diagnósticos individuales hechos, anonimizaríamos los resultados y buscaríamos patrones.</p>
            <p class="mono label q-k" data-reveal>Preguntas que el piloto podría responder</p>
            <ol class="questions" data-reveal>{preguntas.map((q, i) => <li style={`--i:${i}`}><span class="mono">Q{i + 1}</span>{q}</li>)}</ol>
            <p class="note" data-reveal>Hoy no tenemos estas respuestas. Son las preguntas que el piloto intentaría contestar.</p>
          </div>
        </div>
      </section>

      <!-- 07 · Mapa -->
      <section id="mapa" class="band-2" aria-labelledby="mapa-title">
        <div class="section wrap">
          <p class="mono label" data-reveal>07 · Mapa</p>
          <h2 id="mapa-title" class="h2 h2-pair h2-wide" data-reveal>
            <span>De cinco Radiografías puede salir algo más que cinco informes.</span>
            <span class="h2-accent">Puede salir un primer mapa exploratorio.</span>
          </h2>

          <div class="map-grid">
            <ol class="pipe" data-reveal aria-label="Del piloto al mapa exploratorio">
              <li class="pipe-hotels"><span class="mono">Entrada</span><span class="pipe-chips">{muestra.map((m) => <b class="mono">H-{m}</b>)}</span></li>
              <li><span class="mono">Paso 1</span>Datos anonimizados</li>
              <li><span class="mono">Paso 2</span>Patrones</li>
              <li class="pipe-out"><span class="mono">Salida</span>Primer mapa exploratorio de fricciones operativas</li>
            </ol>

            <figure class="field field-map" data-reveal aria-label="Ilustración: las mismas cinco operaciones analizadas con una misma metodología; algunas fricciones se alinean entre hoteles">
              <figcaption class="mono fig">Fig. 04 · Las mismas operaciones, una misma metodología</figcaption>
              <div class="field-body" aria-hidden="true">
                <span class="bands">{bands.map((b) => <span class="band" style={`--ax:${b.toFixed(1)}%`}><b class="mono">patrón</b></span>)}</span>
                {field.map((r, ri) => (
                  <div class="frow" style={`--r:${ri}`}>
                    <span class="frow-k mono">H-{r.k}</span>
                    <span class="frow-track">{r.nodes.map((n) => <i class:list={{ f: n.f, p: n.p }} style={`--sx:${n.sx.toFixed(1)}%;--ax:${n.ax.toFixed(1)}%`}></i>)}</span>
                  </div>
                ))}
              </div>
