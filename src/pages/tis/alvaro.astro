    <script>
      import { initProspectLanding } from "../../scripts/prospect-landing";
      const { track } = initProspectLanding({ landing: "alvaro", gtmId: document.body.dataset.gtm ?? "", videoTitle: "alvaro_luiz", scrollMarks: [50, 90] });

      // view_pilot: una vez, cuando la cabecera del piloto entra de verdad en pantalla.
      const pilot = document.querySelector<HTMLElement>('[data-view="pilot"]');
      if (pilot && "IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) { track("view_pilot", { section: "piloto" }); io.disconnect(); }
        }, { threshold: 0.6 });
        io.observe(pilot);
      }
