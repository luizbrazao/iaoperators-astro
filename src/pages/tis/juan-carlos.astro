---
// Landing personalizada para Juan Carlos Sanjuán, fundador y CEO de Casual
// Hoteles. Se llega por el QR de una tarjeta entregada en mano. Privada:
// noindex,nofollow y fuera del sitemap ("/tis/" en NOINDEX_PATHS).
//
// Concepto: continúa la pregunta "CapEx or TechEx? Where should hotels invest
// first?" con otra anterior: dentro del TechEx, ¿qué primero? El lenguaje
// visual es la priorización: muchas opciones grises que se ordenan y solo tres
// quedan en naranja. Monocromo con el naranja de marca reservado a las
// prioridades. Números grandes y tabulares.
//
// Datos públicos usados (verificados el 04/10/2026):
//   - Agenda TIS 2026: Juan Carlos Sanjuán (CEO & Founder) en "CapEx or TechEx?
//     Where should hotels invest first?", 06/10/2026. No se menciona en la página.
//   - Sivarious, 07/09/2026: cita literal sobre el modelo que nació en Valencia;
//     presencia en España, Portugal, Italia, Grecia y República Dominicana.
//   - Interdiario, 09/09/2026: Bayahíbe ("En Europa crecer cada vez es más difícil").
//   - Web de Casual: propiedad, alquiler, gestión y franquicia.
//   - Nexotur, 2019: IDeaS RMS y análisis de datos para decidir.
// No se cita el número exacto de hoteles ni de habitaciones.
//
// Comportamiento compartido en src/scripts/prospect-landing.ts.

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  src: "",
  poster: "",
  type: "video/mp4",
  orientation: "horizontal" as "horizontal" | "vertical",
  duracion: "55 segundos",
};

const CONTACT_HREF = `https://wa.me/34662423523?text=${encodeURIComponent(
  "Hola Luiz, soy Juan Carlos Sanjuán, de Casual Hoteles. He visto la página sobre la Radiografía Digital y me gustaría hablarlo.",
)}`;
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/juan-carlos/", site).toString();
const ogImage = new URL("/og/juan-carlos.png", site).toString();
const title = "Juan Carlos Sanjuán × IA Operators | Radiografía Digital";
const description = "Una reflexión sobre priorización tecnológica preparada por IA Operators para Juan Carlos Sanjuán y Casual Hoteles.";

const pad = (n: number) => String(n).padStart(2, "0");

const valor = [
  { a: "Una tarea repetitiva", b: "puede merecer automatización." },
  { a: "Dos sistemas desconectados", b: "quizá solo necesiten integrarse." },
  { a: "Un proceso lento", b: "quizá haya que rediseñarlo." },
  { a: "Una decisión compleja", b: "puede beneficiarse de datos o de IA." },
  { a: "Y a veces", b: "el proceso ya funciona bien." },
];

const techex = ["automatización", "IA", "nuevas plataformas", "integraciones", "datos", "experiencia digital"];
const bien = ["Fricción", "Impacto", "Prioridad", "Tecnología"];

const multiplica = [
  "repetirse entre establecimientos",
  "afectar a distintos equipos",
  "aparecer en varios países",
  "replicarse rápido en nuevas aperturas",
];

const pequenas = [
  "Una tarea de pocos minutos.",
  "Una validación manual.",
  "Una transferencia entre departamentos.",
  "Una información que alguien vuelve a introducir.",
  "Una excepción que termina siempre en la misma persona.",
];

const pasos = [
  "Entramos en una parte concreta de la operación.",
  "Hablamos con las personas que ejecutan los procesos.",
  "Seguimos el flujo de trabajo.",
  "Observamos qué información entra y sale.",
  "Identificamos qué sistemas participan.",
  "Detectamos tareas manuales, esperas, transferencias, repeticiones y excepciones.",
];
const criterios = ["Impacto", "Frecuencia", "Esfuerzo", "Riesgo", "Potencial de mejora"];

const areas = ["Captación", "Atención", "Operación", "Gestión"];
const senales = ["Repetición", "Transferencia", "Espera", "Inconsistencia"];

// Campo de 40 ideas: posición dispersa (pseudoaleatoria y estable) → rejilla 8×5.
// Tres de ellas terminan como prioridades.
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const PRIORIDADES: Record<number, number> = { 9: 1, 20: 2, 30: 3 };
const ideas = Array.from({ length: 40 }, (_, i) => {
  const gx = 6 + (i % 8) * 12.5;
  const gy = 10 + Math.floor(i / 8) * 20;
  return { gx, gy, sx: 4 + rnd() * 92, sy: 6 + rnd() * 86, p: PRIORIDADES[i] ?? 0 };
});

// Matriz impacto × esfuerzo con ejemplos abstractos (x: esfuerzo, y: impacto, 0–100).
const puntos = [
  { id: "A", x: 22, y: 78 }, { id: "B", x: 36, y: 66 }, { id: "C", x: 76, y: 66 },
  { id: "D", x: 62, y: 62 }, { id: "E", x: 18, y: 30 }, { id: "F", x: 38, y: 18 },
  { id: "G", x: 70, y: 32 }, { id: "H", x: 86, y: 14 },
];

const tareaA = [
  ["Frecuencia", "una vez al mes"],
  ["Duración", "cinco minutos"],
  ["Errores", "no genera"],
  ["Huésped", "no le afecta"],
  ["Bloqueos", "no bloquea a nadie"],
];
const tareaB = [
  ["Frecuencia", "cientos de veces al día"],
  ["Duración", "pocos minutos"],
  ["Errores", "hay que medirlo"],
  ["Huésped", "hay que medirlo"],
  ["Equipos", "varios departamentos"],
];

const ambitos = ["operación", "atención al huésped", "backoffice", "reservas", "información entre hoteles y central", "gestión interna"];
const objetivo = ["identificar fricciones", "cuantificar su frecuencia", "entender su impacto", "evaluar alternativas"];

const cadena = ["Fricción", "Frecuencia", "Impacto", "Causa", "Prioridad", "Opciones", "Decisión"];
const opciones = ["automatizar", "integrar", "aplicar IA", "cambiar una herramienta", "rediseñar el proceso"];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Antes del próximo TechEx, una pregunta: ¿dónde genera realmente más retorno? Una idea para Juan Carlos Sanjuán." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#fafaf8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><span aria-hidden="true">↗</span> IA Operators</a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="label">Una idea para Juan Carlos Sanjuán</p>
        <h1 id="hero-title" class="greeting">Juan Carlos, antes del próximo <b>TechEx</b> hay una pregunta que me parece más importante.</h1>
        <p class="return-q">¿Dónde genera realmente más retorno?</p>

        <div class="hero-grid">
          <div class:list={["video", `video-${VIDEO.orientation}`]} data-video>
            {VIDEO.src && (
              <video class="video-el" preload="none" playsinline controls poster={VIDEO.poster || undefined} aria-label="Vídeo de Luiz Brazão para Juan Carlos Sanjuán">
                <source src={VIDEO.src} type={VIDEO.type} />
              </video>
            )}
            <button class="video-cover" type="button" data-video-play aria-label={`Reproducir el vídeo de Luiz Brazão, ${VIDEO.duracion}`}>
              <span class="video-dots" aria-hidden="true">{Array.from({ length: 12 }, (_, i) => <i class:list={{ on: i === 4 }}></i>)}</span>
              <span class="video-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
              </span>
              <span class="video-meta">
                <span class="video-time">▶ {VIDEO.duracion}</span>
                <span class="video-who">Luiz Brazão · IA Operators</span>
              </span>
            </button>
            <p class="video-note" data-video-note hidden>El vídeo estará disponible en breve.</p>
          </div>

          <div class="hero-copy">
            <p>Entre automatización, inteligencia artificial, datos, integraciones y nuevas plataformas, hoy existen más posibilidades tecnológicas que capacidad para implementarlas todas.</p>
            <p>Por eso quizá la primera decisión no sea</p>
            <p class="hero-not">qué tecnología incorporar,</p>
            <p>sino</p>
            <p class="hero-yes">qué problema merece inversión primero.</p>
          </div>
        </div>
      </section>

      <!-- Valor -->
      <section id="valor" class="section wrap" aria-labelledby="va-title">
        <p class="label" data-reveal>Valor</p>
        <h2 id="va-title" class="h2" data-reveal>No todas las oportunidades tecnológicas tienen el mismo valor.</h2>
        <ol class="pairs" data-reveal>
          {valor.map((v, i) => (
            <li class:list={{ "pair-last": i === valor.length - 1 }}>
              <span class="pair-a">{v.a}</span>
              <span class="pair-arrow" aria-hidden="true">→</span>
              <span class="pair-b">{v.b}</span>
            </li>
          ))}
        </ol>
        <p class="thesis" data-reveal>
          <span>El reto no es encontrar tecnología.</span>
          <span class="thesis-b">El reto es priorizar dónde utilizarla.</span>
        </p>
      </section>

      <!-- TechEx -->
      <section id="techex" class="night" aria-labelledby="tx-title">
        <div class="wrap section">
          <p class="label label-night" data-reveal>CapEx o TechEx</p>
          <p class="tx-lead" data-reveal>CapEx o TechEx es una gran pregunta.</p>
          <p class="tx-lead tx-lead-2" data-reveal>Pero dentro del TechEx aparece otra.</p>
          <h2 id="tx-title" class="tx-big" data-reveal>¿Qué TechEx primero?</h2>

          <div class="tx-body">
            <p class="tx-text" data-reveal>Antes de invertir en</p>
            <ul class="tx-list" data-reveal>{techex.map((t) => <li>{t}</li>)}</ul>
            <p class="tx-text" data-reveal>conviene saber dónde existe una fricción que justifique la inversión.</p>
          </div>

          <div class="orders">
            <div class="order order-yes" data-reveal>
              <p class="order-label">Proponemos</p>
              <ol class="order-row">
                {bien.map((b, i) => <li class:list={{ "order-tech": i === bien.length - 1 }}>{b}</li>)}
              </ol>
            </div>
            <div class="order order-no" data-reveal style="--d:120ms">
              <p class="order-label">No</p>
              <ol class="order-row">
                <li class="order-tech">Tecnología</li>
                <li>buscar dónde utilizarla</li>
              </ol>
            </div>
          </div>
        </div>
      </section>

      <!-- Casual -->
      <section id="casual" class="section wrap" aria-labelledby="ca-title">
        <div class="split">
          <p class="label label-accent" data-reveal>Casual Hoteles</p>
          <div>
            <h2 id="ca-title" class="h2" data-reveal>En una operación como Casual, esta decisión se vuelve aún más interesante.</h2>
            <div class="facts" data-reveal>
              <p><span class="fact-k">Mercados</span><span class="fact-v">España, Portugal, Italia, Grecia y el salto a Bayahíbe</span></p>
              <p><span class="fact-k">Modelos</span><span class="fact-v">propiedad, alquiler, gestión y franquicia</span></p>
              <p><span class="fact-k">Decisiones</span><span class="fact-v">con revenue management y datos desde hace años</span></p>
            </div>
            <figure class="quote" data-reveal>
              <blockquote>«Demostrar que el modelo que nació en Valencia puede viajar, adaptarse y seguir creciendo en otros mercados.»</blockquote>
              <figcaption>Juan Carlos Sanjuán · septiembre de 2026</figcaption>
            </figure>
            <div class="prose" data-reveal>
              <p>Una organización con hoteles en distintos mercados y distintos modelos de explotación tiene una realidad operativa más compleja que la de un único hotel.</p>
              <p>Una mejora pequeña puede:</p>
            </div>
            <ul class="ticks" data-reveal>{multiplica.map((m) => <li>{m}</li>)}</ul>
            <p class="prose-line" data-reveal>Del mismo modo, una ineficiencia pequeña también puede escalar.</p>
            <p class="statement" data-reveal>Cuando una operación crece, priorizar bien tiene efecto multiplicador.</p>
          </div>
        </div>
      </section>

      <!-- Escala -->
      <section id="escala" class="warm" aria-labelledby="sc-title">
        <div class="wrap section">
          <h2 id="sc-title" class="h2 h2-wide" data-reveal>¿Qué ocurre cuando multiplicamos un proceso por</h2>
          <p class="numbers" data-reveal aria-label="20, 25 o 30 hoteles"><span>20</span><span>25</span><span>30</span><small>hoteles?</small></p>
          <div class="split split-tight">
            <span></span>
            <div>
              <ul class="small-list" data-reveal>{pequenas.map((p) => <li>{p}</li>)}</ul>
              <p class="prose-line" data-reveal>Individualmente pueden parecer pequeñas. Multiplicadas por establecimientos, huéspedes y días:</p>
              <p class="statement statement-plain" data-reveal>pueden convertirse en decisiones de inversión.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Radiografía -->
      <section id="radiografia" class="section wrap" aria-labelledby="rd-title">
        <div class="split">
          <p class="label" data-reveal>Radiografía Digital</p>
          <div>
            <h2 id="rd-title" class="h2" data-reveal>Ahí entra la Radiografía Digital.</h2>
            <p class="lede" data-reveal>Antes de decidir la solución, buscamos el problema que merece ser resuelto.</p>
            <ol class="steps" data-reveal>{pasos.map((p, i) => <li><span class="n">{pad(i + 1)}</span>{p}</li>)}</ol>
            <p class="prose-line" data-reveal>Después evaluamos:</p>
            <ul class="criteria" data-reveal>{criterios.map((c) => <li>{c}</li>)}</ul>
            <p class="statement statement-plain" data-reveal>Solo entonces hablamos de tecnología.</p>
          </div>
        </div>
      </section>

      <!-- Framework 4×4 -->
      <section id="metodo" class="section section-top0 wrap" aria-labelledby="fw-title">
        <div class="split">
          <p class="label" data-reveal>Framework 4×4</p>
          <div>
            <h2 id="fw-title" class="h3" data-reveal>Un método para encontrar fricciones antes de hablar de soluciones.</h2>
            <div class="m44" data-reveal role="table" aria-label="Framework 4×4: cuatro áreas por cuatro señales">
              <div class="m-row m-head" role="row">
                <span role="columnheader"><span class="sr-only">Área</span></span>
                {senales.map((s) => <span role="columnheader"><span class="m-full">{s}</span><span class="m-short" aria-hidden="true">{s.charAt(0)}</span></span>)}
              </div>
              {areas.map((a, r) => (
                <div class="m-row" role="row">
                  <span class="m-area" role="rowheader">{a}</span>
                  {senales.map((s, c) => <span class="m-cell" role="cell" style={`--i:${r * 4 + c}`}><i></i><span class="sr-only">{a} · {s}</span></span>)}
                </div>
              ))}
            </div>
            <p class="m-legend" aria-hidden="true">{senales.map((s) => <span><b>{s.charAt(0)}</b> {s}</span>)}</p>
          </div>
        </div>
      </section>

      <!-- Priorizar -->
      <section id="priorizar" class="night" aria-labelledby="pz-title">
        <div class="wrap section">
          <p class="label label-night" data-reveal>Priorizar</p>
          <p class="tx-lead" data-reveal>Detectar oportunidades es relativamente fácil.</p>
          <h2 id="pz-title" class="tx-big" data-reveal>Priorizar es lo difícil.</h2>

          <div class="prio-grid">
            <figure class="matrix" data-reveal aria-label="Matriz de impacto y esfuerzo con ejemplos abstractos">
              <div class="mx">
                <span class="mx-q mx-q1">Hacer primero</span>
                <span class="mx-q mx-q2">Proyecto estratégico</span>
                <span class="mx-q mx-q3">Evaluar</span>
                <span class="mx-q mx-q4">No prioritario</span>
                {puntos.map((p) => <i class:list={["mx-dot", { hot: p.x < 50 && p.y > 50 }]} style={`left:${p.x}%;bottom:${p.y}%`}><b>{p.id}</b></i>)}
                <span class="mx-axis mx-x">Esfuerzo →</span>
                <span class="mx-axis mx-y">Impacto →</span>
              </div>
              <figcaption>Ejemplos abstractos. No representan proyectos de Casual.</figcaption>
            </figure>

            <figure class="field-fig" data-reveal aria-label="Cuarenta ideas posibles que se ordenan hasta quedar tres prioridades">
              <div class="field">
                {ideas.map((d) => (
                  <i class:list={["idea", { prio: d.p }]} style={`--sx:${d.sx.toFixed(1)}%;--sy:${d.sy.toFixed(1)}%;--gx:${d.gx}%;--gy:${d.gy}%`}>{d.p ? <b>{d.p}</b> : null}</i>
                ))}
              </div>
              <figcaption class="field-cap"><span class="cap-40">40 ideas</span><span class="cap-arrow" aria-hidden="true">→</span><span class="cap-3">3 prioridades</span></figcaption>
            </figure>
          </div>

          <div class="prio-close">
            <p class="tx-text" data-reveal>La Radiografía no busca producir una lista de 40 ideas. Busca ayudar a responder:</p>
            <p class="three-q" data-reveal>¿Qué tres merecen nuestra atención primero?</p>
          </div>
        </div>
      </section>

      <!-- Ejemplo -->
      <section id="ejemplo" class="section wrap" aria-labelledby="ej-title">
        <p class="label" data-reveal>Un ejemplo</p>
        <h2 id="ej-title" class="h2" data-reveal>Porque «automatizable» no significa «prioritario».</h2>
        <div class="compare" data-reveal>
          <div class="task">
            <p class="task-name">Tarea A <span>perfectamente automatizable</span></p>
            <dl>{tareaA.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
            <p class="task-verdict">Quizá no es donde deberíamos invertir.</p>
          </div>
          <div class="task task-b">
            <p class="task-name">Tarea B <span>aparentemente pequeña</span></p>
            <dl>{tareaB.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
            <p class="task-verdict">Puede merecer atención antes.</p>
          </div>
        </div>
        <p class="compare-note" data-reveal>Ejemplo ilustrativo. No describe ningún proceso de Casual.</p>
        <div class="right-q" data-reveal>
          <p class="right-no">La pregunta correcta no es «¿podemos automatizarlo?».</p>
          <p class="right-yes">Es «¿merece la pena hacerlo?».</p>
        </div>
      </section>

      <!-- Independencia -->
      <section id="independencia" class="warm" aria-labelledby="in-title">
        <div class="wrap section">
          <div class="split">
            <p class="label" data-reveal>Independencia</p>
            <div>
              <h2 id="in-title" class="h2" data-reveal>Sin plataforma que justificar.</h2>
              <ul class="nots" data-reveal>
                <li>IA Operators no representa una tecnología hotelera concreta.</li>
                <li>No vendemos un PMS.</li>
                <li>No vendemos un RMS.</li>
                <li>No necesitamos colocar un chatbot.</li>
                <li>Y no necesitamos encontrar artificialmente un caso de uso para la IA.</li>
              </ul>
              <p class="prose-line" data-reveal>Eso permite un análisis independiente.</p>
            </div>
          </div>
          <p class="euro" data-reveal><span class="euro-n">1 €</span><span class="euro-q">Si tuviéramos 1 € de TechEx para invertir, ¿dónde generaría más valor?</span></p>
          <p class="euro-note" data-reveal>Un euro conceptual. No es un cálculo financiero.</p>
        </div>
      </section>

      <!-- Propuesta -->
      <section id="propuesta" class="section wrap" aria-labelledby="pr-title">
        <div class="split">
          <p class="label label-accent" data-reveal>Una idea concreta</p>
          <div>
            <h2 id="pr-title" class="h2 h2-pair" data-reveal>
              <span>No empecemos por toda Casual Hoteles.</span>
              <span class="h2-accent">Empecemos por un proceso.</span>
            </h2>
            <p class="lede" data-reveal>Lo elegiríamos junto con la dirección: un proceso suficientemente relevante y transversal, y lo seguiríamos de principio a fin.</p>
            <p class="prose-line" data-reveal>Podría estar relacionado con:</p>
            <ul class="chips" data-reveal>{ambitos.map((a) => <li>{a}</li>)}</ul>
            <p class="chips-note" data-reveal>Son solo ejemplos. No damos por hecho dónde está la fricción.</p>
            <p class="prose-line" data-reveal>El objetivo:</p>
            <ol class="steps steps-tight" data-reveal>{objetivo.map((o, i) => <li><span class="n">{pad(i + 1)}</span>{o}</li>)}</ol>
            <p class="prose-line" data-reveal>y responder:</p>
            <p class="worth" data-reveal>¿Merece inversión?</p>
          </div>
        </div>
      </section>

      <!-- Resultado -->
      <section id="resultado" class="warm" aria-labelledby="re-title">
        <div class="wrap section">
          <div class="split">
            <p class="label" data-reveal>Resultado</p>
            <div>
              <h2 id="re-title" class="h2" data-reveal>Una decisión antes de una implementación.</h2>
