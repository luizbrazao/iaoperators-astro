      .funnel li { width: var(--w); min-width: 140px; padding: 10px 14px; background: var(--paper); border-left: 3px solid var(--line-strong); font-size: 17px; font-weight: 550; letter-spacing: -.015em; }
      .funnel li:first-child { border-left-color: var(--soft); }
      .funnel li:last-child { border-left-color: var(--orange); background: var(--ink); color: var(--paper); }

      /* Cierre */
      .closing { padding-block: 120px 128px; }
      .cl-1 { font-size: clamp(28px, 3.6vw, 48px); font-weight: 500; letter-spacing: -.045em; color: var(--soft); }
      .cl-2 { margin-top: 28px; font-size: 18px; color: var(--muted); }
      .cl-big { margin-top: 10px; font-size: clamp(56px, 13vw, 190px); font-weight: 500; letter-spacing: -.07em; line-height: .95; }
      .cl-3 { margin-top: 64px; font-size: clamp(19px, 1.8vw, 23px); letter-spacing: -.02em; color: var(--text); }

      /* Conversación */
      .cta { border-top: 1px solid var(--line); }
      .cta-title { max-width: 14em; }
      .cta-copy { margin-top: 20px; max-width: 32em; font-size: 18px; color: var(--muted); }
      .cta-row { display: grid; gap: 36px; margin-top: 40px; }
      .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; width: max-content; min-height: 56px; padding: 0 24px; background: var(--ink); color: var(--paper); font-size: 16px; font-weight: 600; transition: background-color .2s ease; }
      .button:hover { background: var(--orange-ink); }
      .signature { padding-top: 18px; border-top: 1px solid var(--line); max-width: 280px; }
      .signature-name { font-size: 18px; font-weight: 650; letter-spacing: -.02em; }
      .signature-role { font-size: 14px; color: var(--muted); }
      .signature-site { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--orange-ink); }

      /* Pie y consentimiento */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding-block: 26px 30px; font-size: 13px; color: var(--muted); }
      .foot-brand { margin-right: auto; font-weight: 650; color: var(--ink); letter-spacing: -.02em; }
      .foot a:hover { color: var(--ink); }
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; background: var(--night); color: var(--night-text); font-size: 13px; line-height: 1.5; border: 1px solid #3a3a3a; box-shadow: 0 10px 30px rgba(0, 0, 0, .18); }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; }
      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 38px; padding: 0 16px; border: 1px solid #3a3a3a; background: transparent; color: var(--night-text); font: inherit; cursor: pointer; }
      .consent .consent-accept { background: var(--night-text); color: var(--night); border-color: var(--night-text); }

      /* Movimiento: discreto */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }
      .js .field .idea { left: var(--sx); top: var(--sy); transition: left 1.4s var(--ease) .2s, top 1.4s var(--ease) .2s, opacity .6s ease 1.5s, background-color .5s ease 1.4s; }
      .js .field .idea.prio { background: #4a4a48; width: 10px; height: 10px; margin: -5px 0 0 -5px; transition: left 1.4s var(--ease) .2s, top 1.4s var(--ease) .2s, width .4s ease 1.6s, height .4s ease 1.6s, margin .4s ease 1.6s, background-color .4s ease 1.6s; }
      .js .field .idea.prio b { opacity: 0; transition: opacity .3s ease 1.9s; }
      .js .field-fig.is-in .idea { left: var(--gx); top: var(--gy); }
      .js .field-fig.is-in .idea:not(.prio) { opacity: .35; }
      .js .field-fig.is-in .idea.prio { background: var(--orange); width: 30px; height: 30px; margin: -15px 0 0 -15px; }
      .js .field-fig.is-in .idea.prio b { opacity: 1; }
      .idea:not(.prio) { opacity: .35; }
      .js .field .idea:not(.prio) { opacity: 1; }
      .js .field-fig.is-in .idea:not(.prio) { opacity: .35; }
      .js .m-cell i { background: transparent; box-shadow: inset 0 0 0 1px var(--ink); transition: background-color .3s ease calc(.2s + var(--i) * 40ms); }
      .js .m44.is-in .m-cell i { background: var(--ink); }

      @media (min-width: 420px) {
        .top-link { display: inline; }
      }

      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .pairs li { grid-template-columns: minmax(0, 5fr) 40px minmax(0, 6fr); align-items: baseline; gap: 12px; }
        .pair-arrow { display: block; }
        .pair-b { font-size: 19px; }
        .orders { grid-template-columns: 3fr 2fr; }
        .facts p { grid-template-columns: 140px minmax(0, 1fr); align-items: baseline; gap: 16px; }
        .criteria { grid-template-columns: repeat(5, minmax(0, 1fr)); }
        .criteria li:last-child { grid-column: auto; }
        .m-full { display: inline; }
        .m-short, .m-legend { display: none; }
        .compare { grid-template-columns: 1fr 1fr; }
        .euro { grid-template-columns: auto 1fr; align-items: end; gap: 40px; }
        .cta-row { grid-template-columns: auto 1fr; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }

      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 40px; padding-bottom: 116px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 52px; align-items: start; }
        .section { padding-block: 128px; }
        .section-top0 { padding-top: 0; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .prio-grid { grid-template-columns: 1fr 1fr; gap: 72px; align-items: end; }
        .closing { padding-block: 180px 190px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .field .idea { left: var(--gx); top: var(--gy); transition: none; }
        .js .field .idea:not(.prio) { opacity: .35; }
        .js .field .idea.prio { background: var(--orange); width: 30px; height: 30px; margin: -15px 0 0 -15px; transition: none; }
        .js .field .idea.prio b { opacity: 1; transition: none; }
        .js .m-cell i { background: var(--ink); transition: none; }
        .video-play, .top, .button, .top-cta { transition: none; }
      }
    </style>
  </body>
</html>
