---
import PresenterVideo from "../../components/PresenterVideo.astro";
// Landing personalizada para Manuel Pérez, director general de Abba Hoteles.
// Creada el 13/11/2026. Privada: noindex,nofollow y fuera del sitemap
// ("/tis/" en NOINDEX_PATHS).
//
// Sesión de TIS 07/10/2026, 10:30, «Growth Under Pressure: Costs, Talent and
// the Power of Brand», moderada por José Emmanuel (Mano) Soler, de Les Roches
// Marbella, con Víctor Fernández Cintrano (Room Mate) y Gonçalo Rebelo
// Almeida (Vila Galé). La transcripción oficial está en inglés: aquí todo va
// parafraseado en español, sin citas literales. Solo turnos atribuibles:
//   - 07:16-07:49 (tras «Good morning, Manuel»): 25 hoteles, 19 en España,
//     en Chile, México y Andorra; a final de año, el primero en Miami; a final
//     del año que viene, uno en Zarautz; buscan proyectos en capitales
//     europeas.
//   - 10:40-12:44 (la moderadora le repregunta «your current strategy, Abba»):
//     crecer hoy es difícil; a veces hay que decir que no a proyectos;
//     estudiar cada uno producto a producto, si encaja con los valores, el
//     beneficio, el futuro de la ciudad, la ubicación. Los costes van a subir
//     mucho: situación geopolítica, compras, energía, coste laboral.
//   - 23:55-24:51 («Would you like to add anything, Manuel?»): crecer en ADR;
//     mejorar la experiencia y el servicio; usar la tecnología para quitar a
//     los equipos tareas administrativas y que se centren en el cliente. Los
//     costes de personal y energía suben y no están en tu mano.
//   - 29:40-30:43 («From Abba or from Roommate…»; responde «In our case… like
//     Gonzalo, two families that are the owners»): invertir en CapEx, en el
//     servicio y en los equipos (formación). Lo segundo, pelear por reducir el
//     coste de distribución, y eso hay que hacerlo uno mismo. Casi un 45 % de
//     clientes directos; la web propia, un 21 %; hay que aumentarlo, y así
//     tienes tu destino en tus manos.
//   - 37:52-38:27 (cierre, «In ABBA…»): la tecnología solo tiene sentido si
//     resuelve problemas operativos o mejora la experiencia del huésped; la
//     tecnología gestiona el proceso y los equipos hacen la hospitalidad.
//   - No se usa 38:27 en adelante (otro ponente) ni 35:24 (atribución dudosa).
//
// Concepto: 45 % directo, 21 % web: ¿qué pasa con el resto del directo? Es una
// pregunta (hipótesis de trabajo), no un dato: parte puede llegar por
// teléfono, email o mostrador y cuesta horas de recepción. Encaja con sus dos
// palancas: reducir el coste de distribución y quitar tareas administrativas.
// Enlace a /es/hoteles/reservas-directas-ia/ en la sección del directo (aquí
// sí es pertinente).
//
// Comportamiento compartido en src/scripts/prospect-landing.ts.

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  // Vídeo de Luiz con fondo blanco, fundido con la página (PresenterVideo).
  src: "/video/luiz-tis.mp4",
  poster: "/video/luiz-tis-poster.jpg",
  duracion: "1 min 24 s",
};

const wa = (t: string) => `https://wa.me/34662423523?text=${encodeURIComponent(t)}`;
const CONTACT_HREF = wa("Hola Luiz, soy Manuel Pérez, de Abba Hoteles. He visto la página que preparaste después de TIS y me gustaría hablarlo.");
const INTRO_HREF = wa("Hola Luiz, soy Manuel Pérez, de Abba Hoteles. Te pongo en contacto con la persona adecuada: ");
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/manuel/", site).toString();
const ogImage = new URL("/og/manuel.png", site).toString();
const title = "Manuel Pérez × IA Operators | Radiografía Digital";
const description = "Después de «Growth Under Pressure» en TIS: un 45 % de clientes directos y un 21 % por la web. Qué pasa con el resto, y cuánto tiempo de los equipos cuesta. Una reflexión preparada por IA Operators para Manuel Pérez y Abba Hoteles.";

const pad = (n: number) => String(n).padStart(2, "0");

const fuera = ["Coste de la energía", "Coste laboral", "Compras", "Situación geopolítica"];
const dentro = ["Coste de distribución", "ADR", "Tiempo de los equipos", "Experiencia del huésped"];

const datos = [
  { n: "25", k: "hoteles", s: "19 de ellos en España" },
  { n: "~45 %", k: "clientes directos", s: "según contaste en la mesa" },
  { n: "21 %", k: "por la web propia", s: "y el objetivo es subirlo" },
  { n: "Miami", k: "próxima apertura", s: "el primero en Estados Unidos" },
];

const pasos = [
  "Elegimos un hotel y una semana normal de recepción y reservas.",
  "Vemos qué tareas administrativas ocupan al equipo y cuánto tiempo se llevan.",
  "Reconstruimos por dónde entra cada reserva directa y cuánto trabajo manual lleva detrás.",
  "Te decimos qué tareas sobran, cuáles se pueden automatizar y qué parte del directo podría pasar a la web, con el coste de cada canal.",
];

const reservas = [
  { k: "Directa por web", d: "entra sola en el PMS" },
  { k: "Directa por teléfono", d: "alguien la teclea" },
  { k: "Directa por email", d: "ida y vuelta de correos" },
];
const tramo = ["Consulta", "Respuesta", "Reserva", "Pago", "PMS"];
const friccion: Record<number, number[]> = { 0: [], 1: [1, 2, 4], 2: [0, 1, 2, 3, 4] };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="45 % directo, 21 % web. ¿Y el resto? Una idea para Manuel Pérez y Abba Hoteles." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f6f5f1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-link top-link-x" href="/es/hoteles/" data-cta="nav_hoteles">Hoteles</a>
          <a class="top-link top-link-x" href="/es/hoteles/reservas-directas-ia/" data-cta="nav_reservas_directas">Reservas directas</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header" data-cta-event="click_contact">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="label">Después de «Growth Under Pressure» · TIS 2026</p>
        <h1 id="hero-title" class="greeting">Manuel, en TIS diste dos cifras que pocas cadenas dicen en público: <b>casi un 45 % de clientes directos, y un 21 % por vuestra web.</b></h1>
        <p class="big">45 % directo. 21 % web.<span>¿Y el resto?</span></p>

        <div class="hero-grid">
          <PresenterVideo src={VIDEO.src} poster={VIDEO.poster} label="Vídeo de Luiz Brazão para Manuel Pérez" duracion={VIDEO.duracion} />

          <div class="hero-copy">
            <p>Te escuché en la mesa que moderó Mano Soler, de Les Roches, con Víctor Fernández y Gonçalo Rebelo.</p>
            <p>Dijiste que lo que toca pelear es reducir el coste de distribución, que eso hay que hacerlo uno mismo, y que así el destino lo tienes en tus manos. Y antes, que la tecnología debería quitar a los equipos tareas administrativas para que se centren en el cliente.</p>
            <p class="hero-strong">Me gustaría proponerte mirar justo donde se cruzan esas dos ideas.</p>
          </div>
        </div>
      </section>

      <!-- Mano -->
      <section id="en-tu-mano" class="section wrap" aria-labelledby="ma-title">
        <div class="split">
          <p class="label label-accent" data-reveal>01 · En tu mano</p>
          <div>
            <h2 id="ma-title" class="h2" data-reveal>Hay costes que no están en tu mano.</h2>
            <p class="lede" data-reveal>Lo explicaste sin rodeos: la energía, el coste laboral, las compras y la situación geopolítica van a seguir apretando. Puedes tomar decisiones para contenerlos, pero no los controlas.</p>
            <figure class="duo" data-reveal aria-label="Lo que no está en tu mano y lo que sí, según lo que contó en la mesa">
              <div class="duo-col">
                <p class="duo-k">No está en tu mano</p>
                <ul>{fuera.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}</ul>
              </div>
              <div class="duo-col duo-you">
                <p class="duo-k">Sí está en tu mano</p>
                <ul>{dentro.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}</ul>
              </div>
              <figcaption>Ordenado a partir de lo que contaste en la mesa.</figcaption>
            </figure>
            <p class="statement" data-reveal>
              <span class="muted">Los costes suben solos.</span>
              <span>La distribución y el tiempo de los equipos se pueden trabajar.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Directo -->
      <section id="directo" class="panel" aria-labelledby="di-title">
        <div class="wrap section">
          <div class="split">
            <p class="label" data-reveal>02 · El directo</p>
            <div>
              <h2 id="di-title" class="h2" data-reveal>Entre el 45 % y el 21 % hay 24 puntos.</h2>
              <p class="lede" data-reveal>Son clientes que ya son vuestros y no llegan por la web. Algunos serán empresas o acuerdos directos. Otros, probablemente, llamadas, correos y consultas en el mostrador que alguien atiende y teclea.</p>
              <figure class="mix" data-reveal aria-label="Reparto de clientes: 21 % web propia, unos 24 puntos de directo que no entra por la web y el resto intermediado">
                <div class="mix-bar">
                  <span class="mix-web" style="--w:21%"><b>21 %</b></span>
                  <span class="mix-dir" style="--w:24%"><b>~24 %</b></span>
                  <span class="mix-int" style="--w:55%"><b>~55 %</b></span>
                </div>
                <figcaption>
                  <span class="cap-web">Web propia</span>
                  <span class="cap-dir">Directo que no entra por la web</span>
                  <span class="cap-int">Intermediado</span>
                </figcaption>
                <p class="mix-note">Las cifras de directo y web son las que diste en la mesa. Cómo se reparten esos 24 puntos es una pregunta, no un dato.</p>
              </figure>
              <p class="prose-line prose-ink" data-reveal>Si una parte de ese directo entra a mano, es directo en el coste de distribución, pero no en el tiempo de los equipos. Y es justo el tiempo que dijiste que queríais devolver al cliente.</p>
              <p class="prose-line" data-reveal>Para la parte de esas consultas que podría acabar en la web, así planteamos un asistente que contesta, lleva al huésped a vuestro motor y no toca el precio: <a class="inline-link" href="/es/hoteles/reservas-directas-ia/" data-cta="reservas_directas">reservas directas con IA</a>.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Regla -->
      <section id="regla" class="night" aria-labelledby="re-title">
        <div class="wrap section">
          <p class="label label-night" data-reveal>03 · La regla de Abba</p>
          <h2 id="re-title" class="h2 h2-wide" data-reveal>La tecnología solo tiene sentido si resuelve un problema operativo o mejora la experiencia del huésped.</h2>
          <dl class="stats" data-reveal>
            {datos.map((d) => (
              <div>
                <dt>{d.k}</dt>
                <dd><b>{d.n}</b><span>{d.s}</span></dd>
              </div>
            ))}
          </dl>
          <p class="stats-src" data-reveal>Datos que compartiste en la mesa.</p>
          <div class="split split-tight">
            <span></span>
            <div>
              <p class="prose-line prose-night" data-reveal>Fue tu cierre. Y lo completaste con una idea que suscribo entera: la tecnología gestiona el proceso, pero la hospitalidad la hacen los equipos.</p>
              <p class="prose-line prose-night" data-reveal>Con Miami a final de año y Zarautz detrás, cada hotel nuevo hereda la forma de trabajar de los demás. Si en recepción hay horas que se van en teclear, se multiplican con la cadena.</p>
            </div>
          </div>
          <p class="huge" data-reveal>La tecnología, al proceso. Las personas, al huésped.</p>
        </div>
      </section>

      <!-- Radiografía -->
      <section id="radiografia" class="panel" aria-labelledby="rd-title">
        <div class="wrap section">
          <div class="split">
            <p class="label label-accent" data-reveal>04 · Radiografía Digital</p>
            <div>
              <h2 id="rd-title" class="h2" data-reveal>Encontrar las horas que se van en tareas que no ve el huésped.</h2>
              <p class="lede" data-reveal>Una Radiografía Digital no evalúa proveedores ni propone una plataforma. Sigue el trabajo real de un hotel a través de los sistemas y las personas que lo hacen.</p>
              <ol class="steps" data-reveal>{pasos.map((p, i) => <li><span class="n">{pad(i + 1)}</span>{p}</li>)}</ol>
              <p class="prose-line" data-reveal>El resultado no es una lista de ideas. Es saber cuánto tiempo del equipo se va en tareas administrativas, cuánto cuesta de verdad cada canal directo y qué cambiar primero.</p>
              <p class="prose-line" data-reveal>En una cadena de cuatro hoteles en Menorca, la dirección declaraba unas 25 herramientas. Encontramos 47, y un 23 % del gasto en SaaS que se podía recortar. <a class="inline-link" href="/es/portfolio/radiografia-cadena-hotelera-menorca/" data-cta="case">Ver el caso</a></p>
              <ul class="nots" data-reveal>
                <li>No tocamos la hospitalidad: esa es de tu equipo.</li>
                <li>No vendemos un PMS ni un motor de reservas.</li>
                <li>No tenemos una plataforma que colocar.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Propuesta -->
      <section id="propuesta" class="section wrap" aria-labelledby="pr-title">
        <div class="split">
          <p class="label label-accent" data-reveal>Una idea concreta</p>
          <div>
            <h2 id="pr-title" class="h2 h2-pair" data-reveal><span>No empecemos por los 25 hoteles.</span><span class="h2-accent">Empecemos por una semana de recepción.</span></h2>
            <p class="lede" data-reveal>Un hotel, una semana. ¿Por dónde entran las reservas directas que no vienen de la web? ¿Cuánto trabajo manual lleva cada una? ¿Y qué otras tareas administrativas se comen el tiempo del equipo?</p>
            <figure class="cmp" data-reveal aria-label="Ejemplo ilustrativo: tres reservas directas y los tramos que se hacen a mano">
              {reservas.map((h, r) => (
                <div class="cmp-row">
                  <p class="cmp-k"><b>{h.k}</b><span>{h.d}</span></p>
                  <ol class="cmp-steps">
                    {tramo.map((p, c) => <li class:list={{ hot: friccion[r].includes(c) }} style={`--i:${r * 5 + c}`}>{p}</li>)}
                  </ol>
                </div>
              ))}
              <figcaption>Ejemplo ilustrativo. En naranja, los tramos que hace una persona a mano.</figcaption>
            </figure>
            <p class="prose-line" data-reveal>Lo haríamos con el director del hotel y su equipo de recepción, sin parar la operación.</p>
            <p class="worth" data-reveal>¿Cuántas horas de recepción se van en teclear?</p>
          </div>
        </div>
      </section>

      <!-- Cierre -->
      <section id="cierre" class="closing wrap" aria-labelledby="ci-title">
        <p class="cl-1" data-reveal>La energía no está en tu mano.</p>
        <h2 id="ci-title" class="cl-big" data-reveal>El tiempo de tus equipos, sí.</h2>
        <p class="cl-3" data-reveal>Ese es el trabajo que me gustaría enseñarte, o enseñar a quien lleve la operación en Abba.</p>
      </section>

      <!-- CTA -->
      <section id="hablar" class="cta" aria-labelledby="cta-title">
        <div class="wrap section">
          <h2 id="cta-title" class="h2 cta-title" data-reveal>Si te parece una conversación útil, seguimos.</h2>
          <p class="cta-copy" data-reveal>En 20 minutos puedo enseñarte cómo hacemos una Radiografía Digital y un ejemplo real en una cadena hotelera.</p>
          <div class="cta-row" data-reveal>
            <div class="buttons">
              <a class="button" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="final" data-cta-event="click_contact">Hablar con Luiz <span aria-hidden="true">↗</span></a>
              <a class="button button-ghost" href={INTRO_HREF} target="_blank" rel="noopener" data-cta="intro" data-cta-event="click_introduction">Presentarme a la persona adecuada <span aria-hidden="true">↗</span></a>
            </div>
            <div class="signature">
              <p class="signature-name">Luiz Brazão</p>
              <p class="signature-role">Founder, IA Operators</p>
              <a class="signature-site" href="https://iaoperators.com/es/" data-cta="site">iaoperators.com</a>
            </div>
          </div>
        </div>
      </section>
    </main>


    <footer class="foot">
      <div class="wrap foot-inner">
        <span class="foot-brand"><img src="/brand/ia-operators-logo.png" alt="IA Operators" width="453" height="82" loading="lazy" /></span>
        <a href="/es/auditoria-de-sistemas/">Radiografía Digital</a>
        <a href="https://iaoperators.com/es/">iaoperators.com</a>
      </div>
    </footer>

    <div class="consent" data-consent hidden role="region" aria-label="Cookies">
      <p>Usamos cookies para medir y mejorar la experiencia. Puedes aceptar o rechazar. <a href="/es/politica-de-privacidad/">Política de Privacidad</a>.</p>
      <div class="consent-actions">
        <button type="button" data-consent-reject>Rechazar</button>
        <button type="button" class="consent-accept" data-consent-accept>Aceptar</button>
      </div>
    </div>

    <script>
      import { initProspectLanding } from "../../scripts/prospect-landing";
      initProspectLanding({ landing: "manuel", gtmId: document.body.dataset.gtm ?? "", videoTitle: "manuel_luiz", scrollMarks: [50, 90] });
    </script>

    <style is:global>
      @font-face {
        font-family: "Manrope JG";
        src: url("/fonts/manrope-latin-variable.woff2") format("woff2");
        font-weight: 200 800;
        font-display: swap;
      }
      :root {
        --paper: #f6f5f1;
        --panel: #ecebe5;
        --ink: #15171a;
        --text: #2c2f33;
        --muted: #62666b;
        --soft: #9a9da1;
        --line: #dfded8;
        --line-strong: #c3c2bb;
        --slate: #24425a;
        --slate-soft: #9fb2c1;
        --orange: #f16532;
        --orange-ink: #b4441a;
        --night: #121417;
        --night-text: #f1f1ee;
        --night-line: #2b2f34;
        --gutter: 20px;
        --ease: cubic-bezier(.2, .7, .2, 1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 72px; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Manrope JG", "Helvetica Neue", Arial, sans-serif; font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums; }
      h1, h2, h3, p, ol, ul, dl, dd, figure, blockquote { margin: 0; }
      ol, ul { padding: 0; list-style: none; }
      a { color: inherit; text-decoration: none; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
      .wrap { width: 100%; max-width: 1240px; margin-inline: auto; padding-inline: var(--gutter); }
      .label { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .label::before { content: ""; width: 7px; height: 7px; background: var(--slate); }
      .label-accent::before { background: var(--orange); }
      .label-night { color: #9a9ea3; }
      .label-night::before { background: var(--slate-soft); }
      .muted { color: var(--soft); }

      /* Cabecera */
      .top { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid transparent; transition: background-color .3s ease, border-color .3s ease; }
      .top.is-scrolled { background: rgba(246, 245, 241, .9); border-bottom-color: var(--line); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
      .top-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 60px; }
      .wordmark img { display: block; width: auto; height: 22px; }
      .foot-brand img { display: block; width: auto; height: 18px; }
      .top-nav { display: flex; align-items: center; gap: 22px; font-size: 13px; }
      .top-link { display: none; color: var(--muted); }
      .top-link:hover { color: var(--ink); }
      .top-cta { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; background: var(--slate); color: var(--night-text); font-weight: 600; white-space: nowrap; transition: background-color .2s ease; }
      .top-cta:hover { background: var(--ink); }

      /* Hero */
      .hero { padding-top: 18px; padding-bottom: 72px; }
      .greeting { margin-top: 14px; max-width: 24em; font-size: clamp(19px, 2.2vw, 28px); font-weight: 500; letter-spacing: -.028em; line-height: 1.28; color: var(--text); }
      .greeting b { font-weight: 700; color: var(--slate); }
      .big { display: grid; gap: 2px; margin-top: 18px; max-width: 13em; font-size: clamp(34px, 6.6vw, 94px); font-weight: 500; letter-spacing: -.058em; line-height: 1; color: var(--soft); }
      .big span { color: var(--ink); }
      .hero-grid { display: grid; gap: 28px; margin-top: 28px; }
      .hero-copy { display: grid; gap: 10px; align-content: start; color: var(--muted); }
      .hero-copy p { max-width: 32em; }
      .hero-strong { margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--line-strong); font-size: clamp(20px, 2vw, 25px); font-weight: 500; letter-spacing: -.03em; line-height: 1.28; color: var(--ink); }

      /* Secciones */
      .section { padding-block: 88px; }
      .panel { background: var(--panel); }
      .night { background: var(--night); color: var(--night-text); }
      .split { display: grid; gap: 18px; }
      .split > .label { align-self: start; padding-top: 10px; }
      .split-tight { margin-top: 40px; }
      .h2 { margin-top: 0; font-size: clamp(30px, 4.4vw, 58px); font-weight: 500; letter-spacing: -.05em; line-height: 1.07; max-width: 15em; }
      section > .wrap > .h2, .section > .h2 { margin-top: 16px; }
      .h2-wide { max-width: 19em; }
      .h2-pair { display: grid; gap: 4px; }
      .h2-accent { color: var(--orange-ink); }
      .lede { margin-top: 20px; max-width: 30em; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.45; letter-spacing: -.018em; color: var(--text); }
      .prose-line { margin-top: 22px; max-width: 36em; color: var(--muted); }
      .prose-ink { color: var(--text); font-size: 18px; }
      .prose-night { color: #b9bcc0; }
      .statement { display: grid; gap: 2px; margin-top: 40px; font-size: clamp(25px, 3.2vw, 42px); font-weight: 500; letter-spacing: -.045em; line-height: 1.12; max-width: 17em; }
      .statement::before { content: ""; display: block; width: 40px; height: 3px; margin-bottom: 16px; background: var(--orange); }
      .huge { margin-top: 72px; font-size: clamp(36px, 7vw, 100px); font-weight: 500; letter-spacing: -.062em; line-height: 1; max-width: 12em; }
      .n { flex: 0 0 26px; font-size: 12px; font-weight: 650; color: var(--soft); }

      /* Filtro */
      .filter { margin-top: 36px; border-top: 1px solid var(--ink); }
      .filter li { display: flex; gap: 14px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); }
      .filter-q { font-size: clamp(21px, 2.3vw, 30px); font-weight: 500; letter-spacing: -.035em; line-height: 1.18; }
      .filter-d { margin-top: 4px; max-width: 36em; font-size: 16px; color: var(--muted); }
      .filter-last .n { color: var(--orange); }
      .filter-last .filter-q { color: var(--slate); }

      /* Abba */
      .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 44px; background: var(--night-line); border: 1px solid var(--night-line); }
      .stats div { padding: 18px 14px; background: var(--night); }
      .stats dt { font-size: 11px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: #9a9ea3; }
      .stats dd b { display: block; margin-top: 6px; font-size: clamp(40px, 6vw, 76px); font-weight: 500; letter-spacing: -.06em; line-height: 1; color: var(--night-text); }
      .stats dd span { display: block; margin-top: 8px; font-size: 13px; color: #9a9ea3; }
      .quote blockquote { font-size: clamp(21px, 2.3vw, 29px); font-weight: 400; letter-spacing: -.03em; line-height: 1.3; max-width: 24em; }
      .quote figcaption { margin-top: 10px; font-size: 13px; color: #9a9ea3; }
      .night .huge { color: var(--night-text); }

      /* Radiografía */
      .steps { margin-top: 28px; border-top: 1px solid var(--line-strong); }
      .steps li { display: flex; gap: 14px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line-strong); font-size: clamp(18px, 1.7vw, 21px); letter-spacing: -.02em; }
      .nots { margin-top: 28px; }
      .nots li { padding: 8px 0; font-size: 16px; color: var(--muted); }
      .nots li::before { content: "·"; margin-right: 10px; color: var(--slate); font-weight: 700; }

      /* Propuesta */
      .cmp { margin-top: 32px; display: grid; gap: 14px; }
      .cmp-row { display: grid; gap: 8px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
      .cmp-k b { font-size: 16px; font-weight: 650; }
      .cmp-k span { margin-left: 10px; font-size: 14px; color: var(--muted); }
      .cmp-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
      .cmp-steps li { padding: 8px 4px; border: 1px solid var(--slate-soft); border-radius: 6px; background: var(--paper); text-align: center; font-size: 12px; font-weight: 600; color: var(--slate); }
      .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }
      .cmp figcaption { font-size: 13px; color: var(--soft); }
      .worth { margin-top: 10px; font-size: clamp(38px, 6.6vw, 90px); font-weight: 500; letter-spacing: -.06em; line-height: 1; color: var(--orange-ink); }

      /* Reparto */
      .duo { display: grid; gap: 12px; margin-top: 36px; }
      .duo-col { padding: 18px; border: 1px solid var(--line-strong); border-radius: 14px; background: var(--paper); }
      .duo-you { border-color: var(--orange); background: rgba(241, 101, 50, .06); }
      .duo-k { margin-bottom: 10px; font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .duo-you .duo-k { color: var(--orange-ink); }
      .duo ul { display: grid; gap: 8px; }
      .duo li { position: relative; padding-left: 20px; font-size: 16px; line-height: 1.35; }
      .duo li::before { content: ""; position: absolute; left: 2px; top: .5em; width: 8px; height: 8px; border-radius: 50%; background: var(--line-strong); }
      .duo-col:not(.duo-you) li { color: var(--muted); }
      .duo-you li::before { background: var(--orange); }
      .duo figcaption { font-size: 13px; color: var(--soft); }

      /* Mezcla de canales */
      .mix { margin-top: 36px; padding: 18px; border: 1px solid var(--line-strong); border-radius: 16px; background: var(--paper); }
      .mix-bar { display: flex; height: 54px; border-radius: 8px; overflow: hidden; }
      .mix-bar span { position: relative; width: var(--w); display: flex; align-items: center; justify-content: center; }
      .mix-bar b { font-size: 14px; font-weight: 650; }
      .mix-web { background: var(--slate); color: var(--night-text); }
      .mix-dir { background: repeating-linear-gradient(135deg, rgba(241, 101, 50, .22) 0 6px, rgba(241, 101, 50, .1) 6px 12px); color: var(--orange-ink); border-left: 2px solid var(--paper); border-right: 2px solid var(--paper); }
      .mix-int { background: var(--line); color: var(--muted); }
      .mix figcaption { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 14px; font-size: 11px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
      .cap-web::before, .cap-dir::before, .cap-int::before { content: ""; display: inline-block; width: 10px; height: 10px; margin-right: 7px; border-radius: 2px; vertical-align: middle; }
      .cap-web::before { background: var(--slate); }
      .cap-dir::before { background: rgba(241, 101, 50, .4); }
      .cap-int::before { background: var(--line-strong); }
      .mix-note { margin-top: 10px; font-size: 13px; color: var(--soft); }
      .stats-src { margin-top: 12px; font-size: 13px; color: #7d8187; }
      .stats dd b { font-size: clamp(34px, 4.6vw, 62px); }
      .night .huge { max-width: 13em; }

      /* Cierre */
      .closing { padding-block: 120px 128px; }
      .cl-1 { font-size: clamp(28px, 3.6vw, 48px); font-weight: 500; letter-spacing: -.045em; color: var(--soft); }
      .cl-big { margin-top: 10px; max-width: 10em; font-size: clamp(52px, 11vw, 160px); font-weight: 500; letter-spacing: -.07em; line-height: .95; }
      .cl-3 { margin-top: 56px; max-width: 30em; font-size: clamp(19px, 1.8vw, 23px); letter-spacing: -.02em; color: var(--text); }

      /* CTA */
      .cta { border-top: 1px solid var(--line); }
      .cta-title { max-width: 14em; }
      .cta-copy { margin-top: 20px; max-width: 32em; font-size: 18px; color: var(--muted); }
      .cta-row { display: grid; gap: 36px; margin-top: 40px; }
      .buttons { display: grid; gap: 10px; justify-items: start; }
      .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 56px; padding: 0 24px; background: var(--slate); color: var(--night-text); font-size: 16px; font-weight: 600; transition: background-color .2s ease, color .2s ease; }
      .button:hover { background: var(--ink); }
      .button-ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
      .button-ghost:hover { background: var(--ink); color: var(--paper); }
      .signature { padding-top: 18px; border-top: 1px solid var(--line); max-width: 280px; }
      .signature-name { font-size: 18px; font-weight: 650; letter-spacing: -.02em; }
      .signature-role { font-size: 14px; color: var(--muted); }
      .signature-site { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--slate); }

      /* Pie y consentimiento */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding-block: 26px 30px; font-size: 13px; color: var(--muted); }
      .foot-brand { margin-right: auto; }
      .foot a:hover { color: var(--ink); }
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; background: var(--night); color: var(--night-text); font-size: 13px; line-height: 1.5; border: 1px solid #3a3d42; box-shadow: 0 10px 30px rgba(0, 0, 0, .18); }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; }
      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 38px; padding: 0 16px; border: 1px solid #3a3d42; background: transparent; color: var(--night-text); font: inherit; cursor: pointer; }
      .consent .consent-accept { background: var(--night-text); color: var(--night); border-color: var(--night-text); }

      /* Movimiento */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }
      .js .cmp-steps li.hot { background: var(--paper); border-color: var(--slate-soft); color: var(--slate); transition: background-color .4s ease calc(.3s + var(--i) * 50ms), border-color .4s ease calc(.3s + var(--i) * 50ms), color .4s ease calc(.3s + var(--i) * 50ms); }
      .js .cmp.is-in .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }

      .js .duo-you li { opacity: .2; transition: opacity .45s ease calc(.4s + var(--i) * 180ms); }
      .js .duo.is-in .duo-you li { opacity: 1; }
      .js .mix .mix-bar span { transform: scaleX(0); transform-origin: left; transition: transform .6s var(--ease); }
      .js .mix .mix-web { transition-delay: .2s; }
      .js .mix .mix-dir { transition-delay: .6s; }
      .js .mix .mix-int { transition-delay: 1s; }
      .js .mix.is-in .mix-bar span { transform: none; }

      @media (min-width: 420px) {
        .top-link { display: inline; }
        .cmp-steps li { font-size: 13px; }
      }
      .top-nav .top-link-x { display: none; }
      @media (min-width: 900px) {
        .top-nav .top-link-x { display: inline; }
      }
      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .duo { grid-template-columns: 1fr 1fr; }
        .duo figcaption { grid-column: 1 / -1; }
        .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .stats div { padding: 22px 18px; }
        .cmp-row { grid-template-columns: 210px minmax(0, 1fr); align-items: center; gap: 16px; }
        .cmp-k span { display: block; margin-left: 0; }
        .cta-row { grid-template-columns: auto 1fr; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }
      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 40px; padding-bottom: 116px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 52px; align-items: start; }
        .section { padding-block: 128px; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .closing { padding-block: 180px 190px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .duo-you li { opacity: 1; transition: none; }
        .js .mix .mix-bar span { transform: none; transition: none; }
        .js .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); transition: none; }
        .top, .button, .top-cta { transition: none; }
      }
      .inline-link { color: var(--slate); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
      .inline-link:hover { color: var(--ink); }
    </style>
  </body>
</html>
