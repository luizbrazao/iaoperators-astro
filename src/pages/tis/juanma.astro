---
import PresenterVideo from "../../components/PresenterVideo.astro";
// Landing personalizada para Juanma García, director comercial y de revenue
// (CCO) de One Shot Hotels: cadena urbana independiente, España y Portugal.
// Creada el 13/11/2026. Privada: noindex,nofollow y fuera del sitemap
// ("/tis/" en NOINDEX_PATHS).
//
// Sesión de TIS 07/10/2026, 15:30, «AI in hotel marketing: intelligent
// segmentation or noise automation?», moderada por Francisca García (Casa
// 1800), con Judit Segura (Spirit) y Milton León (Cometa Web). Verificado
// contra la transcripción oficial del vídeo (13/11/2026). Solo se usa lo que
// con seguridad dijo Juanma, parafraseado salvo citas cortas:
//   - 05:23-06:59: la IA, de momento, abarata la producción del ruido, no lo
//     minimiza. No pensar en la IA como una herramienta más del stack: PMS,
//     CRS y CRM añaden su capa de IA y «corremos el riesgo de tener muchas IAs
//     que no miren por el negocio». Prefiere «una IA transversal que me ayude
//     a tomar decisiones». «Una campaña puede tener un ROAS bueno, pero no ser
//     una decisión comercial buena». La segmentación la hará la IA tan rápido
//     que será un commodity; si todos personalizamos todo, la personalización
//     dejará de ser ventaja.
//   - 13:55-16:18: la IA puede democratizar el descubrimiento (oportunidades
//     para independientes y cadenas pequeñas); más prudente con la
//     democratización de la distribución: no tenemos la capacidad
//     transaccional de Booking o Expedia; cada escaparate nuevo acaba
//     monetizado (buscador, metabuscador, comparador, turoperador) y aparece
//     un «fee» de marketing, «el comodín que al final monetiza». Desde una
//     situación «controlada y privilegiada» por años de venta directa muy
//     alta: no solo preocupa aparecer en los buscadores de IA, «me preocupa
//     más quién va a ser el dueño de esa transacción». ¿Qué es el canal
//     directo? Desvincularlo quizá de la web propia: un agente de IA podría
//     entrar en el PMS, jugar con el inventario, negociar el precio. Canal
//     directo = controlar al cliente, por dónde ha venido, conocer el coste.
//     «Unas capas tecnológicas, unas capas económicas que podemos llegar a
//     desconocer».
//   - 25:37-26:18 (cierre, tras «Juanma» de la moderadora): la IA puede dar
//     más capacidad de competir, pero en marketing puede estandarizar las
//     campañas y crear más dependencias; tener en el radar esas dependencias.
//   - No se usa 20:20 ni 22:09-22:43 (explicabilidad, «límite de delegación»,
//     gobernanza): atribución dudosa.
// Datos públicos: Hosteltur 16/01/2026 (más de 30 M€ de facturación en 2025,
// +12 %; EBITDA 7,5 M€; 14 hoteles con One Shot La Latina; Ibiza, Bilbao y
// Lisboa en 2026). La Voz de Ibiza 13/02/2026 (más del 50 % de reservas
// directas; One Shot Friends, más de 70.000 usuarios; Juanma García, director
// comercial y de revenue). No se menciona la Alianza Hotelera.
//
// Concepto: «¿quién es el dueño de la transacción?». Radiografía de las capas
// tecnológicas y económicas entre el huésped y el margen, empezando por una
// muestra de reservas directas de un hotel. Enlace suave a
// /es/hoteles/reservas-directas-ia/ en la sección del canal directo.
//
// Comportamiento compartido en src/scripts/prospect-landing.ts.

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  // Vídeo de Luiz con fondo blanco, fundido con la página (PresenterVideo).
  src: "/video/luiz-tis.mp4",
  poster: "/video/luiz-tis-poster.jpg",
  duracion: "1 min 24 s",
};

const wa = (t: string) => `https://wa.me/34662423523?text=${encodeURIComponent(t)}`;
const CONTACT_HREF = wa("Hola Luiz, soy Juanma García, de One Shot Hotels. He visto la página que preparaste después de TIS y me gustaría hablarlo.");
const INTRO_HREF = wa("Hola Luiz, soy Juanma García, de One Shot Hotels. Te pongo en contacto con la persona de revenue y distribución: ");
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/juanma/", site).toString();
const ogImage = new URL("/og/juanma.png", site).toString();
const title = "Juanma García × IA Operators | Radiografía Digital";
const description = "Después de la mesa de IA en marketing hotelero en TIS: quién es el dueño de la transacción y cuántas capas hay entre una reserva directa y el margen. Una reflexión preparada por IA Operators para Juanma García y One Shot Hotels.";

const pad = (n: number) => String(n).padStart(2, "0");

// Ejemplo ilustrativo: el camino de una reserva "directa".
const capas = [
  { k: "Agente de IA o buscador", t: "tech", d: "donde empieza la búsqueda" },
  { k: "Metabuscador", t: "eco", d: "coste por clic o comisión" },
  { k: "Web y motor de reservas", t: "tech", d: "la reserva parece directa" },
  { k: "Pasarela de pago", t: "eco", d: "comisión por transacción" },
  { k: "CRS y channel manager", t: "tech", d: "inventario y precio" },
  { k: "PMS", t: "tech", d: "la estancia" },
];

// Ejemplo ilustrativo: cada herramienta con su IA y su objetivo.
const ias = [
  { k: "PMS", o: "ocupación" },
  { k: "CRS", o: "conversión" },
  { k: "CRM", o: "aperturas" },
  { k: "Campañas", o: "ROAS" },
  { k: "RMS", o: "precio medio" },
];

const datos = [
  { n: "+30", k: "millones de euros", s: "facturación en 2025, un 12 % más" },
  { n: "+50 %", k: "reservas directas", s: "más de la mitad del total" },
  { n: "+70.000", k: "One Shot Friends", s: "usuarios registrados" },
  { n: "3", k: "aperturas en 2026", s: "Ibiza, Bilbao y Lisboa" },
];

const pasos = [
  "Elegimos un hotel y una muestra de reservas directas reales de un mes.",
  "Reconstruimos el camino de cada una: por dónde llegó, qué sistemas tocó y quién cobró algo por el camino.",
  "Inventariamos las capas de IA que ya traen vuestras herramientas y qué optimiza cada una.",
  "Calculamos el coste real por canal y marcamos qué capas controláis, cuáles no y cuáles podrían controlarse.",
];

// Ejemplo ilustrativo: tres reservas "directas" con capas económicas distintas.
const reservas = [
  { k: "Reserva A", d: "entra escribiendo la URL" },
  { k: "Reserva B", d: "llega desde un metabuscador" },
  { k: "Reserva C", d: "la recomienda un agente de IA" },
];
const tramo = ["Origen", "Anuncio", "Motor", "Pago", "PMS"];
const friccion: Record<number, number[]> = { 0: [3], 1: [1, 3], 2: [0, 1, 3] };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Una reserva directa. ¿Cuántas capas en medio? Una idea para Juanma García y One Shot Hotels." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f6f5f1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-link top-link-x" href="/es/hoteles/" data-cta="nav_hoteles">Hoteles</a>
          <a class="top-link top-link-x" href="/es/hoteles/reservas-directas-ia/" data-cta="nav_reservas_directas">Reservas directas</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header" data-cta-event="click_contact">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="label">Después de «IA en marketing hotelero» · TIS 2026</p>
        <h1 id="hero-title" class="greeting">Juanma, en TIS dijiste que ya no te preocupa solo aparecer en las recomendaciones de la IA. <b>Te preocupa más quién va a ser el dueño de esa transacción.</b></h1>
        <p class="big">Una reserva directa.<span>¿Cuántas capas en medio?</span></p>

        <div class="hero-grid">
          <PresenterVideo src={VIDEO.src} poster={VIDEO.poster} label="Vídeo de Luiz Brazão para Juanma García" duracion={VIDEO.duracion} />

          <div class="hero-copy">
            <p>Te escuché en la mesa que moderó Francisca García, con Judit Segura y Milton León.</p>
            <p>Hablaste desde una posición que reconociste privilegiada: muchos años construyendo una venta directa muy alta. Y aun así planteaste la pregunta incómoda. ¿Qué es realmente el canal directo cuando un agente de IA puede entrar en el PMS, jugar con el inventario y hasta negociar el precio?</p>
            <p class="hero-strong">Me gustaría proponerte una forma de contestarla con datos: ver cada capa que hay entre el huésped y vuestra cuenta de resultados.</p>
          </div>
        </div>
      </section>

      <!-- Transacción -->
      <section id="transaccion" class="section wrap" aria-labelledby="tr-title">
        <div class="split">
          <p class="label label-accent" data-reveal>01 · La transacción</p>
          <div>
            <h2 id="tr-title" class="h2" data-reveal>¿Qué es realmente el canal directo?</h2>
            <div class="two">
              <div>
                <p class="lede" data-reveal>Tu respuesta fue clara. Canal directo es aquel en el que controláis al cliente, sabéis por dónde ha venido y conocéis lo que cuesta. Aunque no pase por vuestra web.</p>
                <p class="statement" data-reveal>
                  <span class="muted">El cliente puede haber venido directamente.</span>
                  <span>Las capas de en medio no siempre se ven.</span>
                </p>
              </div>
              <figure class="path" data-reveal aria-label="Ejemplo ilustrativo: capas tecnológicas y económicas en el camino de una reserva directa">
                <p class="path-head">El camino de una reserva «directa»</p>
                <ol>
                  {capas.map((c, i) => (
                    <li class:list={["layer", c.t]} style={`--i:${i}`}><b>{c.k}</b><span>{c.d}</span></li>
                  ))}
                </ol>
                <figcaption><span class="cap-tech">Capa tecnológica</span><span class="cap-eco">Capa económica</span></figcaption>
                <p class="path-note">Ejemplo ilustrativo. No describe la distribución de One Shot.</p>
              </figure>
            </div>
            <p class="prose-line prose-ink" data-reveal>Y recordaste cómo ha ido siempre la distribución hotelera: cada escaparate nuevo acaba monetizado. Buscador, metabuscador, comparador, el contrato con el turoperador. Y de repente aparece un «fee» de marketing, el comodín que al final monetiza.</p>
            <p class="prose-line" data-reveal>Por eso nuestro asistente para reservas directas está pensado para que la conversación con el huésped acabe en vuestro motor y el dato se quede en casa. <a class="inline-link" href="/es/hoteles/reservas-directas-ia/" data-cta="reservas_directas">Ver cómo lo planteamos</a></p>
          </div>
        </div>
      </section>

      <!-- IAs -->
      <section id="ias" class="panel" aria-labelledby="ia-title">
        <div class="wrap section">
          <div class="split">
            <p class="label" data-reveal>02 · Muchas IAs</p>
            <div>
              <h2 id="ia-title" class="h2" data-reveal>«Muchas IAs que no miren por el negocio.»</h2>
              <p class="lede" data-reveal>Lo explicaste así: todos tenemos PMS, CRS y CRM, y cada uno está añadiendo su propia capa de inteligencia artificial. Tú prefieres una IA transversal que ayude a decidir.</p>
              <figure class="ias" data-reveal aria-label="Ejemplo ilustrativo: cada herramienta optimiza su propio indicador; el negocio necesita otro">
                <ol class="ias-grid">
                  {ias.map((t, i) => <li style={`--i:${i}`}><small>IA</small><b>{t.k}</b><span>optimiza {t.o}</span></li>)}
                </ol>
                <p class="ias-biz"><small>Lo que mira el negocio</small>Margen por cliente y por canal</p>
                <figcaption>Ejemplo ilustrativo.</figcaption>
              </figure>
              <p class="statement" data-reveal>
                <span class="muted">Una campaña puede tener un buen ROAS</span>
                <span>y no ser una buena decisión comercial.</span>
              </p>
              <p class="prose-line" data-reveal>Para que una IA transversal decida bien necesita lo que hoy suele estar repartido entre herramientas: el origen de cada reserva, su coste real y el valor de cada cliente. Ese trabajo previo no lo trae ninguna herramienta de serie.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- One Shot -->
      <section id="one-shot" class="night" aria-labelledby="os-title">
        <div class="wrap section">
          <p class="label label-night" data-reveal>03 · One Shot</p>
          <h2 id="os-title" class="h2 h2-wide" data-reveal>Más capacidad para competir. Y más dependencias.</h2>
          <dl class="stats" data-reveal>
            {datos.map((d) => (
              <div>
                <dt>{d.k}</dt>
                <dd><b>{d.n}</b><span>{d.s}</span></dd>
              </div>
            ))}
          </dl>
          <p class="stats-src" data-reveal>Datos publicados a principios de 2026.</p>
          <div class="split split-tight">
            <span></span>
            <div>
              <p class="prose-line prose-night" data-reveal>En el cierre de la mesa lo resumiste: la IA puede daros más capacidad de competir, pero en marketing también puede estandarizar las campañas y crear más dependencias. Y antes dijiste algo parecido de la personalización: si todos podemos personalizarlo todo, deja de ser una ventaja.</p>
              <p class="prose-line prose-night" data-reveal>Con más de la mitad de las reservas en directo, lo que está en juego no es aparecer. Es no perder, capa a capa, el control de lo que ya es vuestro.</p>
            </div>
          </div>
          <p class="huge" data-reveal>El dueño de la transacción se ve en el margen.</p>
        </div>
      </section>

      <!-- Radiografía -->
      <section id="radiografia" class="panel" aria-labelledby="rd-title">
        <div class="wrap section">
          <div class="split">
            <p class="label label-accent" data-reveal>04 · Radiografía Digital</p>
            <div>
              <h2 id="rd-title" class="h2" data-reveal>Todas las capas entre el huésped y el EBITDA.</h2>
              <p class="lede" data-reveal>Una Radiografía Digital no evalúa proveedores ni propone una plataforma. Sigue reservas reales a través de los sistemas y los costes que tocan.</p>
              <ol class="steps" data-reveal>{pasos.map((p, i) => <li><span class="n">{pad(i + 1)}</span>{p}</li>)}</ol>
              <p class="prose-line" data-reveal>El resultado no es una lista de ideas. Es saber cuánto cuesta de verdad cada canal, qué capas os dan control y cuáles os lo quitan, en un formato que se puede llevar a la cuenta de resultados.</p>
              <p class="prose-line" data-reveal>En una cadena de cuatro hoteles en Menorca, la dirección declaraba unas 25 herramientas. Encontramos 47, y un 23 % del gasto en SaaS que se podía recortar. <a class="inline-link" href="/es/portfolio/radiografia-cadena-hotelera-menorca/" data-cta="case">Ver el caso</a></p>
              <ul class="nots" data-reveal>
                <li>No vendemos un PMS, un CRS ni un CRM.</li>
                <li>No tenemos una plataforma que colocar.</li>
                <li>No sustituimos a vuestro equipo de revenue: le damos el mapa.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Propuesta -->
      <section id="propuesta" class="section wrap" aria-labelledby="pr-title">
        <div class="split">
          <p class="label label-accent" data-reveal>Una idea concreta</p>
          <div>
            <h2 id="pr-title" class="h2 h2-pair" data-reveal><span>No empecemos por toda la distribución.</span><span class="h2-accent">Empecemos por cien reservas.</span></h2>
            <p class="lede" data-reveal>Cien reservas directas de un hotel, reconstruidas una a una. ¿Cuántas fueron directas según tu definición, con cliente, origen y coste bajo control? ¿Y cuánto costó cada una?</p>
            <figure class="cmp" data-reveal aria-label="Ejemplo ilustrativo: tres reservas directas con capas económicas distintas">
              {reservas.map((h, r) => (
                <div class="cmp-row">
                  <p class="cmp-k"><b>{h.k}</b><span>{h.d}</span></p>
                  <ol class="cmp-steps">
                    {tramo.map((p, c) => <li class:list={{ hot: friccion[r].includes(c) }} style={`--i:${r * 5 + c}`}>{p}</li>)}
                  </ol>
                </div>
              ))}
              <figcaption>Ejemplo ilustrativo. En naranja, los tramos donde alguien cobra.</figcaption>
            </figure>
            <p class="prose-line" data-reveal>Lo haríamos con tu equipo de revenue y distribución, con el EBITDA delante.</p>
            <p class="worth" data-reveal>¿Cuánto cuesta de verdad una reserva directa?</p>
          </div>
        </div>
      </section>

      <!-- Cierre -->
      <section id="cierre" class="closing wrap" aria-labelledby="ci-title">
        <p class="cl-1" data-reveal>Canal directo.</p>
        <h2 id="ci-title" class="cl-big" data-reveal>Cliente, origen y coste.</h2>
        <p class="cl-3" data-reveal>Si se controlan los tres, la transacción es vuestra. Ese es el trabajo que me gustaría enseñarte, o enseñar a quien lleve la distribución en One Shot.</p>
      </section>

      <!-- CTA -->
      <section id="hablar" class="cta" aria-labelledby="cta-title">
        <div class="wrap section">
          <h2 id="cta-title" class="h2 cta-title" data-reveal>Si te parece una conversación útil, seguimos.</h2>
          <p class="cta-copy" data-reveal>En 20 minutos puedo enseñarte cómo hacemos una Radiografía Digital y un ejemplo real en una cadena hotelera.</p>
          <div class="cta-row" data-reveal>
            <div class="buttons">
              <a class="button" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="final" data-cta-event="click_contact">Hablar con Luiz <span aria-hidden="true">↗</span></a>
              <a class="button button-ghost" href={INTRO_HREF} target="_blank" rel="noopener" data-cta="intro" data-cta-event="click_introduction">Presentarme a la persona adecuada <span aria-hidden="true">↗</span></a>
            </div>
            <div class="signature">
              <p class="signature-name">Luiz Brazão</p>
              <p class="signature-role">Founder, IA Operators</p>
              <a class="signature-site" href="https://iaoperators.com/es/" data-cta="site">iaoperators.com</a>
            </div>
          </div>
        </div>
      </section>
    </main>


    <footer class="foot">
      <div class="wrap foot-inner">
        <span class="foot-brand"><img src="/brand/ia-operators-logo.png" alt="IA Operators" width="453" height="82" loading="lazy" /></span>
        <a href="/es/auditoria-de-sistemas/">Radiografía Digital</a>
        <a href="https://iaoperators.com/es/">iaoperators.com</a>
      </div>
    </footer>

    <div class="consent" data-consent hidden role="region" aria-label="Cookies">
      <p>Usamos cookies para medir y mejorar la experiencia. Puedes aceptar o rechazar. <a href="/es/politica-de-privacidad/">Política de Privacidad</a>.</p>
      <div class="consent-actions">
        <button type="button" data-consent-reject>Rechazar</button>
        <button type="button" class="consent-accept" data-consent-accept>Aceptar</button>
      </div>
    </div>

    <script>
      import { initProspectLanding } from "../../scripts/prospect-landing";
      initProspectLanding({ landing: "juanma", gtmId: document.body.dataset.gtm ?? "", videoTitle: "juanma_luiz", scrollMarks: [50, 90] });
    </script>

    <style is:global>
      @font-face {
        font-family: "Manrope JG";
        src: url("/fonts/manrope-latin-variable.woff2") format("woff2");
        font-weight: 200 800;
        font-display: swap;
      }
      :root {
        --paper: #f6f5f1;
        --panel: #ecebe5;
        --ink: #15171a;
        --text: #2c2f33;
        --muted: #62666b;
        --soft: #9a9da1;
        --line: #dfded8;
        --line-strong: #c3c2bb;
        --slate: #24425a;
        --slate-soft: #9fb2c1;
        --orange: #f16532;
        --orange-ink: #b4441a;
        --night: #121417;
        --night-text: #f1f1ee;
        --night-line: #2b2f34;
        --gutter: 20px;
        --ease: cubic-bezier(.2, .7, .2, 1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 72px; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Manrope JG", "Helvetica Neue", Arial, sans-serif; font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums; }
      h1, h2, h3, p, ol, ul, dl, dd, figure, blockquote { margin: 0; }
      ol, ul { padding: 0; list-style: none; }
      a { color: inherit; text-decoration: none; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
      .wrap { width: 100%; max-width: 1240px; margin-inline: auto; padding-inline: var(--gutter); }
      .label { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .label::before { content: ""; width: 7px; height: 7px; background: var(--slate); }
      .label-accent::before { background: var(--orange); }
      .label-night { color: #9a9ea3; }
      .label-night::before { background: var(--slate-soft); }
      .muted { color: var(--soft); }

      /* Cabecera */
      .top { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid transparent; transition: background-color .3s ease, border-color .3s ease; }
      .top.is-scrolled { background: rgba(246, 245, 241, .9); border-bottom-color: var(--line); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
      .top-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 60px; }
      .wordmark img { display: block; width: auto; height: 22px; }
      .foot-brand img { display: block; width: auto; height: 18px; }
      .top-nav { display: flex; align-items: center; gap: 22px; font-size: 13px; }
      .top-link { display: none; color: var(--muted); }
      .top-link:hover { color: var(--ink); }
      .top-cta { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; background: var(--slate); color: var(--night-text); font-weight: 600; white-space: nowrap; transition: background-color .2s ease; }
      .top-cta:hover { background: var(--ink); }

      /* Hero */
      .hero { padding-top: 18px; padding-bottom: 72px; }
      .greeting { margin-top: 14px; max-width: 24em; font-size: clamp(19px, 2.2vw, 28px); font-weight: 500; letter-spacing: -.028em; line-height: 1.28; color: var(--text); }
      .greeting b { font-weight: 700; color: var(--slate); }
      .big { display: grid; gap: 2px; margin-top: 18px; max-width: 13em; font-size: clamp(34px, 6.6vw, 94px); font-weight: 500; letter-spacing: -.058em; line-height: 1; color: var(--soft); }
      .big span { color: var(--ink); }
      .hero-grid { display: grid; gap: 28px; margin-top: 28px; }
      .hero-copy { display: grid; gap: 10px; align-content: start; color: var(--muted); }
      .hero-copy p { max-width: 32em; }
      .hero-strong { margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--line-strong); font-size: clamp(20px, 2vw, 25px); font-weight: 500; letter-spacing: -.03em; line-height: 1.28; color: var(--ink); }

      /* Secciones */
      .section { padding-block: 88px; }
      .panel { background: var(--panel); }
      .night { background: var(--night); color: var(--night-text); }
      .split { display: grid; gap: 18px; }
      .split > .label { align-self: start; padding-top: 10px; }
      .split-tight { margin-top: 40px; }
      .h2 { margin-top: 0; font-size: clamp(30px, 4.4vw, 58px); font-weight: 500; letter-spacing: -.05em; line-height: 1.07; max-width: 15em; }
      section > .wrap > .h2, .section > .h2 { margin-top: 16px; }
      .h2-wide { max-width: 19em; }
      .h2-pair { display: grid; gap: 4px; }
      .h2-accent { color: var(--orange-ink); }
      .lede { margin-top: 20px; max-width: 30em; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.45; letter-spacing: -.018em; color: var(--text); }
      .prose-line { margin-top: 22px; max-width: 36em; color: var(--muted); }
      .prose-ink { color: var(--text); font-size: 18px; }
      .prose-night { color: #b9bcc0; }
      .statement { display: grid; gap: 2px; margin-top: 40px; font-size: clamp(25px, 3.2vw, 42px); font-weight: 500; letter-spacing: -.045em; line-height: 1.12; max-width: 17em; }
      .statement::before { content: ""; display: block; width: 40px; height: 3px; margin-bottom: 16px; background: var(--orange); }
      .huge { margin-top: 72px; font-size: clamp(36px, 7vw, 100px); font-weight: 500; letter-spacing: -.062em; line-height: 1; max-width: 12em; }
      .n { flex: 0 0 26px; font-size: 12px; font-weight: 650; color: var(--soft); }

      /* Filtro */
      .filter { margin-top: 36px; border-top: 1px solid var(--ink); }
      .filter li { display: flex; gap: 14px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); }
      .filter-q { font-size: clamp(21px, 2.3vw, 30px); font-weight: 500; letter-spacing: -.035em; line-height: 1.18; }
      .filter-d { margin-top: 4px; max-width: 36em; font-size: 16px; color: var(--muted); }
      .filter-last .n { color: var(--orange); }
      .filter-last .filter-q { color: var(--slate); }

      /* One Shot */
      .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 44px; background: var(--night-line); border: 1px solid var(--night-line); }
      .stats div { padding: 18px 14px; background: var(--night); }
      .stats dt { font-size: 11px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: #9a9ea3; }
      .stats dd b { display: block; margin-top: 6px; font-size: clamp(40px, 6vw, 76px); font-weight: 500; letter-spacing: -.06em; line-height: 1; color: var(--night-text); }
      .stats dd span { display: block; margin-top: 8px; font-size: 13px; color: #9a9ea3; }
      .quote blockquote { font-size: clamp(21px, 2.3vw, 29px); font-weight: 400; letter-spacing: -.03em; line-height: 1.3; max-width: 24em; }
      .quote figcaption { margin-top: 10px; font-size: 13px; color: #9a9ea3; }
      .night .huge { color: var(--night-text); }

      /* Radiografía */
      .steps { margin-top: 28px; border-top: 1px solid var(--line-strong); }
      .steps li { display: flex; gap: 14px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line-strong); font-size: clamp(18px, 1.7vw, 21px); letter-spacing: -.02em; }
      .nots { margin-top: 28px; }
      .nots li { padding: 8px 0; font-size: 16px; color: var(--muted); }
      .nots li::before { content: "·"; margin-right: 10px; color: var(--slate); font-weight: 700; }

      /* Propuesta */
      .cmp { margin-top: 32px; display: grid; gap: 14px; }
      .cmp-row { display: grid; gap: 8px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
      .cmp-k b { font-size: 16px; font-weight: 650; }
      .cmp-k span { margin-left: 10px; font-size: 14px; color: var(--muted); }
      .cmp-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
      .cmp-steps li { padding: 8px 4px; border: 1px solid var(--slate-soft); border-radius: 6px; background: var(--paper); text-align: center; font-size: 12px; font-weight: 600; color: var(--slate); }
      .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }
      .cmp figcaption { font-size: 13px; color: var(--soft); }
      .worth { margin-top: 10px; font-size: clamp(38px, 6.6vw, 90px); font-weight: 500; letter-spacing: -.06em; line-height: 1; color: var(--orange-ink); }

      /* Camino de la reserva */
      .two { display: grid; gap: 40px; }
      .path { align-self: start; width: 100%; max-width: 380px; padding: 18px; border: 1px solid var(--line-strong); border-radius: 16px; background: var(--paper); }
      .path-head { padding-bottom: 10px; margin-bottom: 12px; border-bottom: 1px solid var(--line); font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .path ol { position: relative; display: grid; gap: 8px; }
      .path ol::before { content: ""; position: absolute; left: 7px; top: 10px; bottom: 10px; width: 2px; background: var(--slate-soft); }
      .layer { position: relative; padding: 6px 0 6px 26px; }
      .layer::before { content: ""; position: absolute; left: 2px; top: 12px; width: 12px; height: 12px; border-radius: 50%; background: var(--paper); border: 2px solid var(--slate); }
      .layer.eco::before { border-color: var(--orange); background: var(--orange); box-shadow: 0 0 0 4px rgba(241, 101, 50, .16); }
      .layer b { display: block; font-size: 16px; font-weight: 600; letter-spacing: -.015em; }
      .layer span { display: block; font-size: 13px; color: var(--muted); }
      .layer.eco span { color: var(--orange-ink); }
      .path figcaption { display: flex; gap: 18px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 11px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
      .cap-tech::before, .cap-eco::before { content: ""; display: inline-block; width: 9px; height: 9px; margin-right: 7px; border-radius: 50%; vertical-align: middle; }
      .cap-tech::before { border: 2px solid var(--slate); width: 7px; height: 7px; }
      .cap-eco::before { background: var(--orange); }
      .path-note { margin-top: 8px; font-size: 13px; color: var(--soft); }

      /* IAs */
      .ias { display: grid; gap: 12px; margin-top: 36px; }
      .ias-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
      .ias-grid li { padding: 12px 14px; border: 1px solid var(--slate-soft); border-radius: 10px; background: var(--paper); }
      .ias-grid small { display: inline-block; margin-bottom: 6px; padding: 1px 6px; border-radius: 4px; background: var(--slate); color: var(--night-text); font-size: 10px; font-weight: 700; letter-spacing: .08em; }
      .ias-grid b { display: block; font-size: 17px; font-weight: 600; letter-spacing: -.02em; color: var(--slate); }
      .ias-grid span { display: block; font-size: 13px; color: var(--muted); }
      .ias-biz { padding: 14px 16px; border: 1px solid var(--orange); border-radius: 10px; background: rgba(241, 101, 50, .08); font-size: clamp(18px, 1.8vw, 22px); letter-spacing: -.02em; }
      .ias-biz small { display: block; margin-bottom: 4px; font-size: 11px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: var(--orange-ink); }
      .ias figcaption { font-size: 13px; color: var(--soft); }
      .stats dd b { font-size: clamp(34px, 4.6vw, 62px); }
      .stats-src { margin-top: 12px; font-size: 13px; color: #7d8187; }

      /* Cierre */
      .closing { padding-block: 120px 128px; }
      .cl-1 { font-size: clamp(28px, 3.6vw, 48px); font-weight: 500; letter-spacing: -.045em; color: var(--soft); }
      .cl-big { margin-top: 10px; max-width: 10em; font-size: clamp(52px, 11vw, 160px); font-weight: 500; letter-spacing: -.07em; line-height: .95; }
      .cl-3 { margin-top: 56px; max-width: 30em; font-size: clamp(19px, 1.8vw, 23px); letter-spacing: -.02em; color: var(--text); }

      /* CTA */
      .cta { border-top: 1px solid var(--line); }
      .cta-title { max-width: 14em; }
      .cta-copy { margin-top: 20px; max-width: 32em; font-size: 18px; color: var(--muted); }
      .cta-row { display: grid; gap: 36px; margin-top: 40px; }
      .buttons { display: grid; gap: 10px; justify-items: start; }
      .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 56px; padding: 0 24px; background: var(--slate); color: var(--night-text); font-size: 16px; font-weight: 600; transition: background-color .2s ease, color .2s ease; }
      .button:hover { background: var(--ink); }
      .button-ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
      .button-ghost:hover { background: var(--ink); color: var(--paper); }
      .signature { padding-top: 18px; border-top: 1px solid var(--line); max-width: 280px; }
      .signature-name { font-size: 18px; font-weight: 650; letter-spacing: -.02em; }
      .signature-role { font-size: 14px; color: var(--muted); }
      .signature-site { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--slate); }

      /* Pie y consentimiento */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding-block: 26px 30px; font-size: 13px; color: var(--muted); }
      .foot-brand { margin-right: auto; }
      .foot a:hover { color: var(--ink); }
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; background: var(--night); color: var(--night-text); font-size: 13px; line-height: 1.5; border: 1px solid #3a3d42; box-shadow: 0 10px 30px rgba(0, 0, 0, .18); }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; }
      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 38px; padding: 0 16px; border: 1px solid #3a3d42; background: transparent; color: var(--night-text); font: inherit; cursor: pointer; }
      .consent .consent-accept { background: var(--night-text); color: var(--night); border-color: var(--night-text); }

      /* Movimiento */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }
      .js .cmp-steps li.hot { background: var(--paper); border-color: var(--slate-soft); color: var(--slate); transition: background-color .4s ease calc(.3s + var(--i) * 50ms), border-color .4s ease calc(.3s + var(--i) * 50ms), color .4s ease calc(.3s + var(--i) * 50ms); }
      .js .cmp.is-in .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }

      .js .path .layer { opacity: .25; transition: opacity .45s ease calc(.25s + var(--i) * 180ms); }
      .js .path.is-in .layer { opacity: 1; }
      .js .ias-grid li { opacity: .25; transition: opacity .45s ease calc(.2s + var(--i) * 110ms); }
      .js .ias.is-in .ias-grid li { opacity: 1; }

      @media (min-width: 420px) {
        .top-link { display: inline; }
        .cmp-steps li { font-size: 13px; }
      }
      .top-nav .top-link-x { display: none; }
      @media (min-width: 900px) {
        .top-nav .top-link-x { display: inline; }
      }
      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .ias-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
        .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .stats div { padding: 22px 18px; }
        .cmp-row { grid-template-columns: 210px minmax(0, 1fr); align-items: center; gap: 16px; }
        .cmp-k span { display: block; margin-left: 0; }
        .cta-row { grid-template-columns: auto 1fr; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }
      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 40px; padding-bottom: 116px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 52px; align-items: start; }
        .section { padding-block: 128px; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .two { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; margin-top: 8px; }
        .closing { padding-block: 180px 190px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .path .layer, .js .ias-grid li { opacity: 1; transition: none; }
        .js .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); transition: none; }
        .top, .button, .top-cta { transition: none; }
      }
      .inline-link { color: var(--slate); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
      .inline-link:hover { color: var(--ink); }
    </style>
  </body>
</html>
