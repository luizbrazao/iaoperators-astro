---
import PresenterVideo from "../../components/PresenterVideo.astro";
// Landing personalizada para Amador Recio Crespo, director del Hotel Ribera
// de Triana (Sevilla; 150 habitaciones, independiente). Creada el 13/11/2026.
// Privada: noindex,nofollow y fuera del sitemap ("/tis/" en NOINDEX_PATHS).
//
// Sesión de TIS 07/10/2026, 17:15, «AI in operations: reducing costs without
// destroying the hotel experience», moderada por Francisca García (Casa 1800),
// con Verónica Martín (Petit Palace) y Nadiuska Franco. Verificado contra la
// transcripción oficial del vídeo (13/11/2026). Solo se usan los dos turnos
// que la moderadora abre con su nombre, parafraseados salvo citas cortas:
//   - 12:04-14:57: 150 habitaciones en Sevilla, hotel independiente. La IA ha
//     venido para quedarse, te la ponen en el móvil y en el ordenador; otra
//     cosa es cómo la quieras usar. «¿Para qué voy a implantar la IA? ¿En qué
//     la necesito?». A mucha gente le imponen situaciones que no necesita en
//     sus hoteles; «a lo mejor te quieren vender necesidades que le interesa
//     comercialmente a alguien, pero no a ti». Primero conocer tu hotel, tu
//     cliente, tu personal y tu necesidad. Formación obligatoria por la
//     normativa europea; en todo momento siempre es tu responsabilidad.
//     Seguridad: la información no debe salir del establecimiento. Ejemplos:
//     dónde está el mayor defecto, qué bombilla se funde siempre, control de
//     horarios, control de stocks, ratios de personal. «Aplicaciones,
//     millones». La ontología: conocer tu ser, «no en plan filosófico, sino en
//     plan informático», y a partir de ahí aplicarlo.
//   - 36:27-37:05 (cierre): reto e ilusión por aprender; no sabemos qué
//     tendremos encima de la mesa la semana que viene, cuando venga «tu
//     tecnólogo a decirte: "Oye, que ahora hacemos esto"».
//   - NO se usan 15:07-17:53 ni 24:44-26:46 (respuestas sin nombre, atribución
//     dudosa entre Amador, Verónica y Nadiuska), ni la frase de los
//     «directores masoquistas» (la cita la moderadora, no se oye a él).
//
// Concepto: «¿para qué voy a implantar la IA?». Radiografía como conocer el
// hotel «en plan informático» antes de decidir, empezando por mantenimiento
// (su ejemplo de la bombilla), con los datos sin salir del hotel. Enlace suave
// a /es/hoteles/reservas-directas-ia/ advirtiendo que no es una necesidad
// que le queramos vender.
//
// Comportamiento compartido en src/scripts/prospect-landing.ts.

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  // Vídeo de Luiz con fondo blanco, fundido con la página (PresenterVideo).
  src: "/video/luiz-tis.mp4",
  poster: "/video/luiz-tis-poster.jpg",
  duracion: "1 min 24 s",
};

const wa = (t: string) => `https://wa.me/34662423523?text=${encodeURIComponent(t)}`;
const CONTACT_HREF = wa("Hola Luiz, soy Amador Recio, del Hotel Ribera de Triana. He visto la página que preparaste después de TIS y me gustaría hablarlo.");
const INTRO_HREF = wa("Hola Luiz, soy Amador Recio, del Hotel Ribera de Triana. Te pongo en contacto con la persona adecuada: ");
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/amador/", site).toString();
const ogImage = new URL("/og/amador.png", site).toString();
const title = "Amador Recio × IA Operators | Radiografía Digital";
const description = "Después de la mesa de IA en operaciones en TIS: antes de implantar nada, conocer el hotel en plan informático y ver dónde está la necesidad. Una reflexión preparada por IA Operators para Amador Recio y el Hotel Ribera de Triana.";

const pad = (n: number) => String(n).padStart(2, "0");

// Lo primero, según él: conocer cuatro cosas.
const filtro = [
  { q: "Tu hotel", d: "Qué procesos tiene de verdad y dónde se atascan." },
  { q: "Tu cliente", d: "Qué valora y dónde no quiere ver una máquina." },
  { q: "Tu personal", d: "Qué le quita tiempo y qué le facilitaría el trabajo." },
  { q: "Tu necesidad", d: "La tuya. No la que le interesa comercialmente a otro." },
];

// Mapa ilustrativo: dónde suele vivir el dato en un hotel independiente.
const mapa = [
  { k: "Recepción", d: "PMS", ok: true },
  { k: "Pisos", d: "papel y WhatsApp", ok: false },
  { k: "Mantenimiento", d: "libreta y llamadas", ok: false },
  { k: "Compras y stocks", d: "Excel", ok: false },
  { k: "Personal y horarios", d: "app de turnos", ok: true },
  { k: "A&B", d: "TPV y albaranes", ok: false },
];

const pasos = [
  "Elegimos contigo un proceso: mantenimiento, pisos, compras o recepción.",
  "Lo seguimos con quien lo hace cada día: dónde se apunta, por dónde viaja y quién lo ve.",
  "Marcamos dónde se pierde tiempo, dónde se repite y dónde depende de una sola persona.",
  "Te decimos si ahí hay una necesidad real de tecnología. Y si no la hay, también.",
];

// Ejemplo ilustrativo: tres incidencias de mantenimiento.
const reservas = [
  { k: "Incidencia A", d: "se avisa por teléfono" },
  { k: "Incidencia B", d: "se apunta en una libreta" },
  { k: "Incidencia C", d: "entra por el PMS" },
];
const tramo = ["Aviso", "Registro", "Asignación", "Reparación", "Cierre"];
const friccion: Record<number, number[]> = { 0: [1, 4], 1: [1, 2, 4], 2: [] };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Conocer tu hotel en plan informático. Una idea para Amador Recio y el Hotel Ribera de Triana." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f6f5f1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-link top-link-x" href="/es/hoteles/" data-cta="nav_hoteles">Hoteles</a>
          <a class="top-link top-link-x" href="/es/hoteles/reservas-directas-ia/" data-cta="nav_reservas_directas">Reservas directas</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header" data-cta-event="click_contact">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="label">Después de «IA en operaciones» · TIS 2026</p>
        <h1 id="hero-title" class="greeting">Amador, en TIS hiciste la pregunta que casi nadie hace: <b>«¿Para qué voy a implantar la IA? ¿En qué la necesito?»</b></h1>
        <p class="big">Conocer tu hotel.<span>En plan informático.</span></p>

        <div class="hero-grid">
          <PresenterVideo src={VIDEO.src} poster={VIDEO.poster} label="Vídeo de Luiz Brazão para Amador Recio" duracion={VIDEO.duracion} />

          <div class="hero-copy">
            <p>Te escuché en la mesa de IA en operaciones que moderó Francisca García, con Verónica Martín y Nadiuska Franco.</p>
            <p>Dijiste que a muchos hoteles les están imponiendo cosas que no necesitan. Y que a lo mejor te quieren vender necesidades que le interesan comercialmente a alguien, pero no a ti.</p>
            <p class="hero-strong">Por eso esta página no te vende una herramienta. Te propone algo anterior: ver dónde está la necesidad.</p>
          </div>
        </div>
      </section>

      <!-- Necesidad -->
      <section id="necesidad" class="section wrap" aria-labelledby="ne-title">
        <div class="split">
          <p class="label label-accent" data-reveal>01 · La necesidad</p>
          <div>
            <h2 id="ne-title" class="h2" data-reveal>Aplicaciones, millones.</h2>
            <p class="lede" data-reveal>Lo resumiste así. La IA ya está en el móvil y en el ordenador, quieras o no. La cuestión es cómo la quieres usar. Y para eso, lo primero es conocer cuatro cosas.</p>
            <ol class="filter" data-reveal>
              {filtro.map((f, i) => (
                <li class:list={{ "filter-last": i === filtro.length - 1 }}>
                  <span class="n">{pad(i + 1)}</span>
                  <div>
                    <p class="filter-q">{f.q}</p>
                    <p class="filter-d">{f.d}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="statement" data-reveal>
              <span class="muted">Te escribo sabiendo que yo también vendo algo.</span>
              <span>Así que empiezo por tu pregunta.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Ontología -->
      <section id="ontologia" class="panel" aria-labelledby="on-title">
        <div class="wrap section">
          <div class="split">
            <p class="label" data-reveal>02 · La ontología</p>
            <div>
              <h2 id="on-title" class="h2" data-reveal>«Conocer tu ser. No en plan filosófico, sino en plan informático.»</h2>
              <p class="lede" data-reveal>Fue la imagen que usaste. Antes de aplicar nada, saber qué es tu hotel por dentro: qué procesos tiene, dónde vive cada dato y quién lo toca.</p>
              <figure class="map" data-reveal aria-label="Ejemplo ilustrativo: dónde suele vivir el dato en cada área de un hotel independiente">
                <ul class="map-grid">
                  {mapa.map((m, i) => (
                    <li class:list={{ off: !m.ok }} style={`--i:${i}`}><b>{m.k}</b><span>{m.d}</span></li>
                  ))}
                </ul>
                <figcaption><span class="cap-on">Dato en un sistema</span><span class="cap-off">Dato disperso</span></figcaption>
                <p class="map-note">Ejemplo ilustrativo. No describe el Ribera de Triana.</p>
              </figure>
              <p class="prose-line prose-ink" data-reveal>Pusiste ejemplos muy concretos: dónde está el mayor defecto, qué bombilla se funde siempre, el control de horarios, el de stocks, los ratios de personal. Todo eso se puede hacer. Pero solo tiene sentido si antes sabes dónde está ese dato hoy y en qué lo vas a usar.</p>
              <p class="prose-line" data-reveal>Puede que un día la necesidad esté en el canal directo. No te lo propongo; solo por si te sirve ver cómo lo planteamos: <a class="inline-link" href="/es/hoteles/reservas-directas-ia/" data-cta="reservas_directas">reservas directas con IA</a>.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Responsabilidad -->
      <section id="responsabilidad" class="night" aria-labelledby="re-title">
        <div class="wrap section">
          <p class="label label-night" data-reveal>03 · La responsabilidad</p>
          <h2 id="re-title" class="h2 h2-wide" data-reveal>La IA puede hacer muchas cosas. Buenas, normales, malas y superfluas.</h2>
          <div class="split split-tight">
            <span></span>
            <div>
              <p class="prose-line prose-night" data-reveal>Lo dijiste en la mesa: no basta con tener IA, hace falta formación, y en todo momento la responsabilidad es tuya. Y todo lo que le des tiene que estar protegido, con la seguridad de que esa información no va a salir de tu establecimiento.</p>
              <p class="prose-line prose-night" data-reveal>Por eso una Radiografía trabaja al revés de una herramienta. No necesita llevarse vuestros datos a ningún sitio para entender cómo trabajáis. Necesita sentarse con quien hace el trabajo.</p>
            </div>
          </div>
          <p class="huge" data-reveal>Siempre es tu responsabilidad.</p>
        </div>
      </section>

      <!-- Radiografía -->
      <section id="radiografia" class="panel" aria-labelledby="rd-title">
        <div class="wrap section">
          <div class="split">
            <p class="label label-accent" data-reveal>04 · Radiografía Digital</p>
            <div>
              <h2 id="rd-title" class="h2" data-reveal>Primero, dónde está la necesidad.</h2>
              <p class="lede" data-reveal>Una Radiografía Digital no evalúa proveedores ni propone una plataforma. Sigue el trabajo real de un proceso del hotel, con las personas que lo hacen.</p>
              <ol class="steps" data-reveal>{pasos.map((p, i) => <li><span class="n">{pad(i + 1)}</span>{p}</li>)}</ol>
              <p class="prose-line" data-reveal>El resultado no es una lista de ideas. Es saber en qué proceso tiene sentido la tecnología, en cuál basta con ordenar y en cuál no hace falta tocar nada.</p>
              <p class="prose-line" data-reveal>En una cadena de cuatro hoteles en Menorca, la dirección declaraba unas 25 herramientas. Encontramos 47, y un 23 % del gasto en SaaS que se podía recortar. <a class="inline-link" href="/es/portfolio/radiografia-cadena-hotelera-menorca/" data-cta="case">Ver el caso</a></p>
              <ul class="nots" data-reveal>
                <li>No te vendemos una herramienta.</li>
                <li>Los datos no salen de tu hotel.</li>
                <li>Si la respuesta es que no la necesitas, te lo diremos.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Propuesta -->
      <section id="propuesta" class="section wrap" aria-labelledby="pr-title">
        <div class="split">
          <p class="label label-accent" data-reveal>Una idea concreta</p>
          <div>
            <h2 id="pr-title" class="h2 h2-pair" data-reveal><span>No empecemos por todo el hotel.</span><span class="h2-accent">Empecemos por mantenimiento.</span></h2>
            <p class="lede" data-reveal>Las incidencias de un trimestre: cómo llegan, dónde se apuntan, quién las asigna, cuánto tardan y qué se repite. Tu ejemplo, con datos.</p>
            <figure class="cmp" data-reveal aria-label="Ejemplo ilustrativo: tres incidencias de mantenimiento y los tramos donde se pierde información">
              {reservas.map((h, r) => (
                <div class="cmp-row">
                  <p class="cmp-k"><b>{h.k}</b><span>{h.d}</span></p>
                  <ol class="cmp-steps">
                    {tramo.map((p, c) => <li class:list={{ hot: friccion[r].includes(c) }} style={`--i:${r * 5 + c}`}>{p}</li>)}
                  </ol>
                </div>
              ))}
              <figcaption>Ejemplo ilustrativo. En naranja, los tramos donde la información se pierde o depende de alguien.</figcaption>
            </figure>
            <p class="prose-line" data-reveal>Lo haríamos contigo y con tu jefe de mantenimiento, en el hotel.</p>
            <p class="worth" data-reveal>¿Qué bombilla se funde siempre?</p>
          </div>
        </div>
      </section>

      <!-- Cierre -->
      <section id="cierre" class="closing wrap" aria-labelledby="ci-title">
        <p class="cl-1" data-reveal>Cuando llegue alguien con «oye, que ahora hacemos esto»,</p>
        <h2 id="ci-title" class="cl-big" data-reveal>sabrás si lo necesitas.</h2>
        <p class="cl-3" data-reveal>Ese es el trabajo que me gustaría enseñarte.</p>
      </section>

      <!-- CTA -->
      <section id="hablar" class="cta" aria-labelledby="cta-title">
        <div class="wrap section">
          <h2 id="cta-title" class="h2 cta-title" data-reveal>Si te parece una conversación útil, seguimos.</h2>
          <p class="cta-copy" data-reveal>En 20 minutos puedo enseñarte cómo hacemos una Radiografía Digital y un ejemplo real en una cadena hotelera.</p>
          <div class="cta-row" data-reveal>
            <div class="buttons">
              <a class="button" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="final" data-cta-event="click_contact">Hablar con Luiz <span aria-hidden="true">↗</span></a>
              <a class="button button-ghost" href={INTRO_HREF} target="_blank" rel="noopener" data-cta="intro" data-cta-event="click_introduction">Presentarme a la persona adecuada <span aria-hidden="true">↗</span></a>
            </div>
            <div class="signature">
              <p class="signature-name">Luiz Brazão</p>
              <p class="signature-role">Founder, IA Operators</p>
              <a class="signature-site" href="https://iaoperators.com/es/" data-cta="site">iaoperators.com</a>
            </div>
          </div>
        </div>
      </section>
    </main>


    <footer class="foot">
      <div class="wrap foot-inner">
        <span class="foot-brand"><img src="/brand/ia-operators-logo.png" alt="IA Operators" width="453" height="82" loading="lazy" /></span>
        <a href="/es/auditoria-de-sistemas/">Radiografía Digital</a>
        <a href="https://iaoperators.com/es/">iaoperators.com</a>
      </div>
    </footer>

    <div class="consent" data-consent hidden role="region" aria-label="Cookies">
      <p>Usamos cookies para medir y mejorar la experiencia. Puedes aceptar o rechazar. <a href="/es/politica-de-privacidad/">Política de Privacidad</a>.</p>
      <div class="consent-actions">
        <button type="button" data-consent-reject>Rechazar</button>
        <button type="button" class="consent-accept" data-consent-accept>Aceptar</button>
      </div>
    </div>

    <script>
      import { initProspectLanding } from "../../scripts/prospect-landing";
      initProspectLanding({ landing: "amador", gtmId: document.body.dataset.gtm ?? "", videoTitle: "amador_luiz", scrollMarks: [50, 90] });
    </script>

    <style is:global>
      @font-face {
        font-family: "Manrope JG";
        src: url("/fonts/manrope-latin-variable.woff2") format("woff2");
        font-weight: 200 800;
        font-display: swap;
      }
      :root {
        --paper: #f6f5f1;
        --panel: #ecebe5;
        --ink: #15171a;
        --text: #2c2f33;
        --muted: #62666b;
        --soft: #9a9da1;
        --line: #dfded8;
        --line-strong: #c3c2bb;
        --slate: #24425a;
        --slate-soft: #9fb2c1;
        --orange: #f16532;
        --orange-ink: #b4441a;
        --night: #121417;
        --night-text: #f1f1ee;
        --night-line: #2b2f34;
        --gutter: 20px;
        --ease: cubic-bezier(.2, .7, .2, 1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 72px; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Manrope JG", "Helvetica Neue", Arial, sans-serif; font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums; }
      h1, h2, h3, p, ol, ul, dl, dd, figure, blockquote { margin: 0; }
      ol, ul { padding: 0; list-style: none; }
      a { color: inherit; text-decoration: none; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
      .wrap { width: 100%; max-width: 1240px; margin-inline: auto; padding-inline: var(--gutter); }
      .label { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .label::before { content: ""; width: 7px; height: 7px; background: var(--slate); }
      .label-accent::before { background: var(--orange); }
      .label-night { color: #9a9ea3; }
      .label-night::before { background: var(--slate-soft); }
      .muted { color: var(--soft); }

      /* Cabecera */
      .top { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid transparent; transition: background-color .3s ease, border-color .3s ease; }
      .top.is-scrolled { background: rgba(246, 245, 241, .9); border-bottom-color: var(--line); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
      .top-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 60px; }
      .wordmark img { display: block; width: auto; height: 22px; }
      .foot-brand img { display: block; width: auto; height: 18px; }
      .top-nav { display: flex; align-items: center; gap: 22px; font-size: 13px; }
      .top-link { display: none; color: var(--muted); }
      .top-link:hover { color: var(--ink); }
      .top-cta { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; background: var(--slate); color: var(--night-text); font-weight: 600; white-space: nowrap; transition: background-color .2s ease; }
      .top-cta:hover { background: var(--ink); }

      /* Hero */
      .hero { padding-top: 18px; padding-bottom: 72px; }
      .greeting { margin-top: 14px; max-width: 24em; font-size: clamp(19px, 2.2vw, 28px); font-weight: 500; letter-spacing: -.028em; line-height: 1.28; color: var(--text); }
      .greeting b { font-weight: 700; color: var(--slate); }
      .big { display: grid; gap: 2px; margin-top: 18px; max-width: 13em; font-size: clamp(34px, 6.6vw, 94px); font-weight: 500; letter-spacing: -.058em; line-height: 1; color: var(--soft); }
      .big span { color: var(--ink); }
      .hero-grid { display: grid; gap: 28px; margin-top: 28px; }
      .hero-copy { display: grid; gap: 10px; align-content: start; color: var(--muted); }
      .hero-copy p { max-width: 32em; }
      .hero-strong { margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--line-strong); font-size: clamp(20px, 2vw, 25px); font-weight: 500; letter-spacing: -.03em; line-height: 1.28; color: var(--ink); }

      /* Secciones */
      .section { padding-block: 88px; }
      .panel { background: var(--panel); }
      .night { background: var(--night); color: var(--night-text); }
      .split { display: grid; gap: 18px; }
      .split > .label { align-self: start; padding-top: 10px; }
      .split-tight { margin-top: 40px; }
      .h2 { margin-top: 0; font-size: clamp(30px, 4.4vw, 58px); font-weight: 500; letter-spacing: -.05em; line-height: 1.07; max-width: 15em; }
      section > .wrap > .h2, .section > .h2 { margin-top: 16px; }
      .h2-wide { max-width: 19em; }
      .h2-pair { display: grid; gap: 4px; }
      .h2-accent { color: var(--orange-ink); }
      .lede { margin-top: 20px; max-width: 30em; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.45; letter-spacing: -.018em; color: var(--text); }
      .prose-line { margin-top: 22px; max-width: 36em; color: var(--muted); }
      .prose-ink { color: var(--text); font-size: 18px; }
      .prose-night { color: #b9bcc0; }
      .statement { display: grid; gap: 2px; margin-top: 40px; font-size: clamp(25px, 3.2vw, 42px); font-weight: 500; letter-spacing: -.045em; line-height: 1.12; max-width: 17em; }
      .statement::before { content: ""; display: block; width: 40px; height: 3px; margin-bottom: 16px; background: var(--orange); }
      .huge { margin-top: 72px; font-size: clamp(36px, 7vw, 100px); font-weight: 500; letter-spacing: -.062em; line-height: 1; max-width: 12em; }
      .n { flex: 0 0 26px; font-size: 12px; font-weight: 650; color: var(--soft); }

      /* Filtro */
      .filter { margin-top: 36px; border-top: 1px solid var(--ink); }
      .filter li { display: flex; gap: 14px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); }
      .filter-q { font-size: clamp(21px, 2.3vw, 30px); font-weight: 500; letter-spacing: -.035em; line-height: 1.18; }
      .filter-d { margin-top: 4px; max-width: 36em; font-size: 16px; color: var(--muted); }
      .filter-last .n { color: var(--orange); }
      .filter-last .filter-q { color: var(--slate); }

      /* Citas */
      .quote blockquote { font-size: clamp(21px, 2.3vw, 29px); font-weight: 400; letter-spacing: -.03em; line-height: 1.3; max-width: 24em; }
      .quote figcaption { margin-top: 10px; font-size: 13px; color: #9a9ea3; }
      .night .huge { color: var(--night-text); }

      /* Radiografía */
      .steps { margin-top: 28px; border-top: 1px solid var(--line-strong); }
      .steps li { display: flex; gap: 14px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line-strong); font-size: clamp(18px, 1.7vw, 21px); letter-spacing: -.02em; }
      .nots { margin-top: 28px; }
      .nots li { padding: 8px 0; font-size: 16px; color: var(--muted); }
      .nots li::before { content: "·"; margin-right: 10px; color: var(--slate); font-weight: 700; }

      /* Propuesta */
      .cmp { margin-top: 32px; display: grid; gap: 14px; }
      .cmp-row { display: grid; gap: 8px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
      .cmp-k b { font-size: 16px; font-weight: 650; }
      .cmp-k span { margin-left: 10px; font-size: 14px; color: var(--muted); }
      .cmp-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
      .cmp-steps li { padding: 8px 4px; border: 1px solid var(--slate-soft); border-radius: 6px; background: var(--paper); text-align: center; font-size: 12px; font-weight: 600; color: var(--slate); }
      .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }
      .cmp figcaption { font-size: 13px; color: var(--soft); }
      .worth { margin-top: 10px; font-size: clamp(38px, 6.6vw, 90px); font-weight: 500; letter-spacing: -.06em; line-height: 1; color: var(--orange-ink); }

      /* Mapa */
      .map { margin-top: 36px; padding: 18px; border: 1px solid var(--line-strong); border-radius: 16px; background: var(--paper); }
      .map-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
      .map-grid li { padding: 12px 14px; border: 1px solid var(--slate); border-radius: 10px; }
      .map-grid li.off { border: 1px dashed var(--orange); background: rgba(241, 101, 50, .05); }
      .map-grid b { display: block; font-size: 16px; font-weight: 600; letter-spacing: -.015em; color: var(--ink); }
      .map-grid span { display: block; margin-top: 2px; font-size: 13px; color: var(--slate); }
      .map-grid li.off span { color: var(--orange-ink); }
      .map figcaption { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 11px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
      .cap-on::before, .cap-off::before { content: ""; display: inline-block; width: 12px; height: 9px; margin-right: 7px; border-radius: 3px; vertical-align: middle; }
      .cap-on::before { border: 1px solid var(--slate); }
      .cap-off::before { border: 1px dashed var(--orange); }
      .map-note { margin-top: 8px; font-size: 13px; color: var(--soft); }
      .cl-1 { max-width: 22em; line-height: 1.15; }
      .prose-line + .worth { margin-top: 36px; }

      /* Cierre */
      .closing { padding-block: 120px 128px; }
      .cl-1 { font-size: clamp(28px, 3.6vw, 48px); font-weight: 500; letter-spacing: -.045em; color: var(--soft); }
      .cl-big { margin-top: 10px; max-width: 10em; font-size: clamp(52px, 11vw, 160px); font-weight: 500; letter-spacing: -.07em; line-height: .95; }
      .cl-3 { margin-top: 56px; max-width: 30em; font-size: clamp(19px, 1.8vw, 23px); letter-spacing: -.02em; color: var(--text); }

      /* CTA */
      .cta { border-top: 1px solid var(--line); }
      .cta-title { max-width: 14em; }
      .cta-copy { margin-top: 20px; max-width: 32em; font-size: 18px; color: var(--muted); }
      .cta-row { display: grid; gap: 36px; margin-top: 40px; }
      .buttons { display: grid; gap: 10px; justify-items: start; }
      .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 56px; padding: 0 24px; background: var(--slate); color: var(--night-text); font-size: 16px; font-weight: 600; transition: background-color .2s ease, color .2s ease; }
      .button:hover { background: var(--ink); }
      .button-ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
      .button-ghost:hover { background: var(--ink); color: var(--paper); }
      .signature { padding-top: 18px; border-top: 1px solid var(--line); max-width: 280px; }
      .signature-name { font-size: 18px; font-weight: 650; letter-spacing: -.02em; }
      .signature-role { font-size: 14px; color: var(--muted); }
      .signature-site { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--slate); }

      /* Pie y consentimiento */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding-block: 26px 30px; font-size: 13px; color: var(--muted); }
      .foot-brand { margin-right: auto; }
      .foot a:hover { color: var(--ink); }
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; background: var(--night); color: var(--night-text); font-size: 13px; line-height: 1.5; border: 1px solid #3a3d42; box-shadow: 0 10px 30px rgba(0, 0, 0, .18); }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; }
      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 38px; padding: 0 16px; border: 1px solid #3a3d42; background: transparent; color: var(--night-text); font: inherit; cursor: pointer; }
      .consent .consent-accept { background: var(--night-text); color: var(--night); border-color: var(--night-text); }

      /* Movimiento */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }
      .js .cmp-steps li.hot { background: var(--paper); border-color: var(--slate-soft); color: var(--slate); transition: background-color .4s ease calc(.3s + var(--i) * 50ms), border-color .4s ease calc(.3s + var(--i) * 50ms), color .4s ease calc(.3s + var(--i) * 50ms); }
      .js .cmp.is-in .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }

      .js .map-grid li { opacity: .25; transition: opacity .45s ease calc(.2s + var(--i) * 120ms); }
      .js .map.is-in .map-grid li { opacity: 1; }

      @media (min-width: 420px) {
        .top-link { display: inline; }
        .cmp-steps li { font-size: 13px; }
      }
      .top-nav .top-link-x { display: none; }
      @media (min-width: 900px) {
        .top-nav .top-link-x { display: inline; }
      }
      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .map-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .cmp-row { grid-template-columns: 210px minmax(0, 1fr); align-items: center; gap: 16px; }
        .cmp-k span { display: block; margin-left: 0; }
        .cta-row { grid-template-columns: auto 1fr; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }
      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 40px; padding-bottom: 116px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 52px; align-items: start; }
        .section { padding-block: 128px; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .closing { padding-block: 180px 190px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .map-grid li { opacity: 1; transition: none; }
        .js .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); transition: none; }
        .top, .button, .top-cta { transition: none; }
      }
      .inline-link { color: var(--slate); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
      .inline-link:hover { color: var(--ink); }
    </style>
  </body>
</html>
