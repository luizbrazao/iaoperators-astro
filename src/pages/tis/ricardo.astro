---
// Landing personalizada para Ricardo Sánchez González, director general de
// Hotel Cap Negret (Altea). Se llega por el QR de una tarjeta entregada en mano.
// Privada: noindex,nofollow y fuera del sitemap ("/tis/" en NOINDEX_PATHS de
// astro.config.mjs).
//
// Concepto: Cap Negret ya trabaja con tecnología y datos. La pregunta no es qué
// falta, sino si el conjunto funciona como un sistema. El lenguaje visual son
// nodos, capas y conexiones: las herramientas están en los nodos y la fricción,
// si existe, en las líneas entre ellos. El naranja de marca se reserva para
// esos puntos de paso; el azul es el de las cúpulas de Altea.
//
// Datos públicos usados (verificados el 04/10/2026):
//   - Web de Cap Negret, sostenibilidad: Power BI para datos de negocio y de
//     consumo energético, Niikiis (fichajes y comunicación interna), app Salto
//     como llave, planta fotovoltaica de 100 kW, contactos magnéticos en
//     terrazas, check-in online.
//   - TecnoHotel, 27/01/2025: PMS integrado con el motor de reservas y este con
//     el channel manager; precio que sube automáticamente con la ocupación;
//     encuestas durante la estancia; equipos ciclistas profesionales en invierno.
//
// Comportamiento compartido (analítica, consentimiento, vídeo, entradas) en
// src/scripts/prospect-landing.ts.

// --- Configuración editable ---------------------------------------------------
// Vídeo: subir el MP4 a /public/video/ y rellenar `src` (y `poster`).
const VIDEO = {
  youtube: "wVUZuLMHoyg", // https://youtu.be/wVUZuLMHoyg
  src: "",
  poster: "",
  type: "video/mp4",
  orientation: "horizontal" as "horizontal" | "vertical",
  duracion: "1 min 24 s",
};

// "Hablar con Luiz": hoy WhatsApp con mensaje preparado. Para Cal.com basta
// con sustituir la URL.
const CONTACT_HREF = `https://wa.me/34662423523?text=${encodeURIComponent(
  "Hola Luiz, soy Ricardo Sánchez, de Cap Negret. He visto la página sobre la Radiografía Digital y me gustaría hablarlo.",
)}`;
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/ricardo/", site).toString();
const ogImage = new URL("/og/ricardo.png", site).toString();
const title = "Ricardo Sánchez × IA Operators | Radiografía Digital";
const description = "Una propuesta de Radiografía Digital preparada por IA Operators para Hotel Cap Negret.";

const pad = (n: number) => String(n).padStart(2, "0");

const cadena = ["Persona", "Sistema", "Dato", "Decisión", "Acción"];

const preguntas = [
  { tag: "Sistema → sistema", q: "¿Dónde se copia información manualmente entre sistemas?" },
  { tag: "Dato → persona", q: "¿Qué dato existe pero no llega a quien lo necesita?" },
  { tag: "Excel · email · mensaje", q: "¿Qué proceso depende todavía de un Excel, un email o un mensaje?" },
  { tag: "Herramienta ↔ herramienta", q: "¿Qué tarea se ejecuta dos veces porque las herramientas no están conectadas?" },
  { tag: "Persona como enlace", q: "¿Dónde una persona actúa como «integración» entre dos sistemas?" },
  { tag: "Dato → acción", q: "¿Qué información podría desencadenar automáticamente una acción?" },
];

// Lo que se ve desde fuera. `linked`: la integración entre esos nodos es pública.
const capas = [
  { name: "Comercial", nodes: ["Motor de reservas", "PMS", "Channel manager"], linked: true, note: "Integrados entre sí. El precio sube solo al llegar a cierta ocupación." },
  { name: "Huésped", nodes: ["Check-in online", "Llave en el móvil con Salto", "Encuestas durante la estancia"], linked: false, note: "" },
  { name: "Equipo", nodes: ["Niikiis"], linked: false, note: "Fichajes y comunicación interna." },
  { name: "Datos", nodes: ["Power BI"], linked: false, note: "Cruza datos de negocio, ingresos, costes y consumos para decidir." },
  { name: "Energía", nodes: ["Planta fotovoltaica", "Corte del aire al abrir la terraza"], linked: false, note: "" },
];

const observamos = [
  "Quién interviene",
  "Qué información entra",
  "Qué sistema se utiliza",
  "Qué decisión se toma",
  "Qué información se transfiere",
  "Qué tarea se ejecuta después",
];

const senales = [
  { name: "Repetición", gloss: "Lo mismo, hecho más de una vez." },
  { name: "Transferencia", gloss: "Información que cambia de manos o de sistema." },
  { name: "Espera", gloss: "Trabajo parado hasta que alguien actúa." },
  { name: "Inconsistencia", gloss: "El mismo dato, con dos valores distintos." },
];
const areas = ["Captación", "Atención", "Operación", "Gestión"];

const revelar = [
  "una integración sencilla resuelve el problema;",
  "un proceso necesita rediseñarse;",
  "una información debería llegar sola a otra área;",
  "una tarea puede automatizarse;",
  "un dato disponible todavía no se está aprovechando;",
];
const revelarUltimo = "o que una parte de la operación ya funciona muy bien y no necesita ninguna intervención.";

const pasosEjemplo = [
  "Abre una herramienta",
  "Copia la información",
  "Envía un email",
  "Actualiza otra herramienta",
  "Avisa a otra persona",
];

const mapa = [
  "Dónde existe una fricción",
  "Qué impacto tiene",
  "Qué la está causando",
  "Qué merece prioridad",
  "Qué podría integrarse",
  "Qué podría automatizarse",
  "Dónde puede aportar valor la IA",
];

const flujos = [
  "atención al huésped",
  "operación",
  "administración",
  "gestión interna",
  "información entre departamentos",
  "sostenibilidad",
  "la estancia de un equipo ciclista",
];

const preguntasPropuesta = [
  "¿Dónde está la fricción?",
  "¿Qué impacto tiene?",
  "¿Qué la provoca?",
  "¿Merece la pena resolverla?",
];

const opciones = ["automatizar", "integrar", "rediseñar un proceso", "aprovechar mejor un dato existente", "cambiar una herramienta"];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="La tecnología ya está. La pregunta es si todo funciona como un sistema. Una idea para Ricardo Sánchez." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#fbfbf9" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="label">Una idea para Ricardo Sánchez</p>
        <h1 id="hero-title" class="greeting">Ricardo, por lo que he visto, en Cap Negret la tecnología ya forma parte de la operación.</h1>
        <p class="thesis">
          <span class="thesis-a">La tecnología ya está.</span>
          <span class="thesis-b">La pregunta es si todo funciona como un sistema.</span>
        </p>

        <div class="hero-grid">
          <div class:list={["video", `video-${VIDEO.orientation}`]} data-video data-youtube={VIDEO.youtube || undefined}>
            {VIDEO.src && (
              <video class="video-el" preload="none" playsinline controls poster={VIDEO.poster || undefined} aria-label="Vídeo de Luiz Brazão para Ricardo Sánchez">
                <source src={VIDEO.src} type={VIDEO.type} />
              </video>
            )}
            <button class="video-cover" type="button" data-video-play aria-label={`Reproducir el vídeo de Luiz Brazão, ${VIDEO.duracion}`}>
              <span class="video-grid" aria-hidden="true"></span>
              <span class="video-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
              </span>
              <span class="video-meta">
                <span class="video-time">▶ {VIDEO.duracion}</span>
                <span class="video-who">Luiz Brazão · IA Operators</span>
              </span>
            </button>
            <p class="video-note" data-video-note hidden>El vídeo estará disponible en breve.</p>
          </div>

          <div class="hero-copy">
            <p>Power BI, herramientas de gestión, comunicación interna, eficiencia energética, sostenibilidad y nuevas soluciones operativas ya forman parte del día a día.</p>
            <p>Cuando una organización llega a ese nivel de madurez, aparece una pregunta diferente:</p>
            <p class="hero-q">¿Dónde siguen existiendo fricciones entre personas, procesos, datos y tecnología?</p>
          </div>
        </div>
      </section>

      <!-- 01 · Entre herramientas -->
      <section id="entre" class="section wrap" aria-labelledby="entre-title">
        <p class="label" data-reveal>01 · Entre herramientas</p>
        <h2 id="entre-title" class="h2 h2-pair" data-reveal>
          <span>A veces la fricción no está dentro de una herramienta.</span>
          <span class="h2-accent">Está entre dos herramientas.</span>
        </h2>

        <figure class="chain-fig" data-reveal>
          <ol class="chain" aria-label="Persona, sistema, dato, decisión, acción">
            {cadena.map((c, i) => <li style={`--i:${i}`}><span class="chain-node">{c}</span></li>)}
          </ol>
          <figcaption class="chain-cap">Las herramientas están en los nodos. La fricción, si existe, suele estar en las flechas.</figcaption>
        </figure>

        <p class="intro" data-reveal>Son algunas de las preguntas que hacemos cuando analizamos una operación tecnológicamente madura.</p>
        <ul class="joints">
          {preguntas.map((p, i) => (
            <li data-reveal style={`--d:${(i % 2) * 80}ms`}>
              <span class="joint-tag">{p.tag}</span>
              <p>{p.q}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- 02 · Cap Negret -->
      <section id="cap-negret" class="limestone" aria-labelledby="cn-title">
        <div class="wrap section">
          <div class="split">
            <p class="label" data-reveal>02 · Cap Negret</p>
            <div>
              <h2 id="cn-title" class="h2" data-reveal>Cap Negret ya ha demostrado algo importante.</h2>
              <p class="lede" data-reveal>La tecnología puede utilizarse para mejorar decisiones, eficiencia y rentabilidad.</p>
              <div class="prose" data-reveal>
                <p>El hotel ya utiliza datos y herramientas digitales en áreas distintas de la operación.</p>
                <p>Por eso, la siguiente oportunidad quizá no esté en incorporar otra plataforma, sino en mirar de forma transversal cómo trabajan juntas todas las piezas.</p>
              </div>
            </div>
          </div>

          <figure class="stack" data-reveal>
            <div class="stack-head">
              <p class="label">Lo que se ve desde fuera</p>
              <p class="stack-src">Según la web del hotel y una entrevista publicada en TecnoHotel (enero de 2025).</p>
            </div>
            <ol class="layers">
              {capas.map((c, i) => (
                <li class="layer" style={`--i:${i}`}>
                  <span class="layer-name">{c.name}</span>
                  <span class:list={["nodes", { "nodes-linked": c.linked }]}>
                    {c.nodes.map((n) => <span class="node">{n}</span>)}
                  </span>
                  {c.note && <span class="layer-note">{c.note}</span>}
                </li>
              ))}
            </ol>
            <figcaption class="legend">
              <span class="legend-item"><i class="legend-solid" aria-hidden="true"></i>Conexión publicada</span>
              <span class="legend-item"><i class="legend-dashed" aria-hidden="true"></i>Lo que no se ve desde fuera: cómo pasa el trabajo de una capa a otra</span>
            </figcaption>
          </figure>

          <p class="less-more" data-reveal>
            <span>Menos herramientas aisladas.</span>
            <span>Más flujo entre ellas.</span>
          </p>
        </div>
      </section>

      <!-- La pregunta -->
      <section class="navy flowq" aria-labelledby="flowq-title">
        <div class="wrap">
          <p class="flowq-small" data-reveal>La pregunta que nos interesa no es:</p>
          <p class="flowq-not" data-reveal>¿Qué software falta?</p>
          <p class="flowq-small" data-reveal>Sino:</p>
          <h2 id="flowq-title" class="flowq-big" data-reveal>¿Dónde se rompe el flujo?</h2>
          <div class="breakline" data-reveal aria-hidden="true"><span></span><i></i><span></span></div>
        </div>
      </section>

      <!-- 03 · Radiografía -->
      <section id="radiografia" class="section wrap" aria-labelledby="rd-title">
        <div class="split">
          <p class="label" data-reveal>03 · Radiografía Digital</p>
          <div>
            <h2 id="rd-title" class="h2" data-reveal>Eso es lo que buscamos en una Radiografía Digital.</h2>
            <p class="lede" data-reveal>No analizamos herramientas de forma aislada. Analizamos cómo circula el trabajo.</p>
            <p class="prose-line" data-reveal>Seguimos los procesos desde que empieza una necesidad hasta que termina.</p>
          </div>
        </div>

        <div class="trace-block">
          <p class="label label-ink" data-reveal>Observamos</p>
          <ol class="trace" data-reveal>
            {observamos.map((o, i) => <li style={`--i:${i}`}><span class="trace-n">{pad(i + 1)}</span>{o}</li>)}
          </ol>
        </div>

        <div class="signals-block">
          <p class="label label-ink" data-reveal>Y buscamos los momentos en los que aparece</p>
          <ul class="signals">
            {senales.map((s, i) => (
              <li data-reveal style={`--d:${i * 70}ms`}>
                <span class="signal-name">{s.name}</span>
                <span class="signal-gloss">{s.gloss}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Framework 4×4 -->
      <section id="metodo" class="section section-tight wrap" aria-labelledby="fw-title">
        <div class="split">
          <p class="label" data-reveal>Framework 4×4</p>
          <div>
            <h2 id="fw-title" class="h3" data-reveal>Una forma estructurada de mirar la operación.</h2>
            <p class="prose-line" data-reveal>Cuatro áreas de la operación. Cuatro señales en cada una.</p>
            <div class="matrix" data-reveal>
              <table>
                <caption class="sr-only">Framework 4×4: cuatro áreas de la operación por cuatro señales de fricción</caption>
                <thead>
                  <tr>
                    <td></td>
                    {senales.map((s) => (
                      <th scope="col"><span class="mx-full">{s.name}</span><span class="mx-short" aria-hidden="true">{s.name.charAt(0)}</span></th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {areas.map((a, r) => (
                    <tr>
                      <th scope="row">{a}</th>
                      {senales.map((s, c) => (
                        <td><span class="mx-dot" style={`--i:${r * 4 + c}`}></span><span class="sr-only">{a} · {s.name}</span></td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="mx-legend" aria-hidden="true">{senales.map((s) => <span><b>{s.name.charAt(0)}</b> {s.name}</span>)}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 04 · Lo que ya existe -->
      <section id="existente" class="limestone" aria-labelledby="ex-title">
        <div class="wrap section">
          <div class="split">
            <p class="label" data-reveal>04 · Lo que ya existe</p>
            <div>
              <h2 id="ex-title" class="h2" data-reveal>No empezamos preguntando qué deberíamos comprar.</h2>
              <p class="lede" data-reveal>Primero queremos entender qué está pasando con lo que ya existe.</p>
              <p class="prose-line" data-reveal>El análisis puede mostrar que:</p>
              <ul class="outcomes" data-reveal>
                {revelar.map((r) => <li>{r}</li>)}
                <li class="outcome-last">{revelarUltimo}</li>
              </ul>
              <div class="maxim" data-reveal>
                <p class="maxim-a">Más tecnología no siempre significa mejor operación.</p>
                <p class="maxim-b">A veces la mejor decisión es conectar mejor lo que ya existe.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Ejemplo -->
      <section id="ejemplo" class="section wrap" aria-labelledby="ej-title">
        <div class="example" data-reveal>
          <p class="example-tag">Ejemplo ilustrativo · no describe Cap Negret</p>
          <h2 id="ej-title" class="h3">Un ejemplo sencillo</h2>
          <p class="example-intro">Imagina que un dato ya existe en un sistema. Otro departamento lo necesita. Pero entre los dos todavía hay una persona que:</p>

          <ol class="handoff" aria-label="Pasos manuales entre dos sistemas">
            <li class="handoff-sys">Sistema A</li>
            {pasosEjemplo.map((p, i) => <li class="handoff-step" style={`--i:${i}`}><span class="handoff-n">{i + 1}</span>{p}</li>)}
            <li class="handoff-sys">Sistema B</li>
          </ol>

          <div class="example-close">
            <p>Ninguna de las herramientas está necesariamente mal. El problema está en el flujo entre ellas.</p>
            <p class="example-last">Ese espacio entre sistemas es precisamente donde muchas oportunidades pasan desapercibidas.</p>
          </div>
        </div>
      </section>

      <!-- 05 · Resultado -->
      <section id="resultado" class="section section-top0 wrap" aria-labelledby="res-title">
        <div class="split">
          <p class="label" data-reveal>05 · Resultado</p>
          <div>
            <h2 id="res-title" class="h2" data-reveal>El resultado no es una lista de software.</h2>
            <p class="lede" data-reveal>Es un mapa priorizado de oportunidades.</p>
            <ol class="results" data-reveal>
              {mapa.map((m, i) => <li><span class="res-n">{pad(i + 1)}</span>{m}</li>)}
            </ol>
            <p class="results-last" data-reveal><span class="res-n">{pad(mapa.length + 1)}</span>Qué no merece la pena tocar</p>
          </div>
        </div>
      </section>

      <!-- 06 · Propuesta -->
      <section id="propuesta" class="limestone" aria-labelledby="pr-title">
        <div class="wrap section">
          <div class="split">
            <p class="label label-blue" data-reveal>Una propuesta para Cap Negret</p>
            <div>
              <h2 id="pr-title" class="h2" data-reveal>Analicemos un proceso de principio a fin.</h2>
              <div class="prose" data-reveal>
                <p>En lugar de empezar con una auditoría enorme de toda la organización, podemos elegir uno o varios procesos concretos y seguir todo su recorrido.</p>
                <p>Desde que aparece una necesidad hasta que el proceso termina.</p>
              </div>
              <p class="prose-line" data-reveal>Por ejemplo, un flujo relacionado con:</p>
              <ul class="chips" data-reveal>
                {flujos.map((f) => <li>{f}</li>)}
              </ul>
              <p class="chips-note" data-reveal>Cuál conviene mirar primero es algo que preferimos decidir contigo.</p>
            </div>
          </div>

          <div class="journey" data-reveal>
            <p class="label label-ink">El objetivo inicial sería responder</p>
            <ol class="stations">
              <li class="station-end">Necesidad</li>
              {preguntasPropuesta.map((p, i) => <li class="station" style={`--i:${i}`}>{p}</li>)}
              <li class="station-end">Fin del proceso</li>
            </ol>
            <div class="after">
              <p class="label label-ink">Y solo después</p>
              <p class="after-q">¿Cuál es la mejor forma de hacerlo?</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Independencia -->
      <section id="independencia" class="section wrap" aria-labelledby="ind-title">
        <div class="split">
          <p class="label" data-reveal>Independencia</p>
          <div>
            <h2 id="ind-title" class="h2" data-reveal>Sin software que vender.</h2>
            <div class="prose" data-reveal>
              <p>IA Operators no representa ninguna plataforma hotelera.</p>
              <p>No necesitamos justificar una herramienta. Tampoco necesitamos encontrar un lugar donde introducir inteligencia artificial.</p>
            </div>
            <p class="prose-line" data-reveal>Podemos recomendar:</p>
            <ul class="options" data-reveal>
              {opciones.map((o) => <li>{o}</li>)}
            </ul>
            <p class="options-last" data-reveal>o, simplemente, no cambiar nada.</p>
            <p class="principle" data-reveal>La tecnología es una consecuencia del diagnóstico, no el punto de partida.</p>
          </div>
        </div>
      </section>

      <!-- Conversación -->
      <section id="hablar" class="cta" aria-labelledby="cta-title">
        <div class="wrap section">
          <h2 id="cta-title" class="h2 cta-title" data-reveal>Si la pregunta te parece interesante, seguimos la conversación.</h2>
          <p class="cta-copy" data-reveal>Puedo enseñarte cómo hacemos una Radiografía Digital y valorar juntos qué proceso tendría más sentido analizar primero en Cap Negret.</p>
          <div class="cta-row" data-reveal>
            <a class="button" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="final">Hablar con Luiz <span aria-hidden="true">↗</span></a>
            <div class="signature">
              <p class="signature-name">Luiz Brazão</p>
              <p class="signature-role">Founder, IA Operators</p>
              <a class="signature-site" href="https://iaoperators.com/es/" data-cta="site">iaoperators.com</a>
            </div>
          </div>
        </div>
      </section>
