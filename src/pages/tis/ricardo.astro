      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 40px; padding: 0 16px; border: 1px solid var(--navy-line); background: transparent; color: var(--navy-text); font: inherit; border-radius: 2px; cursor: pointer; }
      .consent .consent-accept { background: var(--navy-text); color: var(--navy); border-color: var(--navy-text); }

      /* Entradas: muy discretas */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }
      .js .chain li + li::before { transform: scaleY(0); transition: transform .5s var(--ease) calc(.25s + var(--i) * .14s); }
      .js .chain-fig.is-in .chain li + li::before { transform: none; }
      .js .mx-dot { background: transparent; transition: background-color .3s ease calc(.2s + var(--i) * 40ms); }
      .js .matrix.is-in .mx-dot { background: var(--ink); }
      .js .breakline i { opacity: 0; transition: opacity .6s ease .5s; }
      .js .breakline.is-in i { opacity: 1; }

      @media (min-width: 420px) {
        .top-link { display: inline; }
      }

      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .chain { display: flex; align-items: center; justify-items: initial; }
        .chain li { flex-direction: row; align-items: center; flex: 1 1 0; }
        .chain li:first-child { flex: 0 0 auto; }
        .chain li + li::before { flex: 1; width: auto; height: 9px; margin: 0 10px; background-size: 9px 9px, 100% 1px; transform-origin: left; }
        .js .chain li + li::before { transform: scaleX(0); }
        .joints { grid-template-columns: 1fr 1fr; column-gap: 48px; }
        .stack { padding: 30px 32px 24px; }
        .layer { grid-template-columns: 130px minmax(0, 1fr); align-items: center; column-gap: 24px; }
        .layer-note { grid-column: 2; }
        .nodes-linked { flex-direction: row; align-items: center; }
        .nodes-linked .node + .node { margin-top: 0; margin-left: 26px; }
        .nodes-linked .node + .node::after { left: -27px; top: 50%; width: 26px; height: 1px; }
        .legend { grid-template-columns: auto 1fr; column-gap: 32px; }
        .mx-full { display: inline; }
        .mx-short, .mx-legend { display: none; }
        .example { padding: 40px 44px 44px; }
        .results { display: grid; grid-template-columns: 1fr 1fr; column-gap: 40px; }
        .stations { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); padding-left: 0; padding-top: 22px; column-gap: 18px; }
        .stations::before { left: 0; right: 0; top: 3px; bottom: auto; width: auto; height: 1px; }
        .stations li { padding: 0; }
        .stations li::before { left: 0; top: -22px; }
        .station { font-size: clamp(19px, 1.8vw, 23px); }
        .cta-row { grid-template-columns: auto 1fr; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }

      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 40px; padding-bottom: 112px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 44px; align-items: start; }
        .section { padding-block: 128px; }
        .section-tight, .section-top0 { padding-top: 0; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .chain-fig, .intro, .joints, .stack, .trace-block, .signals-block, .journey, .less-more { margin-left: calc((100% - 48px) / 3 + 48px); }
        .chain-fig { margin-top: 72px; }
        .stack { margin-top: 72px; }
        .trace-block, .signals-block { margin-top: 72px; }
        .trace { grid-template-columns: 1fr 1fr; column-gap: 40px; }
        .trace::before { display: none; }
        .trace li { border-bottom: 1px solid var(--line); padding: 14px 0; }
        .trace li::before { display: none; }
        .trace { padding-left: 0; border-top: 1px solid var(--line); }
        .signals { grid-template-columns: 1fr 1fr; column-gap: 40px; }
        .flowq { padding-block: 140px 120px; }
        .journey { margin-top: 88px; }
        .handoff { display: grid; grid-template-columns: auto repeat(5, minmax(0, 1fr)) auto; align-items: start; margin-top: 44px; }
        .handoff li { display: block; }
        .handoff li.handoff-sys { display: inline-flex; align-items: center; }
        .handoff-step { margin: 0; padding: 56px 12px 0; border-left: 0; font-size: 15px; line-height: 1.35; }
        .handoff-step:first-of-type, .handoff-sys + .handoff-step { padding-top: 56px; }
        .handoff-step:last-of-type { padding-bottom: 0; }
        .handoff-step::before { content: ""; position: absolute; left: 0; right: 0; top: 22px; height: 1px; background: var(--line-strong); }
        .handoff-n { position: absolute; top: 11px; left: 12px; width: 22px; height: 22px; margin: 0; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .chain li + li::before, .js .mx-dot, .js .breakline i { transform: none; transition: none; opacity: 1; }
        .js .mx-dot { background: var(--ink); }
        .video-play, .top, .button { transition: none; }
      }
    </style>
  </body>
</html>
