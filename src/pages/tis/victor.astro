---
// Landing personalizada para Víctor Sánchez González, director general de Tres
// Reyes Hoteles (Pamplona y San Sebastián). Se llega por el QR de una tarjeta
// entregada en mano. Privada: noindex,nofollow y fuera del sitemap.
//
// Concepto: la IA ya está implantada; ahora toca demostrar impacto. La pregunta
// central es "¿qué cambió realmente?". La Radiografía Digital se presenta como
// medición antes/después, una capa independiente y complementaria a quien
// implantó (no se nombra a la Alianza Hotelera a propósito).
//
// Lenguaje visual: antes → después, líneas de tiempo y medición (Δ). Índigo
// para el "después", gris para el "antes" y naranja solo para la fricción que
// queda.
//
// Contexto aportado por Luiz (no verificado públicamente a 04/10/2026):
// programa de IA agéntica con la Alianza Hotelera en Comercial, Marketing,
// Revenue, F&B, Mantenimiento y Housekeeping; nueva etapa de crecimiento.
// Verificado: Víctor Sánchez, director general desde 2014; Tres Reyes en
// Pamplona y en San Sebastián (Miramón, 2021).

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  src: "",
  poster: "",
  type: "video/mp4",
  orientation: "horizontal" as "horizontal" | "vertical",
  duracion: "55 segundos",
};

const CONTACT_HREF = `https://wa.me/34662423523?text=${encodeURIComponent(
  "Hola Luiz, soy Víctor Sánchez, de Tres Reyes Hoteles. He visto la página sobre la Radiografía Digital y me gustaría hablarlo.",
)}`;
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/victor/", site).toString();
const ogImage = new URL("/og/victor.png", site).toString();
const title = "Víctor Sánchez × IA Operators | Radiografía Digital";
const description = "Una reflexión sobre medición, automatización e impacto preparada por IA Operators para Tres Reyes Hoteles.";

const pad = (n: number) => String(n).padStart(2, "0");

const areasIA = ["Comercial", "Marketing", "Revenue", "F&B", "Mantenimiento", "Housekeeping"];

const peroPuede = [
  "ser poco utilizada",
  "ahorrar poco tiempo",
  "crear nuevas excepciones",
  "depender demasiado de la supervisión",
  "trasladar la fricción a otro departamento",
  "generar resultados difíciles de medir",
  "o resolver un problema demasiado pequeño para justificar su mantenimiento",
];

const medir = [
  { d: "tiempo", q: "¿Cuánto tiempo desapareció?" },
  { d: "pasos", q: "¿Cuántos pasos se eliminaron?" },
  { d: "transferencias", q: "¿Cuántas transferencias dejaron de existir?" },
  { d: "excepciones", q: "¿Cuántas excepciones sigue gestionando una persona?" },
  { d: "respuesta", q: "¿Mejoró el tiempo de respuesta?" },
  { d: "errores", q: "¿Disminuyeron los errores?" },
  { d: "adopción", q: "¿El equipo utiliza realmente el nuevo proceso?" },
  { d: "huésped", q: "¿El huésped percibe alguna mejora?" },
];

const filas = ["Proceso", "Tiempo", "Personas", "Sistemas", "Errores", "Esperas", "Excepciones"];

const mirar = [
  "cómo funcionaba el proceso",
  "cómo funciona ahora",
  "qué tareas desaparecieron",
  "qué tareas nuevas aparecieron",
  "qué excepciones siguen existiendo",
  "cuánto trabajo humano sigue siendo necesario",
  "qué impacto produjo realmente el cambio",
];

const areas = ["Captación", "Atención", "Operación", "Gestión"];
const senales = ["Repetición", "Transferencia", "Espera", "Inconsistencia"];
// Patrón ilustrativo: 1 = señal presente. "despues" apaga algunas.
const antes4 = [1, 1, 0, 1, 1, 1, 1, 0, 1, 1, 1, 1, 0, 1, 1, 1];
const despues4 = [0, 1, 0, 0, 1, 0, 1, 0, 0, 1, 0, 1, 0, 0, 1, 0];

const adopcion = [
  "¿El equipo confía en el nuevo proceso?",
  "¿Lo utiliza siempre?",
  "¿O vuelve al método anterior cuando aparece una excepción?",
  "¿Hay pasos en paralelo?",
  "¿Están apareciendo nuevos Excel, mensajes o tareas manuales alrededor de la automatización?",
];

// Ejemplo ilustrativo de falso positivo (minutos conceptuales).
const fpAntes = [
  { t: "Recibir", m: 3 }, { t: "Tarea", m: 10 }, { t: "Cerrar", m: 4 },
];
const fpDespues = [
  { t: "Recibir", m: 3 }, { t: "Tarea", m: 2, win: true }, { t: "Revisión manual", m: 5, new: true }, { t: "Cerrar", m: 4 },
];
const escondidas = ["una revisión manual posterior", "una excepción frecuente", "una duplicación de datos", "una nueva dependencia"];

const replicar = ["replicarse", "simplificarse", "automatizarse", "integrarse"];
const iniciativas = ["Housekeeping", "Mantenimiento", "Revenue", "F&B", "Comercial", "Marketing"];
const plan = [
  "mapear el antes",
  "mapear el después",
  "identificar métricas",
  "entrevistar a quienes lo usan",
  "observar las excepciones",
  "calcular frecuencias",
  "identificar las fricciones que quedan",
  "y producir una evaluación objetiva",
];
const cadena = ["Antes", "Cambio", "Resultado", "Fricciones restantes", "Impacto", "Decisión"];
const decisiones = ["Escalar", "Ajustar", "Integrar", "Rediseñar", "Detener"];
const preguntasInd = ["¿Funcionó?", "¿Cuánto?", "¿Para quién?", "¿A qué coste?", "¿Deberíamos escalarlo?"];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Implantar es solo el principio. ¿Qué cambió realmente? Una reflexión para Víctor Sánchez." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#fbfbfa" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="label">Una reflexión para Víctor Sánchez</p>
        <h1 id="hero-title" class="greeting">Víctor, acabáis de dar un paso importante con la IA.</h1>
        <p class="start">Implantar es solo el principio.</p>
        <p class="sub">Ahora toca demostrar impacto.</p>

        <div class="hero-grid">
          <div class:list={["video", `video-${VIDEO.orientation}`]} data-video>
            {VIDEO.src && (
              <video class="video-el" preload="none" playsinline controls poster={VIDEO.poster || undefined} aria-label="Vídeo de Luiz Brazão para Víctor Sánchez">
                <source src={VIDEO.src} type={VIDEO.type} />
              </video>
            )}
            <button class="video-cover" type="button" data-video-play aria-label={`Reproducir el vídeo de Luiz Brazão, ${VIDEO.duracion}`}>
              <span class="video-tl" aria-hidden="true"><i></i><b></b><i class="d"></i></span>
              <span class="video-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
              </span>
              <span class="video-meta">
                <span class="video-time">▶ {VIDEO.duracion}</span>
                <span class="video-who">Luiz Brazão · IA Operators</span>
              </span>
            </button>
            <p class="video-note" data-video-note hidden>El vídeo estará disponible en breve.</p>
          </div>

          <div class="hero-copy">
            <ul class="areas" aria-label="Áreas">{areasIA.map((a) => <li>{a}</li>)}</ul>
            <p>ya están entrando en una nueva forma de trabajar.</p>
            <p>El siguiente reto quizá no sea incorporar más tecnología. Puede ser algo más difícil:</p>
            <p class="hero-strong">saber qué está funcionando de verdad.</p>
          </div>
        </div>

        <div class="horizon">
          <div class="tl" aria-hidden="true">
            <span class="tl-node tl-now">Implantación</span>
            <span class="tl-line"></span>
            <span class="tl-node tl-mid">+6 meses</span>
            <span class="tl-line tl-dashed"></span>
            <span class="tl-node tl-end">¿Qué cambió?</span>
          </div>
          <p class="horizon-q">Dentro de seis meses, ¿cómo sabremos qué automatizaciones merecen <span class="k">quedarse</span>, <span class="k">escalar</span> o <span class="k k-off">desaparecer</span>?</p>
        </div>
      </section>

      <!-- Valor -->
      <section id="valor" class="section wrap" aria-labelledby="va-title">
        <div class="split">
          <p class="label" data-reveal><b>Δ</b> Valor</p>
          <div>
            <h2 id="va-title" class="h2" data-reveal>Una automatización funcionando no significa necesariamente una automatización rentable.</h2>
            <p class="prose-line" data-reveal>Una automatización puede funcionar técnicamente y aun así</p>
            <ul class="list" data-reveal>{peroPuede.map((p) => <li>{p}</li>)}</ul>
            <p class="statement" data-reveal><span class="muted">Funcionar técnicamente</span> <span>y generar valor son cosas diferentes.</span></p>
          </div>
        </div>
      </section>

      <!-- Qué medir -->
      <section id="medir" class="mist" aria-labelledby="me-title">
        <div class="wrap section">
          <p class="label" data-reveal><b>Δ</b> Medición</p>
          <p class="was" data-reveal>La pregunta deja de ser «¿funciona?».</p>
          <h2 id="me-title" class="became" data-reveal>Y pasa a ser «¿qué cambió?».</h2>
          <ul class="dims" data-reveal>
            {medir.map((m, i) => (
              <li style={`--i:${i}`}>
                <span class="dim">Δ {m.d}</span>
                <span class="dim-q">{m.q}</span>
              </li>
            ))}
          </ul>
          <p class="note" data-reveal>Dimensiones que podrían medirse. No son resultados.</p>
        </div>
      </section>

      <!-- Antes / después -->
      <section id="linea-base" class="section wrap" aria-labelledby="lb-title">
        <p class="label" data-reveal><b>Δ</b> Línea base</p>
        <h2 id="lb-title" class="h2" data-reveal>Toda automatización necesita un antes.</h2>
        <div class="ba" data-reveal role="table" aria-label="Comparación antes y después de una automatización">
          <div class="ba-row ba-head" role="row">
            <span role="columnheader"><span class="sr-only">Dimensión</span></span>
            <span role="columnheader" class="ba-col-a">Antes</span>
            <span role="columnheader" class="ba-col-x">Automatización</span>
            <span role="columnheader" class="ba-col-b">Después</span>
          </div>
          {filas.map((f, i) => (
            <div class="ba-row" role="row" style={`--i:${i}`}>
              <span class="ba-k" role="rowheader">{f}</span>
              <span class="ba-a" role="cell"><i></i><span class="sr-only">sin medir</span></span>
              <span class="ba-x" role="cell" aria-hidden="true"><i></i></span>
              <span class="ba-b" role="cell"><i>?</i><span class="sr-only">por medir</span></span>
            </div>
          ))}
        </div>
        <p class="huge" data-reveal>Si no conocemos el antes, es muy difícil demostrar el después.</p>
      </section>

      <!-- Radiografía hacia atrás -->
      <section id="radiografia" class="ink" aria-labelledby="rd-title">
        <div class="wrap section">
          <div class="split">
            <p class="label label-ink" data-reveal><b>Δ</b> Radiografía Digital</p>
            <div>
              <h2 id="rd-title" class="h2" data-reveal>La Radiografía también puede mirar hacia atrás.</h2>
              <p class="lede lede-ink" data-reveal>Normalmente la utilizamos para descubrir oportunidades antes de implementar tecnología. Pero también puede utilizarse después.</p>
              <p class="prose-line prose-ink" data-reveal>En ese caso mapearíamos:</p>
              <ol class="steps steps-ink" data-reveal>{mirar.map((m, i) => <li><span class="n">{pad(i + 1)}</span>{m}</li>)}</ol>
            </div>
          </div>
          <p class="shift" data-reveal>
            <span class="shift-a">De «hemos implantado IA»</span>
            <span class="shift-b">a «sabemos qué impacto está generando».</span>
          </p>
        </div>
      </section>

      <!-- 4×4 antes / después -->
      <section id="patrones" class="section wrap" aria-labelledby="pa-title">
        <div class="split">
          <p class="label" data-reveal><b>Δ</b> Framework 4×4</p>
          <div>
            <h2 id="pa-title" class="h3" data-reveal>Los mismos patrones permiten medir el cambio.</h2>
            <p class="prose-line" data-reveal>Cuatro áreas y cuatro señales de fricción. Antes del cambio contamos cuántas aparecen. Después de la implantación, volvemos a mirar.</p>
          </div>
        </div>
        <div class="twin" data-reveal>
          {[{ k: "Antes", d: antes4 }, { k: "Después", d: despues4 }].map((m, mi) => (
            <figure class:list={["mx", { "mx-b": mi === 1 }]}>
              <figcaption>{m.k}</figcaption>
              <div class="mx-grid" role="img" aria-label={`Matriz 4×4 ilustrativa, ${m.k.toLowerCase()}`}>
                <span></span>
                {senales.map((s) => <span class="mx-h">{s.charAt(0)}</span>)}
                {areas.map((a, r) => (
                  <>
                    <span class="mx-a">{a}</span>
                    {senales.map((_, c) => <i class:list={{ on: m.d[r * 4 + c] }} style={`--i:${r * 4 + c}`}></i>)}
                  </>
                ))}
              </div>
            </figure>
          ))}
        </div>
        <p class="note" data-reveal>R repetición · T transferencia · E espera · I inconsistencia. Patrón ilustrativo.</p>
        <p class="huge huge-q" data-reveal>¿Cuántas fricciones desaparecieron realmente?</p>
      </section>

      <!-- Adopción -->
      <section id="adopcion" class="mist" aria-labelledby="ad-title">
        <div class="wrap section">
          <div class="split">
            <p class="label" data-reveal><b>Δ</b> Adopción</p>
            <div>
              <h2 id="ad-title" class="h2" data-reveal>El mejor sistema no genera retorno si el equipo no lo utiliza.</h2>
              <p class="lede" data-reveal>Después de una implantación hay una dimensión que las métricas técnicas no capturan del todo: la adopción.</p>
              <ul class="qs" data-reveal>{adopcion.map((q) => <li>{q}</li>)}</ul>
              <p class="statement" data-reveal><span>La operación real siempre importa más que el proceso diseñado.</span></p>
            </div>
          </div>
        </div>
      </section>

      <!-- Falso positivo -->
      <section id="falso-positivo" class="section wrap" aria-labelledby="fp-title">
        <div class="split">
          <p class="label" data-reveal><b>Δ</b> Falso positivo</p>
          <div>
            <h2 id="fp-title" class="h2" data-reveal>Una automatización también puede esconder una fricción.</h2>
            <p class="lede" data-reveal>Una tarea que antes llevaba diez minutos ahora lleva dos. Parece un éxito.</p>
          </div>
        </div>
        <figure class="fp" data-reveal aria-label="Ejemplo ilustrativo: una etapa mejora pero aparece una revisión manual">
          <p class="fp-tag">Ejemplo ilustrativo</p>
          <div class="fp-row">
            <span class="fp-k">Antes</span>
            <span class="fp-bar">{fpAntes.map((s) => <span class="fp-seg" style={`--m:${s.m}`}><b>{s.t}</b></span>)}</span>
          </div>
          <div class="fp-row">
            <span class="fp-k">Después</span>
            <span class="fp-bar">{fpDespues.map((s) => <span class:list={["fp-seg", { win: s.win, new: s.new }]} style={`--m:${s.m}`}><b>{s.t}</b></span>)}</span>
          </div>
          <figcaption>La etapa mejora. El proceso, no necesariamente.</figcaption>
        </figure>
        <div class="split split-tight">
          <span></span>
          <div>
            <p class="prose-line" data-reveal>Quizá haya creado</p>
            <ul class="list" data-reveal>{escondidas.map((e) => <li>{e}</li>)}</ul>
            <p class="statement" data-reveal><span>Optimizar una etapa no siempre significa optimizar el proceso.</span></p>
          </div>
        </div>
      </section>

      <!-- Escala -->
      <section id="escala" class="mist" aria-labelledby="es-title">
        <div class="wrap section">
          <p class="label" data-reveal><b>Δ</b> Escala</p>
          <h2 id="es-title" class="h2 h2-wide" data-reveal>Medir ahora es especialmente importante cuando la operación va a crecer.</h2>
          <div class="forks" data-reveal>
            <p class="fork fork-good"><span class="fork-k">Si una automatización funciona bien</span>el crecimiento multiplica su valor.</p>
            <p class="fork fork-bad"><span class="fork-k">Si funciona mal</span>el crecimiento también multiplica el problema.</p>
          </div>
          <p class="huge" data-reveal>Escalar tecnología sin medir impacto también escala errores.</p>
        </div>
      </section>

      <!-- Crecimiento -->
      <section id="crecimiento" class="section wrap" aria-labelledby="cr-title">
        <div class="split">
          <p class="label" data-reveal><b>Δ</b> Tres Reyes</p>
          <div>
            <h2 id="cr-title" class="h2" data-reveal>El mejor momento para validar un modelo es antes de replicarlo.</h2>
            <p class="lede" data-reveal>De Pamplona a San Sebastián, y ahora hacia una nueva etapa de crecimiento. Es un buen momento para observar qué nuevos procesos deberían</p>
            <ul class="tags" data-reveal>{replicar.map((r) => <li>{r}</li>)}<li class="tag-alt">o rediseñarse antes de llevarse a nuevas operaciones</li></ul>
            <p class="pair" data-reveal><span class="muted">Primero validar.</span> <span>Después escalar.</span></p>
          </div>
        </div>
      </section>

      <!-- Propuesta -->
      <section id="propuesta" class="mist" aria-labelledby="pr-title">
        <div class="wrap section">
          <div class="split">
            <p class="label label-accent" data-reveal>Una idea para Tres Reyes</p>
            <div>
              <h2 id="pr-title" class="h2 h2-pair" data-reveal><span>Elijamos una automatización ya implantada.</span><span class="h2-accent">Y midamos qué cambió realmente.</span></h2>
              <p class="prose-line prose-dark" data-reveal>La elegiríamos contigo. Podría estar en</p>
              <ul class="tags" data-reveal>{iniciativas.map((a) => <li>{a}</li>)}</ul>
              <p class="note" data-reveal>Sin dar por hecho qué área es prioritaria.</p>
              <p class="prose-line prose-dark" data-reveal>Para ese proceso:</p>
              <ol class="steps" data-reveal>{plan.map((p, i) => <li><span class="n">{pad(i + 1)}</span>{p}</li>)}</ol>
            </div>
          </div>
        </div>
      </section>

      <!-- Resultado -->
      <section id="resultado" class="section wrap" aria-labelledby="re-title">
        <div class="split">
          <p class="label" data-reveal><b>Δ</b> Resultado</p>
          <div>
            <h2 id="re-title" class="h2 h2-pair" data-reveal><span class="muted">No otro proyecto de IA.</span><span>Una respuesta.</span></h2>
            <ol class="chain" data-reveal>{cadena.map((c, i) => <li style={`--i:${i}`}>{c}</li>)}</ol>
            <p class="prose-line" data-reveal>Y una decisión posible:</p>
            <ul class="decisions" data-reveal>{decisiones.map((d) => <li class:list={{ stop: d === "Detener" }}>{d}</li>)}</ul>
            <p class="statement" data-reveal><span>Saber qué detener también genera retorno.</span></p>
          </div>
        </div>
      </section>

      <!-- Independencia -->
      <section id="independencia" class="ink" aria-labelledby="in-title">
        <div class="wrap section">
          <div class="split">
            <p class="label label-ink" data-reveal><b>Δ</b> Independencia</p>
            <div>
              <h2 id="in-title" class="h2" data-reveal>Una mirada independiente después de la implantación.</h2>
              <div class="prose prose-on-ink" data-reveal>
                <p>Quien implanta conoce la tecnología por dentro. Una mirada externa puede medir el proceso desde fuera. Son papeles distintos y complementarios.</p>
                <p>IA Operators no necesita justificar la tecnología implantada. No vendemos la plataforma ni participamos en la implantación original. Eso permite hacer preguntas sin compromiso con la solución:</p>
              </div>
              <ul class="qrow" data-reveal>{preguntasInd.map((q) => <li>{q}</li>)}</ul>
            </div>
          </div>
          <p class="shift" data-reveal>
            <span class="shift-a">No buscamos demostrar que la tecnología funciona.</span>
            <span class="shift-b">Buscamos descubrir si genera valor.</span>
          </p>
        </div>
      </section>

      <!-- CTA -->
      <section id="hablar" class="cta" aria-labelledby="cta-title">
        <div class="wrap section">
          <p class="cta-lead" data-reveal>Dentro de unos meses habrá una pregunta interesante que responder.</p>
          <h2 id="cta-title" class="cta-title" data-reveal>¿Qué cambió realmente?</h2>
