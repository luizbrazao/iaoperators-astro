---
import PresenterVideo from "../../components/PresenterVideo.astro";
// Landing personalizada para Pablo Hernández Ubiria, CEO de RH Hoteles
// (cadena familiar de la Comunidad Valenciana, con presencia en Murcia y en
// Andalucía, Jerez; hoteles y apartamentos turísticos, casi 5.000 plazas
// según la presentación de la moderadora). Creada el 13/11/2026. Privada:
// noindex,nofollow y fuera del sitemap ("/tis/" en NOINDEX_PATHS).
//
// Sesión de TIS 06/10/2026, 11:30, «From Data to Strategy: Big Data
// Ecosystems», moderada por Mayte García (HOSBEC), con Álvaro Carrillo de
// Albornoz (ITH) y Daniel Caro (Andalucía Nexus). Verificado contra la
// transcripción oficial del vídeo (13/11/2026). Solo turnos que la moderadora
// abre con su nombre, parafraseados salvo citas cortas:
//   - 18:18-21:23: cadena familiar; en los inicios de Biontrend, de los
//     impulsores. Destinos como Benidorm, Gandía o Peñíscola, muchos hoteles
//     independientes. Entre hoteleros es más fácil hablar del pasado («¿qué
//     tal te ha ido el verano?»); del futuro cuesta más. En un destino
//     estacional, al cerrar el hotel no tienes información propia. Caso:
//     el año pasado un desvío por obras de otro competidor les dio un
//     empujón; este año lo pierden y, comparándose con sus propios datos,
//     «Ostras, estoy fatal», ofertas, turoperador, un 15 % o un 10 % por
//     debajo en diciembre, enero y febrero. Comparado con el destino: «Oye,
//     Pablo, relájate… No empieces a lanzar ofertas aquí como un loco».
//   - 21:44-24:06: lo usan para ver fechas y, sobre todo, el pickup: cuando ya
//     están tranquilos con sus datos, ver si el pickup del destino se parece
//     al suyo o si hay una fecha que potenciar. Tiendes a no tirar ofertas;
//     no es al tuntún. Herramienta básica del revenue. Se llaman mucho entre
//     compañeros («¿has visto qué está pasando en diciembre?»). Debe haber
//     confianza, porque «los datos que están en el PMS tienen que ser
//     correctos». Tienen pendientes los apartamentos turísticos; la clave es
//     un PMS que pueda estar integrado e incorporar ese escenario de datos.
//   - 32:20-34:54 (responde a la pregunta de Mayte «Pablo, nos has
//     presentado aplicaciones prácticas…»): las cadenas ya tienen sus cuadros
//     de mando; el del destino es superinteresante; incorporar los datos del
//     PMS de forma más visual. Ya hacen una tesis interna de chatbot: «Dime
//     qué estrategia tengo que seguir para la Semana Santa del 27», que te
//     compare con el destino y te diga «en esta fecha estás bajando». Los
//     paneles están muy bien, pero hay que echar un vistazo a todos los datos.
//
// Relación: Mayte (HOSBEC) y Álvaro (ITH) tienen sus propias páginas
// (/tis/mayte, /tis/alvaro). Aquí no se mencionan.
//
// Concepto: fuera, el destino te dice «relájate»; dentro, el dato del PMS
// tiene que cuadrar. Radiografía orientada a su propia tesis del chatbot:
// qué datos necesita esa respuesta y si están bien. Enlace suave a
// /es/hoteles/reservas-directas-ia/ en «fechas que potenciar».
//
// Comportamiento compartido en src/scripts/prospect-landing.ts.

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  // Vídeo de Luiz con fondo blanco, fundido con la página (PresenterVideo).
  src: "/video/luiz-tis.mp4",
  poster: "/video/luiz-tis-poster.jpg",
  duracion: "1 min 24 s",
};

const wa = (t: string) => `https://wa.me/34662423523?text=${encodeURIComponent(t)}`;
const CONTACT_HREF = wa("Hola Luiz, soy Pablo Hernández, de RH Hoteles. He visto la página que preparaste después de TIS y me gustaría hablarlo.");
const INTRO_HREF = wa("Hola Luiz, soy Pablo Hernández, de RH Hoteles. Te pongo en contacto con la persona de revenue y sistemas: ");
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/pablo/", site).toString();
const ogImage = new URL("/og/pablo.png", site).toString();
const title = "Pablo Hernández × IA Operators | Radiografía Digital";
const description = "Después de «De los datos a la estrategia» en TIS: el destino te dice «relájate», pero el dato de dentro tiene que cuadrar. Una reflexión preparada por IA Operators para Pablo Hernández y RH Hoteles.";

const pad = (n: number) => String(n).padStart(2, "0");

// Ejemplo ilustrativo inspirado en su caso (diciembre a febrero).
const meses = [
  { m: "Dic", tu: -15, dest: -14 },
  { m: "Ene", tu: -12, dest: -13 },
  { m: "Feb", tu: -10, dest: -11 },
];

// Fuentes que necesitaría la respuesta del chatbot (ilustrativo).
const fuentes = [
  { k: "PMS de los hoteles", s: "reservas, pickup y precio", ok: true },
  { k: "Apartamentos turísticos", s: "pendientes de integrar", ok: false },
  { k: "Destino (Biontrend)", s: "agregado y set competitivo", ok: true },
  { k: "Turoperadores y canales", s: "cupos y condiciones", ok: false },
];

const pasos = [
  "Partimos de tu pregunta: qué estrategia seguir para la Semana Santa del 27.",
  "Listamos los datos que hacen falta para contestarla y dónde vive cada uno: PMS, apartamentos, canales, destino.",
  "Comprobamos si son correctos y comparables: segmentos, fechas, cancelaciones, el mismo criterio en cada hotel.",
  "Te dejamos qué conectar, qué limpiar y qué falta para que la respuesta no salga de un dato equivocado.",
];

const reservas = [
  { k: "Hotel A", d: "PMS con el criterio de la cadena" },
  { k: "Apartamentos", d: "sin integrar todavía" },
  { k: "Destino", d: "dato agregado" },
];
const tramo = ["Reserva", "Segmento", "Fecha", "Precio", "Cancelación"];
const friccion: Record<number, number[]> = { 0: [1], 1: [0, 1, 4], 2: [] };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fuera, el destino te calma. Dentro, el dato tiene que cuadrar. Una idea para Pablo Hernández y RH Hoteles." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f6f5f1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-link top-link-x" href="/es/hoteles/" data-cta="nav_hoteles">Hoteles</a>
          <a class="top-link top-link-x" href="/es/hoteles/reservas-directas-ia/" data-cta="nav_reservas_directas">Reservas directas</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header" data-cta-event="click_contact">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="label">Después de «De los datos a la estrategia» · TIS 2026</p>
        <h1 id="hero-title" class="greeting">Pablo, en TIS contaste lo que te dice el destino cuando te comparas con él: <b>«Oye, Pablo, relájate. No empieces a lanzar ofertas como un loco.»</b></h1>
        <p class="big">Fuera, el destino te calma.<span>Dentro, el dato tiene que cuadrar.</span></p>

        <div class="hero-grid">
          <PresenterVideo src={VIDEO.src} poster={VIDEO.poster} label="Vídeo de Luiz Brazão para Pablo Hernández" duracion={VIDEO.duracion} />

          <div class="hero-copy">
            <p>Te escuché en la mesa que moderó Mayte García, con Álvaro Carrillo de Albornoz y Daniel Caro.</p>
            <p>Explicaste cómo usáis Biontrend en el día a día de RH: el pickup, las fechas que hay que potenciar, no tirar ofertas al tuntún. Y dejaste caer algo que suele pasar desapercibido: para confiar en todo eso, los datos que están en el PMS tienen que ser correctos.</p>
            <p class="hero-strong">Me gustaría proponerte algo para ese lado, el de dentro.</p>
          </div>
        </div>
      </section>

      <!-- Destino -->
      <section id="destino" class="section wrap" aria-labelledby="de-title">
        <div class="split">
          <p class="label label-accent" data-reveal>01 · El destino</p>
          <div>
            <h2 id="de-title" class="h2" data-reveal>Entre hoteleros es más fácil hablar del pasado.</h2>
            <p class="lede" data-reveal>«¿Qué tal te ha ido el verano?» se pregunta solo. Hablar de cómo va el futuro cuesta más. Y contaste el caso: un año un desvío por obras de un competidor os dio un empujón, al siguiente lo perdisteis, y comparándoos solo con vosotros mismos la reacción era «ostras, estoy fatal».</p>
            <figure class="mirror" data-reveal aria-label="Ejemplo ilustrativo: la caída del hotel frente a la del destino en diciembre, enero y febrero">
              <div class="mirror-grid">
                {meses.map((m, i) => (
                  <div class="mirror-col" style={`--i:${i}`}>
                    <div class="bars">
                      <span class="bar bar-tu" style={`--h:${Math.abs(m.tu) * 5}%`}><b>{m.tu} %</b></span>
                      <span class="bar bar-dest" style={`--h:${Math.abs(m.dest) * 5}%`}><b>{m.dest} %</b></span>
                    </div>
                    <p>{m.m}</p>
                  </div>
                ))}
              </div>
              <figcaption><span class="cap-tu">Tu hotel frente al año pasado</span><span class="cap-dest">El destino frente al año pasado</span></figcaption>
              <p class="mirror-note">Ejemplo ilustrativo, inspirado en el caso que contaste.</p>
            </figure>
            <p class="statement" data-reveal>
              <span class="muted">Con tus datos solos, te asustas.</span>
              <span>Con el destino al lado, decides.</span>
            </p>
            <p class="prose-line" data-reveal>Y cuando la comparación dice que hay una fecha que potenciar, también importa por dónde llega esa reserva. Por si te sirve ver cómo lo planteamos en el canal directo: <a class="inline-link" href="/es/hoteles/reservas-directas-ia/" data-cta="reservas_directas">reservas directas con IA</a>.</p>
          </div>
        </div>
      </section>

      <!-- Confianza -->
      <section id="confianza" class="panel" aria-labelledby="co-title">
        <div class="wrap section">
          <div class="split">
            <p class="label" data-reveal>02 · La confianza</p>
            <div>
              <h2 id="co-title" class="h2" data-reveal>«Los datos que están en el PMS tienen que ser correctos.»</h2>
              <p class="lede" data-reveal>Lo dijiste casi de pasada, hablando de la confianza que tiene que haber para compartir datos. Y añadiste lo que tenéis pendiente: los apartamentos turísticos. La clave, dijiste, es tener un PMS que pueda estar integrado.</p>
              <figure class="flow" data-reveal aria-label="Ejemplo ilustrativo: los datos de los hoteles llegan al destino; los de los apartamentos todavía no">
                <div class="flow-row">
                  <span class="flow-n">Hoteles RH<small>PMS</small></span>
                  <i class="flow-c" aria-hidden="true"></i>
                  <span class="flow-n flow-mid">Destino<small>dato agregado</small></span>
                  <i class="flow-c" aria-hidden="true"></i>
                  <span class="flow-n">Tu panel<small>pickup y fechas</small></span>
                </div>
                <div class="flow-row flow-off">
                  <span class="flow-n">Apartamentos<small>pendiente</small></span>
                  <i class="flow-c" aria-hidden="true"></i>
                  <span class="flow-gap">sin integrar</span>
                </div>
                <figcaption>Ejemplo ilustrativo. No describe los sistemas de RH Hoteles.</figcaption>
              </figure>
              <p class="prose-line prose-ink" data-reveal>Si una reserva entra mal en el PMS, la comparación con el destino también sale mal. Y entonces el «relájate» puede ser una calma falsa.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Semana Santa -->
      <section id="semana-santa" class="night" aria-labelledby="ss-title">
        <div class="wrap section">
          <p class="label label-night" data-reveal>03 · Vuestra tesis</p>
          <h2 id="ss-title" class="h2 h2-wide" data-reveal>«Dime qué estrategia tengo que seguir para la Semana Santa del 27.»</h2>
          <div class="split split-tight">
            <span></span>
            <div>
              <p class="prose-line prose-night" data-reveal>Contaste que estáis trabajando en una tesis interna: un chatbot al que preguntarle así, que te compare con el destino y te avise de que en tal fecha estás bajando. Y añadiste que los paneles están muy bien, pero hay que mirar todos los datos.</p>
              <figure class="chat" data-reveal aria-label="Ejemplo ilustrativo: la pregunta al chatbot y las fuentes de datos que necesita su respuesta">
                <p class="chat-q">Dime qué estrategia tengo que seguir para la Semana Santa del 27.</p>
                <div class="chat-a">
                  <p class="chat-k">Para contestarte bien, necesito</p>
                  <ul>
                    {fuentes.map((f, i) => (
                      <li class:list={{ off: !f.ok }} style={`--i:${i}`}><b>{f.k}</b><span>{f.s}</span></li>
                    ))}
                  </ul>
                </div>
                <figcaption>Ejemplo ilustrativo.</figcaption>
              </figure>
            </div>
          </div>
          <p class="huge" data-reveal>Un chatbot contesta tan bien como el dato que le llega.</p>
        </div>
      </section>

      <!-- Radiografía -->
      <section id="radiografia" class="panel" aria-labelledby="rd-title">
        <div class="wrap section">
          <div class="split">
            <p class="label label-accent" data-reveal>04 · Radiografía Digital</p>
            <div>
              <h2 id="rd-title" class="h2" data-reveal>Antes del chatbot, el dato que va a usar.</h2>
              <p class="lede" data-reveal>Una Radiografía Digital no evalúa proveedores ni propone una plataforma. Sigue los datos reales a través de los sistemas y las personas que los tocan.</p>
              <ol class="steps" data-reveal>{pasos.map((p, i) => <li><span class="n">{pad(i + 1)}</span>{p}</li>)}</ol>
              <p class="prose-line" data-reveal>El resultado no es una lista de ideas. Es saber qué datos están listos para alimentar esa respuesta, cuáles hay que corregir y qué hace falta integrar, empezando por los apartamentos.</p>
              <p class="prose-line" data-reveal>En una cadena de cuatro hoteles en Menorca, la dirección declaraba unas 25 herramientas. Encontramos 47, y un 23 % del gasto en SaaS que se podía recortar. <a class="inline-link" href="/es/portfolio/radiografia-cadena-hotelera-menorca/" data-cta="case">Ver el caso</a></p>
              <ul class="nots" data-reveal>
                <li>No sustituimos vuestro panel ni el del destino.</li>
                <li>No vendemos un PMS.</li>
                <li>Los datos de RH se quedan en RH.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Propuesta -->
      <section id="propuesta" class="section wrap" aria-labelledby="pr-title">
        <div class="split">
          <p class="label label-accent" data-reveal>Una idea concreta</p>
          <div>
            <h2 id="pr-title" class="h2 h2-pair" data-reveal><span>No empecemos por el chatbot.</span><span class="h2-accent">Empecemos por la pregunta.</span></h2>
            <p class="lede" data-reveal>La Semana Santa del 27, en un hotel y en los apartamentos. ¿Qué datos haría falta juntar para contestarla? ¿Dónde están hoy? ¿Cuadran entre sí?</p>
            <figure class="cmp" data-reveal aria-label="Ejemplo ilustrativo: tres fuentes y los campos donde el dato no es comparable">
              {reservas.map((h, r) => (
                <div class="cmp-row">
                  <p class="cmp-k"><b>{h.k}</b><span>{h.d}</span></p>
                  <ol class="cmp-steps">
                    {tramo.map((p, c) => <li class:list={{ hot: friccion[r].includes(c) }} style={`--i:${r * 5 + c}`}>{p}</li>)}
                  </ol>
                </div>
              ))}
              <figcaption>Ejemplo ilustrativo. En naranja, los campos donde el dato no es comparable.</figcaption>
            </figure>
            <p class="prose-line" data-reveal>Lo haríamos contigo y con quien lleve el revenue, con vuestra tesis delante.</p>
            <p class="worth" data-reveal>¿Qué tiene que saber el chatbot para contestarte bien?</p>
          </div>
        </div>
      </section>

      <!-- Cierre -->
      <section id="cierre" class="closing wrap" aria-labelledby="ci-title">
        <p class="cl-1" data-reveal>Fuera, relájate.</p>
        <h2 id="ci-title" class="cl-big" data-reveal>Dentro, que cuadre.</h2>
        <p class="cl-3" data-reveal>Ese es el trabajo que me gustaría enseñarte, o enseñar a quien lleve el revenue en RH.</p>
      </section>

      <!-- CTA -->
      <section id="hablar" class="cta" aria-labelledby="cta-title">
        <div class="wrap section">
          <h2 id="cta-title" class="h2 cta-title" data-reveal>Si te parece una conversación útil, seguimos.</h2>
          <p class="cta-copy" data-reveal>En 20 minutos puedo enseñarte cómo hacemos una Radiografía Digital y un ejemplo real en una cadena hotelera.</p>
          <div class="cta-row" data-reveal>
            <div class="buttons">
              <a class="button" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="final" data-cta-event="click_contact">Hablar con Luiz <span aria-hidden="true">↗</span></a>
              <a class="button button-ghost" href={INTRO_HREF} target="_blank" rel="noopener" data-cta="intro" data-cta-event="click_introduction">Presentarme a la persona adecuada <span aria-hidden="true">↗</span></a>
            </div>
            <div class="signature">
              <p class="signature-name">Luiz Brazão</p>
              <p class="signature-role">Founder, IA Operators</p>
              <a class="signature-site" href="https://iaoperators.com/es/" data-cta="site">iaoperators.com</a>
            </div>
          </div>
        </div>
      </section>
    </main>


    <footer class="foot">
      <div class="wrap foot-inner">
        <span class="foot-brand"><img src="/brand/ia-operators-logo.png" alt="IA Operators" width="453" height="82" loading="lazy" /></span>
        <a href="/es/auditoria-de-sistemas/">Radiografía Digital</a>
        <a href="https://iaoperators.com/es/">iaoperators.com</a>
      </div>
    </footer>

    <div class="consent" data-consent hidden role="region" aria-label="Cookies">
      <p>Usamos cookies para medir y mejorar la experiencia. Puedes aceptar o rechazar. <a href="/es/politica-de-privacidad/">Política de Privacidad</a>.</p>
      <div class="consent-actions">
        <button type="button" data-consent-reject>Rechazar</button>
        <button type="button" class="consent-accept" data-consent-accept>Aceptar</button>
      </div>
    </div>

    <script>
      import { initProspectLanding } from "../../scripts/prospect-landing";
      initProspectLanding({ landing: "pablo", gtmId: document.body.dataset.gtm ?? "", videoTitle: "pablo_luiz", scrollMarks: [50, 90] });
    </script>

    <style is:global>
      @font-face {
        font-family: "Manrope JG";
        src: url("/fonts/manrope-latin-variable.woff2") format("woff2");
        font-weight: 200 800;
        font-display: swap;
      }
      :root {
        --paper: #f6f5f1;
        --panel: #ecebe5;
        --ink: #15171a;
        --text: #2c2f33;
        --muted: #62666b;
        --soft: #9a9da1;
        --line: #dfded8;
        --line-strong: #c3c2bb;
        --slate: #24425a;
        --slate-soft: #9fb2c1;
        --orange: #f16532;
        --orange-ink: #b4441a;
        --night: #121417;
        --night-text: #f1f1ee;
        --night-line: #2b2f34;
        --gutter: 20px;
        --ease: cubic-bezier(.2, .7, .2, 1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 72px; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Manrope JG", "Helvetica Neue", Arial, sans-serif; font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums; }
      h1, h2, h3, p, ol, ul, dl, dd, figure, blockquote { margin: 0; }
      ol, ul { padding: 0; list-style: none; }
      a { color: inherit; text-decoration: none; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
      .wrap { width: 100%; max-width: 1240px; margin-inline: auto; padding-inline: var(--gutter); }
      .label { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .label::before { content: ""; width: 7px; height: 7px; background: var(--slate); }
      .label-accent::before { background: var(--orange); }
      .label-night { color: #9a9ea3; }
      .label-night::before { background: var(--slate-soft); }
      .muted { color: var(--soft); }

      /* Cabecera */
      .top { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid transparent; transition: background-color .3s ease, border-color .3s ease; }
      .top.is-scrolled { background: rgba(246, 245, 241, .9); border-bottom-color: var(--line); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
      .top-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 60px; }
      .wordmark img { display: block; width: auto; height: 22px; }
      .foot-brand img { display: block; width: auto; height: 18px; }
      .top-nav { display: flex; align-items: center; gap: 22px; font-size: 13px; }
      .top-link { display: none; color: var(--muted); }
      .top-link:hover { color: var(--ink); }
      .top-cta { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; background: var(--slate); color: var(--night-text); font-weight: 600; white-space: nowrap; transition: background-color .2s ease; }
      .top-cta:hover { background: var(--ink); }

      /* Hero */
      .hero { padding-top: 18px; padding-bottom: 72px; }
      .greeting { margin-top: 14px; max-width: 24em; font-size: clamp(19px, 2.2vw, 28px); font-weight: 500; letter-spacing: -.028em; line-height: 1.28; color: var(--text); }
      .greeting b { font-weight: 700; color: var(--slate); }
      .big { display: grid; gap: 2px; margin-top: 18px; max-width: 13em; font-size: clamp(34px, 6.6vw, 94px); font-weight: 500; letter-spacing: -.058em; line-height: 1; color: var(--soft); }
      .big span { color: var(--ink); }
      .hero-grid { display: grid; gap: 28px; margin-top: 28px; }
      .hero-copy { display: grid; gap: 10px; align-content: start; color: var(--muted); }
      .hero-copy p { max-width: 32em; }
      .hero-strong { margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--line-strong); font-size: clamp(20px, 2vw, 25px); font-weight: 500; letter-spacing: -.03em; line-height: 1.28; color: var(--ink); }

      /* Secciones */
      .section { padding-block: 88px; }
      .panel { background: var(--panel); }
      .night { background: var(--night); color: var(--night-text); }
      .split { display: grid; gap: 18px; }
      .split > .label { align-self: start; padding-top: 10px; }
      .split-tight { margin-top: 40px; }
      .h2 { margin-top: 0; font-size: clamp(30px, 4.4vw, 58px); font-weight: 500; letter-spacing: -.05em; line-height: 1.07; max-width: 15em; }
      section > .wrap > .h2, .section > .h2 { margin-top: 16px; }
      .h2-wide { max-width: 19em; }
      .h2-pair { display: grid; gap: 4px; }
      .h2-accent { color: var(--orange-ink); }
      .lede { margin-top: 20px; max-width: 30em; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.45; letter-spacing: -.018em; color: var(--text); }
      .prose-line { margin-top: 22px; max-width: 36em; color: var(--muted); }
      .prose-ink { color: var(--text); font-size: 18px; }
      .prose-night { color: #b9bcc0; }
      .statement { display: grid; gap: 2px; margin-top: 40px; font-size: clamp(25px, 3.2vw, 42px); font-weight: 500; letter-spacing: -.045em; line-height: 1.12; max-width: 17em; }
      .statement::before { content: ""; display: block; width: 40px; height: 3px; margin-bottom: 16px; background: var(--orange); }
      .huge { margin-top: 72px; font-size: clamp(36px, 7vw, 100px); font-weight: 500; letter-spacing: -.062em; line-height: 1; max-width: 12em; }
      .n { flex: 0 0 26px; font-size: 12px; font-weight: 650; color: var(--soft); }

      /* Filtro */
      .filter { margin-top: 36px; border-top: 1px solid var(--ink); }
      .filter li { display: flex; gap: 14px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); }
      .filter-q { font-size: clamp(21px, 2.3vw, 30px); font-weight: 500; letter-spacing: -.035em; line-height: 1.18; }
      .filter-d { margin-top: 4px; max-width: 36em; font-size: 16px; color: var(--muted); }
      .filter-last .n { color: var(--orange); }
      .filter-last .filter-q { color: var(--slate); }

      /* Citas */
      .quote blockquote { font-size: clamp(21px, 2.3vw, 29px); font-weight: 400; letter-spacing: -.03em; line-height: 1.3; max-width: 24em; }
      .quote figcaption { margin-top: 10px; font-size: 13px; color: #9a9ea3; }
      .night .huge { color: var(--night-text); }

      /* Radiografía */
      .steps { margin-top: 28px; border-top: 1px solid var(--line-strong); }
      .steps li { display: flex; gap: 14px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line-strong); font-size: clamp(18px, 1.7vw, 21px); letter-spacing: -.02em; }
      .nots { margin-top: 28px; }
      .nots li { padding: 8px 0; font-size: 16px; color: var(--muted); }
      .nots li::before { content: "·"; margin-right: 10px; color: var(--slate); font-weight: 700; }

      /* Propuesta */
      .cmp { margin-top: 32px; display: grid; gap: 14px; }
      .cmp-row { display: grid; gap: 8px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
      .cmp-k b { font-size: 16px; font-weight: 650; }
      .cmp-k span { margin-left: 10px; font-size: 14px; color: var(--muted); }
      .cmp-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
      .cmp-steps li { padding: 8px 4px; border: 1px solid var(--slate-soft); border-radius: 6px; background: var(--paper); text-align: center; font-size: 12px; font-weight: 600; color: var(--slate); }
      .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }
      .cmp figcaption { font-size: 13px; color: var(--soft); }
      .worth { margin-top: 10px; font-size: clamp(38px, 6.6vw, 90px); font-weight: 500; letter-spacing: -.06em; line-height: 1; color: var(--orange-ink); }

      /* Espejo */
      .mirror { margin-top: 36px; padding: 18px; border: 1px solid var(--line-strong); border-radius: 16px; background: var(--paper); max-width: 560px; }
      .mirror-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
      .bars { display: flex; align-items: flex-end; justify-content: center; gap: 8px; height: 120px; border-bottom: 1px solid var(--line-strong); }
      .bar { position: relative; width: 34%; height: var(--h); border-radius: 4px 4px 0 0; }
      .bar b { position: absolute; left: 50%; top: -20px; transform: translateX(-50%); font-size: 12px; font-weight: 650; white-space: nowrap; }
      .bar-tu { background: var(--orange); }
      .bar-tu b { color: var(--orange-ink); }
      .bar-dest { background: var(--slate-soft); }
      .bar-dest b { color: var(--slate); }
      .mirror-col p { margin-top: 6px; text-align: center; font-size: 12px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
      .mirror figcaption { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 11px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
      .cap-tu::before, .cap-dest::before { content: ""; display: inline-block; width: 10px; height: 10px; margin-right: 7px; border-radius: 2px; vertical-align: middle; }
      .cap-tu::before { background: var(--orange); }
      .cap-dest::before { background: var(--slate-soft); }
      .mirror-note { margin-top: 8px; font-size: 13px; color: var(--soft); }

      /* Flujo */
      .flow { display: grid; gap: 12px; margin-top: 36px; padding: 18px; border: 1px solid var(--line-strong); border-radius: 16px; background: var(--paper); }
      .flow-row { display: grid; grid-template-columns: 1fr 16px 1fr 16px 1fr; align-items: center; gap: 6px; }
      .flow-n { padding: 10px; border: 1px solid var(--slate); border-radius: 10px; text-align: center; font-size: 14px; font-weight: 600; color: var(--ink); }
      .flow-n small { display: block; font-size: 12px; font-weight: 500; color: var(--slate); }
      .flow-mid { background: #eef1f3; }
      .flow-c { height: 2px; background: var(--slate); }
      .flow-off .flow-n { border: 1px dashed var(--orange); background: rgba(241, 101, 50, .06); }
      .flow-off .flow-n small { color: var(--orange-ink); }
      .flow-off .flow-c { background: repeating-linear-gradient(90deg, var(--orange) 0 4px, transparent 4px 8px); }
      .flow-gap { grid-column: 3 / -1; font-size: 13px; color: var(--orange-ink); }
      .flow figcaption { font-size: 13px; color: var(--soft); }

      /* Chat */
      .chat { display: grid; gap: 12px; margin-top: 32px; max-width: 560px; }
      .chat-q { justify-self: end; max-width: 85%; padding: 12px 16px; border-radius: 16px 16px 4px 16px; background: var(--slate); color: var(--night-text); font-size: 16px; line-height: 1.4; }
      .chat-a { max-width: 92%; padding: 14px 16px; border: 1px solid var(--night-line); border-radius: 16px 16px 16px 4px; background: #1b1e22; }
      .chat-k { margin-bottom: 10px; font-size: 11px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: #9a9ea3; }
      .chat-a ul { display: grid; gap: 8px; }
      .chat-a li { position: relative; padding-left: 24px; }
      .chat-a li::before { content: "✓"; position: absolute; left: 0; top: 0; font-size: 14px; font-weight: 700; color: var(--slate-soft); }
      .chat-a li.off::before { content: "?"; color: var(--orange); }
      .chat-a b { display: block; font-size: 15px; font-weight: 600; color: var(--night-text); }
      .chat-a span { display: block; font-size: 13px; color: #9a9ea3; }
      .chat-a li.off span { color: #f0a07f; }
      .chat figcaption { font-size: 13px; color: #7d8187; }
      .night .huge { max-width: 14em; }

      /* Cierre */
      .closing { padding-block: 120px 128px; }
      .cl-1 { font-size: clamp(28px, 3.6vw, 48px); font-weight: 500; letter-spacing: -.045em; color: var(--soft); }
      .cl-big { margin-top: 10px; max-width: 10em; font-size: clamp(52px, 11vw, 160px); font-weight: 500; letter-spacing: -.07em; line-height: .95; }
      .cl-3 { margin-top: 56px; max-width: 30em; font-size: clamp(19px, 1.8vw, 23px); letter-spacing: -.02em; color: var(--text); }

      /* CTA */
      .cta { border-top: 1px solid var(--line); }
      .cta-title { max-width: 14em; }
      .cta-copy { margin-top: 20px; max-width: 32em; font-size: 18px; color: var(--muted); }
      .cta-row { display: grid; gap: 36px; margin-top: 40px; }
      .buttons { display: grid; gap: 10px; justify-items: start; }
      .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 56px; padding: 0 24px; background: var(--slate); color: var(--night-text); font-size: 16px; font-weight: 600; transition: background-color .2s ease, color .2s ease; }
      .button:hover { background: var(--ink); }
      .button-ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
      .button-ghost:hover { background: var(--ink); color: var(--paper); }
      .signature { padding-top: 18px; border-top: 1px solid var(--line); max-width: 280px; }
      .signature-name { font-size: 18px; font-weight: 650; letter-spacing: -.02em; }
      .signature-role { font-size: 14px; color: var(--muted); }
      .signature-site { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--slate); }

      /* Pie y consentimiento */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding-block: 26px 30px; font-size: 13px; color: var(--muted); }
      .foot-brand { margin-right: auto; }
      .foot a:hover { color: var(--ink); }
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; background: var(--night); color: var(--night-text); font-size: 13px; line-height: 1.5; border: 1px solid #3a3d42; box-shadow: 0 10px 30px rgba(0, 0, 0, .18); }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; }
      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 38px; padding: 0 16px; border: 1px solid #3a3d42; background: transparent; color: var(--night-text); font: inherit; cursor: pointer; }
      .consent .consent-accept { background: var(--night-text); color: var(--night); border-color: var(--night-text); }

      /* Movimiento */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }
      .js .cmp-steps li.hot { background: var(--paper); border-color: var(--slate-soft); color: var(--slate); transition: background-color .4s ease calc(.3s + var(--i) * 50ms), border-color .4s ease calc(.3s + var(--i) * 50ms), color .4s ease calc(.3s + var(--i) * 50ms); }
      .js .cmp.is-in .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }

      .js .mirror .bar { transform: scaleY(0); transform-origin: bottom; transition: transform .7s var(--ease) calc(.2s + var(--i, 0) * 120ms); }
      .js .mirror-col .bar-dest { transition-delay: .9s; }
      .js .mirror.is-in .bar { transform: none; }
      .js .chat .chat-a li { opacity: .2; transition: opacity .45s ease calc(.4s + var(--i) * 200ms); }
      .js .chat.is-in .chat-a li { opacity: 1; }

      @media (min-width: 420px) {
        .top-link { display: inline; }
        .cmp-steps li { font-size: 13px; }
      }
      .top-nav .top-link-x { display: none; }
      @media (min-width: 900px) {
        .top-nav .top-link-x { display: inline; }
      }
      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .cmp-row { grid-template-columns: 210px minmax(0, 1fr); align-items: center; gap: 16px; }
        .cmp-k span { display: block; margin-left: 0; }
        .cta-row { grid-template-columns: auto 1fr; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }
      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 40px; padding-bottom: 116px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 52px; align-items: start; }
        .section { padding-block: 128px; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .closing { padding-block: 180px 190px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .mirror .bar { transform: none; transition: none; }
        .js .chat .chat-a li { opacity: 1; transition: none; }
        .js .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); transition: none; }
        .top, .button, .top-cta { transition: none; }
      }
      .inline-link { color: var(--slate); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
      .inline-link:hover { color: var(--ink); }
    </style>
  </body>
</html>
