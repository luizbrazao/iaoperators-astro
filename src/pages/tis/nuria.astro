---
// Landing personalizada para Nuria Blanco López, directora general de Hotel
// Plaza (Hotel & Spa) y Hotel Avenida (A Coruña), grupo Blancohostel. Se llega
// por el QR de una tarjeta entregada en mano. Privada: noindex,nofollow y fuera
// del sitemap ("/tis/" en NOINDEX_PATHS de astro.config.mjs).
//
// Concepto: la lógica de "planta piloto" habitual en reformas hoteleras
// (probar, escuchar al cliente, ajustar y después extender) aplicada a la
// operación. Se plantea como idea general, no como un hecho sobre el Plaza. La metáfora visual es un alzado de edificio: una planta marcada en
// el hero y, más abajo, el resto de plantas que se completan al llegar.
//
// Página autónoma (sin BaseLayout): identidad de IA Operators (Manrope local,
// naranja de marca) con una paleta más fría y calmada que la de Casa 1800.
// Comportamiento compartido (analítica, consentimiento, vídeo, entradas) en
// src/scripts/prospect-landing.ts.

// --- Configuración editable ---------------------------------------------------
// Vídeo: subir el MP4 a /public/video/ y rellenar `src` (y `poster`).
const VIDEO = {
  src: "",
  poster: "",
  type: "video/mp4",
  orientation: "horizontal" as "horizontal" | "vertical",
  duracion: "55 segundos",
};

// "Hablar con Luiz": hoy WhatsApp con mensaje preparado. Para Cal.com o
// Calendly basta con sustituir la URL.
const CONTACT_HREF = `https://wa.me/34662423523?text=${encodeURIComponent(
  "Hola Luiz, soy Nuria Blanco. He visto la página sobre la Radiografía Digital y me gustaría hablarlo.",
)}`;
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/nuria/", site).toString();
const ogImage = new URL("/og/nuria.png", site).toString();
const title = "Nuria Blanco × IA Operators | Radiografía Digital";
const description = "Una propuesta de Radiografía Digital preparada por IA Operators para Nuria Blanco y Blancohostel.";

const escalan = [
  "Hay procesos que escalan perfectamente.",
  "Otros empiezan a exigir más trabajo.",
  "Algunos dependen demasiado de determinadas personas.",
  "Y otros pueden simplificarse antes de crecer.",
];

const preguntas = [
  "¿Qué procesos funcionan hoy porque alguien los conoce de memoria?",
  "¿Dónde sigue entrando información manualmente?",
  "¿Qué tareas se repiten entre departamentos?",
  "¿Qué información debería fluir automáticamente entre sistemas?",
  "¿Qué trabajo administrativo aumenta cuando aumenta la ocupación?",
  "¿Dónde una automatización tendría impacto real?",
];
const preguntaFinal = "¿Y dónde sería mejor no automatizar nada?";

const circula = ["personas", "información", "tareas", "datos", "decisiones"];

const pasos = [
  "Hablamos con las personas que ejecutan los procesos.",
  "Seguimos la información desde que entra hasta que termina el proceso.",
  "Identificamos tareas manuales, transferencias, esperas, duplicidades y dependencias.",
  "Revisamos cómo intervienen los sistemas actuales.",
];
const recorrido = ["Observar", "Entender", "Detectar", "Priorizar", "Decidir"];

const areas = ["Captación", "Atención", "Operación", "Gestión"];
const fricciones = ["Repetición", "Transferencia", "Espera", "Inconsistencia"];

const mapa = [
  "Qué merece atención primero",
  "Qué proceso debería simplificarse",
  "Qué podría automatizarse",
  "Qué sistemas deberían comunicarse",
  "Dónde puede aportar valor la IA",
];

const ambitos = ["reservas", "atención al huésped", "recepción", "operación interna", "gestión", "backoffice"];

const tresPreguntas = [
  "¿Dónde existe una fricción real?",
  "¿Cuánto impacto tiene?",
  "¿Merece la pena resolverla?",
];

const pad = (n: number) => String(n).padStart(2, "0");

// Alzado: 7 plantas, la cuarta desde abajo es la piloto. `dist` es la distancia
// a la piloto y marca el orden en que el resto "se completa".
const PILOTO = 3;
const plantas = Array.from({ length: 7 }, (_, i) => ({ i, piloto: i === PILOTO, dist: Math.abs(i - PILOTO) }));

// Indicador de plantas (escritorio): una por sección, como un ascensor.
const planta = [
  { id: "inicio", n: "00", label: "La idea" },
  { id: "escalar", n: "01", label: "Qué escalar" },
  { id: "operacion", n: "02", label: "La operación" },
  { id: "radiografia", n: "03", label: "Radiografía" },
  { id: "resultado", n: "04", label: "Resultado" },
  { id: "propuesta", n: "05", label: "Propuesta" },
  { id: "hablar", n: "06", label: "Conversación" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Probar. Aprender. Después escalar. Una idea para Nuria Blanco." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f4f2ee" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <nav class="floors" aria-label="Plantas de la página">
      <ol>
        {planta.map((p) => (
          <li><a href={`#${p.id}`} data-floor-link={p.id}><span class="floors-n">{p.n}</span><span class="floors-l">{p.label}</span></a></li>
        ))}
      </ol>
    </nav>

    <main>
      <!-- 00 · La idea -->
      <section id="inicio" class="hero wrap" data-floor aria-labelledby="hero-title">
        <p class="eyebrow" data-reveal style="--d:0ms">Una idea para Nuria Blanco</p>
        <h1 id="hero-title" class="greeting" data-reveal style="--d:80ms">Nuria, cuando un hotel se renueva, muchas veces empieza por una sola planta.</h1>

        <div class="hero-grid">
          <p class="triad" aria-label="Probar. Aprender. Después escalar.">
            <span data-reveal style="--d:200ms">Probar.</span>
            <span data-reveal style="--d:420ms">Aprender.</span>
            <span data-reveal style="--d:640ms">Después escalar.</span>
          </p>

          <figure class="elev elev-hero" data-reveal style="--d:300ms" aria-hidden="true">
            <svg viewBox="0 0 300 260" role="presentation">
              <line x1="20" y1="244" x2="280" y2="244" class="elev-ground" />
              {plantas.map((p) => {
                const y = 214 - p.i * 30;
                return (
                  <g class:list={["elev-floor", { "elev-pilot": p.piloto }]}>
                    <rect x="60" y={y} width="180" height="26" />
                    {[0, 1, 2, 3, 4].map((k) => <rect class="elev-win" x={74 + k * 32} y={y + 8} width="20" height="10" />)}
                  </g>
                );
              })}
              <line x1="246" y1={214 - PILOTO * 30 + 13} x2="262" y2={214 - PILOTO * 30 + 13} class="elev-tick" />
            </svg>
            <figcaption class="elev-cap">Planta piloto</figcaption>
          </figure>
        </div>

        <div class="hero-copy">
          <div class="hero-text" data-reveal>
            <p>Se reforma una planta piloto, se escucha al cliente, se ajustan los detalles y solo después se extiende al resto del edificio.</p>
            <p>Es una forma prudente de abordar un cambio.</p>
          </div>
          <p class="hero-question" data-reveal>¿Y si aplicamos la misma lógica a los procesos y la tecnología del Plaza y del Avenida?</p>
        </div>

        <div class:list={["video", `video-${VIDEO.orientation}`]} data-video data-reveal>
          {VIDEO.src && (
            <video class="video-el" preload="none" playsinline controls poster={VIDEO.poster || undefined} aria-label="Vídeo de Luiz Brazão para Nuria Blanco">
              <source src={VIDEO.src} type={VIDEO.type} />
            </video>
          )}
          <button class="video-cover" type="button" data-video-play aria-label={`Reproducir el vídeo, ${VIDEO.duracion}`}>
            <span class="video-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
            </span>
            <span class="video-time">{VIDEO.duracion}</span>
          </button>
          <p class="video-note" data-video-note hidden>El vídeo estará disponible en breve.</p>
        </div>
      </section>

      <!-- 01 · Qué merece la pena escalar -->
      <section id="escalar" class="section wrap" data-floor aria-labelledby="escalar-title">
        <div class="split">
          <p class="eyebrow" data-reveal>01 · Antes de escalar</p>
          <div>
            <h2 id="escalar-title" class="h2" data-reveal>Antes de escalar algo, conviene saber qué merece la pena escalar.</h2>
            <p class="lede" data-reveal>Cuando una operación funciona y empieza a incorporar nuevos servicios, unidades de negocio o modelos de alojamiento, no todo debería crecer de la misma forma.</p>
            <ul class="scale-list">
              {escalan.map((t, i) => <li data-reveal style={`--d:${i * 90}ms`}>{t}</li>)}
            </ul>
          </div>
        </div>

        <ol class="route">
          {preguntas.map((q, i) => (
            <li class:list={["route-item", i % 2 ? "route-right" : "route-left"]} data-reveal>
              <span class="route-n">{pad(i + 1)}</span>
              <p>{q}</p>
            </li>
          ))}
          <li class="route-item route-last" data-reveal>
            <span class="route-n">{pad(preguntas.length + 1)}</span>
            <p>{preguntaFinal}</p>
          </li>
        </ol>
      </section>

      <!-- 02 · La operación -->
      <section id="operacion" class="stone" data-floor aria-labelledby="operacion-title">
        <div class="wrap section">
          <div class="split">
            <p class="eyebrow" data-reveal>02 · Blancohostel</p>
            <div>
              <h2 id="operacion-title" class="h2" data-reveal>La operación ya es más que un hotel.</h2>
              <div class="prose" data-reveal>
                <p>Hotel Plaza y Hotel Avenida conviven dentro de una estructura empresarial que también incorpora restauración, servicios y nuevas líneas de actividad.</p>
                <p>Además, modelos como Avenida Lofts muestran que existen otras formas de ampliar la experiencia hotelera sin limitarse al alojamiento tradicional.</p>
                <p class="prose-ink">Cuanto mayor es la variedad de operaciones, más importa entender cómo circulan:</p>
              </div>
              <ul class="flowwords" data-reveal>
                {circula.map((w) => <li>{w}</li>)}
              </ul>
            </div>
          </div>
          <div class="question-pair" data-reveal>
            <p class="qp-muted">La pregunta no es cuánta tecnología incorporar.</p>
            <p class="qp-ink">La pregunta es dónde eliminar complejidad antes de seguir creciendo.</p>
          </div>
        </div>
      </section>

      <!-- 03 · Radiografía -->
      <section id="radiografia" class="sea" data-floor aria-labelledby="radiografia-title">
        <div class="wrap section">
          <div class="split">
            <p class="eyebrow" data-reveal>03 · Radiografía Digital</p>
            <div>
              <h2 id="radiografia-title" class="h2" data-reveal>Ahí entra la Radiografía Digital.</h2>
            </div>
          </div>

          <div class="pilot">
            <p class="pilot-title" data-reveal>Una planta piloto para la operación.</p>
            <figure class="elev elev-scale" data-reveal aria-hidden="true">
              <svg viewBox="0 0 300 260" role="presentation">
                <line x1="20" y1="244" x2="280" y2="244" class="elev-ground" />
                {plantas.map((p) => {
                  const y = 214 - p.i * 30;
                  return (
                    <g class:list={["elev-floor", { "elev-pilot": p.piloto }]} style={`--k:${p.dist}`}>
                      <rect x="60" y={y} width="180" height="26" />
                      {[0, 1, 2, 3, 4].map((k) => <rect class="elev-win" x={74 + k * 32} y={y + 8} width="20" height="10" />)}
                    </g>
                  );
                })}
              </svg>
            </figure>
          </div>

          <div class="method">
            <div class="method-lead" data-reveal>
              <p>No empezamos instalando tecnología.</p>
              <p>Empezamos observando cómo funciona realmente una parte del negocio.</p>
            </div>
            <ol class="method-steps">
              {pasos.map((p, i) => <li data-reveal><span>{pad(i + 1)}</span><p>{p}</p></li>)}
            </ol>
            <p class="method-close" data-reveal>Y solamente entonces planteamos dónde podría tener sentido integrar, automatizar o aplicar inteligencia artificial.</p>
          </div>

          <ol class="path" data-reveal aria-label="Recorrido: observar, entender, detectar, priorizar y decidir">
            {recorrido.map((r, i) => <li class:list={{ "path-end": i === recorrido.length - 1 }} style={`--i:${i}`}><span class="path-dot" aria-hidden="true"></span>{r}</li>)}
          </ol>
        </div>
      </section>

      <!-- Método 4×4 -->
      <section class="section wrap framework" aria-labelledby="framework-title">
        <div class="split">
          <p class="eyebrow" data-reveal>Método</p>
          <div>
            <h2 id="framework-title" class="h3" data-reveal>Framework 4×4</h2>
            <p class="lede lede-small" data-reveal>Analizamos cuatro áreas de la operación y, en cada una, buscamos cuatro tipos de fricción.</p>
          </div>
        </div>
        <div class="matrix-wrap" data-reveal>
          <table class="matrix">
            <caption class="sr-only">Framework 4×4: áreas de la operación por tipos de fricción</caption>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Área</span></th>
                {fricciones.map((f, j) => <th scope="col"><span class="m-full">{f}</span><span class="m-short" aria-hidden="true">F{j + 1}</span></th>)}
              </tr>
            </thead>
            <tbody>
              {areas.map((a, i) => (
                <tr>
                  <th scope="row">{a}</th>
                  {fricciones.map((f, j) => <td style={`--c:${i + j}`}><span class="m-dot" aria-hidden="true"></span><span class="sr-only">{a} · {f}</span></td>)}
                </tr>
              ))}
            </tbody>
          </table>
          <p class="matrix-legend" aria-hidden="true">{fricciones.map((f, j) => <span>F{j + 1} {f}</span>)}</p>
        </div>
      </section>

      <!-- 04 · Resultado -->
      <section id="resultado" class="section wrap" data-floor aria-labelledby="resultado-title">
        <div class="split">
          <p class="eyebrow" data-reveal>04 · Resultado</p>
          <div>
            <h2 id="resultado-title" class="h2" data-reveal>No termina con una lista de herramientas.</h2>
            <p class="lede" data-reveal>La Radiografía termina con un mapa priorizado de oportunidades.</p>
          </div>
        </div>
        <ol class="map">
          {mapa.map((m, i) => <li data-reveal><span>{pad(i + 1)}</span><p>{m}</p></li>)}
        </ol>
        <p class="map-last" data-reveal><span>{pad(mapa.length + 1)}</span>Qué no merece la pena tocar</p>
      </section>

      <!-- 05 · Propuesta -->
      <section id="propuesta" class="mist" data-floor aria-labelledby="propuesta-title">
        <div class="wrap section">
          <div class="split">
            <p class="eyebrow" data-reveal>05 · Una propuesta concreta</p>
            <div>
              <h2 id="propuesta-title" class="h2" data-reveal>Hagamos una planta piloto de la operación.</h2>
              <div class="prose prose-ink" data-reveal>
                <p>Podríamos seleccionar una parte concreta de Hotel Plaza o Hotel Avenida y realizar una Radiografía Digital limitada a ese ámbito.</p>
                <p>Por ejemplo, podríamos seguir de principio a fin uno o varios procesos relacionados con:</p>
              </div>
              <ul class="chips" data-reveal aria-label="Ámbitos posibles, a modo de ejemplo">
                {ambitos.map((a) => <li>{a}</li>)}
              </ul>
              <div class="prose prose-ink" data-reveal>
                <p class="prose-strong">El objetivo no sería implementar nada.</p>
                <p>Sería responder primero a tres preguntas:</p>
              </div>
              <ol class="three">
                {tresPreguntas.map((q, i) => <li data-reveal style={`--d:${i * 90}ms`}><span>{i + 1}</span>{q}</li>)}
              </ol>
            </div>
          </div>
          <p class="motto" data-reveal><span>Primero entender.</span><span>Después decidir.</span></p>
        </div>
      </section>

      <!-- Independencia -->
      <section class="section wrap independence" aria-labelledby="indep-title">
        <div class="split">
          <p class="eyebrow" data-reveal>Independencia</p>
          <div>
            <h2 id="indep-title" class="h2" data-reveal>Sin proyecto tecnológico que justificar.</h2>
            <div class="prose" data-reveal>
              <p>IA Operators trabaja de forma independiente de las plataformas.</p>
              <p>No necesitamos encontrar un lugar para introducir inteligencia artificial.</p>
            </div>
            <ul class="maybe" data-reveal>
              <li>Puede que la conclusión sea automatizar.</li>
              <li>Puede que sea integrar dos sistemas.</li>
              <li>Puede que sea cambiar un proceso.</li>
              <li>O puede que descubramos que algo funciona perfectamente como está.</li>
            </ul>
            <p class="good-result" data-reveal>También es un buen resultado descubrir qué no debemos cambiar.</p>
          </div>
        </div>
      </section>

      <!-- 06 · Conversación -->
      <section id="hablar" class="cta" data-floor aria-labelledby="cta-title">
        <div class="wrap section">
          <h2 id="cta-title" class="h2 cta-title" data-reveal>Si te parece interesante, seguimos la conversación.</h2>
          <p class="cta-copy" data-reveal>Puedo enseñarte cómo hacemos una Radiografía Digital y valorar juntos si tendría sentido probarla en una parte de la operación.</p>
          <div class="cta-row" data-reveal>
            <a class="button" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="final">Hablar con Luiz <span aria-hidden="true">↗</span></a>
            <div class="signature">
              <p class="signature-name">Luiz Brazão</p>
              <p class="signature-role">Founder, IA Operators</p>
              <a class="signature-site" href="https://iaoperators.com/es/" data-cta="site">iaoperators.com</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <span class="foot-brand"><img src="/brand/ia-operators-logo.png" alt="IA Operators" width="453" height="82" loading="lazy" /></span>
        <a href="/es/auditoria-de-sistemas/">Radiografía Digital</a>
        <a href="https://iaoperators.com/es/">iaoperators.com</a>
      </div>
    </footer>

    <div class="consent" data-consent hidden role="region" aria-label="Cookies">
      <p>Usamos cookies para medir y mejorar la experiencia. Puedes aceptar o rechazar. <a href="/es/politica-de-privacidad/">Política de Privacidad</a>.</p>
      <div class="consent-actions">
        <button type="button" data-consent-reject>Rechazar</button>
        <button type="button" class="consent-accept" data-consent-accept>Aceptar</button>
      </div>
    </div>

    <script define:vars={{ GTM_ID }}>window.__NURIA_GTM__ = GTM_ID;</script>
    <script>
      import { initProspectLanding } from "../../scripts/prospect-landing";
      const gtmId = (window as unknown as { __NURIA_GTM__?: string }).__NURIA_GTM__ ?? "";
      initProspectLanding({ landing: "nuria", gtmId, videoTitle: "nuria_luiz" });

      // Indicador de plantas: marca la sección visible.
      const links = new Map<string, HTMLElement>();
      document.querySelectorAll<HTMLElement>("[data-floor-link]").forEach((a) => links.set(a.dataset.floorLink!, a));
      if ("IntersectionObserver" in window && links.size) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (!e.isIntersecting) return;
            links.forEach((a) => a.removeAttribute("aria-current"));
            links.get(e.target.id)?.setAttribute("aria-current", "true");
          }),
          { rootMargin: "-45% 0px -50% 0px" },
        );
        document.querySelectorAll<HTMLElement>("[data-floor]").forEach((s) => io.observe(s));
      }
    </script>

    <style is:global>
      @font-face {
        font-family: "Manrope Nuria";
        src: url("/fonts/manrope-latin-variable.woff2") format("woff2");
        font-weight: 200 800;
        font-display: swap;
      }
      :root {
        --paper: #f4f2ee;
        --stone: #ebe7df;
        --mist: #dfe5e4;
        --ink: #1e2526;
        --muted: #5f6869;
        --soft: #8b9393;
        --line: #d4d6d1;
        --orange: #f16532;
        --orange-ink: #b4441a;
        --sea: #1c2a2f;
        --sea-text: #e7ecea;
        --sea-muted: #9fb0b2;
        --sea-line: #34464c;
        --mono: "SFMono-Regular", ui-monospace, Menlo, Consolas, monospace;
        --gutter: 22px;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 72px; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Manrope Nuria", "Helvetica Neue", Arial, sans-serif; font-size: 17px; line-height: 1.62; -webkit-font-smoothing: antialiased; }
      h1, h2, p, ol, ul, figure, table { margin: 0; }
      ol, ul { padding: 0; list-style: none; }
      a { color: inherit; text-decoration: none; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
      .wrap { width: 100%; max-width: 1200px; margin-inline: auto; padding-inline: var(--gutter); }
      .eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: .09em; text-transform: uppercase; color: var(--muted); }

      /* Cabecera */
      .top { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid transparent; transition: background-color .3s ease, border-color .3s ease; }
      .top.is-scrolled { background: rgba(244, 242, 238, .92); border-bottom-color: var(--line); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
      .top-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 62px; }
      .wordmark { font-size: 19px; font-weight: 600; letter-spacing: -.04em; white-space: nowrap; }
      .wordmark span, .foot-brand span { color: var(--orange); }
      .wordmark img { display: block; width: auto; height: 22px; }
      .foot-brand img { display: block; width: auto; height: 18px; }
      .top-nav { display: flex; align-items: center; gap: 22px; font-size: 13px; }
      .top-link { display: none; }
      .top-cta { display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; border: 1px solid var(--ink); border-radius: 999px; font-weight: 500; white-space: nowrap; transition: background-color .2s ease, color .2s ease; }
      .top-cta:hover { background: var(--ink); color: var(--paper); }

      /* Indicador de plantas (solo escritorio ancho) */
      .floors { display: none; }

      /* Hero */
      .hero { padding-top: 22px; padding-bottom: 64px; }
      .greeting { margin-top: 18px; max-width: 20em; font-size: clamp(23px, 3.2vw, 38px); font-weight: 500; letter-spacing: -.03em; line-height: 1.22; }
      .hero-grid { display: grid; gap: 24px; margin-top: 22px; }
      .triad { display: grid; font-size: clamp(42px, 11.2vw, 104px); font-weight: 300; letter-spacing: -.055em; line-height: 1.02; }
      .triad span:last-child { color: var(--orange-ink); }
      .elev { display: none; }
      .hero-copy { display: grid; gap: 22px; margin-top: 30px; }
      .hero-text p { color: var(--muted); max-width: 34em; }
      .hero-text p + p { margin-top: 12px; color: var(--ink); }
      .hero-question { font-size: clamp(22px, 2.6vw, 34px); font-weight: 500; letter-spacing: -.035em; line-height: 1.25; max-width: 18em; }
      .video { position: relative; overflow: hidden; margin-top: 34px; background: var(--sea); color: var(--sea-text); border-radius: 2px; }
      .video-horizontal { aspect-ratio: 16 / 9; }
      .video-vertical { aspect-ratio: 9 / 16; max-height: 78vh; width: min(100%, calc(78vh * 9 / 16)); margin-inline: auto; }
      .video-el { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #000; }
      .video-cover { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; width: 100%; padding: 0; border: 0; background: radial-gradient(120% 90% at 50% 60%, #24363c 0%, var(--sea) 70%); color: inherit; font: inherit; cursor: pointer; }
      .video.is-playing .video-cover { display: none; }
      .video-play { display: grid; place-items: center; width: 68px; height: 68px; border-radius: 50%; border: 1px solid rgba(231, 236, 234, .7); color: var(--sea-text); transition: background-color .3s ease, color .3s ease, transform .35s cubic-bezier(.2,.7,.2,1); }
      .video-play svg { margin-left: 3px; }
      .video-cover:hover .video-play { background: var(--sea-text); color: var(--sea); transform: scale(1.04); }
      .video-time { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--sea-muted); }
      .video-note { position: absolute; left: 0; right: 0; bottom: 14px; text-align: center; font-size: 13px; color: var(--sea-text); }

      /* Secciones */
      .section { padding-block: 84px; }
      .split { display: grid; gap: 20px; }
      .split > .eyebrow { padding-top: 6px; }
      .h2 { font-size: clamp(31px, 4.8vw, 64px); font-weight: 400; letter-spacing: -.05em; line-height: 1.08; max-width: 14em; }
      .h3 { font-size: clamp(26px, 3vw, 38px); font-weight: 400; letter-spacing: -.04em; line-height: 1.15; }
      .lede { margin-top: 24px; max-width: 32em; font-size: 19px; line-height: 1.55; letter-spacing: -.012em; color: var(--ink); }
      .lede-small { font-size: 17px; color: var(--muted); }
      .prose { margin-top: 24px; max-width: 36em; }
      .prose p { color: var(--muted); }
      .prose p + p { margin-top: 12px; }
      .prose .prose-ink, .prose-ink p { color: #39433f; }
      .prose .prose-strong { color: var(--ink); font-size: 20px; letter-spacing: -.015em; }

      .scale-list { margin-top: 30px; border-top: 1px solid var(--line); }
      .scale-list li { padding-block: 13px; border-bottom: 1px solid var(--line); font-size: 17px; letter-spacing: -.01em; }
      .scale-list li:last-child { color: var(--orange-ink); }

      /* Preguntas como recorrido */
      .route { position: relative; margin-top: 72px; padding-left: 26px; }
      .route::before { content: ""; position: absolute; left: 4px; top: 8px; bottom: 8px; width: 1px; background: var(--line); }
      .route-item { position: relative; padding-block: 20px; }
      .route-item::before { content: ""; position: absolute; left: -26px; top: 30px; width: 9px; height: 9px; border-radius: 50%; background: var(--paper); border: 1px solid var(--soft); }
      .route-n { font-family: var(--mono); font-size: 11px; color: var(--soft); letter-spacing: .06em; }
      .route-item p { margin-top: 4px; font-size: clamp(21px, 2.6vw, 34px); font-weight: 400; letter-spacing: -.035em; line-height: 1.22; max-width: 19em; }
      .route-last { margin-top: 18px; padding: 24px 22px 26px; background: var(--ink); color: var(--paper); }
      .route-last::before { background: var(--orange); border-color: var(--orange); left: -26px; }
      .route-last .route-n { color: var(--orange); }

      /* Blancohostel */
      .stone { background: var(--stone); }
      .flowwords { margin-top: 26px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 0; }
      .flowwords li { display: inline-flex; align-items: center; font-size: clamp(20px, 2.2vw, 28px); font-weight: 400; letter-spacing: -.035em; }
      .flowwords li:not(:last-child)::after { content: ""; display: inline-block; width: 20px; height: 1px; margin-inline: 10px; background: var(--soft); }
      .question-pair { margin-top: 64px; padding-top: 30px; border-top: 1px solid #cfc9bd; display: grid; gap: 10px; }
      .qp-muted { font-size: clamp(20px, 2.4vw, 30px); letter-spacing: -.03em; line-height: 1.25; color: var(--muted); }
      .qp-ink { font-size: clamp(28px, 4.2vw, 56px); font-weight: 400; letter-spacing: -.05em; line-height: 1.1; max-width: 17em; }

      /* Radiografía (mar) */
      .sea { background: var(--sea); color: var(--sea-text); }
      .sea .eyebrow { color: var(--sea-muted); }
      .pilot { margin-top: 40px; display: grid; gap: 28px; align-items: center; }
      .pilot-title { font-size: clamp(40px, 8.6vw, 112px); font-weight: 300; letter-spacing: -.06em; line-height: 1; max-width: 9em; }
      .method { margin-top: 64px; display: grid; gap: 28px; }
      .method-lead p { font-size: clamp(22px, 2.6vw, 32px); letter-spacing: -.035em; line-height: 1.25; }
      .method-lead p + p { margin-top: 8px; color: var(--sea-muted); }
      .method-steps { border-top: 1px solid var(--sea-line); }
      .method-steps li { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 12px; padding-block: 18px; border-bottom: 1px solid var(--sea-line); }
      .method-steps span { font-family: var(--mono); font-size: 11px; color: var(--sea-muted); padding-top: .45em; }
      .method-steps p { font-size: 18px; line-height: 1.5; }
      .method-close { font-size: 19px; line-height: 1.5; color: var(--sea-text); max-width: 32em; padding-left: 16px; border-left: 2px solid var(--orange); }
      .path { margin-top: 64px; display: grid; gap: 16px; position: relative; padding-left: 0; }
      .path li { position: relative; display: flex; align-items: center; gap: 14px; font-size: 18px; letter-spacing: -.02em; }
      .path-dot { width: 9px; height: 9px; border-radius: 50%; border: 1px solid var(--sea-text); flex: none; }
      .path-end { color: var(--orange); }
      .path-end .path-dot { background: var(--orange); border-color: var(--orange); }

      /* Alzado del edificio */
      .elev svg { display: block; width: 100%; height: auto; overflow: visible; }
      .elev .elev-ground { stroke: var(--soft); stroke-width: 1; }
      .elev .elev-floor rect { fill: none; stroke: var(--line); stroke-width: 1; }
      .elev .elev-floor .elev-win { stroke: none; fill: var(--line); }
      .elev .elev-pilot rect:first-child { stroke: var(--orange); stroke-width: 1.4; fill: rgba(241, 101, 50, .06); }
      .elev .elev-pilot .elev-win { fill: var(--orange); opacity: .7; }
      .elev .elev-tick { stroke: var(--orange); stroke-width: 1; }
      .elev-hero .elev-floor:not(.elev-pilot) rect:first-child { stroke-dasharray: 3 4; }
      .elev-cap { margin-top: 10px; font-family: var(--mono); font-size: 11px; letter-spacing: .09em; text-transform: uppercase; color: var(--orange-ink); text-align: right; padding-right: 13%; }
      .elev-scale { display: block; max-width: 300px; }
      .elev-scale .elev-floor rect:first-child { stroke: var(--sea-line); }
      .elev-scale .elev-floor .elev-win { fill: var(--sea-line); }
      .elev-scale .elev-ground { stroke: var(--sea-muted); }
      .elev-scale .elev-pilot rect:first-child { stroke: var(--orange); fill: rgba(241, 101, 50, .12); }
      .elev-scale .elev-pilot .elev-win { fill: var(--orange); }
      .elev-scale.is-in .elev-floor:not(.elev-pilot) rect:first-child { stroke: var(--sea-muted); }
      .elev-scale.is-in .elev-floor:not(.elev-pilot) .elev-win { fill: var(--sea-muted); }

      /* Framework 4×4 */
      .framework .h3 { margin-top: 0; }
      .matrix-wrap { margin-top: 44px; }
      .matrix { width: 100%; border-collapse: collapse; table-layout: fixed; }
      .matrix th, .matrix td { border-bottom: 1px solid var(--line); padding: 14px 6px; text-align: center; font-weight: 400; }
      .matrix thead th { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); border-bottom-color: var(--ink); }
      .matrix thead th:first-child, .matrix tbody th { width: 30%; text-align: left; padding-left: 0; }
      .matrix tbody th { font-size: 17px; letter-spacing: -.02em; }
      .m-full { display: none; }
      .m-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; border: 1px solid var(--soft); transition: background-color .5s ease calc(var(--c) * 60ms), border-color .5s ease calc(var(--c) * 60ms); }
      .matrix-wrap.is-in .m-dot { background: var(--ink); border-color: var(--ink); }
      .matrix-legend { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 6px 16px; font-family: var(--mono); font-size: 11px; color: var(--muted); }

      /* Resultado */
      .map { margin-top: 56px; border-top: 1px solid var(--line); }
      .map li { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 12px; padding-block: 20px; border-bottom: 1px solid var(--line); }
      .map span, .map-last span { font-family: var(--mono); font-size: 11px; color: var(--soft); padding-top: .9em; }
      .map p { font-size: clamp(25px, 3.6vw, 46px); font-weight: 400; letter-spacing: -.045em; line-height: 1.12; }
      .map-last { margin-top: 30px; display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 12px; padding: 26px 20px 30px; border: 1px solid var(--ink); font-size: clamp(27px, 3.6vw, 46px); letter-spacing: -.05em; line-height: 1.1; }
      .map-last span { color: var(--orange-ink); }

      /* Propuesta (niebla) */
      .mist { background: var(--mist); }
      .mist .eyebrow { color: #4f5d5e; }
      .chips { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 8px; }
      .chips li { padding: 8px 14px; border: 1px dashed #7c8a8b; border-radius: 999px; font-size: 14px; color: #34403f; }
      .chips + .prose { margin-top: 30px; }
      .three { margin-top: 20px; display: grid; gap: 10px; }
      .three li { display: grid; grid-template-columns: 30px minmax(0, 1fr); align-items: baseline; gap: 10px; font-size: clamp(20px, 2.4vw, 28px); letter-spacing: -.03em; line-height: 1.25; }
      .three span { font-family: var(--mono); font-size: 12px; color: var(--orange-ink); }
      .motto { margin-top: 80px; display: grid; font-size: clamp(42px, 10vw, 136px); font-weight: 300; letter-spacing: -.06em; line-height: 1; }
      .motto span:last-child { color: #637173; }

      /* Independencia */
      .maybe { margin-top: 28px; border-top: 1px solid var(--line); }
      .maybe li { padding-block: 12px; border-bottom: 1px solid var(--line); color: var(--muted); }
      .maybe li:last-child { color: var(--ink); }
      .good-result { margin-top: 36px; font-size: clamp(26px, 3.6vw, 46px); font-weight: 400; letter-spacing: -.045em; line-height: 1.15; max-width: 16em; }
      .good-result::before { content: ""; display: block; width: 40px; height: 2px; margin-bottom: 20px; background: var(--orange); }

      /* CTA */
      .cta { border-top: 1px solid var(--line); }
      .cta-title { max-width: 13em; }
      .cta-copy { margin-top: 22px; max-width: 34em; color: var(--muted); font-size: 18px; }
      .cta-row { margin-top: 36px; display: grid; gap: 32px; }
      .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; justify-self: start; min-height: 56px; padding: 0 24px; background: var(--ink); color: var(--paper); font-size: 15px; font-weight: 500; transition: background-color .2s ease; }
      .button:hover { background: #000; }
      .button span { transition: transform .25s ease; }
      .button:hover span { transform: translate(2px, -2px); }
      .signature { border-top: 1px solid var(--line); padding-top: 16px; max-width: 320px; }
      .signature-name { font-size: 18px; font-weight: 600; letter-spacing: -.02em; }
      .signature-role { color: var(--muted); font-size: 14px; }
      .signature-site { display: inline-block; margin-top: 8px; font-family: var(--mono); font-size: 11px; letter-spacing: .06em; color: var(--soft); min-height: 24px; }
      .signature-site:hover { color: var(--ink); }

      /* Pie */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; padding-block: 24px 32px; font-size: 13px; color: var(--muted); }
      .foot-brand { color: var(--ink); font-weight: 600; letter-spacing: -.03em; margin-right: auto; }
      .foot a { min-height: 32px; display: inline-flex; align-items: center; }
      .foot a:hover { color: var(--ink); }

      /* Consentimiento */
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; max-width: 560px; margin-inline: auto; background: var(--ink); color: #e7ecea; font-size: 13px; line-height: 1.5; border-radius: 3px; }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; text-underline-offset: 3px; }
      .consent-actions { display: flex; justify-content: flex-end; gap: 10px; }
      .consent button { min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid #5c6a6c; background: transparent; color: inherit; font: inherit; font-weight: 500; cursor: pointer; }
      .consent .consent-accept { background: var(--paper); color: var(--ink); border-color: var(--paper); }

      /* Entradas: cada bloque "se abre" como una planta que se prueba antes de la siguiente */
      .js [data-reveal] { opacity: 0; transform: translateY(14px); transition: opacity .85s ease var(--d, 0ms), transform .85s cubic-bezier(.2, .7, .2, 1) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }
      .js .elev-scale .elev-floor:not(.elev-pilot) { opacity: .25; transition: opacity .6s ease calc(.35s + var(--k) * .22s); }
      .js .elev-scale.is-in .elev-floor:not(.elev-pilot) { opacity: 1; }
      .js .path li { opacity: 0; transition: opacity .5s ease calc(.2s + var(--i) * .15s); }
      .js .path.is-in li { opacity: 1; }

      @media (min-width: 560px) {
        .top-link { display: inline-flex; align-items: center; min-height: 40px; color: var(--muted); }
        .top-link:hover { color: var(--ink); }
        .consent { grid-template-columns: 1fr auto; align-items: center; }
        .m-full { display: inline; }
        .m-short, .matrix-legend { display: none; }
        .matrix thead th { font-size: 10px; letter-spacing: .03em; }
      }
      @media (min-width: 900px) {
        :root { --gutter: 48px; }
        body { font-size: 18px; }
        .top-inner { height: 74px; }
        .wordmark { font-size: 21px; }
        .hero { padding-top: 34px; padding-bottom: 104px; }
        .hero-grid { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); align-items: end; gap: 48px; margin-top: 28px; }
        .elev-hero { display: block; padding-bottom: 8px; }
        .hero-copy { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: end; margin-top: 48px; }
        .video { margin-top: 56px; max-width: 980px; }
        .section { padding-block: 124px; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .route { margin-top: 96px; padding-left: 0; }
        .route::before { left: 50%; }
        .route-item { width: 50%; padding: 26px 0; }
        .route-left { padding-right: 56px; text-align: right; }
        .route-left p { margin-left: auto; }
        .route-right { margin-left: 50%; padding-left: 56px; }
        .route-left::before { left: auto; right: -5px; top: 36px; }
        .route-right::before { left: -4px; top: 36px; }
        .route-last { width: auto; margin: 40px auto 0; max-width: 760px; text-align: center; padding: 34px 40px 38px; }
        .route-last::before { left: calc(50% - 5px); top: -46px; }
        .route-last p { margin-inline: auto; }
        .flowwords, .question-pair { margin-left: 0; }
        .question-pair { margin-top: 88px; margin-left: calc((100% - 48px) / 3 + 48px); }
        .pilot { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); margin-top: 56px; }
        .method { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; margin-top: 96px; }
        .method-close { grid-column: 2; }
        .method-steps li { grid-template-columns: 56px minmax(0, 1fr); }
        .path { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; margin-top: 96px; border-top: 1px solid var(--sea-line); padding-top: 22px; }
        .path li { font-size: 22px; }
        .matrix-wrap { margin-left: calc((100% - 48px) / 3 + 48px); }
        .matrix thead th { font-size: 11px; letter-spacing: .06em; }
        .map, .map-last { margin-left: calc((100% - 48px) / 3 + 48px); }
        .map li, .map-last { grid-template-columns: 56px minmax(0, 1fr); }
        .map-last { padding: 34px 20px 38px 24px; }
        .motto { margin-top: 112px; }
        .cta-row { grid-template-columns: auto 1fr; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; }
      }
      @media (min-width: 1360px) {
        .floors { display: block; position: fixed; left: 24px; top: 50%; transform: translateY(-50%); z-index: 10; }
        .floors ol { display: grid; gap: 2px; }
        .floors a { display: flex; align-items: center; gap: 10px; min-height: 28px; font-family: var(--mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--soft); }
        .floors-n { width: 22px; padding-bottom: 2px; border-bottom: 1px solid transparent; }
        .floors-l { opacity: 0; transform: translateX(-4px); transition: opacity .3s ease, transform .3s ease; }
        .floors a:hover .floors-l, .floors a[aria-current] .floors-l { opacity: 1; transform: none; }
        .floors a[aria-current] { color: var(--orange-ink); }
        .floors a[aria-current] .floors-n { border-bottom-color: var(--orange); }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal], .js .path li, .js .elev-scale .elev-floor { opacity: 1 !important; transform: none !important; transition: none !important; }
        .m-dot, .video-play, .button span, .top, .floors-l { transition: none !important; }
      }
    </style>
  </body>
</html>
