---
import PresenterVideo from "../../components/PresenterVideo.astro";
// Landing personalizada para Elisabeth Martínez Santos, directora de
// Operaciones de Hoteles Casa 1800 (Sevilla y Granada; Córdoba en camino).
// Creada el 13/11/2026. Privada: noindex,nofollow y fuera del sitemap
// ("/tis/" en NOINDEX_PATHS). Complementa /tis/casa1800 (dirigida a
// Francisca García, CEO): misma propuesta, otro ángulo (datos y operación).
//
// Sesión de TIS 07/10/2026, 16:00, «AI and revenue management: what's really
// increasing RevPAR?», moderada por Francisca García, con Luis de Diego
// (Axel), Nicolás Lleixà (Pierre & Vacances) y Sònia Molina (HotelsDot).
// Verificado contra la transcripción oficial del vídeo (13/11/2026). Solo se
// usa lo que con seguridad dijo Elisabeth (turnos abiertos por la moderadora
// con su nombre), parafraseado salvo citas cortas:
//   - 12:31-15:50: dos hoteles boutique pequeños en Sevilla y Granada, y las
//     afueras de Córdoba. 99 % de ocupación, 65 % de cliente directo y casi
//     90 % internacional; hay que afinar la estrategia a diario para superar
//     cada año los resultados, «porque no es nada fácil». Han incorporado la
//     IA con sus colaboradores. Antes: el típico Excel en el que volcaban cada
//     mañana el listado del PMS, con millones de pestañas (fechas, semanas,
//     días, eventos, festivos). Hoy, con un clic, información actualizada,
//     datos cruzados, tantas veces al día como quieran, sin esperar al día
//     siguiente para ver cancelaciones o movimientos. Canal directo: asistente
//     virtual en la web con un colaborador (por eso aquí NO se empuja el
//     enlace a reservas directas). Por la situación geopolítica, clientes que
//     reservaban con 60 días de antelación pasan a reservar con siete.
//   - 26:36-28:34: la IA ayuda a hacer informes, cruzar datos, optimizar los
//     Excel y eliminar el trabajo que no aportaba valor, una persona picando
//     datos casi toda la jornada, sin tiempo para analizar, fijar estrategias
//     y hacer tests. «Nos comíamos el día analizando, montando informes».
//     Apuesta por el revenue manager; la IA, un complemento.
//   - 37:55-39:27: «nos estamos volviendo un poco locos con la incorporación
//     de la IA»; hay prisa, pero hay que dar los pasos correctamente, no «a lo
//     loco y todo vale». Establecer qué datos queremos, que estén bien
//     conectados, bien mapeados, sin duplicados, y que todo el mundo trabaje
//     en la misma línea. Están desarrollando una herramienta interna para
//     conectar el PMS con esa herramienta y con el RMS, para ver el conjunto
//     del negocio y no analizar cada departamento de forma aislada.
//   - No se usa el cierre (42:30-43:51): atribución dudosa.
//
// Concepto: «los pasos correctos antes de la IA». La Radiografía como mapa de
// datos que su herramienta interna necesita, empezando por un dato concreto.
//
// Comportamiento compartido en src/scripts/prospect-landing.ts.

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  // Vídeo de Luiz con fondo blanco, fundido con la página (PresenterVideo).
  src: "/video/luiz-tis.mp4",
  poster: "/video/luiz-tis-poster.jpg",
  duracion: "1 min 24 s",
};

const wa = (t: string) => `https://wa.me/34662423523?text=${encodeURIComponent(t)}`;
const CONTACT_HREF = wa("Hola Luiz, soy Elisabeth Martínez, de Hoteles Casa 1800. He visto la página que preparaste después de TIS y me gustaría hablarlo.");
const INTRO_HREF = wa("Hola Luiz, soy Elisabeth Martínez, de Hoteles Casa 1800. Te pongo en contacto con la persona que lleva la herramienta interna: ");
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/elisabeth/", site).toString();
const ogImage = new URL("/og/elisabeth.png", site).toString();
const title = "Elisabeth Martínez × IA Operators | Radiografía Digital";
const description = "Después de la mesa de IA y revenue management en TIS: los pasos correctos antes de la IA, con los datos bien conectados y mapeados. Una reflexión preparada por IA Operators para Elisabeth Martínez y Hoteles Casa 1800.";

const pad = (n: number) => String(n).padStart(2, "0");

// Antes y ahora, tal y como lo describió.
const antes = [
  "Exportar cada mañana el listado del PMS",
  "Volcarlo en el Excel de siempre",
  "Comparar por fechas, semanas, días, eventos y festivos",
  "Esperar al día siguiente para ver cancelaciones",
];
const ahora = [
  "Un clic",
  "Información actualizada y datos cruzados",
  "Tantas veces al día como haga falta",
  "Tiempo para analizar, fijar estrategias y probar",
];

const datos = [
  { n: "99 %", k: "ocupación", s: "y hay que superarla cada año" },
  { n: "65 %", k: "cliente directo", s: "con asistente virtual en la web" },
  { n: "~90 %", k: "cliente internacional", s: "la antelación es un dato clave" },
];

// Sus condiciones para que los datos sirvan.
const filtro = [
  { q: "¿Qué datos queremos de verdad?", d: "Antes de conectar nada, decidir qué información aporta valor al negocio." },
  { q: "¿Están bien conectados?", d: "Que lo que sale del PMS llegue igual a cada herramienta." },
  { q: "¿Están bien mapeados y sin duplicados?", d: "Un mismo segmento, un mismo canal, una misma reserva, con el mismo nombre en todas partes." },
  { q: "¿Trabaja todo el mundo en la misma línea?", d: "Que cada departamento no saque sus propias conclusiones por separado." },
];

const pasos = [
  "Elegimos un dato que importa, por ejemplo la antelación por mercado.",
  "Lo seguimos desde el PMS hasta el RMS, los informes y la herramienta interna.",
  "Marcamos dónde se transforma, se duplica, se mapea distinto o se toca a mano.",
  "Dejamos el mapa y las definiciones comunes que la herramienta interna necesita para conectarlo todo.",
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Primero, los datos bien conectados. Después, la IA. Una idea para Elisabeth Martínez y Hoteles Casa 1800." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f6f5f1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-link top-link-x" href="/es/hoteles/" data-cta="nav_hoteles">Hoteles</a>
          <a class="top-link top-link-x" href="/es/hoteles/reservas-directas-ia/" data-cta="nav_reservas_directas">Reservas directas</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header" data-cta-event="click_contact">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="label">Después de «IA y revenue management» · TIS 2026</p>
        <h1 id="hero-title" class="greeting">Elisabeth, en TIS dijiste que nos estamos volviendo un poco locos con la IA. <b>Que hay que empezar dando los pasos correctamente.</b></h1>
        <p class="big">Primero, los datos bien conectados.<span>Después, la IA.</span></p>

        <div class="hero-grid">
          <PresenterVideo src={VIDEO.src} poster={VIDEO.poster} label="Vídeo de Luiz Brazão para Elisabeth Martínez" duracion={VIDEO.duracion} />

          <div class="hero-copy">
            <p>Te escuché en la mesa de revenue que moderó Francisca, con Luis de Diego, Nicolás Lleixà y Sònia Molina.</p>
            <p>Dijiste que hay prisa por incorporar la IA, pero si los datos no son correctos, la IA devuelve información que tampoco lo es. Y que estáis construyendo una herramienta interna para conectar el PMS con el RMS y ver el negocio entero.</p>
            <p class="hero-strong">Me gustaría proponerte algo pensado para ese momento: el mapa de los datos antes de conectarlos.</p>
          </div>
        </div>
      </section>

      <!-- Excel -->
      <section id="excel" class="section wrap" aria-labelledby="ex-title">
        <div class="split">
          <p class="label label-accent" data-reveal>01 · Del Excel al clic</p>
          <div>
            <h2 id="ex-title" class="h2" data-reveal>«Nos comíamos el día analizando, montando informes.»</h2>
            <p class="lede" data-reveal>Así lo describiste: una persona picando datos casi toda la jornada y, al final del día, la sensación de no haber llegado a lo importante, que era el análisis.</p>
            <figure class="ba" data-reveal aria-label="Antes y ahora: del Excel de cada mañana a la información con un clic">
              <div class="ba-col">
                <p class="ba-k">Antes</p>
                <ol>{antes.map((a, i) => <li style={`--i:${i}`}>{a}</li>)}</ol>
              </div>
              <div class="ba-col ba-now">
                <p class="ba-k">Ahora</p>
                <ol>{ahora.map((a, i) => <li style={`--i:${i}`}>{a}</li>)}</ol>
              </div>
              <figcaption>Tal y como lo contaste en la mesa.</figcaption>
            </figure>
            <p class="statement" data-reveal>
              <span class="muted">La IA no sustituye al revenue manager.</span>
              <span>Le devuelve el tiempo para pensar.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Casa 1800 -->
      <section id="casa-1800" class="night" aria-labelledby="ca-title">
        <div class="wrap section">
          <p class="label label-night" data-reveal>02 · Casa 1800</p>
          <h2 id="ca-title" class="h2 h2-wide" data-reveal>Con estos números, crecer es afinar cada día.</h2>
          <dl class="stats stats-3" data-reveal>
            {datos.map((d) => (
              <div>
                <dt>{d.k}</dt>
                <dd><b>{d.n}</b><span>{d.s}</span></dd>
              </div>
            ))}
          </dl>
          <p class="stats-src" data-reveal>Datos que compartiste en la mesa.</p>
          <div class="split split-tight">
            <span></span>
            <div>
              <p class="prose-line prose-night" data-reveal>Y con casi todo el cliente de fuera, la antelación pesa. Contaste que, con la situación geopolítica, hay clientes que reservaban con 60 días y ahora reservan con siete.</p>
              <figure class="lead" data-reveal aria-label="La antelación de reserva pasa de 60 días a 7">
                <div class="lead-axis">
                  <span class="lead-bar"></span>
                  <span class="lead-mark lead-before" style="--x:100%"><b>60 días</b><i>antes</i></span>
                  <span class="lead-mark lead-after" style="--x:11.6%"><b>7 días</b><i>ahora</i></span>
                </div>
                <figcaption>Días entre la reserva y la llegada.</figcaption>
              </figure>
              <p class="prose-line prose-night" data-reveal>Reaccionar a ese cambio a tiempo depende de que el dato de antelación llegue limpio y el mismo día a quien decide.</p>
            </div>
          </div>
          <p class="huge" data-reveal>De 60 días a 7.</p>
        </div>
      </section>

      <!-- Datos -->
      <section id="datos" class="section wrap" aria-labelledby="da-title">
        <div class="split">
          <p class="label" data-reveal>03 · Los pasos correctos</p>
          <div>
            <h2 id="da-title" class="h2" data-reveal>Ni a lo loco ni todo vale.</h2>
            <p class="lede" data-reveal>Cuando Francisca te preguntó qué hacéis con el dato, no empezaste por las herramientas. Empezaste por las condiciones.</p>
            <ol class="filter" data-reveal>
              {filtro.map((f, i) => (
                <li class:list={{ "filter-last": i === filtro.length - 1 }}>
                  <span class="n">{pad(i + 1)}</span>
                  <div>
                    <p class="filter-q">{f.q}</p>
                    <p class="filter-d">{f.d}</p>
                  </div>
                </li>
              ))}
            </ol>
            <figure class="hub" data-reveal aria-label="La herramienta interna conecta el PMS y el RMS para que todos los departamentos vean lo mismo">
              <div class="hub-row">
                <span class="hub-n">PMS</span>
                <i class="hub-c" aria-hidden="true"></i>
                <span class="hub-n hub-core">Herramienta interna</span>
                <i class="hub-c" aria-hidden="true"></i>
                <span class="hub-n">RMS</span>
              </div>
              <ul class="hub-deps">
                <li>Recepción</li><li>Revenue</li><li>Marketing</li><li>Dirección</li>
              </ul>
              <figcaption>Lo que estáis construyendo, simplificado: todo el negocio a la vista y no cada departamento por su lado.</figcaption>
            </figure>
            <p class="prose-line prose-ink" data-reveal>Es justo el orden correcto. Y es también donde suele haber más trabajo invisible: decidir qué significa cada dato antes de conectarlo.</p>
          </div>
        </div>
      </section>

      <!-- Radiografía -->
      <section id="radiografia" class="panel" aria-labelledby="rd-title">
        <div class="wrap section">
          <div class="split">
            <p class="label label-accent" data-reveal>04 · Radiografía Digital</p>
            <div>
              <h2 id="rd-title" class="h2" data-reveal>El mapa que vuestra herramienta interna necesita.</h2>
              <p class="lede" data-reveal>Una Radiografía Digital no evalúa proveedores ni propone una plataforma. Sigue los datos reales de un hotel a través de los sistemas y las personas que los tocan.</p>
              <ol class="steps" data-reveal>{pasos.map((p, i) => <li><span class="n">{pad(i + 1)}</span>{p}</li>)}</ol>
              <p class="prose-line" data-reveal>El resultado no es una lista de ideas. Es saber qué dato está bien, cuál está mal mapeado y cuál está duplicado, con las definiciones comunes que necesita cualquier integración posterior.</p>
              <p class="prose-line" data-reveal>En una cadena de cuatro hoteles en Menorca, la dirección declaraba unas 25 herramientas. Encontramos 47, y un 23 % del gasto en SaaS que se podía recortar. <a class="inline-link" href="/es/portfolio/radiografia-cadena-hotelera-menorca/" data-cta="case">Ver el caso</a></p>
              <ul class="nots" data-reveal>
                <li>No sustituimos vuestra herramienta interna: le damos el mapa.</li>
                <li>No vendemos un PMS ni un RMS.</li>
                <li>No tenemos una plataforma que colocar.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Propuesta -->
      <section id="propuesta" class="section wrap" aria-labelledby="pr-title">
        <div class="split">
          <p class="label label-accent" data-reveal>Una idea concreta</p>
          <div>
            <h2 id="pr-title" class="h2 h2-pair" data-reveal><span>No empecemos por todos los datos.</span><span class="h2-accent">Empecemos por uno.</span></h2>
            <p class="lede" data-reveal>La antelación por mercado, en un hotel. La seguimos del PMS al RMS y a los informes, y comprobamos que llega igual, a tiempo y con el mismo nombre a todos los que deciden.</p>
            <p class="prose-line" data-reveal>Lo haríamos contigo y con quien esté desarrollando la herramienta interna, para que el resultado entre directamente en ella.</p>
            <p class="worth" data-reveal>¿Llega el mismo dato a recepción, revenue y dirección?</p>
          </div>
        </div>
      </section>

      <!-- Cierre -->
      <section id="cierre" class="closing wrap" aria-labelledby="ci-title">
        <p class="cl-1" data-reveal>Primero, los pasos correctos.</p>
        <h2 id="ci-title" class="cl-big" data-reveal>Después, la IA.</h2>
        <p class="cl-3" data-reveal>Ese es el trabajo que me gustaría enseñarte, a ti o a quien lleve la herramienta interna en Casa 1800.</p>
      </section>

      <!-- CTA -->
      <section id="hablar" class="cta" aria-labelledby="cta-title">
        <div class="wrap section">
          <h2 id="cta-title" class="h2 cta-title" data-reveal>Si te parece una conversación útil, seguimos.</h2>
          <p class="cta-copy" data-reveal>En 20 minutos puedo enseñarte cómo hacemos una Radiografía Digital y un ejemplo real en una cadena hotelera.</p>
          <div class="cta-row" data-reveal>
            <div class="buttons">
              <a class="button" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="final" data-cta-event="click_contact">Hablar con Luiz <span aria-hidden="true">↗</span></a>
              <a class="button button-ghost" href={INTRO_HREF} target="_blank" rel="noopener" data-cta="intro" data-cta-event="click_introduction">Presentarme a la persona adecuada <span aria-hidden="true">↗</span></a>
            </div>
            <div class="signature">
              <p class="signature-name">Luiz Brazão</p>
              <p class="signature-role">Founder, IA Operators</p>
              <a class="signature-site" href="https://iaoperators.com/es/" data-cta="site">iaoperators.com</a>
            </div>
          </div>
        </div>
      </section>
    </main>


    <footer class="foot">
      <div class="wrap foot-inner">
        <span class="foot-brand"><img src="/brand/ia-operators-logo.png" alt="IA Operators" width="453" height="82" loading="lazy" /></span>
        <a href="/es/auditoria-de-sistemas/">Radiografía Digital</a>
        <a href="https://iaoperators.com/es/">iaoperators.com</a>
      </div>
    </footer>

    <div class="consent" data-consent hidden role="region" aria-label="Cookies">
      <p>Usamos cookies para medir y mejorar la experiencia. Puedes aceptar o rechazar. <a href="/es/politica-de-privacidad/">Política de Privacidad</a>.</p>
      <div class="consent-actions">
        <button type="button" data-consent-reject>Rechazar</button>
        <button type="button" class="consent-accept" data-consent-accept>Aceptar</button>
      </div>
    </div>

    <script>
      import { initProspectLanding } from "../../scripts/prospect-landing";
      initProspectLanding({ landing: "elisabeth", gtmId: document.body.dataset.gtm ?? "", videoTitle: "elisabeth_luiz", scrollMarks: [50, 90] });
    </script>

    <style is:global>
      @font-face {
        font-family: "Manrope JG";
        src: url("/fonts/manrope-latin-variable.woff2") format("woff2");
        font-weight: 200 800;
        font-display: swap;
      }
      :root {
        --paper: #f6f5f1;
        --panel: #ecebe5;
        --ink: #15171a;
        --text: #2c2f33;
        --muted: #62666b;
        --soft: #9a9da1;
        --line: #dfded8;
        --line-strong: #c3c2bb;
        --slate: #24425a;
        --slate-soft: #9fb2c1;
        --orange: #f16532;
        --orange-ink: #b4441a;
        --night: #121417;
        --night-text: #f1f1ee;
        --night-line: #2b2f34;
        --gutter: 20px;
        --ease: cubic-bezier(.2, .7, .2, 1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 72px; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Manrope JG", "Helvetica Neue", Arial, sans-serif; font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums; }
      h1, h2, h3, p, ol, ul, dl, dd, figure, blockquote { margin: 0; }
      ol, ul { padding: 0; list-style: none; }
      a { color: inherit; text-decoration: none; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
      .wrap { width: 100%; max-width: 1240px; margin-inline: auto; padding-inline: var(--gutter); }
      .label { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .label::before { content: ""; width: 7px; height: 7px; background: var(--slate); }
      .label-accent::before { background: var(--orange); }
      .label-night { color: #9a9ea3; }
      .label-night::before { background: var(--slate-soft); }
      .muted { color: var(--soft); }

      /* Cabecera */
      .top { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid transparent; transition: background-color .3s ease, border-color .3s ease; }
      .top.is-scrolled { background: rgba(246, 245, 241, .9); border-bottom-color: var(--line); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
      .top-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 60px; }
      .wordmark img { display: block; width: auto; height: 22px; }
      .foot-brand img { display: block; width: auto; height: 18px; }
      .top-nav { display: flex; align-items: center; gap: 22px; font-size: 13px; }
      .top-link { display: none; color: var(--muted); }
      .top-link:hover { color: var(--ink); }
      .top-cta { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; background: var(--slate); color: var(--night-text); font-weight: 600; white-space: nowrap; transition: background-color .2s ease; }
      .top-cta:hover { background: var(--ink); }

      /* Hero */
      .hero { padding-top: 18px; padding-bottom: 72px; }
      .greeting { margin-top: 14px; max-width: 24em; font-size: clamp(19px, 2.2vw, 28px); font-weight: 500; letter-spacing: -.028em; line-height: 1.28; color: var(--text); }
      .greeting b { font-weight: 700; color: var(--slate); }
      .big { display: grid; gap: 2px; margin-top: 18px; max-width: 13em; font-size: clamp(34px, 6.6vw, 94px); font-weight: 500; letter-spacing: -.058em; line-height: 1; color: var(--soft); }
      .big span { color: var(--ink); }
      .hero-grid { display: grid; gap: 28px; margin-top: 28px; }
      .hero-copy { display: grid; gap: 10px; align-content: start; color: var(--muted); }
      .hero-copy p { max-width: 32em; }
      .hero-strong { margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--line-strong); font-size: clamp(20px, 2vw, 25px); font-weight: 500; letter-spacing: -.03em; line-height: 1.28; color: var(--ink); }

      /* Secciones */
      .section { padding-block: 88px; }
      .panel { background: var(--panel); }
      .night { background: var(--night); color: var(--night-text); }
      .split { display: grid; gap: 18px; }
      .split > .label { align-self: start; padding-top: 10px; }
      .split-tight { margin-top: 40px; }
      .h2 { margin-top: 0; font-size: clamp(30px, 4.4vw, 58px); font-weight: 500; letter-spacing: -.05em; line-height: 1.07; max-width: 15em; }
      section > .wrap > .h2, .section > .h2 { margin-top: 16px; }
      .h2-wide { max-width: 19em; }
      .h2-pair { display: grid; gap: 4px; }
      .h2-accent { color: var(--orange-ink); }
      .lede { margin-top: 20px; max-width: 30em; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.45; letter-spacing: -.018em; color: var(--text); }
      .prose-line { margin-top: 22px; max-width: 36em; color: var(--muted); }
      .prose-ink { color: var(--text); font-size: 18px; }
      .prose-night { color: #b9bcc0; }
      .statement { display: grid; gap: 2px; margin-top: 40px; font-size: clamp(25px, 3.2vw, 42px); font-weight: 500; letter-spacing: -.045em; line-height: 1.12; max-width: 17em; }
      .statement::before { content: ""; display: block; width: 40px; height: 3px; margin-bottom: 16px; background: var(--orange); }
      .huge { margin-top: 72px; font-size: clamp(36px, 7vw, 100px); font-weight: 500; letter-spacing: -.062em; line-height: 1; max-width: 12em; }
      .n { flex: 0 0 26px; font-size: 12px; font-weight: 650; color: var(--soft); }

      /* Filtro */
      .filter { margin-top: 36px; border-top: 1px solid var(--ink); }
      .filter li { display: flex; gap: 14px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); }
      .filter-q { font-size: clamp(21px, 2.3vw, 30px); font-weight: 500; letter-spacing: -.035em; line-height: 1.18; }
      .filter-d { margin-top: 4px; max-width: 36em; font-size: 16px; color: var(--muted); }
      .filter-last .n { color: var(--orange); }
      .filter-last .filter-q { color: var(--slate); }

      /* Casa 1800 */
      .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 44px; background: var(--night-line); border: 1px solid var(--night-line); }
      .stats div { padding: 18px 14px; background: var(--night); }
      .stats dt { font-size: 11px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: #9a9ea3; }
      .stats dd b { display: block; margin-top: 6px; font-size: clamp(40px, 6vw, 76px); font-weight: 500; letter-spacing: -.06em; line-height: 1; color: var(--night-text); }
      .stats dd span { display: block; margin-top: 8px; font-size: 13px; color: #9a9ea3; }
      .quote blockquote { font-size: clamp(21px, 2.3vw, 29px); font-weight: 400; letter-spacing: -.03em; line-height: 1.3; max-width: 24em; }
      .quote figcaption { margin-top: 10px; font-size: 13px; color: #9a9ea3; }
      .night .huge { color: var(--night-text); }

      /* Radiografía */
      .steps { margin-top: 28px; border-top: 1px solid var(--line-strong); }
      .steps li { display: flex; gap: 14px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line-strong); font-size: clamp(18px, 1.7vw, 21px); letter-spacing: -.02em; }
      .nots { margin-top: 28px; }
      .nots li { padding: 8px 0; font-size: 16px; color: var(--muted); }
      .nots li::before { content: "·"; margin-right: 10px; color: var(--slate); font-weight: 700; }

      /* Propuesta */
      .worth { margin-top: 10px; font-size: clamp(38px, 6.6vw, 90px); font-weight: 500; letter-spacing: -.06em; line-height: 1; color: var(--orange-ink); }

      /* Antes y ahora */
      .ba { display: grid; gap: 12px; margin-top: 36px; }
      .ba-col { padding: 18px; border: 1px solid var(--line-strong); border-radius: 14px; background: var(--paper); }
      .ba-now { border-color: var(--slate); background: #eef1f3; }
      .ba-k { margin-bottom: 10px; font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .ba-now .ba-k { color: var(--slate); }
      .ba ol { display: grid; gap: 8px; counter-reset: s; }
      .ba li { position: relative; padding-left: 26px; font-size: 16px; line-height: 1.35; counter-increment: s; }
      .ba li::before { content: counter(s); position: absolute; left: 0; top: 1px; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; font-size: 10px; font-weight: 700; background: var(--line); color: var(--muted); }
      .ba-now li::before { background: var(--slate); color: var(--night-text); }
      .ba-col:not(.ba-now) li { color: var(--muted); }
      .ba figcaption { font-size: 13px; color: var(--soft); }

      /* Antelación */
      .stats-3 { grid-template-columns: 1fr; }
      .stats-src { margin-top: 12px; font-size: 13px; color: #7d8187; }
      .lead { margin-top: 32px; max-width: 560px; }
      .lead-axis { position: relative; height: 74px; }
      .lead-bar { position: absolute; left: 0; right: 0; top: 63px; height: 2px; background: var(--night-line); }
      .lead-bar::after { content: ""; position: absolute; left: 11.6%; right: 0; top: 0; bottom: 0; background: linear-gradient(90deg, var(--orange), rgba(241, 101, 50, .2)); }
      .lead-mark { position: absolute; left: var(--x); top: 0; transform: translateX(-50%); display: grid; justify-items: center; gap: 2px; }
      .lead-before { transform: translateX(-100%); justify-items: end; }
      .lead-mark b { font-size: 18px; font-weight: 600; color: var(--night-text); white-space: nowrap; }
      .lead-mark i { font-style: normal; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #9a9ea3; }
      .lead-mark::after { content: ""; width: 12px; height: 12px; margin-top: 6px; border-radius: 50%; background: var(--night); border: 2px solid var(--slate-soft); }
      .lead-after::after { background: var(--orange); border-color: var(--orange); box-shadow: 0 0 0 4px rgba(241, 101, 50, .2); }
      .lead figcaption { margin-top: 10px; font-size: 13px; color: #7d8187; }

      /* Hub */
      .hub { margin-top: 40px; padding: 20px; border: 1px solid var(--line-strong); border-radius: 16px; background: var(--paper); }
      .hub-row { display: grid; grid-template-columns: auto 1fr auto 1fr auto; align-items: center; gap: 6px; }
      .hub-n { padding: 10px 12px; border: 1px solid var(--slate); border-radius: 10px; font-size: 14px; font-weight: 600; color: var(--slate); text-align: center; }
      .hub-core { border-color: var(--orange); background: rgba(241, 101, 50, .08); color: var(--orange-ink); }
      .hub-c { height: 2px; background: var(--orange); }
      .hub-deps { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-top: 16px; padding-top: 14px; border-top: 1px dashed var(--line-strong); }
      .hub-deps li { padding: 5px 10px; border-radius: 999px; background: var(--panel); font-size: 13px; color: var(--text); }
      .hub figcaption { margin-top: 12px; font-size: 13px; color: var(--soft); text-align: center; }

      /* Cierre */
      .closing { padding-block: 120px 128px; }
      .cl-1 { font-size: clamp(28px, 3.6vw, 48px); font-weight: 500; letter-spacing: -.045em; color: var(--soft); }
      .cl-big { margin-top: 10px; max-width: 10em; font-size: clamp(52px, 11vw, 160px); font-weight: 500; letter-spacing: -.07em; line-height: .95; }
      .cl-3 { margin-top: 56px; max-width: 30em; font-size: clamp(19px, 1.8vw, 23px); letter-spacing: -.02em; color: var(--text); }

      /* CTA */
      .cta { border-top: 1px solid var(--line); }
      .cta-title { max-width: 14em; }
      .cta-copy { margin-top: 20px; max-width: 32em; font-size: 18px; color: var(--muted); }
      .cta-row { display: grid; gap: 36px; margin-top: 40px; }
      .buttons { display: grid; gap: 10px; justify-items: start; }
      .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 56px; padding: 0 24px; background: var(--slate); color: var(--night-text); font-size: 16px; font-weight: 600; transition: background-color .2s ease, color .2s ease; }
      .button:hover { background: var(--ink); }
      .button-ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
      .button-ghost:hover { background: var(--ink); color: var(--paper); }
      .signature { padding-top: 18px; border-top: 1px solid var(--line); max-width: 280px; }
      .signature-name { font-size: 18px; font-weight: 650; letter-spacing: -.02em; }
      .signature-role { font-size: 14px; color: var(--muted); }
      .signature-site { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--slate); }

      /* Pie y consentimiento */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding-block: 26px 30px; font-size: 13px; color: var(--muted); }
      .foot-brand { margin-right: auto; }
      .foot a:hover { color: var(--ink); }
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; background: var(--night); color: var(--night-text); font-size: 13px; line-height: 1.5; border: 1px solid #3a3d42; box-shadow: 0 10px 30px rgba(0, 0, 0, .18); }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; }
      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 38px; padding: 0 16px; border: 1px solid #3a3d42; background: transparent; color: var(--night-text); font: inherit; cursor: pointer; }
      .consent .consent-accept { background: var(--night-text); color: var(--night); border-color: var(--night-text); }

      /* Movimiento */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }

      .js .ba-now li { opacity: .2; transition: opacity .45s ease calc(.4s + var(--i) * 200ms); }
      .js .ba.is-in .ba-now li { opacity: 1; }
      .js .lead .lead-after { opacity: 0; transition: opacity .5s ease .9s; }
      .js .lead .lead-bar::after { transform: scaleX(0); transform-origin: right; transition: transform 1s var(--ease) .3s; }
      .js .lead.is-in .lead-after { opacity: 1; }
      .js .lead.is-in .lead-bar::after { transform: none; }

      @media (min-width: 420px) {
        .top-link { display: inline; }
      }
      .top-nav .top-link-x { display: none; }
      @media (min-width: 900px) {
        .top-nav .top-link-x { display: inline; }
      }
      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .ba { grid-template-columns: 1fr 1fr; }
        .ba figcaption { grid-column: 1 / -1; }
        .stats-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .hub-n { font-size: 15px; padding: 12px 16px; }
        .stats:not(.stats-3) { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .stats div { padding: 22px 18px; }
        .cta-row { grid-template-columns: auto 1fr; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }
      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 40px; padding-bottom: 116px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 52px; align-items: start; }
        .section { padding-block: 128px; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .closing { padding-block: 180px 190px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .ba-now li, .js .lead .lead-after { opacity: 1; transition: none; }
        .js .lead .lead-bar::after { transform: none; transition: none; }
        .top, .button, .top-cta { transition: none; }
      }
      .inline-link { color: var(--slate); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
      .inline-link:hover { color: var(--ink); }
    </style>
  </body>
</html>
