      .prose-line { margin-top: 22px; max-width: 36em; color: var(--muted); }
      .prose-ink { color: var(--text); font-size: 18px; }
      .statement { display: grid; gap: 2px; margin-top: 44px; font-size: clamp(25px, 3.2vw, 42px); font-weight: 500; letter-spacing: -.045em; line-height: 1.12; max-width: 17em; }
