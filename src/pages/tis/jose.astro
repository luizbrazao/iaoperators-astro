    <style is:global>
      @font-face {
        font-family: "Manrope Jose";
        src: url("/fonts/manrope-latin-variable.woff2") format("woff2");
        font-weight: 200 800;
        font-display: swap;
      }
      :root {
        --paper: #faf8f4;
        --sand: #f3eee6;
