      .mult { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; margin-top: 40px; font-size: clamp(24px, 3.4vw, 44px); font-weight: 500; letter-spacing: -.04em; line-height: 1.15; }
