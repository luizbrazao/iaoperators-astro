      .free { margin-top: 14px; max-width: 12em; font-size: clamp(34px, 7vw, 100px); font-weight: 500; letter-spacing: -.058em; line-height: 1; color: var(--wine); }
      .free-num { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 .28em; max-width: none; font-variant-numeric: tabular-nums; }
