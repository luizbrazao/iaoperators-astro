---
import PresenterVideo from "../../components/PresenterVideo.astro";
// Landing personalizada para José Rodríguez Pousa, CEO de Sercotel Hotel Group.
// Se llega por el QR de una tarjeta entregada en mano. Privada: noindex,nofollow
// y fuera del sitemap ("/tis/" en NOINDEX_PATHS).
//
// Concepto: la tecnología como medio para liberar a las personas de trabajo que
// no necesita ser humano. Con 100 hoteles y el objetivo de superar los 160, la
// pregunta es qué trabajo merece desaparecer primero. La Radiografía Digital se
// presenta como paso previo y complementario a OpenStay Lab, nunca como
// alternativa. El cierre pide una introducción, no una compra.
//
// Lenguaje visual: la "jornada" (trabajo repetitivo rayado que se libera) y la
// red (100 hoteles llenos + 60 por llegar). Burdeos para lo humano; el naranja
// de marca solo para la fricción.
//
// Datos públicos usados (verificados el 04/10/2026):
//   - Sercotel, 06/2026: 100 hoteles; plan 2026–2029 con cuatro pilares
//     (crecimiento, tecnología, talento, experiencia de cliente); más de 160
//     hoteles en 2029.
//   - Sercotel/TecnoHotel: OpenStay Lab con SEIDOR, pilotos de startups en
//     hoteles reales, Demo Day; Hub de Innovación con SEIDOR.
//   - Ara, 04/06/2026: la IA no es para reducir costes ni personal.
// La idea de la IA asumiendo facturación, check-in administrativo y datos para
// dejar a las personas lo que requiere criterio y empatía la aporta Luiz; no se
// cita literalmente.
//
// Revisión 07/10/2026, después de la sesión "CapEx or TechEx?" de TIS
// (06/10/2026, con Juan Carlos Sanjuán, de Casual, y Jairo González, de Petit
// Palace). Solo se usa lo que con seguridad dijo José según la transcripción,
// parafraseado (la transcripción automática es imprecisa):
//   - Recomendación sobre IA: plan global, nada de inventos ni de amigos que
//     vienen a inventarte cosas, inversiones "a performance". Tienen bastantes
//     agentes de IA; cotizar grupos en 3 horas en lugar de 47, encadenando tres
//     agentes, es una inversión que se hace. "Si no, lo demás, ya veremos."
//   - Viene del mundo industrial: allí la clave es la fábrica (un 1 % de
//     desviación en sus costes puede llevar a números rojos). En hotelería la
//     clave es la primera línea: web, CMS, CRM, channel manager y RMS. Best of
//     suite o best of breed; en el segundo el problema es la integración, y la
//     diferencia entre integraciones bien y mal hechas es "abismal".
//   - Segunda línea: recursos humanos (el personal ronda el 35 % de la cuenta).
//     Después, P2P. Implementar, conectar y crecer a la vez es dificilísimo,
//     "pero se hace".
// La cifra de ahorro del P2P no se usa: la transcripción no es fiable ahí.
//
// Comportamiento compartido en src/scripts/prospect-landing.ts.

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  // Vídeo de Luiz con fondo blanco, fundido con la página (PresenterVideo).
  src: "/video/luiz-tis.mp4",
  poster: "/video/luiz-tis-poster.jpg",
  type: "video/mp4",
  orientation: "horizontal" as "horizontal" | "vertical",
  duracion: "1 min 24 s",
};

const wa = (t: string) => `https://wa.me/34662423523?text=${encodeURIComponent(t)}`;
// Contacto directo con Luiz.
const CONTACT_HREF = wa("Hola Luiz, soy José Rodríguez, de Sercotel. He visto la página que preparaste después de TIS y me gustaría hablarlo.");
// Introducción: José presenta a la persona adecuada.
const INTRO_HREF = wa("Hola Luiz, soy José Rodríguez, de Sercotel. Te pongo en contacto con la persona que debería ver la Radiografía Digital: ");
// Caso público de referencia (sin nombre de cliente).
const CASE_HREF = "/es/portfolio/radiografia-cadena-hotelera-menorca/";
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/jose/", site).toString();
const ogImage = new URL("/og/jose.png", site).toString();
const title = "José Rodríguez × IA Operators | Radiografía Digital";
const description = "Después de «CapEx or TechEx?» en TIS: dónde está la próxima inversión a performance. Una reflexión preparada por IA Operators para José Rodríguez y Sercotel.";

const pad = (n: number) => String(n).padStart(2, "0");

// Prioridades tecnológicas tal y como las ordenó José en la mesa.
const lineas = [
  {
    k: "Primera línea",
    t: "La que tienes que tener «súper controlada».",
    tags: ["web", "CMS", "CRM", "channel manager", "RMS"],
    d: "Si eliges el mejor de cada vertical, el problema está en la integración.",
    main: true,
  },
  { k: "Segunda línea", t: "Recursos humanos.", tags: [], d: "Porque el personal ronda el 35 % de la cuenta de resultados.", main: false },
  { k: "Después", t: "P2P.", tags: [], d: "Compras, donde una cadena grande se juega un ahorro de costes muy relevante.", main: false },
];
const costuras = [
  "datos que alguien vuelve a introducir en otro sistema",
  "conciliaciones hechas a mano",
  "información que llega tarde a recepción, revenue o a la central",
  "excepciones que acaban siempre en la misma persona",
];

const candidatas = [
  "Facturación", "Administración", "Transferencia de información", "Validaciones", "Reporting",
  "Comunicación interna", "Procesos entre departamentos", "Gestión de excepciones", "Datos que alguien vuelve a introducir",
];
const variables = ["frecuencia", "impacto", "coste", "riesgo", "complejidad"];

const factores = ["1 tarea", "varios hoteles", "varios empleados", "365 días"];

const lab = ["llevar soluciones al entorno real", "medir resultados", "validar su viabilidad", "decidir qué merece avanzar"];
const resolver = ["procesos", "integraciones", "automatización", "IA", "tecnología existente", "nueva tecnología"];

const flujo = [
  { t: "Operación", g: "rx" }, { t: "Fricción", g: "rx" }, { t: "Impacto", g: "rx" }, { t: "Prioridad", g: "rx" },
  { t: "Solución", g: "lab" }, { t: "Piloto", g: "lab" }, { t: "Escala", g: "lab" },
];

const observamos = [
  "cómo empieza una tarea",
  "qué información utiliza",
  "qué sistemas intervienen",
  "a quién se transfiere",
  "dónde espera",
  "qué excepciones aparecen",
  "qué parte depende de trabajo manual",
];
const patrones = ["Repetición", "Transferencia", "Espera", "Inconsistencia"];
const areas = ["Captación", "Atención", "Operación", "Gestión"];

// Jornada conceptual: tramos repetitivos (se liberan) y tramos humanos.
const jornada = [
  { t: "copiar datos", r: true, w: 9 },
  { t: "atender", r: false, w: 12 },
  { t: "rellenar sistemas", r: true, w: 11 },
  { t: "preparar informes", r: true, w: 10 },
  { t: "coordinar", r: false, w: 9 },
  { t: "transferir información", r: true, w: 12 },
  { t: "buscar documentos", r: true, w: 8 },
  { t: "decidir", r: false, w: 8 },
  { t: "validaciones repetitivas", r: true, w: 13 },
  { t: "resolver", r: false, w: 8 },
];
const elimina = ["copiar datos", "rellenar sistemas", "preparar informes", "transferir información", "buscar documentos", "realizar validaciones repetitivas"];
const libera = ["resolver una excepción", "hablar con el huésped", "tomar una decisión", "coordinar al equipo", "mejorar la experiencia"];
const humano = ["contexto", "criterio", "empatía", "negociación", "sensibilidad", "experiencia"];

const seleccion = [
  "aparezca en varios hoteles",
  "implique trabajo manual",
  "tenga una frecuencia significativa",
  "o atraviese varios sistemas o departamentos",
];
const piloto = [
  { t: "1 proceso", opt: false }, { t: "1–3 hoteles", opt: false }, { t: "Radiografía", opt: false },
  { t: "Hipótesis", opt: false }, { t: "Impacto", opt: false }, { t: "Decisión", opt: false },
  { t: "Piloto", opt: true }, { t: "Escala", opt: true },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="La tecnología debería liberar a las personas. ¿Qué trabajo merece desaparecer primero? Una reflexión para José Rodríguez." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f5f1ea" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header" data-cta-event="click_contact">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="label">Después de «CapEx or TechEx?» · TIS 2026</p>
        <h1 id="hero-title" class="greeting">José, en TIS tu recomendación sobre IA fue clara: plan global, nada de inventos e inversiones a performance.</h1>
        <p class="free free-num" aria-label="De 47 horas a 3 horas"><span class="was">47 h</span><span class="to" aria-hidden="true">→</span><span>3 h</span></p>
        <p class="first-q">Esa es la vara de medir. La cuestión es: entre 100 hoteles, <span>¿dónde está la próxima?</span></p>

        <div class="hero-grid">
          <PresenterVideo src={VIDEO.src} poster={VIDEO.poster} label="Vídeo de Luiz Brazão para José Rodríguez" duracion={VIDEO.duracion} />

          <div class="hero-copy">
            <p>Contaste que en Sercotel tenéis bastantes agentes de IA, pero que cada uno está ahí porque tiene un performance concreto: cotizar grupos en tres horas en lugar de 47, encadenando tres agentes. Si no, lo demás, ya veremos.</p>
            <p>Coincido. Antes de encadenar ningún agente hay que saber dónde está el siguiente proceso de 47 horas.</p>
            <p class="hero-strong">Y que lo que se automatice sea trabajo que no necesita ser humano, no criterio, empatía o sentido común.</p>
          </div>
        </div>
      </section>

      <!-- Primera línea -->
      <section id="primera-linea" class="section wrap" aria-labelledby="pl-title">
        <div class="split">
          <p class="label label-orange" data-reveal>(01) Primera línea</p>
          <div>
            <h2 id="pl-title" class="h2 h2-pair" data-reveal><span>En la industria, la clave es la fábrica.</span><span class="h2-wine">En hotelería, la primera línea.</span></h2>
            <p class="lede" data-reveal>Lo explicaste desde tu experiencia en el mundo industrial: si los costes de la fábrica se desvían un 1 %, toda la compañía puede entrar en números rojos. En un hotel, dijiste, todo se juega en primera línea.</p>
            <ol class="tiers" data-reveal>
              {lineas.map((l) => (
                <li class:list={{ "tier-main": l.main }}>
                  <span class="tier-k">{l.k}</span>
                  <div>
                    <p class="tier-t">{l.t}</p>
                    {l.tags.length > 0 && <ul class="tags">{l.tags.map((t) => <li>{t}</li>)}</ul>}
                    <p class="tier-d">{l.d}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="statement" data-reveal>
              <span class="muted">Entre una integración bien hecha y una mal hecha,</span>
              <span>la diferencia es abismal.</span>
            </p>
            <p class="prose-line" data-reveal>Ahí está buena parte de lo que busca una Radiografía Digital. Rara vez la fricción está dentro de un sistema; suele estar en las costuras entre ellos:</p>
            <ul class="obs" data-reveal>{costuras.map((c) => <li>{c}</li>)}</ul>
          </div>
        </div>
      </section>

      <!-- Priorizar -->
      <section id="priorizar" class="section wrap" aria-labelledby="pr-title">
        <div class="split">
          <p class="label" data-reveal>(02) Priorizar</p>
          <div>
            <h2 id="pr-title" class="h2 h2-pair" data-reveal><span>Automatizar es fácil de decir.</span><span class="h2-wine">Priorizar es más difícil.</span></h2>
            <p class="lede" data-reveal>En una operación de esta escala pueden existir cientos de oportunidades potenciales.</p>
            <ul class="cands" data-reveal>{candidatas.map((c) => <li>{c}</li>)}</ul>
            <p class="prose-line" data-reveal>Pero cada una tiene una</p>
            <ul class="vars" data-reveal>{variables.map((v) => <li><span>{v}</span> <em>distinta</em></li>)}</ul>
            <p class="statement" data-reveal>
              <span class="muted">No necesitamos encontrar más cosas automatizables.</span>
              <span>Necesitamos saber cuáles merecen atención primero.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Escala de la red -->
      <section id="red" class="sand" aria-labelledby="red-title">
        <div class="wrap section">
          <p class="label" data-reveal>(03) Sercotel</p>
          <h2 id="red-title" class="h2 h2-wide" data-reveal>Cuando el modelo llega a 100 hoteles, una pequeña fricción deja de ser pequeña.</h2>
          <div class="mult" data-reveal>
            {factores.map((f, i) => (
              <>
                {i > 0 && <span class="mult-op" aria-hidden="true">×</span>}
                <span class="mult-t">{f}</span>
              </>
            ))}
            <span class="mult-op" aria-hidden="true">=</span>
            <span class="mult-r">impacto operativo</span>
          </div>
          <div class="split split-tight">
            <span></span>
            <div>
              <p class="prose-line prose-ink" data-reveal>Una tarea de dos minutos puede no justificar ningún proyecto en un hotel.</p>
              <p class="prose-line prose-ink" data-reveal>La misma tarea, repetida miles de veces dentro de una red, puede convertirse en otra cosa.</p>
            </div>
          </div>
          <p class="huge" data-reveal>La escala cambia la prioridad.</p>
        </div>
      </section>

      <!-- OpenStay Lab -->
      <section id="openstay" class="section wrap" aria-labelledby="os-title">
        <div class="split">
          <p class="label" data-reveal>(04) OpenStay Lab</p>
          <div>
            <h2 id="os-title" class="h2" data-reveal>Sercotel ya sabe probar tecnología.</h2>
            <p class="lede" data-reveal>OpenStay Lab parte de una lógica especialmente interesante:</p>
            <ol class="lab" data-reveal>{lab.map((l, i) => <li><span class="n">{pad(i + 1)}</span>{l}</li>)}</ol>
            <p class="prose-line" data-reveal>Encaja con lo que dijiste en TIS: plan global, nada de inventos. Nuestra pregunta está un paso antes.</p>
          </div>
        </div>
        <p class="lab-q" data-reveal>¿Cómo identificamos el problema que merece entrar en el laboratorio?</p>
        <div class="split split-tight">
          <span></span>
          <div>
            <div class="prose" data-reveal>
              <p>Una Radiografía Digital no busca startups ni selecciona plataformas. Busca fricciones operativas: oportunidades concretas que después pueden resolverse mediante</p>
            </div>
            <ul class="tags" data-reveal>{resolver.map((r) => <li>{r}</li>)}<li class="tag-none">o, a veces, ninguna tecnología</li></ul>
          </div>
        </div>
      </section>

      <!-- Antes del piloto -->
      <section id="antes" class="sand" aria-labelledby="an-title">
        <div class="wrap section">
          <p class="label" data-reveal>(05) Antes del piloto</p>
          <h2 id="an-title" class="h2 h2-wide" data-reveal>Antes de probar una solución, necesitamos formular bien el problema.</h2>
          <div class="pipe" data-reveal>
            <ol class="pipe-steps">
              {flujo.map((f, i) => <li class:list={["pipe-step", `pipe-${f.g}`]} style={`--i:${i}`}>{f.t}</li>)}
            </ol>
            <div class="pipe-brackets" aria-hidden="true">
              <span class="br br-rx">Donde puede aportar una Radiografía Digital</span>
              <span class="br br-lab">Donde OpenStay Lab ya trabaja</span>
            </div>
          </div>
          <p class="pipe-note" data-reveal>Dos partes del mismo recorrido. Una ayuda a formular y priorizar el problema; la otra, a validar y escalar la solución.</p>
        </div>
      </section>

      <!-- Radiografía -->
      <section id="radiografia" class="section wrap" aria-labelledby="rd-title">
        <div class="split">
          <p class="label" data-reveal>(06) Radiografía Digital</p>
          <div>
            <h2 id="rd-title" class="h2" data-reveal>Ahí entra la Radiografía Digital.</h2>
            <p class="lede" data-reveal>Seguimos el trabajo antes de hablar de tecnología.</p>
            <p class="prose-line" data-reveal>Hablamos con las personas que ejecutan los procesos y observamos:</p>
            <ul class="obs" data-reveal>{observamos.map((o) => <li>{o}</li>)}</ul>
            <p class="prose-line" data-reveal>Y buscamos cuatro patrones:</p>
            <ul class="pats" data-reveal>{patrones.map((p) => <li>{p}</li>)}</ul>
          </div>
        </div>
        <p class="huge huge-pair" data-reveal><span class="muted">No buscamos IA.</span><span>Buscamos fricción.</span></p>
      </section>

      <!-- 4×4 -->
      <section id="metodo" class="section section-top0 wrap" aria-labelledby="fw-title">
        <div class="split">
          <p class="label" data-reveal>Framework 4×4</p>
          <div>
            <h2 id="fw-title" class="h3" data-reveal>Una metodología sencilla para mirar operaciones complejas.</h2>
            <div class="m44" data-reveal role="table" aria-label="Framework 4×4: cuatro áreas por cuatro patrones">
              <div class="m-row m-head" role="row">
                <span role="columnheader"><span class="sr-only">Área</span></span>
                {patrones.map((s) => <span role="columnheader"><span class="m-full">{s}</span><span class="m-short" aria-hidden="true">{s.charAt(0)}</span></span>)}
              </div>
              {areas.map((a, r) => (
                <div class="m-row" role="row">
                  <span class="m-area" role="rowheader">{a}</span>
                  {patrones.map((s, c) => <span class="m-cell" role="cell" style={`--i:${r * 4 + c}`}><i></i><span class="sr-only">{a} · {s}</span></span>)}
                </div>
              ))}
            </div>
            <p class="m-legend" aria-hidden="true">{patrones.map((s) => <span><b>{s.charAt(0)}</b> {s}</span>)}</p>
          </div>
        </div>
      </section>

      <!-- Personas primero -->
      <section id="personas" class="ink" aria-labelledby="pe-title">
        <div class="wrap section">
          <p class="label label-ink" data-reveal>(07) Personas primero</p>
          <h2 id="pe-title" class="h2 h2-wide" data-reveal>La mejor automatización puede ser la que el huésped nunca ve.</h2>

          <figure class="day" data-reveal aria-label="Jornada conceptual: los tramos de trabajo repetitivo se liberan y queda tiempo para el trabajo humano">
            <p class="day-label">Una jornada, conceptualmente</p>
            <div class="day-bar">
              {jornada.map((j) => <span class:list={["seg", { rep: j.r }]} style={`--w:${j.w}`}><b>{j.t}</b></span>)}
            </div>
            <div class="day-legend"><span><i class="lg-rep"></i>trabajo que no necesita ser humano</span><span><i class="lg-hum"></i>trabajo que sí</span></div>
          </figure>

          <div class="swap">
            <div data-reveal>
              <p class="swap-k">Si una automatización elimina</p>
              <ul class="swap-list swap-off">{elimina.map((e) => <li>{e}</li>)}</ul>
            </div>
            <div data-reveal style="--d:120ms">
              <p class="swap-k">puede liberar tiempo para</p>
              <ul class="swap-list swap-on">{libera.map((l) => <li>{l}</li>)}</ul>
            </div>
          </div>
          <p class="huge huge-pair huge-ink" data-reveal><span class="muted">La tecnología desaparece.</span><span>La hospitalidad permanece.</span></p>
        </div>
      </section>

      <!-- Qué no automatizar -->
      <section id="no-automatizar" class="section wrap" aria-labelledby="na-title">
        <div class="split">
          <p class="label" data-reveal>(08) Límites</p>
          <div>
            <h2 id="na-title" class="h2" data-reveal>También necesitamos saber qué no automatizar.</h2>
            <p class="lede" data-reveal>Una Radiografía Digital no parte de la premisa de que todo proceso manual sea malo.</p>
            <p class="prose-line" data-reveal>Algunas tareas requieren</p>
            <ul class="tags tags-wine" data-reveal>{humano.map((h) => <li>{h}</li>)}</ul>
            <p class="prose-line" data-reveal>Automatizarlas podría empeorar el proceso.</p>
            <p class="statement" data-reveal>
              <span class="muted">El objetivo no es reducir humanos.</span>
              <span>Es reducir trabajo humano que no necesita ser humano.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- 100 → 160 -->
      <section id="escala" class="sand" aria-labelledby="es-title">
        <div class="wrap section">
          <p class="label" data-reveal>(09) Escala</p>
          <h2 id="es-title" class="h2 h2-wide" data-reveal>160 hoteles no deberían significar 60 hoteles más de complejidad.</h2>
          <figure class="net" data-reveal aria-label="Cien hoteles hoy y sesenta más en el objetivo de la red">
            <div class="net-grid">{Array.from({ length: 160 }, (_, i) => <i class:list={{ new: i >= 100 }} style={`--r:${Math.floor(i / 20)}`}></i>)}</div>
            <figcaption class="net-cap"><span><b>100</b> hoy</span><span><b>+60</b> en el plan</span></figcaption>
          </figure>
          <div class="split split-tight">
            <span></span>
            <div>
              <p class="prose-line prose-ink" data-reveal>A medida que una red crece, hay dos caminos.</p>
              <ol class="paths" data-reveal>
                <li><span class="n">A</span>Replicar también las pequeñas fricciones.</li>
                <li><span class="n">B</span>Identificarlas y eliminarlas antes de que escalen.</li>
              </ol>
            </div>
          </div>
          <p class="prose-line prose-ink prose-quote" data-reveal>Lo dijiste en la mesa: implementar, conectar y crecer al mismo tiempo es dificilísimo. Pero se hace.</p>
          <p class="huge" data-reveal>Crecer también es decidir qué no queremos multiplicar.</p>
        </div>
      </section>

      <!-- Propuesta -->
      <section id="propuesta" class="section wrap" aria-labelledby="pp-title">
        <div class="split">
          <p class="label label-orange" data-reveal>Una idea para Sercotel</p>
          <div>
            <h2 id="pp-title" class="h2 h2-pair" data-reveal><span>No propongo auditar 100 hoteles.</span><span class="h2-wine">Propongo encontrar una fricción transversal.</span></h2>
            <p class="prose-line prose-ink" data-reveal>Podríamos elegir, junto al equipo de Operaciones y Tecnología, un proceso que:</p>
            <ul class="obs" data-reveal>{seleccion.map((s) => <li>{s}</li>)}</ul>
            <p class="prose-line" data-reveal>Y hacer una Radiografía limitada a ese proceso para entender, medir y priorizar. Solo después decidiríamos si hay algo que merezca resolverse.</p>
            <p class="prose-line prose-ink" data-reveal>Con una vara de medir como la tuya: horas antes, horas después. O la conclusión, también válida, de que no merece inversión.</p>

            <figure class="pilot" data-reveal aria-label="Modelo piloto conceptual">
