      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
      .wrap { width: 100%; max-width: 1240px; margin-inline: auto; padding-inline: var(--gutter); }
      .label { font-size: 13px; font-weight: 500; letter-spacing: -.005em; color: var(--muted); font-variant-numeric: tabular-nums; }
      .label-ink { color: var(--dark-muted); }
