      .net-grid i { aspect-ratio: 1; border-radius: 2px; background: var(--ink); }
      .net-grid i.new { background: transparent; box-shadow: inset 0 0 0 1px var(--line-strong); }
      .net-cap { display: flex; gap: 28px; margin-top: 14px; font-size: 15px; color: var(--muted); }
      .net-cap b { margin-right: 6px; font-size: clamp(26px, 3vw, 40px); font-weight: 500; letter-spacing: -.04em; color: var(--ink); }
      .net-cap span:last-child b { color: var(--soft); }
      .paths { margin-top: 12px; border-top: 1px solid var(--line-strong); }
      .paths li { display: flex; gap: 14px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line-strong); font-size: clamp(18px, 1.8vw, 22px); letter-spacing: -.02em; }
      .paths li:first-child { color: var(--soft); }

      /* Propuesta y piloto */
      .pilot { margin-top: 40px; }
      .pilot ol { display: grid; gap: 0; }
      .pilot li { position: relative; display: flex; align-items: baseline; gap: 10px; padding: 9px 0 9px 22px; border-left: 2px solid var(--ink); font-size: 18px; font-weight: 500; letter-spacing: -.02em; }
      .pilot li::before { content: ""; position: absolute; left: -6px; top: 50%; width: 10px; height: 10px; margin-top: -5px; border-radius: 50%; background: var(--paper); border: 2px solid var(--ink); }
      .pilot li:nth-child(3)::before { background: var(--orange); border-color: var(--orange); }
      .pilot li.opt { border-left-style: dashed; border-left-color: var(--line-strong); color: var(--muted); }
      .pilot li.opt::before { border-color: var(--line-strong); }
      .pilot small { font-size: 12px; font-weight: 500; color: var(--soft); }
      .pilot figcaption { margin-top: 16px; max-width: 32em; font-size: 15px; color: var(--muted); }

      /* Segunda mirada */
      .nots { margin-top: 22px; border-top: 1px solid var(--line-strong); }
      .nots li { padding: 10px 0; border-bottom: 1px solid var(--line-strong); font-size: clamp(17px, 1.6vw, 20px); color: var(--text); }
      .q-big { margin-top: 8px; font-size: clamp(30px, 4.4vw, 58px); font-weight: 500; letter-spacing: -.05em; line-height: 1.06; color: var(--wine); max-width: 14em; }
      .q-small { margin-top: 12px; font-size: clamp(18px, 1.8vw, 22px); color: var(--text); }
      .proof { margin-top: 48px; padding: 18px 18px 20px; border: 1px solid var(--line-strong); border-radius: 4px; background: var(--paper); max-width: 34em; }
      .proof-k { font-size: 13px; font-weight: 600; color: var(--muted); }
      .proof p:not(.proof-k) { margin-top: 6px; font-size: 16px; color: var(--text); }
      .proof a { display: inline-block; margin-top: 10px; font-size: 15px; font-weight: 600; color: var(--wine); }
      .proof a:hover { text-decoration: underline; }

      /* La persona adecuada */
      .who { display: grid; gap: 6px; font-size: clamp(32px, 5.6vw, 78px); font-weight: 500; letter-spacing: -.058em; line-height: 1.02; max-width: 15em; }

      /* CTA */
      .cta { background: var(--sand); }
      .cta-title { font-size: clamp(40px, 8vw, 116px); font-weight: 500; letter-spacing: -.062em; line-height: .98; color: var(--wine); }
      .cta-copy { margin-top: 22px; max-width: 32em; font-size: 18px; color: var(--text); }
      .cta-row { display: grid; gap: 36px; margin-top: 40px; }
      .buttons { display: grid; gap: 10px; justify-items: start; }
      .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 56px; padding: 0 24px; border-radius: 4px; background: var(--ink); color: var(--paper); font-size: 16px; font-weight: 600; transition: background-color .2s ease, color .2s ease; }
      .button:hover { background: var(--wine); }
      .button-ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
      .button-ghost:hover { background: var(--ink); color: var(--paper); }
      .signature { padding-top: 18px; border-top: 1px solid var(--line-strong); max-width: 280px; }
      .signature-name { font-size: 18px; font-weight: 650; letter-spacing: -.02em; }
      .signature-role { font-size: 14px; color: var(--muted); }
      .signature-site { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--wine); }

      /* Pie y consentimiento */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding-block: 26px 30px; font-size: 13px; color: var(--muted); }
      .foot-brand { margin-right: auto; font-weight: 650; color: var(--ink); letter-spacing: -.02em; }
      .foot a:hover { color: var(--ink); }
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; background: var(--dark); color: var(--dark-text); font-size: 13px; line-height: 1.5; border-radius: 4px; border: 1px solid #4a453e; box-shadow: 0 10px 30px rgba(0, 0, 0, .16); }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; }
      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 38px; padding: 0 16px; border: 1px solid #4a453e; border-radius: 4px; background: transparent; color: var(--dark-text); font: inherit; cursor: pointer; }
      .consent .consent-accept { background: var(--dark-text); color: var(--dark); border-color: var(--dark-text); }

      /* Movimiento discreto */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }
      .js .net-grid i { opacity: 0; transition: opacity .4s ease calc(.15s + var(--r) * 90ms); }
      .js .net.is-in .net-grid i { opacity: 1; }
      .js .m-cell i { background: transparent; box-shadow: inset 0 0 0 1px var(--wine); transition: background-color .3s ease calc(.2s + var(--i) * 40ms); }
      .js .m44.is-in .m-cell i { background: var(--wine); }

      @media (min-width: 420px) {
        .top-link { display: inline; }
      }

      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .tiers > li { grid-template-columns: 150px minmax(0, 1fr); align-items: baseline; gap: 24px; }
        .vars { grid-template-columns: repeat(5, minmax(0, 1fr)); border-bottom: 1px solid var(--line); }
        .vars li { border-bottom: 0; }
        .pipe-steps { grid-template-columns: repeat(7, minmax(0, 1fr)); }
        .pipe-step { padding: 14px 10px 0 0; border-left: 0; border-top: 3px solid var(--line-strong); font-size: 18px; }
        .pipe-rx { border-top-color: var(--orange); }
        .pipe-lab { border-top-color: var(--ink); }
        .pipe-step:not(:last-child)::after { content: "→"; position: absolute; right: 8px; top: 13px; color: var(--soft); font-weight: 400; }
        .pipe-brackets { grid-template-columns: 4fr 3fr; gap: 0; }
        .pipe-brackets .br { padding-top: 10px; }
        .seg b { display: block; }
        .swap { grid-template-columns: 1fr 1fr; gap: 48px; }
        .pats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .m-full { display: inline; }
        .m-short, .m-legend { display: none; }
        .pilot ol { display: flex; flex-wrap: wrap; row-gap: 22px; }
        .pilot li { flex-direction: column; gap: 2px; padding: 22px 22px 0 0; border-left: 0; border-top: 2px solid var(--ink); font-size: 16px; }
        .pilot li::before { left: 0; top: -6px; margin-top: 0; }
        .pilot li.opt { border-top-style: dashed; border-top-color: var(--line-strong); }
        .buttons { grid-auto-flow: column; justify-content: start; }
        .cta-row { grid-template-columns: auto 1fr; align-items: end; gap: 48px; }
        .signature { justify-self: end; min-width: 240px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }

      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 40px; padding-bottom: 116px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 48px; align-items: start; }
        .section { padding-block: 128px; }
        .section-top0 { padding-top: 0; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .huge { margin-top: 88px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .net-grid i { opacity: 1; transition: none; }
        .js .m-cell i { background: var(--wine); transition: none; }
        .seg { transition: none; }
        .day .seg.rep { flex-grow: .9; opacity: .55; }
        .day .seg:not(.rep) { flex-grow: calc(var(--w) * 2.2); }
        .video-play, .top, .button, .top-cta { transition: none; }
      }
    </style>
  </body>
</html>
