      .video-vertical { aspect-ratio: 9 / 16; max-height: 78vh; width: min(100%, calc(78vh * 9 / 16)); margin-inline: auto; }
      .video-el { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #000; }
      .video-cover { position: absolute; inset: 0; display: grid; place-items: center; width: 100%; padding: 0; border: 0; background: var(--dark); color: inherit; font: inherit; cursor: pointer; }
      .video-bar { position: absolute; left: 16px; right: 16px; top: 18px; display: flex; gap: 3px; height: 6px; }
      .video-bar i { flex: 1; background: repeating-linear-gradient(135deg, #4a453e 0 2px, transparent 2px 5px); }
