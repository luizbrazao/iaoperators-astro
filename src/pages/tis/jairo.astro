---
import PresenterVideo from "../../components/PresenterVideo.astro";
// Landing personalizada para Jairo González, consejero y director de expansión
// de Petit Palace. Se llega por el QR de una tarjeta entregada en mano.
// Privada: noindex,nofollow y fuera del sitemap ("/tis/" en NOINDEX_PATHS).
//
// Concepto: la "columna vertebral digital" de la que habló en TIS. Una cadena
// que quiere crecer necesita una columna que le permita escalar; lo que cruje
// al crecer no suelen ser las piezas, sino las uniones entre ellas. La
// Radiografía Digital mira esas uniones antes del hotel 20 (y del 70).
// Lenguaje visual: la columna (sistemas como vértebras, uniones en naranja) y
// la rejilla de 20 hoteles "cada uno de su padre y de su madre" frente a 20
// hoteles sobre la misma columna. Pizarra azul para el sistema; el naranja de
// marca solo para las costuras.
//
// Sesión de TIS 06/10/2026 "CapEx or TechEx?" con Juan Carlos Sanjuán (Casual)
// y José Rodríguez Pousa (Sercotel). Solo se usa lo que con seguridad dijo
// Jairo según la transcripción automática (imprecisa), parafraseado:
//   - Columna vertebral digital: una compañía con ambición de crecer o tiene
//     una columna que le permite escalar fácilmente o está muerta. Cualquier
//     hotel funciona con cualquier tecnología; en el hotel 20, si cada uno es
//     "de su padre y de su madre", no se puede gestionar.
//   - Ecosistema PMS, ERP, CRM, revenue, automatizaciones, BI sobre datos
//     comunes; las soluciones completas son cerradas y siempre hay uno que
//     puntualmente lo hace mejor y no habla con el resto.
//   - El PMS de hoy, ¿sirve dentro de cinco años para 50 hoteles en Italia?
//     Un único sistema adaptado al negocio, en cualquier geografía, escalable.
//   - Crecer sin columna: "cuerpos extraños", equipos "como pollos sin cabeza";
//     hace falta la cabeza (talento, control) que maneje un cuerpo que crece a
//     velocidades endiabladas. Si escalas es porque tienes un sistema que te
//     lo permite.
//   - Puede crecer a ritmos del 20 % anual durante cinco o diez años; en la
//     columna digital no quitaría nada. Hay capas de tecnología superpuestas
//     y alguna sobra: tecnología de moda que el cliente ni ve ni siente.
//   - CapEx verde: la tecnología es el "sistema operativo del CapEx"; de qué
//     sirve la mejor bomba de calor si el sistema de control no funciona
//     (un Ferrari conducido como un utilitario).
//   - Las cuatro preguntas de cada inversión (cliente que paga más, operativa,
//     costes, escalar otros 20 hoteles sin que se noten las costuras); el euro
//     que paga el cliente y se convierte entero en EBITDA. Juan Carlos dijo
//     estar de acuerdo «al 97,3 %».
// Atribución media, no usada: la apertura con 53 hoteles abiertos y 25 en
// camino (solo "unos 25 en camino", como lo que contó); "propiedad de un fondo".
//
// Datos públicos (verificados el 07/10/2026):
//   - TIS 2026: Jairo González, Expansion Director, Petit Palace Hotels.
//   - ExpoHIP: consejero independiente y director de expansión; dirigió
//     Sidorme 2013–2016 (dobló la cadena y triplicó ingresos antes de su venta
//     a B&B HOTELS) y después B&B HOTELS España y Portugal (expansión y
//     digitalización).
//   - Hosteltur, 24/09/2025: 41 hoteles, 2.575 habitaciones, 135 M€ (2024);
//     plan de duplicar tamaño en cinco años (España, Italia, Portugal,
//     Alemania); cita literal de Jairo sobre fondear el CAPEX.
//   - idealista, 04/05/2026: alianza con Soho Boutique Hotels, 12 hoteles en
//     una primera fase e integración completa antes de que acabe 2027.
//   - Sivarious, 05/10/2026: más de 50 hoteles y unas 3.300 habitaciones.
//   - Reason Why: la compañía nació en 2001 como High Tech Hoteles.
//
// Comportamiento compartido en src/scripts/prospect-landing.ts.

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  // Vídeo de Luiz con fondo blanco, fundido con la página (PresenterVideo).
  src: "/video/luiz-tis.mp4",
  poster: "/video/luiz-tis-poster.jpg",
  duracion: "1 min 24 s",
};

const wa = (t: string) => `https://wa.me/34662423523?text=${encodeURIComponent(t)}`;
const CONTACT_HREF = wa("Hola Luiz, soy Jairo González, de Petit Palace. He visto la página que preparaste después de TIS y me gustaría hablarlo.");
const INTRO_HREF = wa("Hola Luiz, soy Jairo González, de Petit Palace. Te pongo en contacto con la persona que lleva nuestra columna digital: ");
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/jairo/", site).toString();
const ogImage = new URL("/og/jairo.png", site).toString();
const title = "Jairo González × IA Operators | Radiografía Digital";
const description = "Después de «CapEx or TechEx?» en TIS: la columna vertebral digital y sus costuras. Una reflexión preparada por IA Operators para Jairo González y Petit Palace.";

const pad = (n: number) => String(n).padStart(2, "0");

// Las cuatro preguntas que planteó Jairo para cada inversión.
const filtro = [
  { q: "¿Lo valora el cliente?", d: "Y no solo que lo valore: que esté dispuesto a pagar más por ello." },
  { q: "¿Mejora la operativa del equipo?", d: "Que le facilite la vida a quien lo usa cada día." },
  { q: "¿Mejora los costes?", d: "Que el euro invertido vuelva a la cuenta de resultados." },
  { q: "¿Permite escalar?", d: "Meter otros 20 hoteles sin dramas y sin que se noten las costuras." },
];

// La columna, tal y como la enumeró en la mesa.
const vertebras = ["PMS", "ERP", "CRM", "Revenue", "Automatizaciones", "Business Intelligence"];

const costuras = [
  "una reserva que se vuelve a teclear en otro sistema",
  "un dato de revenue que llega tarde a recepción",
  "un informe que alguien monta a mano cada lunes",
  "una excepción que solo sabe resolver una persona",
  "un hotel recién integrado que trabaja «a su manera»",
];

const datos = [
  { n: "+50", k: "hoteles abiertos", s: "unas 3.300 habitaciones" },
  { n: "≈25", k: "en camino", s: "según contaste en TIS" },
  { n: "12", k: "hoteles Soho", s: "en la primera fase de la alianza" },
  { n: "×2", k: "en cinco años", s: "España, Italia, Portugal y Alemania" },
];

// 20 hoteles: sin columna, cada uno con su variante; con columna, todos iguales.
const variantes = [0, 3, 1, 4, 2, 2, 0, 4, 1, 3, 4, 1, 3, 0, 2, 1, 4, 2, 3, 0];

const pasos = [
  "Elegimos un proceso que cruce varios sistemas y varios hoteles.",
  "Lo seguimos con las personas que lo ejecutan, de principio a fin.",
  "Marcamos cada unión: dónde se transfiere, se espera, se repite o se corrige.",
  "Pasamos cada fricción por tus cuatro preguntas.",
];

const hoteles = [
  { k: "Hotel A", d: "Petit Palace de siempre" },
  { k: "Hotel B", d: "integrado en los últimos años" },
  { k: "Hotel C", d: "recién llegado" },
];
const proceso = ["Reserva", "Llegada", "Estancia", "Salida", "Cierre"];
// Diferencias ilustrativas por hotel (índice del paso con fricción).
const friccion: Record<number, number[]> = { 0: [], 1: [1, 4], 2: [0, 2, 4] };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Otros 20 hoteles, sin que se noten las costuras. Una idea para Jairo González." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f6f5f1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header" data-cta-event="click_contact">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="label">Después de «CapEx or TechEx?» · TIS 2026</p>
        <h1 id="hero-title" class="greeting">Jairo, en TIS lo dijiste sin rodeos: una compañía que quiere crecer o tiene una <b>columna vertebral digital</b> que le permite escalar, o no escala.</h1>
        <p class="big">Lo que cruje al crecer no suelen ser las piezas.<span>Son las uniones.</span></p>

        <div class="hero-grid">
          <PresenterVideo src={VIDEO.src} poster={VIDEO.poster} label="Vídeo de Luiz Brazão para Jairo González" duracion={VIDEO.duracion} />

          <div class="hero-copy">
            <p>Pusiste un ejemplo muy claro: cualquier hotel funciona razonablemente con cualquier tecnología. El problema llega en el hotel 20, cuando cada uno es de su padre y de su madre.</p>
            <p>Petit Palace está justo ahí: más de 50 hoteles, unos 25 en camino y una integración en marcha.</p>
            <p class="hero-strong">La pregunta que me gustaría explorar contigo es dónde está la próxima costura, antes de que se note.</p>
          </div>
        </div>
      </section>

      <!-- Filtro -->
      <section id="filtro" class="section wrap" aria-labelledby="fi-title">
        <div class="split">
          <p class="label label-accent" data-reveal>01 · Tu filtro</p>
          <div>
            <h2 id="fi-title" class="h2" data-reveal>Cuatro preguntas antes de invertir un euro.</h2>
            <p class="lede" data-reveal>Las planteaste al final de la sesión. Juan Carlos dijo estar de acuerdo «al 97,3 %».</p>
            <ol class="filter" data-reveal>
              {filtro.map((f, i) => (
                <li class:list={{ "filter-last": i === filtro.length - 1 }}>
                  <span class="n">{pad(i + 1)}</span>
                  <div>
                    <p class="filter-q">{f.q}</p>
                    <p class="filter-d">{f.d}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="statement" data-reveal>
              <span class="muted">Ni para que el hotel sea más bonito, ni para tener tecnología molona.</span>
              <span>Para que ese euro lo pague el cliente y acabe entero en EBITDA.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Columna -->
      <section id="columna" class="panel" aria-labelledby="co-title">
        <div class="wrap section">
          <p class="label" data-reveal>02 · La columna</p>
          <h2 id="co-title" class="h2 h2-wide" data-reveal>Un ecosistema en el que los sistemas hablan entre ellos.</h2>
          <div class="spine-grid">
            <div>
              <p class="lede" data-reveal>Así la describiste: PMS, ERP, CRM, revenue, automatizaciones y business intelligence sobre datos comunes. Y con un matiz que en la práctica lo decide casi todo.</p>
              <p class="prose-line" data-reveal>Las soluciones completas suelen ser cerradas. Siempre hay alguien que hace mejor una pieza concreta, pero que luego no habla con el resto.</p>
              <p class="statement" data-reveal>
                <span class="muted">Las piezas se eligen.</span>
                <span>Las uniones hay que mirarlas.</span>
              </p>
            </div>
            <figure class="spine" data-reveal aria-label="La columna digital: seis sistemas unidos por costuras sobre datos comunes">
              <div class="spine-cord" aria-hidden="true"></div>
              <ol class="spine-list">
                {vertebras.map((v, i) => (
                  <>
                    <li class="vert" style={`--i:${i}`}><span>{v}</span></li>
                    {i < vertebras.length - 1 && <li class="joint" style={`--i:${i}`} aria-hidden="true"><i></i></li>}
                  </>
                ))}
              </ol>
              <figcaption><span class="cap-cord">Datos comunes</span><span class="cap-joint">Costuras</span></figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- Hotel 20 -->
      <section id="hotel-20" class="section wrap" aria-labelledby="h20-title">
        <p class="label" data-reveal>03 · El hotel 20</p>
        <h2 id="h20-title" class="h2 h2-wide" data-reveal>«Cada uno de su padre y de su madre.»</h2>
        <div class="twenty">
          <figure class="t-fig" data-reveal aria-label="Veinte hoteles, cada uno con su propia forma de trabajar">
            <div class="t-grid">{variantes.map((v) => <i class={`h v${v}`}></i>)}</div>
            <figcaption><b>Sin columna.</b> Cada hotel resuelve a su manera. Funciona, hasta que hay que gestionarlos juntos.</figcaption>
          </figure>
          <figure class="t-fig" data-reveal style="--d:120ms" aria-label="Veinte hoteles sobre la misma columna">
            <div class="t-grid t-grid-on">{variantes.map(() => <i class="h on"></i>)}</div>
            <figcaption><b>Con columna.</b> Cada hotel nuevo se conecta a lo que ya funciona.</figcaption>
          </figure>
        </div>
        <div class="split split-tight">
          <span></span>
          <div>
            <p class="prose-line prose-ink" data-reveal>Lo resumiste como la pescadilla que se muerde la cola: si escalas es porque tienes un sistema que te lo permite. Sin él, aparecen cuerpos extraños, cada uno funcionando lo mejor que sabe, y equipos que corren sin cabeza.</p>
            <p class="prose-line" data-reveal>Y añadiste la pregunta incómoda: el PMS que hoy funciona en España, ¿servirá dentro de cinco años para 50 hoteles en Italia?</p>
          </div>
        </div>
      </section>

      <!-- Petit Palace -->
      <section id="petit-palace" class="night" aria-labelledby="pp-title">
        <div class="wrap section">
          <p class="label label-night" data-reveal>04 · Petit Palace</p>
          <h2 id="pp-title" class="h2 h2-wide" data-reveal>Una cadena que nació como High Tech Hoteles y hoy crece integrando.</h2>
          <dl class="stats" data-reveal>
            {datos.map((d) => (
              <div>
                <dt>{d.k}</dt>
                <dd><b>{d.n}</b><span>{d.s}</span></dd>
              </div>
            ))}
          </dl>
          <div class="split split-tight">
            <span></span>
            <div>
              <figure class="quote" data-reveal>
                <blockquote>«Tenemos capacidad para fondear el CAPEX y seleccionamos solo proyectos que aporten una rentabilidad que permita una expansión sólida y sostenible.»</blockquote>
                <figcaption>Jairo González · septiembre de 2025</figcaption>
              </figure>
              <p class="prose-line prose-night" data-reveal>En TIS lo llevaste al TechEx: en la columna digital no quitarías nada, porque es lo que sostiene un crecimiento de años. Pero también dijiste que hay capas de tecnología superpuestas y que alguna sobra.</p>
              <p class="prose-line prose-night" data-reveal>Sunotel en 2024, la marca única en 2025, doce hoteles Soho ahora y el resto antes de que acabe 2027. Cada integración trae sus sistemas, sus procesos y sus costumbres.</p>
            </div>
          </div>
          <p class="huge" data-reveal>La expansión se firma en meses. Las costuras se notan durante años.</p>
        </div>
      </section>

      <!-- Ferrari -->
      <section id="ferrari" class="section wrap" aria-labelledby="fe-title">
        <div class="split">
          <p class="label" data-reveal>05 · El Ferrari</p>
          <div>
            <h2 id="fe-title" class="h2" data-reveal>¿De qué sirve la mejor bomba de calor si el sistema de control no funciona?</h2>
            <p class="lede" data-reveal>Lo dijiste hablando de CapEx verde: la tecnología es el sistema operativo del CapEx. Sin ella, tienes un Ferrari y lo conduces como un utilitario.</p>
            <p class="prose-line" data-reveal>Con el TechEx pasa lo mismo, una capa más abajo. El mejor PMS, el mejor RMS o el mejor CRM rinden lo que rinden sus uniones:</p>
            <ul class="ticks" data-reveal>{costuras.map((c) => <li>{c}</li>)}</ul>
            <p class="statement" data-reveal>Ahí es donde se pierde el rendimiento de la inversión que ya está hecha.</p>
          </div>
        </div>
      </section>

      <!-- Radiografía -->
      <section id="radiografia" class="panel" aria-labelledby="rd-title">
        <div class="wrap section">
          <div class="split">
            <p class="label label-accent" data-reveal>06 · Radiografía Digital</p>
            <div>
              <h2 id="rd-title" class="h2" data-reveal>Mirar las uniones antes de cambiar las piezas.</h2>
              <p class="lede" data-reveal>Una Radiografía Digital no evalúa proveedores ni propone una plataforma. Sigue el trabajo real a través de los sistemas.</p>
              <ol class="steps" data-reveal>{pasos.map((p, i) => <li><span class="n">{pad(i + 1)}</span>{p}</li>)}</ol>
              <p class="prose-line" data-reveal>El resultado no es una lista de ideas. Es saber qué costuras merecen inversión, cuáles basta con ordenar y cuáles pueden esperar.</p>
              <ul class="nots" data-reveal>
                <li>No vendemos un PMS, un RMS ni un CRM.</li>
                <li>No tenemos una plataforma que colocar.</li>
                <li>Integramos cuando hace falta, pero la decisión es tuya y va antes.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Propuesta -->
      <section id="propuesta" class="section wrap" aria-labelledby="pr-title">
        <div class="split">
          <p class="label label-accent" data-reveal>Una idea concreta</p>
          <div>
            <h2 id="pr-title" class="h2 h2-pair" data-reveal><span>No empecemos por toda la columna.</span><span class="h2-accent">Empecemos por una costura.</span></h2>
            <p class="lede" data-reveal>Un mismo proceso, seguido en tres hoteles de origen distinto. Es la forma más rápida de ver dónde la columna ya sostiene y dónde todavía no.</p>
            <figure class="cmp" data-reveal aria-label="Ejemplo ilustrativo: el mismo proceso en tres hoteles">
              {hoteles.map((h, r) => (
                <div class="cmp-row">
                  <p class="cmp-k"><b>{h.k}</b><span>{h.d}</span></p>
                  <ol class="cmp-steps">
                    {proceso.map((p, c) => <li class:list={{ hot: friccion[r].includes(c) }} style={`--i:${r * 5 + c}`}>{p}</li>)}
                  </ol>
                </div>
              ))}
              <figcaption>Ejemplo ilustrativo. No describe ningún proceso real de Petit Palace.</figcaption>
            </figure>
            <p class="prose-line" data-reveal>Lo elegiríamos con quien lleve la operación y la tecnología, y lo mediríamos con tus cuatro preguntas delante.</p>
            <p class="worth" data-reveal>¿Se notan las costuras?</p>
          </div>
        </div>
      </section>

      <!-- Cierre -->
      <section id="cierre" class="closing wrap" aria-labelledby="ci-title">
        <p class="cl-1" data-reveal>Otros 20 hoteles.</p>
        <h2 id="ci-title" class="cl-big" data-reveal>Sin que se noten las costuras.</h2>
        <p class="cl-3" data-reveal>Ese es el trabajo que me gustaría enseñarte, o enseñar a quien lleve la columna digital de Petit Palace.</p>
      </section>

      <!-- CTA -->
      <section id="hablar" class="cta" aria-labelledby="cta-title">
        <div class="wrap section">
          <h2 id="cta-title" class="h2 cta-title" data-reveal>Si te parece una conversación útil, seguimos.</h2>
          <p class="cta-copy" data-reveal>En 20 minutos puedo enseñarte cómo hacemos una Radiografía Digital y un ejemplo real en una cadena hotelera.</p>
          <div class="cta-row" data-reveal>
            <div class="buttons">
              <a class="button" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="final" data-cta-event="click_contact">Hablar con Luiz <span aria-hidden="true">↗</span></a>
              <a class="button button-ghost" href={INTRO_HREF} target="_blank" rel="noopener" data-cta="intro" data-cta-event="click_introduction">Presentarme a la persona adecuada <span aria-hidden="true">↗</span></a>
            </div>
            <div class="signature">
              <p class="signature-name">Luiz Brazão</p>
              <p class="signature-role">Founder, IA Operators</p>
              <a class="signature-site" href="https://iaoperators.com/es/" data-cta="site">iaoperators.com</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <span class="foot-brand"><img src="/brand/ia-operators-logo.png" alt="IA Operators" width="453" height="82" loading="lazy" /></span>
        <a href="/es/auditoria-de-sistemas/">Radiografía Digital</a>
        <a href="https://iaoperators.com/es/">iaoperators.com</a>
      </div>
    </footer>

    <div class="consent" data-consent hidden role="region" aria-label="Cookies">
      <p>Usamos cookies para medir y mejorar la experiencia. Puedes aceptar o rechazar. <a href="/es/politica-de-privacidad/">Política de Privacidad</a>.</p>
      <div class="consent-actions">
        <button type="button" data-consent-reject>Rechazar</button>
        <button type="button" class="consent-accept" data-consent-accept>Aceptar</button>
      </div>
    </div>

    <script>
      import { initProspectLanding } from "../../scripts/prospect-landing";
      initProspectLanding({ landing: "jairo", gtmId: document.body.dataset.gtm ?? "", videoTitle: "jairo_luiz", scrollMarks: [50, 90] });
    </script>

    <style is:global>
      @font-face {
        font-family: "Manrope JG";
        src: url("/fonts/manrope-latin-variable.woff2") format("woff2");
        font-weight: 200 800;
        font-display: swap;
      }
      :root {
        --paper: #f6f5f1;
        --panel: #ecebe5;
        --ink: #15171a;
        --text: #2c2f33;
        --muted: #62666b;
        --soft: #9a9da1;
        --line: #dfded8;
        --line-strong: #c3c2bb;
        --slate: #24425a;
        --slate-soft: #9fb2c1;
        --orange: #f16532;
        --orange-ink: #b4441a;
        --night: #121417;
        --night-text: #f1f1ee;
        --night-line: #2b2f34;
        --gutter: 20px;
        --ease: cubic-bezier(.2, .7, .2, 1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 72px; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Manrope JG", "Helvetica Neue", Arial, sans-serif; font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums; }
      h1, h2, h3, p, ol, ul, dl, dd, figure, blockquote { margin: 0; }
      ol, ul { padding: 0; list-style: none; }
      a { color: inherit; text-decoration: none; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
      .wrap { width: 100%; max-width: 1240px; margin-inline: auto; padding-inline: var(--gutter); }
      .label { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .label::before { content: ""; width: 7px; height: 7px; background: var(--slate); }
      .label-accent::before { background: var(--orange); }
      .label-night { color: #9a9ea3; }
      .label-night::before { background: var(--slate-soft); }
      .muted { color: var(--soft); }

      /* Cabecera */
      .top { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid transparent; transition: background-color .3s ease, border-color .3s ease; }
      .top.is-scrolled { background: rgba(246, 245, 241, .9); border-bottom-color: var(--line); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
      .top-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 60px; }
      .wordmark img { display: block; width: auto; height: 22px; }
      .foot-brand img { display: block; width: auto; height: 18px; }
      .top-nav { display: flex; align-items: center; gap: 22px; font-size: 13px; }
      .top-link { display: none; color: var(--muted); }
      .top-link:hover { color: var(--ink); }
      .top-cta { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; background: var(--slate); color: var(--night-text); font-weight: 600; white-space: nowrap; transition: background-color .2s ease; }
      .top-cta:hover { background: var(--ink); }

      /* Hero */
      .hero { padding-top: 18px; padding-bottom: 72px; }
      .greeting { margin-top: 14px; max-width: 24em; font-size: clamp(19px, 2.2vw, 28px); font-weight: 500; letter-spacing: -.028em; line-height: 1.28; color: var(--text); }
      .greeting b { font-weight: 700; color: var(--slate); }
      .big { display: grid; gap: 2px; margin-top: 18px; max-width: 13em; font-size: clamp(34px, 6.6vw, 94px); font-weight: 500; letter-spacing: -.058em; line-height: 1; color: var(--soft); }
      .big span { color: var(--ink); }
      .hero-grid { display: grid; gap: 28px; margin-top: 28px; }
      .hero-copy { display: grid; gap: 10px; align-content: start; color: var(--muted); }
      .hero-copy p { max-width: 32em; }
      .hero-strong { margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--line-strong); font-size: clamp(20px, 2vw, 25px); font-weight: 500; letter-spacing: -.03em; line-height: 1.28; color: var(--ink); }

      /* Secciones */
      .section { padding-block: 88px; }
      .panel { background: var(--panel); }
      .night { background: var(--night); color: var(--night-text); }
      .split { display: grid; gap: 18px; }
      .split > .label { align-self: start; padding-top: 10px; }
      .split-tight { margin-top: 40px; }
      .h2 { margin-top: 0; font-size: clamp(30px, 4.4vw, 58px); font-weight: 500; letter-spacing: -.05em; line-height: 1.07; max-width: 15em; }
      section > .wrap > .h2, .section > .h2 { margin-top: 16px; }
      .h2-wide { max-width: 19em; }
      .h2-pair { display: grid; gap: 4px; }
      .h2-accent { color: var(--orange-ink); }
      .lede { margin-top: 20px; max-width: 30em; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.45; letter-spacing: -.018em; color: var(--text); }
      .prose-line { margin-top: 22px; max-width: 36em; color: var(--muted); }
      .prose-ink { color: var(--text); font-size: 18px; }
      .prose-night { color: #b9bcc0; }
      .statement { display: grid; gap: 2px; margin-top: 40px; font-size: clamp(25px, 3.2vw, 42px); font-weight: 500; letter-spacing: -.045em; line-height: 1.12; max-width: 17em; }
      .statement::before { content: ""; display: block; width: 40px; height: 3px; margin-bottom: 16px; background: var(--orange); }
      .huge { margin-top: 72px; font-size: clamp(36px, 7vw, 100px); font-weight: 500; letter-spacing: -.062em; line-height: 1; max-width: 12em; }
      .n { flex: 0 0 26px; font-size: 12px; font-weight: 650; color: var(--soft); }

      /* Filtro */
      .filter { margin-top: 36px; border-top: 1px solid var(--ink); }
      .filter li { display: flex; gap: 14px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); }
      .filter-q { font-size: clamp(21px, 2.3vw, 30px); font-weight: 500; letter-spacing: -.035em; line-height: 1.18; }
      .filter-d { margin-top: 4px; max-width: 36em; font-size: 16px; color: var(--muted); }
      .filter-last .n { color: var(--orange); }
      .filter-last .filter-q { color: var(--slate); }

      /* Columna */
      .spine-grid { display: grid; gap: 48px; margin-top: 8px; }
      .spine { position: relative; max-width: 380px; width: 100%; justify-self: center; padding: 8px 0; }
      .spine-cord { position: absolute; left: 50%; top: 0; bottom: 34px; width: 2px; margin-left: -1px; background: var(--slate-soft); }
      .spine-list { position: relative; display: grid; justify-items: center; }
      .vert { position: relative; width: 100%; padding: 12px 16px; background: var(--paper); border: 1px solid var(--slate); border-radius: 10px; text-align: center; font-size: clamp(16px, 1.6vw, 19px); font-weight: 600; letter-spacing: -.02em; color: var(--slate); }
      .joint { display: grid; place-items: center; height: 26px; }
      .joint i { width: 12px; height: 12px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 4px rgba(241, 101, 50, .16); }
      .spine figcaption { display: flex; justify-content: center; gap: 20px; margin-top: 16px; font-size: 12px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
      .cap-cord::before, .cap-joint::before { content: ""; display: inline-block; vertical-align: middle; margin-right: 8px; }
      .cap-cord::before { width: 14px; height: 2px; background: var(--slate-soft); }
      .cap-joint::before { width: 9px; height: 9px; border-radius: 50%; background: var(--orange); }

      /* Hotel 20 */
      .twenty { display: grid; gap: 36px; margin-top: 44px; }
      .t-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; max-width: 420px; }
      .h { position: relative; aspect-ratio: 1; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--paper); }
      .h::after { content: ""; position: absolute; inset: 28%; }
      .h.v0::after { border-radius: 50%; background: var(--soft); }
      .h.v1::after { background: var(--line-strong); transform: rotate(45deg); }
      .h.v2::after { inset: 22% 18%; background: repeating-linear-gradient(90deg, var(--soft) 0 2px, transparent 2px 6px); }
      .h.v3::after { border: 2px solid var(--soft); border-radius: 50%; }
      .h.v4::after { inset: 40% 20%; background: var(--soft); }
      .h.v1, .h.v3 { transform: rotate(-4deg); }
      .h.v2 { transform: rotate(3deg); }
      .h.on { border-color: var(--slate); }
      .h.on::after { inset: 34% 34%; border-radius: 50%; background: var(--slate); }
      .t-grid-on { position: relative; }
      .t-fig figcaption { margin-top: 16px; max-width: 26em; font-size: 15px; color: var(--muted); }
      .t-fig figcaption b { color: var(--ink); }

      /* Petit Palace */
      .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 44px; background: var(--night-line); border: 1px solid var(--night-line); }
      .stats div { padding: 18px 14px; background: var(--night); }
      .stats dt { font-size: 11px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: #9a9ea3; }
      .stats dd b { display: block; margin-top: 6px; font-size: clamp(40px, 6vw, 76px); font-weight: 500; letter-spacing: -.06em; line-height: 1; color: var(--night-text); }
      .stats dd span { display: block; margin-top: 8px; font-size: 13px; color: #9a9ea3; }
      .quote blockquote { font-size: clamp(21px, 2.3vw, 29px); font-weight: 400; letter-spacing: -.03em; line-height: 1.3; max-width: 24em; }
      .quote figcaption { margin-top: 10px; font-size: 13px; color: #9a9ea3; }
      .night .huge { color: var(--night-text); }

      /* Ferrari */
      .ticks { margin-top: 10px; }
      .ticks li { position: relative; padding: 9px 0 9px 22px; border-bottom: 1px solid var(--line); font-size: clamp(17px, 1.6vw, 20px); letter-spacing: -.015em; }
      .ticks li::before { content: ""; position: absolute; left: 0; top: calc(9px + .7em); width: 9px; height: 9px; border-radius: 50%; background: var(--orange); transform: translateY(-50%); }

      /* Radiografía */
      .steps { margin-top: 28px; border-top: 1px solid var(--line-strong); }
      .steps li { display: flex; gap: 14px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line-strong); font-size: clamp(18px, 1.7vw, 21px); letter-spacing: -.02em; }
      .nots { margin-top: 28px; }
      .nots li { padding: 8px 0; font-size: 16px; color: var(--muted); }
      .nots li::before { content: "·"; margin-right: 10px; color: var(--slate); font-weight: 700; }

      /* Propuesta */
      .cmp { margin-top: 32px; display: grid; gap: 14px; }
      .cmp-row { display: grid; gap: 8px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
      .cmp-k b { font-size: 16px; font-weight: 650; }
      .cmp-k span { margin-left: 10px; font-size: 14px; color: var(--muted); }
      .cmp-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
      .cmp-steps li { padding: 8px 4px; border: 1px solid var(--slate-soft); border-radius: 6px; background: var(--paper); text-align: center; font-size: 12px; font-weight: 600; color: var(--slate); }
      .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }
      .cmp figcaption { font-size: 13px; color: var(--soft); }
      .worth { margin-top: 10px; font-size: clamp(38px, 6.6vw, 90px); font-weight: 500; letter-spacing: -.06em; line-height: 1; color: var(--orange-ink); }

      /* Cierre */
      .closing { padding-block: 120px 128px; }
      .cl-1 { font-size: clamp(28px, 3.6vw, 48px); font-weight: 500; letter-spacing: -.045em; color: var(--soft); }
      .cl-big { margin-top: 10px; max-width: 10em; font-size: clamp(52px, 11vw, 160px); font-weight: 500; letter-spacing: -.07em; line-height: .95; }
      .cl-3 { margin-top: 56px; max-width: 30em; font-size: clamp(19px, 1.8vw, 23px); letter-spacing: -.02em; color: var(--text); }

      /* CTA */
      .cta { border-top: 1px solid var(--line); }
      .cta-title { max-width: 14em; }
      .cta-copy { margin-top: 20px; max-width: 32em; font-size: 18px; color: var(--muted); }
      .cta-row { display: grid; gap: 36px; margin-top: 40px; }
      .buttons { display: grid; gap: 10px; justify-items: start; }
      .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 56px; padding: 0 24px; background: var(--slate); color: var(--night-text); font-size: 16px; font-weight: 600; transition: background-color .2s ease, color .2s ease; }
      .button:hover { background: var(--ink); }
      .button-ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
      .button-ghost:hover { background: var(--ink); color: var(--paper); }
      .signature { padding-top: 18px; border-top: 1px solid var(--line); max-width: 280px; }
      .signature-name { font-size: 18px; font-weight: 650; letter-spacing: -.02em; }
      .signature-role { font-size: 14px; color: var(--muted); }
      .signature-site { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--slate); }

      /* Pie y consentimiento */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding-block: 26px 30px; font-size: 13px; color: var(--muted); }
      .foot-brand { margin-right: auto; }
      .foot a:hover { color: var(--ink); }
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; background: var(--night); color: var(--night-text); font-size: 13px; line-height: 1.5; border: 1px solid #3a3d42; box-shadow: 0 10px 30px rgba(0, 0, 0, .18); }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; }
      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 38px; padding: 0 16px; border: 1px solid #3a3d42; background: transparent; color: var(--night-text); font: inherit; cursor: pointer; }
      .consent .consent-accept { background: var(--night-text); color: var(--night); border-color: var(--night-text); }

      /* Movimiento */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }
      .js .spine .joint i { transform: scale(0); transition: transform .4s var(--ease) calc(.4s + var(--i) * 140ms); }
      .js .spine.is-in .joint i { transform: scale(1); }
      .js .t-grid-on .h { opacity: .25; transition: opacity .5s ease calc(var(--k, 0) * 1ms); }
      .js .t-fig.is-in .t-grid-on .h { opacity: 1; }
      .js .cmp-steps li.hot { background: var(--paper); border-color: var(--slate-soft); color: var(--slate); transition: background-color .4s ease calc(.3s + var(--i) * 50ms), border-color .4s ease calc(.3s + var(--i) * 50ms), color .4s ease calc(.3s + var(--i) * 50ms); }
      .js .cmp.is-in .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }

      @media (min-width: 420px) {
        .top-link { display: inline; }
        .cmp-steps li { font-size: 13px; }
      }
      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .twenty { grid-template-columns: 1fr 1fr; gap: 56px; }
        .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        .stats div { padding: 22px 18px; }
        .cmp-row { grid-template-columns: 210px minmax(0, 1fr); align-items: center; gap: 16px; }
        .cmp-k span { display: block; margin-left: 0; }
        .cta-row { grid-template-columns: auto 1fr; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }
      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 40px; padding-bottom: 116px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 52px; align-items: start; }
        .section { padding-block: 128px; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .spine-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 72px; align-items: center; }
        .closing { padding-block: 180px 190px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .spine .joint i { transform: none; transition: none; }
        .js .t-grid-on .h { opacity: 1; transition: none; }
        .js .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); transition: none; }
        .top, .button, .top-cta { transition: none; }
      }
    </style>
  </body>
</html>
