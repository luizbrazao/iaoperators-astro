    <script>
      import { initProspectLanding } from "../../scripts/prospect-landing";
      const { track } = initProspectLanding({ landing: "mayte", gtmId: document.body.dataset.gtm ?? "", videoTitle: "mayte_luiz", scrollMarks: [50, 90] });

      // view_pilot: una vez, cuando la cabecera de la iniciativa entra de verdad en pantalla.
      const pilot = document.querySelector<HTMLElement>('[data-view="pilot"]');
      if (pilot && "IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) { track("view_pilot", { section: "iniciativa" }); io.disconnect(); }
        }, { threshold: 0.6 });
        io.observe(pilot);
      }
    </script>

