---
// Landing personalizada para Mayte García Córcoles, directora ejecutiva de
// HOSBEC. Se llega por el QR de una tarjeta entregada en mano. Privada:
// noindex,nofollow y fuera del sitemap.
//
// No vende consultoría a HOSBEC. Propone una iniciativa para sus asociados:
// aplicar la Radiografía Digital a un grupo pequeño de establecimientos
// (3–5, empezando por 1) para observar qué fricciones operativas se repiten.
// Cada hotel recibe su diagnóstico confidencial; HOSBEC recibe patrones
// agregados y anonimizados. Complementa a ITH y al resto de socios.
//
// Lenguaje visual: red de establecimientos. Cada uno con su propia matriz
// 4×4; al comparar, las mismas celdas se encienden en varios a la vez.
// Baya para los patrones, grises para lo individual. Sin datos inventados:
// todas las figuras van marcadas como ilustración.
//
// Verificado a 04/10/2026:
// - Mayte García, directora ejecutiva desde febrero de 2025 (Hosteltur,
//   07/02/2025): servicios a asociados, innovación y tecnología, entre otras.
// - HOSBEC recoge datos de ocupación de sus asociados desde 1985
//   (hosbec.com/big-data). Hoteles, apartamentos, campings y oferta
//   complementaria en Alicante, Valencia y Castellón (hosbec.com).
// - HOSBEC e ITH: "The Hotel Data Breakfast & Coffee Tour 2026", 22/09 en
//   Valencia y 24/09 en Benidorm (datos, IA, automatización, robótica).

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  src: "",
  poster: "",
  type: "video/mp4",
  orientation: "horizontal" as "horizontal" | "vertical",
  duracion: "55 segundos",
};

const CONTACT_HREF = `https://wa.me/34662423523?text=${encodeURIComponent(
  "Hola Luiz, soy Mayte García, de HOSBEC. He visto la propuesta de la Radiografía Operativa Hotelera y me gustaría hablarlo.",
)}`;
const MAIL_HREF = `mailto:info@iaoperators.com?subject=${encodeURIComponent("Radiografía Operativa Hotelera · HOSBEC")}`;
const CASE_HREF = "/es/portfolio/radiografia-cadena-hotelera-menorca/";
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/mayte/", site).toString();
const ogImage = new URL("/og/mayte.png", site).toString();
const title = "Mayte García × IA Operators | Radiografía Operativa Hotelera";
const description = "Una propuesta de piloto de Radiografía Digital para hoteles asociados a HOSBEC.";

const pad = (n: number) => String(n).padStart(2, "0");

const dentro = [
  "qué tareas se repiten",
  "dónde espera un proceso",
  "qué información cambia de manos",
  "qué sistemas no comparten datos",
  "qué procesos dependen demasiado de determinadas personas",
];

const medimos = ["ocupación", "ADR", "RevPAR", "mercados", "reservas", "estacionalidad"];
const casiNunca = ["repetición", "transferencia", "espera", "inconsistencia", "trabajo manual", "dependencias operativas"];

const detalles = [
  "Una tarea repetida.",
  "Una información introducida dos veces.",
  "Una aprobación que tarda.",
  "Un dato que pasa a mano entre sistemas.",
  "Una excepción que siempre necesita a la misma persona.",
];

const queRepite = [
  "¿Qué aparece una y otra vez entre operaciones distintas?",
  "¿Qué fricciones son comunes?",
  "¿Cuáles son propias de ciertos tipos de establecimiento?",
  "¿Dónde la automatización aparece como respuesta frecuente?",
  "¿Dónde el problema es de integración?",
  "¿Dónde la tecnología no parece ser la respuesta?",
];

const areas = ["Captación", "Atención", "Operación", "Gestión"];
const senales = [
  { k: "Repetición", d: "lo que se hace una y otra vez" },
  { k: "Transferencia", d: "lo que cambia de manos o de sistema" },
  { k: "Espera", d: "lo que se queda parado" },
  { k: "Inconsistencia", d: "lo que cada uno hace a su manera" },
];

const perfiles = ["hotel urbano", "hotel vacacional", "hotel independiente", "pequeña cadena", "establecimiento de otro tamaño"];

const proceso = [
  { k: "Escuchar", d: "Conversaciones con las personas que ejecutan los procesos reales." },
  { k: "Seguir", d: "Observar cómo circulan el trabajo y la información." },
  { k: "Detectar", d: "Identificar las fricciones." },
  { k: "Priorizar", d: "Valorar frecuencia, impacto y esfuerzo." },
  { k: "Decidir", d: "Determinar qué merece atención." },
];

const privacidad = [
  { k: "Anonimizaríamos", d: "Sin nombres de establecimientos ni de personas." },
  { k: "Agruparíamos", d: "Por tipo de fricción, área y perfil de operación." },
  { k: "Compararíamos", d: "Lo que se repite entre varios, no lo que hace uno." },
  { k: "Filtraríamos", d: "Solo patrones que no permitan identificar a ningún participante." },
];

const preguntasRepite = [
  "¿En qué áreas aparecen más tareas manuales?",
  "¿Qué tipo de transferencias son frecuentes?",
  "¿Dónde aparecen más esperas?",
  "¿Qué procesos dependen más de personas concretas?",
  "¿Qué oportunidades podrían resolverse con integración?",
  "¿Dónde aparece la automatización?",
  "¿Dónde aparece la IA?",
  "¿Dónde el problema no es tecnológico?",
];

const respuestas = ["formación", "guías prácticas", "talleres", "proyectos piloto", "casos de uso", "tecnologías"];
const cadenaProv = ["Patrón", "Necesidad", "Soluciones", "Piloto", "Resultado"];
const caminos = ["formación", "investigación", "tecnología", "pilotos", "guías prácticas"];
const uno = ["Seleccionamos un hotel asociado.", "Aplicamos la metodología.", "Entregamos la Radiografía.", "Tú y el hotel valoráis si el resultado es útil."];
const revisado = ["procesos", "sistemas", "aplicaciones", "datos", "integraciones", "oportunidades de mejora"];

// Red de establecimientos: cada uno con su matriz 4×4 (índice = área*4 + señal).
// Ilustrativo. Las celdas 4, 9 y 14 aparecen en varios a la vez.
const patronCeldas = [4, 9, 14];
const red = [
  { k: "A", f: [2, 4, 9, 14] },
  { k: "B", f: [4, 7, 9] },
  { k: "C", f: [0, 9, 11, 14] },
  { k: "D", f: [4, 13, 14] },
  { k: "E", f: [4, 6, 9, 14] },
];
const celdas = Array.from({ length: 16 }, (_, i) => i);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="¿Y si observamos también lo que ocurre dentro de los hoteles? Radiografía Operativa Hotelera: 3–5 hoteles, una misma metodología." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f7f7f5" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#iniciativa">La iniciativa</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="kicker"><i aria-hidden="true"></i>Una idea para Mayte García y HOSBEC</p>
        <p class="greeting">Mayte, HOSBEC conoce muy bien lo que ocurre alrededor de los hoteles.</p>
        <h1 id="hero-title" class="question">¿Y si observamos también lo que ocurre dentro?</h1>
        <p class="hero-sub">Además de medir el mercado, observar las fricciones de la operación.</p>
        <p class="sample"><span class="sample-net" aria-hidden="true"><i></i><i></i><i></i><i class="opt"></i><i class="opt"></i></span>3–5 hoteles. Una misma metodología.</p>

        <div class="hero-grid">
          <div class:list={["video", `video-${VIDEO.orientation}`]} data-video>
            {VIDEO.src && (
              <video class="video-el" preload="none" playsinline controls poster={VIDEO.poster || undefined} aria-label="Vídeo de Luiz Brazão para Mayte García">
                <source src={VIDEO.src} type={VIDEO.type} />
              </video>
            )}
            <button class="video-cover" type="button" data-video-play aria-label={`Reproducir el vídeo de Luiz Brazão, ${VIDEO.duracion}`}>
              <span class="video-net" aria-hidden="true">{celdas.map((c) => <i class:list={{ on: patronCeldas.includes(c) }}></i>)}</span>
              <span class="video-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
              </span>
              <span class="video-meta">
                <span class="video-time">▶ {VIDEO.duracion}</span>
                <span class="video-who">Luiz Brazão · IA Operators</span>
              </span>
            </button>
            <p class="video-note" data-video-note hidden>El vídeo estará disponible en breve.</p>
          </div>

          <div class="hero-copy">
            <p>Ocupación, mercados, estacionalidad y destinos ayudan a entender cómo funciona el negocio desde fuera.</p>
            <p>Pero hay otra capa de información que normalmente no aparece en los datos del sector: <b>cómo circula de verdad el trabajo dentro de un hotel.</b></p>
            <ul class="inside">{dentro.map((t) => <li>{t}</li>)}</ul>
            <p class="hero-strong">Eso es lo que buscamos con una Radiografía Digital.</p>
          </div>
        </div>

        <figure class="ad" aria-label="Ilustración: alrededor del hotel, ocupación, mercados, estacionalidad y destinos; dentro, un proceso con dos fricciones">
          <svg viewBox="0 0 720 300" role="presentation" aria-hidden="true">
            <g class="ad-out">
              <text x="360" y="26" text-anchor="middle">ocupación</text>
              <text x="360" y="292" text-anchor="middle">estacionalidad</text>
              <text x="8" y="156">destinos</text>
              <text x="712" y="156" text-anchor="end">mercados</text>
              <path d="M360 36v22M360 242v22M106 150h40M574 150h40" />
            </g>
            <rect class="ad-box" x="160" y="64" width="400" height="172" rx="14" />
            <text class="ad-k" x="182" y="92">dentro</text>
            <g class="ad-flow">
              <path d="M210 140H510M300 140V200H420" />
              <circle cx="210" cy="140" r="7" />
              <circle cx="300" cy="140" r="7" />
              <circle class="fr" cx="390" cy="140" r="9" />
              <circle cx="510" cy="140" r="7" />
              <circle class="fr" cx="300" cy="200" r="9" />
              <circle cx="420" cy="200" r="7" />
              <text x="390" y="120" text-anchor="middle">espera</text>
              <text x="318" y="224">transferencia</text>
            </g>
          </svg>
          <figcaption>Ilustración. Fuera, el mercado. Dentro, el trabajo.</figcaption>
        </figure>
      </section>

      <!-- Dos capas -->
      <section id="capas" class="section tone" aria-labelledby="capas-title">
        <div class="wrap">
          <p class="kicker" data-reveal><i aria-hidden="true"></i>Dos capas de información</p>
          <h2 id="capas-title" class="sr-only">Dos capas de información</h2>
          <div class="layers" data-reveal>
            <div class="layer">
              <p class="layer-k">Lo que normalmente medimos</p>
              <ul>{medimos.map((t) => <li>{t}</li>)}</ul>
            </div>
            <span class="layer-plus" aria-hidden="true">+</span>
            <div class="layer layer-in">
              <p class="layer-k">Lo que casi nunca medimos</p>
              <ul>{casiNunca.map((t) => <li>{t}</li>)}</ul>
            </div>
          </div>
          <p class="note" data-reveal>Dos perspectivas complementarias. Una no sustituye a la otra.</p>
          <p class="statement" data-reveal>
            <span>Una explica cómo funciona el negocio.</span>
            <span class="accent">La otra puede ayudarnos a entender cómo funciona el trabajo.</span>
          </p>
        </div>
      </section>

      <!-- Fricción -->
      <section id="friccion" class="section wrap" aria-labelledby="friccion-title">
        <div class="split">
          <p class="kicker" data-reveal><i aria-hidden="true"></i>Fricción operativa</p>
          <div>
            <h2 id="friccion-title" class="h2" data-reveal>La eficiencia también deja datos.</h2>
            <ul class="details" data-reveal>{detalles.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}</ul>
            <p class="lede" data-reveal>Por separado parecen pequeños detalles. Observados de forma sistemática,</p>
            <p class="patterns-line" data-reveal>se convierten en <mark class="hl">patrones</mark>.</p>
          </div>
        </div>
      </section>

      <!-- Red -->
      <section id="red" class="section tone" aria-labelledby="red-title">
        <div class="wrap">
          <p class="kicker" data-reveal><i aria-hidden="true"></i>Por qué una asociación</p>
          <h2 id="red-title" class="statement statement-h" data-reveal>
            <span>Un hotel nos enseña un caso.</span>
            <span class="accent">Varios hoteles pueden enseñarnos un patrón.</span>
          </h2>
          <div class="split">
            <span></span>
            <div>
              <p class="lede" data-reveal>No se trataría solo de producir informes individuales. La pregunta interesante es otra:</p>
              <ol class="qlist" data-reveal>{queRepite.map((q, i) => <li style={`--i:${i}`}><span>{pad(i + 1)}</span>{q}</li>)}</ol>
            </div>
          </div>
        </div>
      </section>

      <!-- Método -->
      <section id="metodo" class="section wrap" aria-labelledby="metodo-title">
        <div class="split">
          <p class="kicker" data-reveal><i aria-hidden="true"></i>Radiografía Digital</p>
          <div>
            <h2 id="metodo-title" class="h2" data-reveal>Una misma forma de observar hoteles diferentes.</h2>
            <p class="lede" data-reveal>El Framework 4×4 de IA Operators cruza cuatro áreas del negocio con cuatro señales de fricción. Al ser siempre la misma rejilla, lo que se observa en un establecimiento se puede comparar con lo que se observa en otro.</p>
            <figure class="mx" data-reveal>
              <div class="mx-grid" role="img" aria-label="Matriz de cuatro por cuatro: Captación, Atención, Operación y Gestión cruzadas con Repetición, Transferencia, Espera e Inconsistencia.">
                <span></span>
                {senales.map((s) => <span class="mx-h"><b>{s.k}</b><small>{s.d}</small></span>)}
                {areas.map((a, ai) => (
                  <>
                    <span class="mx-a">{a}</span>
                    {senales.map((_, si) => <span class="mx-c" style={`--i:${ai * 4 + si}`}></span>)}
                  </>
                ))}
              </div>
              <figcaption>Framework 4×4 de IA Operators · 16 puntos de observación por establecimiento</figcaption>
            </figure>
          </div>
        </div>
        <p class="triad" data-reveal><span>Misma metodología.</span><span>Diferentes hoteles.</span><span class="accent">Patrones comparables.</span></p>
      </section>

      <!-- La iniciativa -->
      <section id="iniciativa" class="dark" aria-labelledby="iniciativa-title">
        <div class="section wrap">
          <div class="split">
            <p class="kicker kicker-ink" data-reveal><i aria-hidden="true"></i>Una posible iniciativa con HOSBEC</p>
            <div data-view="pilot">
              <h2 id="iniciativa-title" class="h2 h2-ink" data-reveal>Radiografía Operativa Hotelera</h2>
              <p class="init-sub" data-reveal>Empecemos con 3–5 establecimientos.</p>
              <p class="note note-ink" data-reveal>Es solo una propuesta inicial, no algo acordado.</p>
            </div>
          </div>

          <div class="split">
            <p class="kicker kicker-ink" data-reveal>Quién podría participar</p>
            <div>
              <ul class="profiles" data-reveal>{perfiles.map((p) => <li>{p}</li>)}</ul>
              <p class="lede lede-ink" data-reveal>Por ejemplo. La selección se definiría junto con HOSBEC; no hay una muestra impuesta.</p>
            </div>
          </div>

          <div class="split">
            <p class="kicker kicker-ink" data-reveal>En cada hotel</p>
            <div>
              <ol class="path" data-reveal>
                {proceso.map((p, i) => (
                  <li style={`--i:${i}`}>
                    <span class="path-dot" aria-hidden="true"></span>
                    <b>{p.k}</b>
                    <span>{p.d}</span>
                  </li>
                ))}
              </ol>
              <p class="init-out" data-reveal>Cada establecimiento recibiría su propia Radiografía. <span>Los resultados específicos son confidenciales.</span></p>
            </div>
          </div>
        </div>
      </section>

      <!-- Confidencialidad -->
      <section id="confidencialidad" class="section wrap" aria-labelledby="conf-title">
        <div class="split">
          <p class="kicker" data-reveal><i aria-hidden="true"></i>Confidencialidad</p>
          <div>
            <h2 id="conf-title" class="statement statement-h statement-tight" data-reveal>
              <span>El hotel recibe su diagnóstico.</span>
              <span class="accent">HOSBEC recibe patrones, no secretos.</span>
            </h2>
            <div class="lanes" data-reveal>
              <div class="lane">
                <p class="lane-who">Cada hotel</p>
                <span class="lane-line" aria-hidden="true"></span>
                <p class="lane-what">Su Radiografía completa<small>Solo para el establecimiento</small></p>
              </div>
              <div class="lane lane-b">
                <p class="lane-who">HOSBEC</p>
                <span class="lane-line" aria-hidden="true"></span>
                <p class="lane-what">Patrones agregados<small>Sin datos que identifiquen a nadie</small></p>
              </div>
            </div>
            <p class="lede" data-reveal>La información operativa de cada hotel se quedaría en ese hotel. Para el análisis conjunto:</p>
            <ol class="privacy" data-reveal>{privacidad.map((p, i) => <li style={`--i:${i}`}><b>{p.k}</b><span>{p.d}</span></li>)}</ol>
          </div>
        </div>
        <p class="big" data-reveal>Compartir aprendizaje sin compartir información sensible.</p>
      </section>

      <!-- ¿Qué se repite? -->
      <section id="repite" class="section tone" aria-labelledby="repite-title">
        <div class="wrap">
          <p class="kicker" data-reveal><i aria-hidden="true"></i>Segunda capa</p>
          <p class="pre" data-reveal>Después de las Radiografías individuales aparece otra pregunta.</p>
          <h2 id="repite-title" class="mega" data-reveal>¿Qué se repite?</h2>

          <figure class="net" data-reveal aria-label="Ilustración: cinco establecimientos con su propia matriz de cuatro por cuatro; al compararlos, tres celdas coinciden en varios a la vez">
            <div class="net-row">
              {red.map((h, hi) => (
                <div class="net-h" style={`--h:${hi}`}>
                  <p>Hotel {h.k}</p>
                  <span class="net-m">{celdas.map((c) => <i class:list={{ f: h.f.includes(c), p: h.f.includes(c) && patronCeldas.includes(c) }} style={`--i:${c}`}></i>)}</span>
                </div>
              ))}
              <div class="net-h net-sum">
                <p>Patrones observados</p>
                <span class="net-m">{celdas.map((c) => <i class:list={{ p: patronCeldas.includes(c) }} style={`--i:${c}`}></i>)}</span>
              </div>
            </div>
            <figcaption>Ilustración, no datos. La misma rejilla en cada establecimiento permite ver qué coincide.</figcaption>
          </figure>

          <div class="split">
            <span></span>
            <div>
              <p class="lede" data-reveal>Algunas dimensiones que el piloto podría explorar:</p>
              <ol class="qlist" data-reveal>{preguntasRepite.map((q, i) => <li style={`--i:${i}`}><span>{pad(i + 1)}</span>{q}</li>)}</ol>
              <p class="note" data-reveal>No tenemos estas respuestas. Son las preguntas que el piloto intentaría contestar.</p>
              <p class="caveat" data-reveal>Con 3–5 establecimientos no hablaríamos de un benchmark representativo del sector valenciano, sino de <b>patrones observados</b> y <b>señales recurrentes</b>: un primer mapa exploratorio. Si más adelante la muestra creciera, podría convertirse en algo más sólido.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Datos + operación -->
      <section id="datos" class="section wrap" aria-labelledby="datos-title">
        <div class="split">
          <p class="kicker" data-reveal><i aria-hidden="true"></i>Datos y operación</p>
          <div>
            <h2 id="datos-title" class="h2" data-reveal>HOSBEC ya convierte actividad turística en información.</h2>
            <p class="lede" data-reveal>Lleva desde 1985 recogiendo datos de ocupación de sus asociados. La pregunta es si podríamos hacer algo parecido con otra materia prima:</p>
            <p class="h2 h2-accent q-op" data-reveal>¿Podríamos convertir también la operación en conocimiento?</p>
          </div>
        </div>
        <div class="eq" data-reveal aria-label="Datos de mercado más patrones operativos igual a mejores preguntas para el sector">
          <p class="eq-a">Datos de mercado</p>
          <span class="eq-op" aria-hidden="true">+</span>
          <p class="eq-b">Patrones operativos</p>
          <span class="eq-op" aria-hidden="true">=</span>
          <p class="eq-c">Mejores preguntas para el sector</p>
        </div>
        <div class="split">
          <span></span>
