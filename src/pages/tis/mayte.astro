      .path::before { content: ""; position: absolute; left: 6px; top: 10px; bottom: 10px; width: 1px; background: var(--dark-line); }
      .path li { position: relative; display: grid; gap: 2px; padding-left: 30px; }
      .path-dot { position: absolute; left: 0; top: .42em; width: 13px; height: 13px; border-radius: 4px; background: var(--dark); box-shadow: inset 0 0 0 1.5px var(--berry-ink); }
      .path li:nth-child(3) .path-dot { background: var(--berry-ink); }
      .path b { font-size: clamp(22px, 2.4vw, 32px); font-weight: 500; letter-spacing: -.04em; line-height: 1.15; }
      .path span:not(.path-dot) { font-size: 15px; color: var(--dark-muted); }
      .init-out { margin-top: 30px; padding: 18px; border-radius: 10px; background: var(--dark-2); box-shadow: inset 0 0 0 1px var(--dark-line); font-size: clamp(19px, 1.9vw, 25px); font-weight: 500; letter-spacing: -.03em; line-height: 1.3; }
      .init-out span { display: block; margin-top: 6px; color: var(--berry-ink); }

      /* Confidencialidad */
      .lanes { display: grid; gap: 10px; margin-top: 28px; }
      .lane { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 10px; background: #fff; box-shadow: inset 0 0 0 1px var(--line); }
      .lane-who { font-weight: 650; letter-spacing: -.01em; }
      .lane-line { height: 1px; background: var(--line-strong); }
      .lane-what { display: grid; text-align: right; font-weight: 600; letter-spacing: -.01em; }
      .lane-what small { font-size: 12px; font-weight: 500; color: var(--muted); }
      .lane-b { background: var(--berry); box-shadow: none; color: #fff; }
      .lane-b .lane-line { background: rgba(255, 255, 255, .45); }
      .lane-b .lane-what small { color: rgba(255, 255, 255, .75); }
      .privacy { display: grid; margin-top: 16px; border-top: 1px solid var(--line); }
      .privacy li { display: grid; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--line); }
      .privacy b { font-size: clamp(19px, 1.8vw, 23px); font-weight: 600; letter-spacing: -.025em; }
      .privacy span { font-size: 15px; color: var(--muted); }

      /* Red de establecimientos */
      .net { margin-top: 44px; }
      .net-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
      .net-h { padding: 12px; border-radius: 10px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line-strong); }
      .net-h p { font-size: 12px; font-weight: 650; color: var(--muted); }
      .net-m { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; margin-top: 10px; }
      .net-m i { aspect-ratio: 1; border-radius: 3px; background: var(--tone); }
      .net-m i.f { background: #8d8e94; }
      .net-m i.p { background: var(--berry); }
      .net-h:not(.net-sum) .net-m i.f:not(.p) { background: transparent; box-shadow: inset 0 0 0 1.5px #b9b9bd; }
      .net-sum { background: var(--ink); box-shadow: none; }
      .net-sum p { color: var(--berry-ink); }
      .net-sum .net-m i { background: #2b2a30; }
      .net-sum .net-m i.p { background: var(--berry-2); }
      .net figcaption { margin-top: 12px; font-size: 12px; color: var(--muted); }
      .caveat { margin-top: 24px; max-width: 36em; padding: 14px 16px; border-left: 2px solid var(--berry); background: var(--paper); font-size: 15px; line-height: 1.55; color: var(--text); }
      .caveat b { font-weight: 650; color: var(--ink); }

      /* Datos + operación */
      .q-op { margin-top: 24px; }
      .eq { display: grid; gap: 8px; margin-top: 44px; }
      .eq p { padding: 18px; border-radius: 10px; font-size: clamp(20px, 2.2vw, 30px); font-weight: 500; letter-spacing: -.035em; line-height: 1.15; }
      .eq-a { background: #fff; box-shadow: inset 0 0 0 1px var(--line-strong); color: var(--muted); }
      .eq-b { background: var(--berry-soft); color: var(--berry); }
      .eq-c { background: var(--ink); color: #fff; }
      .eq-op { justify-self: center; font-size: 30px; font-weight: 300; line-height: 1; color: var(--soft); }

      /* Formación */
      .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
      .chips li { padding: 6px 12px; border-radius: 999px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line-strong); font-size: 15px; font-weight: 500; }
      .chips-sm li { font-size: 13px; padding: 4px 10px; }

      /* Proveedores */
      .talk { display: grid; gap: 10px; margin-top: 26px; }
      .talk p { display: grid; gap: 6px; padding: 18px 16px; border-radius: 10px; font-size: clamp(20px, 2.1vw, 28px); font-weight: 500; letter-spacing: -.035em; line-height: 1.2; }
      .talk small { font-size: 12px; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; }
      .talk-a { color: var(--soft); box-shadow: inset 0 0 0 1px var(--line); }
      .talk-b { background: var(--ink); color: #fff; }
      .talk-b small { color: var(--berry-ink); }
      .chain { display: flex; flex-wrap: wrap; gap: 10px 0; margin-top: 28px; }
      .chain li { position: relative; padding-right: 42px; font-size: clamp(18px, 1.9vw, 24px); font-weight: 500; letter-spacing: -.03em; }
      .chain li:not(:last-child)::after { content: "→"; position: absolute; right: 14px; color: var(--soft); font-weight: 400; }
      .chain li.first { color: var(--berry); }

      /* Ecosistema */
      .stack { display: grid; gap: 6px; margin-top: 26px; }
      .stack li { display: grid; gap: 2px; padding: 14px 16px; border-radius: 10px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line-strong); font-size: clamp(17px, 1.7vw, 21px); font-weight: 600; letter-spacing: -.02em; }
      .stack small { font-size: 12px; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
      .stack-mine { background: var(--berry) !important; box-shadow: none !important; color: #fff; }
      .stack-mine small { color: rgba(255, 255, 255, .75); }

      /* Resultado */
      .out { display: grid; gap: 10px; margin-top: 26px; }
      .out-hotels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
      .out-hotels p { display: grid; gap: 2px; padding: 12px; border-radius: 10px; background: #fff; box-shadow: inset 0 0 0 1px var(--line-strong); }
      .out-hotels b { font-size: 15px; font-weight: 650; }
      .out-hotels small { font-size: 12px; line-height: 1.3; color: var(--muted); }
      .out-step { position: relative; display: flex; justify-content: center; height: 34px; }
      .out-step::before { content: ""; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: var(--line-strong); }
      .out-step span { position: relative; align-self: center; padding: 0 8px; background: var(--paper); font-size: 12px; font-weight: 600; color: var(--muted); }
      .out-pat { padding: 14px 16px; border-radius: 10px; background: var(--berry); color: #fff; text-align: center; font-size: clamp(19px, 2vw, 25px); font-weight: 600; letter-spacing: -.03em; }
      .chips-out { justify-content: center; margin-top: 0; }

      /* Empezar con uno */
      .steps { display: grid; margin-top: 30px; border-top: 1px solid var(--line-strong); }
      .steps li { display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line-strong); font-size: clamp(19px, 1.8vw, 24px); font-weight: 500; letter-spacing: -.025em; }
      .steps li span { font-size: 12px; font-weight: 650; color: var(--berry); }
      .then { display: grid; gap: 6px; margin-top: 28px; }
      .then span { color: var(--muted); }
      .then b { font-size: clamp(26px, 3vw, 40px); font-weight: 500; letter-spacing: -.045em; line-height: 1.15; }

      /* Experiencia */
      .exp p { margin-top: 12px; max-width: 34em; color: var(--text); }
      .link { display: inline-flex; gap: 6px; margin-top: 16px; font-weight: 600; color: var(--berry); border-bottom: 1px solid currentColor; }

      /* CTA */
      .cta-q { margin-top: 16px; max-width: 11em; font-size: clamp(40px, 7.2vw, 106px); font-weight: 500; letter-spacing: -.06em; line-height: .98; }
      .cta-row { display: grid; gap: 40px; margin-top: 30px; }
      .cta-row .lede { margin-top: 0; }
      .cta-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 26px; }
      .button { display: inline-flex; align-items: center; gap: 22px; min-height: 52px; padding: 0 24px; border-radius: 999px; background: var(--berry); color: #fff; font-weight: 650; transition: background-color .2s ease; }
      .button:hover { background: var(--ink); }
      .mail { font-size: 14px; color: var(--muted); border-bottom: 1px solid var(--line-strong); }
      .mail:hover { color: var(--ink); }
      .signature { padding-top: 16px; border-top: 1px solid var(--line-strong); }
      .signature-name { font-weight: 650; letter-spacing: -.02em; }
      .signature-role { font-size: 14px; color: var(--muted); }
      .signature-site { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--berry); }

      /* Pie y consentimiento */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding-block: 26px 30px; font-size: 13px; color: var(--muted); }
      .foot-brand { margin-right: auto; font-weight: 650; color: var(--ink); letter-spacing: -.02em; }
      .foot a:hover { color: var(--ink); }
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; background: var(--dark); color: var(--dark-text); font-size: 13px; line-height: 1.5; border-radius: 10px; border: 1px solid #3c3440; box-shadow: 0 10px 30px rgba(0, 0, 0, .16); }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; }
      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 38px; padding: 0 16px; border: 1px solid #3c3440; border-radius: 999px; background: transparent; color: var(--dark-text); font: inherit; cursor: pointer; }
      .consent .consent-accept { background: var(--dark-text); color: var(--dark); border-color: var(--dark-text); }

      /* Movimiento discreto */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }
      .js .hl { background-size: 0% .42em; transition: background-size .9s var(--ease) .5s; }
      .js .patterns-line.is-in .hl { background-size: 100% .42em; }
      .js .mx-c { transition: background-color .4s ease calc(.25s + var(--i) * 40ms), box-shadow .4s ease calc(.25s + var(--i) * 40ms); }
      .js .mx:not(.is-in) .mx-c { background: transparent; box-shadow: inset 0 0 0 1px var(--line); }
      .js .net-m i { transition: background-color .5s ease calc(.6s + var(--h, 0) * 120ms), box-shadow .5s ease calc(.6s + var(--h, 0) * 120ms); }
      .js .net:not(.is-in) .net-h:not(.net-sum) .net-m i.f { background: #8d8e94; box-shadow: none; }
      .js .net:not(.is-in) .net-sum .net-m i.p { background: #2b2a30; }
      .js .net-sum .net-m i { transition-delay: 1.4s; }
      .js .path li { opacity: .3; transition: opacity .5s ease calc(.2s + var(--i) * 140ms); }
      .js .path.is-in li { opacity: 1; }

      @media (min-width: 420px) {
        .top-link { display: inline; }
      }

      @media (min-width: 560px) {
        .net-row { grid-template-columns: repeat(6, minmax(0, 1fr)); }
        .mx-h { font-size: 12px; }
      }

      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .layers { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: stretch; gap: 18px; }
        .layer { padding: 24px; }
        .layer-plus { align-self: center; }
        .mx { padding: 24px; }
        .mx-grid { gap: 8px; }
        .mx-h small { display: block; }
        .mx-a { font-size: 15px; }
        .mx-c { min-height: 40px; aspect-ratio: auto; }
        .lanes { grid-template-columns: 1fr; }
        .eq { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr); align-items: stretch; gap: 14px; }
        .eq-op { align-self: center; }
        .talk { grid-template-columns: 1fr 1fr; }
        .path { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
        .path::before { left: 6px; right: 0; top: 6px; bottom: auto; width: auto; height: 1px; }
        .path li { padding-left: 0; padding-top: 26px; }
        .path-dot { top: 0; }
        .cta-row { grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }

      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 36px; padding-bottom: 112px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 44px; align-items: start; }
        .ad { margin-top: 88px; }
        .section { padding-block: 124px; }
        .section-tight { padding-block: 88px; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .split + .split, .split + .triad, .split + .big, .split + .statement, .eq + .split, .net + .split { margin-top: 64px; }
        .statement { margin-top: 64px; }
        .statement-h { margin-top: 18px; }
        .split .statement-h { margin-top: 0; }
        .triad, .big { margin-top: 80px; }
        .net { margin-top: 64px; }
        .net-row { gap: 14px; }
        .net-h { padding: 16px; }
        .net-m { gap: 6px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .hl { background-size: 100% .42em; transition: none; }
        .js .mx-c, .js .net-m i, .js .path li { transition: none; }
        .js .mx:not(.is-in) .mx-c { background: var(--tone); }
        .js .net:not(.is-in) .net-h:not(.net-sum) .net-m i.f:not(.p) { background: transparent; box-shadow: inset 0 0 0 1.5px #b9b9bd; }
        .js .net:not(.is-in) .net-h .net-m i.p { background: var(--berry); }
        .js .net:not(.is-in) .net-sum .net-m i.p { background: var(--berry-2); }
        .js .path li { opacity: 1; }
        .video-play, .top, .button, .top-cta { transition: none; }
      }
    </style>
  </body>
</html>
