---
import PresenterVideo from "../../components/PresenterVideo.astro";
// Landing personalizada para Humberto Moreno, de AR Hotels & Resorts (Calpe;
// hoteles, spas y restaurantes; expansión a Tenerife, Ibiza, Palma, Valencia
// y Elche según Hosteltur 28/11/2025). El cartel de TIS le pone «CCO», pero
// el moderador le presentó como CEO desde hacía tres o cuatro meses («recién
// aterrizado»): en la página no se usa ningún cargo. Creada el 13/11/2026.
// Privada: noindex,nofollow y fuera del sitemap ("/tis/" en NOINDEX_PATHS).
//
// Sesión de TIS 07/10/2026, 13:00, «The new digital economy of Tourism»,
// moderada por Roberto Torregrosa (ACPT), con Eduvigis Ortiz (Women4Cyber
// Spain), Joni Leal (Expedia) y Xavier Canalis (Hosteltur). Verificado contra
// la transcripción oficial del vídeo (13/11/2026). Solo turnos que el
// moderador abre con su nombre:
//   - 28:52-29:09: plantilla de unas 450-500 personas (75-80 en la central).
//   - 45:00-46:10 («Humberto, ¿habéis tenido algún ciberataque?»): «Afortu-
//     nadamente, no. Toca madera». Manual de continuidad operativa: si se cae
//     el PMS, un «backup» manual para que recepción y pisos se comuniquen y no
//     se dupliquen asignaciones; si se cae el channel manager o el motor,
//     alguien atento a capar las ventas; los TPV y la consolidación del
//     consumo. «Ocurra lo que ocurra, no podemos dejar de alojar, atender y
//     cobrar». Falta la práctica (simulacros).
//   - 54:56-56:20 (cierre): la IA, revolución tecnológica. Mucha gente se le
//     acerca a venderle tecnología y hace siempre tres preguntas: ¿me va a
//     ayudar a mejorar mis ingresos?, ¿a reducir mis gastos?, ¿a conocer mejor
//     a mi cliente? Plan de adopción de IA «muy incipiente»; le encantaría
//     volver el año que viene y decir «Oye, Roberto, estos han sido los
//     resultados». Tienen una IA conversacional integrada con el motor de
//     reservas y estudian qué porcentaje de consultas responde, qué negocio
//     aporta y, sobre todo, cuándo debe parar y remitir a un equipo humano.
//     «No nos olvidemos de las personas».
//   - No se usa 46:45-47:31 (simulacro: mezcla de voces) ni 38:54 (respuesta
//     de Expedia).
//
// Ya tienen asistente conversacional integrado con el motor: NO se empuja el
// enlace a /es/hoteles/reservas-directas-ia/ en el cuerpo (solo el menú).
// Concepto: los resultados del año que viene se miden desde hoy (línea base
// del asistente con sus tres preguntas) y, de paso, el mapa de dependencias
// para su manual de continuidad.
//
// Comportamiento compartido en src/scripts/prospect-landing.ts.

// --- Configuración editable ---------------------------------------------------
const VIDEO = {
  // Vídeo de Luiz con fondo blanco, fundido con la página (PresenterVideo).
  src: "/video/luiz-tis.mp4",
  poster: "/video/luiz-tis-poster.jpg",
  duracion: "1 min 24 s",
};

const wa = (t: string) => `https://wa.me/34662423523?text=${encodeURIComponent(t)}`;
const CONTACT_HREF = wa("Hola Luiz, soy Humberto Moreno, de AR Hotels & Resorts. He visto la página que preparaste después de TIS y me gustaría hablarlo.");
const INTRO_HREF = wa("Hola Luiz, soy Humberto Moreno, de AR Hotels & Resorts. Te pongo en contacto con la persona que lleva el asistente: ");
const GTM_ID = "GTM-572KJ7HZ";
// -----------------------------------------------------------------------------

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const pageUrl = new URL("/tis/humberto/", site).toString();
const ogImage = new URL("/og/humberto.png", site).toString();
const title = "Humberto Moreno × IA Operators | Radiografía Digital";
const description = "Después de «La nueva economía digital del turismo» en TIS: los resultados que quieres contar el año que viene se miden desde hoy. Una reflexión preparada por IA Operators para Humberto Moreno y AR Hotels & Resorts.";

const pad = (n: number) => String(n).padStart(2, "0");

// Sus tres preguntas ante cualquier tecnología.
const filtro = [
  { q: "¿Me va a ayudar a mejorar mis ingresos?", d: "Más reservas, más venta, mejor precio." },
  { q: "¿Me va a ayudar a reducir mis gastos?", d: "Menos horas en tareas que no ve el huésped." },
  { q: "¿Me va a ayudar a conocer mejor a mi cliente?", d: "Y, por tanto, a conseguir la primera o la segunda." },
];

// Lo que estáis estudiando del asistente.
const metricas = [
  { k: "Consultas que responde", d: "qué porcentaje resuelve sin ayuda" },
  { k: "Negocio que aporta", d: "reservas y ventas después de la conversación" },
  { k: "Cuándo para", d: "en qué casos debe pasar a una persona" },
];

// Su lista de continuidad, convertida en mapa.
const deps = [
  { s: "PMS", p: "Recepción y pisos se coordinan a mano para no duplicar habitaciones" },
  { s: "channel manager", p: "Alguien tiene que capar las ventas en cada canal" },
  { s: "motor de reservas", p: "Se para la venta directa y, con ella, el asistente" },
  { s: "TPV", p: "El consumo hay que consolidarlo después" },
];

const pasos = [
  "Elegimos un hotel y un mes de conversaciones del asistente.",
  "Medimos qué contestó, qué pasó a una persona y qué acabó en reserva o en otra venta.",
  "Seguimos esas reservas y los datos del huésped hasta el PMS, para ver si de verdad sirven para conocerle mejor.",
  "Y dejamos el mapa de qué depende de cada sistema: la base técnica de vuestro manual de continuidad.",
];

const reservas = [
  { k: "Consulta A", d: "la IA responde y acaba en reserva" },
  { k: "Consulta B", d: "la IA deriva a recepción" },
  { k: "Consulta C", d: "nadie la cierra" },
];
const tramo = ["Pregunta", "Respuesta", "Derivación", "Reserva", "PMS"];
const friccion: Record<number, number[]> = { 0: [], 1: [2], 2: [1, 2, 3, 4] };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IA Operators" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Los resultados del año que viene se miden desde hoy. Una idea para Humberto Moreno y AR Hotels &amp; Resorts." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f6f5f1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body data-gtm={GTM_ID}>
    <header class="top" data-top>
      <div class="wrap top-inner">
        <a class="wordmark" href="#inicio" aria-label="IA Operators, volver al inicio de la página"><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
        <nav class="top-nav" aria-label="Página">
          <a class="top-link" href="#radiografia">Radiografía Digital</a>
          <a class="top-link top-link-x" href="/es/hoteles/" data-cta="nav_hoteles">Hoteles</a>
          <a class="top-link top-link-x" href="/es/hoteles/reservas-directas-ia/" data-cta="nav_reservas_directas">Reservas directas</a>
          <a class="top-cta" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="header" data-cta-event="click_contact">Hablar con Luiz</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section id="inicio" class="hero wrap" aria-labelledby="hero-title">
        <p class="label">Después de «La nueva economía digital del turismo» · TIS 2026</p>
        <h1 id="hero-title" class="greeting">Humberto, en TIS dijiste que te encantaría volver el año que viene y decir: <b>«Oye, Roberto, estos han sido los resultados».</b></h1>
        <p class="big">Los resultados del año que viene<span>se miden desde hoy.</span></p>

        <div class="hero-grid">
          <PresenterVideo src={VIDEO.src} poster={VIDEO.poster} label="Vídeo de Luiz Brazão para Humberto Moreno" duracion={VIDEO.duracion} />

          <div class="hero-copy">
            <p>Te escuché en la mesa que moderó Roberto Torregrosa, con Eduvigis Ortiz, Joni Leal y Xavier Canalis, recién aterrizado en AR Hotels &amp; Resorts.</p>
            <p>Contaste que vuestro plan de adopción de IA es todavía incipiente y que ya tenéis una IA conversacional integrada con el motor de reservas. Y que estáis estudiando tres cosas: qué porcentaje de consultas es capaz de responder, qué negocio aporta y cuándo debe parar y pasar a una persona.</p>
            <p class="hero-strong">Me gustaría proponerte algo para que esas tres respuestas tengan cifras.</p>
          </div>
        </div>
      </section>

      <!-- Preguntas -->
      <section id="preguntas" class="section wrap" aria-labelledby="pq-title">
        <div class="split">
          <p class="label label-accent" data-reveal>01 · Tus tres preguntas</p>
          <div>
            <h2 id="pq-title" class="h2" data-reveal>Se acerca muchísima gente a venderte tecnología.</h2>
            <p class="lede" data-reveal>Y a todos les haces las mismas tres preguntas. Lo contaste al final de la mesa.</p>
            <ol class="filter" data-reveal>
              {filtro.map((f, i) => (
                <li class:list={{ "filter-last": i === filtro.length - 1 }}>
                  <span class="n">{pad(i + 1)}</span>
                  <div>
                    <p class="filter-q">{f.q}</p>
                    <p class="filter-d">{f.d}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="statement" data-reveal>
              <span class="muted">Yo también soy de los que se acercan.</span>
              <span>Así que esta página contesta a las tres.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Asistente -->
      <section id="asistente" class="panel" aria-labelledby="as-title">
        <div class="wrap section">
          <div class="split">
            <p class="label" data-reveal>02 · El asistente</p>
            <div>
              <h2 id="as-title" class="h2" data-reveal>Cuánto responde, qué aporta y cuándo para.</h2>
              <p class="lede" data-reveal>Son las tres cosas que dijiste que estáis estudiando. Y son justo las que, dentro de un año, convierten «tenemos un asistente» en «estos han sido los resultados».</p>
              <figure class="board" data-reveal aria-label="Las tres métricas del asistente, con su línea base de hoy y el resultado en TIS 2027 todavía por medir">
                <div class="board-head"><span></span><span>Hoy</span><span>TIS 2027</span></div>
                {metricas.map((m, i) => (
                  <div class="board-row" style={`--i:${i}`}>
                    <p class="board-k"><b>{m.k}</b><span>{m.d}</span></p>
                    <span class="board-cell board-now">por fijar</span>
                    <span class="board-cell board-next">?</span>
                  </div>
                ))}
                <figcaption>Si la línea base no se fija hoy, el año que viene no hay con qué comparar.</figcaption>
              </figure>
              <p class="prose-line prose-ink" data-reveal>Y dijiste algo más, que para mí es lo importante: encontrar cuándo debe parar y pasar a un equipo humano que aporte un poco más de criterio. No nos olvidemos de las personas.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Continuidad -->
      <section id="continuidad" class="night" aria-labelledby="co-title">
        <div class="wrap section">
          <p class="label label-night" data-reveal>03 · La continuidad</p>
          <h2 id="co-title" class="h2 h2-wide" data-reveal>Ocurra lo que ocurra, no podéis dejar de alojar, atender y cobrar.</h2>
          <div class="split split-tight">
            <span></span>
            <div>
              <p class="prose-line prose-night" data-reveal>Cuando Roberto te preguntó por los ciberataques, no hablaste de antivirus. Hablaste de operación: un manual de continuidad para cuando se cae un sistema. Y lo enumeraste casi entero.</p>
              <figure class="deps" data-reveal aria-label="Qué se para en el hotel cuando cae cada sistema, según lo que contó en la mesa">
                <ul>
                  {deps.map((d, i) => (
                    <li style={`--i:${i}`}><b>Si cae el {d.s}</b><span>{d.p}</span></li>
                  ))}
                </ul>
                <figcaption>Tu lista, convertida en mapa.</figcaption>
              </figure>
              <p class="prose-line prose-night" data-reveal>Dijiste también que quizá lo que falta es la práctica. Y hay un detalle que conviene tener presente: con el asistente integrado con el motor, cada sistema nuevo es también una dependencia nueva.</p>
            </div>
          </div>
          <p class="huge" data-reveal>Cada sistema nuevo, una dependencia nueva.</p>
        </div>
      </section>

      <!-- Radiografía -->
      <section id="radiografia" class="panel" aria-labelledby="rd-title">
        <div class="wrap section">
          <div class="split">
            <p class="label label-accent" data-reveal>04 · Radiografía Digital</p>
            <div>
              <h2 id="rd-title" class="h2" data-reveal>Medir lo que ya tenéis antes de añadir nada.</h2>
              <p class="lede" data-reveal>Una Radiografía Digital no evalúa proveedores ni propone una plataforma. Sigue el trabajo real a través de los sistemas y las personas que lo tocan.</p>
              <ol class="steps" data-reveal>{pasos.map((p, i) => <li><span class="n">{pad(i + 1)}</span>{p}</li>)}</ol>
              <p class="prose-line" data-reveal>El resultado no es una lista de ideas. Es la línea base del asistente con tus tres preguntas delante, y el mapa de dependencias que vuestro manual necesita.</p>
              <p class="prose-line" data-reveal>En una cadena de cuatro hoteles en Menorca, la dirección declaraba unas 25 herramientas. Encontramos 47, y un 23 % del gasto en SaaS que se podía recortar. <a class="inline-link" href="/es/portfolio/radiografia-cadena-hotelera-menorca/" data-cta="case">Ver el caso</a></p>
              <ul class="nots" data-reveal>
                <li>No sustituimos vuestro asistente: lo medimos.</li>
                <li>No vendemos un chatbot ni un PMS.</li>
                <li>No tenemos una plataforma que colocar.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Propuesta -->
      <section id="propuesta" class="section wrap" aria-labelledby="pr-title">
        <div class="split">
          <p class="label label-accent" data-reveal>Una idea concreta</p>
          <div>
            <h2 id="pr-title" class="h2 h2-pair" data-reveal><span>No esperemos a TIS 2027.</span><span class="h2-accent">Fijemos hoy la línea base.</span></h2>
            <p class="lede" data-reveal>Un hotel y un mes de conversaciones. Qué responde la IA, qué pasa a recepción, qué acaba en reserva y qué se queda sin cerrar.</p>
            <figure class="cmp" data-reveal aria-label="Ejemplo ilustrativo: tres consultas al asistente y los tramos donde se pierden">
              {reservas.map((h, r) => (
                <div class="cmp-row">
                  <p class="cmp-k"><b>{h.k}</b><span>{h.d}</span></p>
                  <ol class="cmp-steps">
                    {tramo.map((p, c) => <li class:list={{ hot: friccion[r].includes(c) }} style={`--i:${r * 5 + c}`}>{p}</li>)}
                  </ol>
                </div>
              ))}
              <figcaption>Ejemplo ilustrativo. En naranja, los tramos donde la consulta necesita a una persona o se pierde.</figcaption>
            </figure>
            <p class="prose-line" data-reveal>Lo haríamos con quien lleve el asistente y con el equipo de recepción del hotel elegido.</p>
            <p class="worth" data-reveal>¿Qué le vas a contar a Roberto el año que viene?</p>
          </div>
        </div>
      </section>

      <!-- Cierre -->
      <section id="cierre" class="closing wrap" aria-labelledby="ci-title">
        <p class="cl-1" data-reveal>Ingresos, gastos, cliente.</p>
        <h2 id="ci-title" class="cl-big" data-reveal>Con cifras.</h2>
        <p class="cl-3" data-reveal>Ese es el trabajo que me gustaría enseñarte, o enseñar a quien lleve el asistente en AR.</p>
      </section>

      <!-- CTA -->
      <section id="hablar" class="cta" aria-labelledby="cta-title">
        <div class="wrap section">
          <h2 id="cta-title" class="h2 cta-title" data-reveal>Si te parece una conversación útil, seguimos.</h2>
          <p class="cta-copy" data-reveal>En 20 minutos puedo enseñarte cómo hacemos una Radiografía Digital y un ejemplo real en una cadena hotelera.</p>
          <div class="cta-row" data-reveal>
            <div class="buttons">
              <a class="button" href={CONTACT_HREF} target="_blank" rel="noopener" data-cta="final" data-cta-event="click_contact">Hablar con Luiz <span aria-hidden="true">↗</span></a>
              <a class="button button-ghost" href={INTRO_HREF} target="_blank" rel="noopener" data-cta="intro" data-cta-event="click_introduction">Presentarme a la persona adecuada <span aria-hidden="true">↗</span></a>
            </div>
            <div class="signature">
              <p class="signature-name">Luiz Brazão</p>
              <p class="signature-role">Founder, IA Operators</p>
              <a class="signature-site" href="https://iaoperators.com/es/" data-cta="site">iaoperators.com</a>
            </div>
          </div>
        </div>
      </section>
    </main>


    <footer class="foot">
      <div class="wrap foot-inner">
        <span class="foot-brand"><img src="/brand/ia-operators-logo.png" alt="IA Operators" width="453" height="82" loading="lazy" /></span>
        <a href="/es/auditoria-de-sistemas/">Radiografía Digital</a>
        <a href="https://iaoperators.com/es/">iaoperators.com</a>
      </div>
    </footer>

    <div class="consent" data-consent hidden role="region" aria-label="Cookies">
      <p>Usamos cookies para medir y mejorar la experiencia. Puedes aceptar o rechazar. <a href="/es/politica-de-privacidad/">Política de Privacidad</a>.</p>
      <div class="consent-actions">
        <button type="button" data-consent-reject>Rechazar</button>
        <button type="button" class="consent-accept" data-consent-accept>Aceptar</button>
      </div>
    </div>

    <script>
      import { initProspectLanding } from "../../scripts/prospect-landing";
      initProspectLanding({ landing: "humberto", gtmId: document.body.dataset.gtm ?? "", videoTitle: "humberto_luiz", scrollMarks: [50, 90] });
    </script>

    <style is:global>
      @font-face {
        font-family: "Manrope JG";
        src: url("/fonts/manrope-latin-variable.woff2") format("woff2");
        font-weight: 200 800;
        font-display: swap;
      }
      :root {
        --paper: #f6f5f1;
        --panel: #ecebe5;
        --ink: #15171a;
        --text: #2c2f33;
        --muted: #62666b;
        --soft: #9a9da1;
        --line: #dfded8;
        --line-strong: #c3c2bb;
        --slate: #24425a;
        --slate-soft: #9fb2c1;
        --orange: #f16532;
        --orange-ink: #b4441a;
        --night: #121417;
        --night-text: #f1f1ee;
        --night-line: #2b2f34;
        --gutter: 20px;
        --ease: cubic-bezier(.2, .7, .2, 1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 72px; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Manrope JG", "Helvetica Neue", Arial, sans-serif; font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums; }
      h1, h2, h3, p, ol, ul, dl, dd, figure, blockquote { margin: 0; }
      ol, ul { padding: 0; list-style: none; }
      a { color: inherit; text-decoration: none; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
      .wrap { width: 100%; max-width: 1240px; margin-inline: auto; padding-inline: var(--gutter); }
      .label { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .label::before { content: ""; width: 7px; height: 7px; background: var(--slate); }
      .label-accent::before { background: var(--orange); }
      .label-night { color: #9a9ea3; }
      .label-night::before { background: var(--slate-soft); }
      .muted { color: var(--soft); }

      /* Cabecera */
      .top { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid transparent; transition: background-color .3s ease, border-color .3s ease; }
      .top.is-scrolled { background: rgba(246, 245, 241, .9); border-bottom-color: var(--line); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
      .top-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 60px; }
      .wordmark img { display: block; width: auto; height: 22px; }
      .foot-brand img { display: block; width: auto; height: 18px; }
      .top-nav { display: flex; align-items: center; gap: 22px; font-size: 13px; }
      .top-link { display: none; color: var(--muted); }
      .top-link:hover { color: var(--ink); }
      .top-cta { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; background: var(--slate); color: var(--night-text); font-weight: 600; white-space: nowrap; transition: background-color .2s ease; }
      .top-cta:hover { background: var(--ink); }

      /* Hero */
      .hero { padding-top: 18px; padding-bottom: 72px; }
      .greeting { margin-top: 14px; max-width: 24em; font-size: clamp(19px, 2.2vw, 28px); font-weight: 500; letter-spacing: -.028em; line-height: 1.28; color: var(--text); }
      .greeting b { font-weight: 700; color: var(--slate); }
      .big { display: grid; gap: 2px; margin-top: 18px; max-width: 13em; font-size: clamp(34px, 6.6vw, 94px); font-weight: 500; letter-spacing: -.058em; line-height: 1; color: var(--soft); }
      .big span { color: var(--ink); }
      .hero-grid { display: grid; gap: 28px; margin-top: 28px; }
      .hero-copy { display: grid; gap: 10px; align-content: start; color: var(--muted); }
      .hero-copy p { max-width: 32em; }
      .hero-strong { margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--line-strong); font-size: clamp(20px, 2vw, 25px); font-weight: 500; letter-spacing: -.03em; line-height: 1.28; color: var(--ink); }

      /* Secciones */
      .section { padding-block: 88px; }
      .panel { background: var(--panel); }
      .night { background: var(--night); color: var(--night-text); }
      .split { display: grid; gap: 18px; }
      .split > .label { align-self: start; padding-top: 10px; }
      .split-tight { margin-top: 40px; }
      .h2 { margin-top: 0; font-size: clamp(30px, 4.4vw, 58px); font-weight: 500; letter-spacing: -.05em; line-height: 1.07; max-width: 15em; }
      section > .wrap > .h2, .section > .h2 { margin-top: 16px; }
      .h2-wide { max-width: 19em; }
      .h2-pair { display: grid; gap: 4px; }
      .h2-accent { color: var(--orange-ink); }
      .lede { margin-top: 20px; max-width: 30em; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.45; letter-spacing: -.018em; color: var(--text); }
      .prose-line { margin-top: 22px; max-width: 36em; color: var(--muted); }
      .prose-ink { color: var(--text); font-size: 18px; }
      .prose-night { color: #b9bcc0; }
      .statement { display: grid; gap: 2px; margin-top: 40px; font-size: clamp(25px, 3.2vw, 42px); font-weight: 500; letter-spacing: -.045em; line-height: 1.12; max-width: 17em; }
      .statement::before { content: ""; display: block; width: 40px; height: 3px; margin-bottom: 16px; background: var(--orange); }
      .huge { margin-top: 72px; font-size: clamp(36px, 7vw, 100px); font-weight: 500; letter-spacing: -.062em; line-height: 1; max-width: 12em; }
      .n { flex: 0 0 26px; font-size: 12px; font-weight: 650; color: var(--soft); }

      /* Filtro */
      .filter { margin-top: 36px; border-top: 1px solid var(--ink); }
      .filter li { display: flex; gap: 14px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); }
      .filter-q { font-size: clamp(21px, 2.3vw, 30px); font-weight: 500; letter-spacing: -.035em; line-height: 1.18; }
      .filter-d { margin-top: 4px; max-width: 36em; font-size: 16px; color: var(--muted); }
      .filter-last .n { color: var(--orange); }
      .filter-last .filter-q { color: var(--slate); }

      /* Citas */
      .quote blockquote { font-size: clamp(21px, 2.3vw, 29px); font-weight: 400; letter-spacing: -.03em; line-height: 1.3; max-width: 24em; }
      .quote figcaption { margin-top: 10px; font-size: 13px; color: #9a9ea3; }
      .night .huge { color: var(--night-text); }

      /* Radiografía */
      .steps { margin-top: 28px; border-top: 1px solid var(--line-strong); }
      .steps li { display: flex; gap: 14px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line-strong); font-size: clamp(18px, 1.7vw, 21px); letter-spacing: -.02em; }
      .nots { margin-top: 28px; }
      .nots li { padding: 8px 0; font-size: 16px; color: var(--muted); }
      .nots li::before { content: "·"; margin-right: 10px; color: var(--slate); font-weight: 700; }

      /* Propuesta */
      .cmp { margin-top: 32px; display: grid; gap: 14px; }
      .cmp-row { display: grid; gap: 8px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
      .cmp-k b { font-size: 16px; font-weight: 650; }
      .cmp-k span { margin-left: 10px; font-size: 14px; color: var(--muted); }
      .cmp-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
      .cmp-steps li { padding: 8px 4px; border: 1px solid var(--slate-soft); border-radius: 6px; background: var(--paper); text-align: center; font-size: 12px; font-weight: 600; color: var(--slate); }
      .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }
      .cmp figcaption { font-size: 13px; color: var(--soft); }
      .worth { margin-top: 10px; font-size: clamp(38px, 6.6vw, 90px); font-weight: 500; letter-spacing: -.06em; line-height: 1; color: var(--orange-ink); }

      /* Tablero */
      .board { margin-top: 36px; padding: 18px; border: 1px solid var(--line-strong); border-radius: 16px; background: var(--paper); }
      .board-head, .board-row { display: grid; grid-template-columns: minmax(0, 1fr) 96px 72px; gap: 10px; align-items: center; }
      .board-head { padding-bottom: 10px; border-bottom: 1px solid var(--line); font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
      .board-head span:not(:first-child) { text-align: center; }
      .board-row { padding: 12px 0; border-bottom: 1px solid var(--line); }
      .board-k b { display: block; font-size: 16px; font-weight: 600; letter-spacing: -.015em; }
      .board-k span { display: block; font-size: 13px; color: var(--muted); }
      .board-cell { display: grid; place-items: center; min-height: 38px; border-radius: 8px; font-size: 12px; font-weight: 650; text-align: center; line-height: 1.2; padding: 4px; }
      .board-now { border: 1px dashed var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .06); }
      .board-next { border: 1px solid var(--slate); color: var(--slate); font-size: 18px; }
      .board figcaption { margin-top: 12px; font-size: 13px; color: var(--soft); }

      /* Dependencias */
      .deps { margin-top: 32px; max-width: 620px; }
      .deps ul { display: grid; gap: 1px; background: var(--night-line); border: 1px solid var(--night-line); border-radius: 12px; overflow: hidden; }
      .deps li { display: grid; gap: 4px; padding: 14px 16px; background: #1b1e22; }
      .deps b { position: relative; padding-left: 20px; font-size: 16px; font-weight: 600; color: var(--night-text); }
      .deps b::before { content: ""; position: absolute; left: 0; top: .45em; width: 10px; height: 10px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 4px rgba(241, 101, 50, .18); }
      .deps span { padding-left: 20px; font-size: 14px; color: #b9bcc0; }
      .deps figcaption { margin-top: 10px; font-size: 13px; color: #7d8187; }
      .night .huge { max-width: 13em; }

      /* Cierre */
      .closing { padding-block: 120px 128px; }
      .cl-1 { font-size: clamp(28px, 3.6vw, 48px); font-weight: 500; letter-spacing: -.045em; color: var(--soft); }
      .cl-big { margin-top: 10px; max-width: 10em; font-size: clamp(52px, 11vw, 160px); font-weight: 500; letter-spacing: -.07em; line-height: .95; }
      .cl-3 { margin-top: 56px; max-width: 30em; font-size: clamp(19px, 1.8vw, 23px); letter-spacing: -.02em; color: var(--text); }

      /* CTA */
      .cta { border-top: 1px solid var(--line); }
      .cta-title { max-width: 14em; }
      .cta-copy { margin-top: 20px; max-width: 32em; font-size: 18px; color: var(--muted); }
      .cta-row { display: grid; gap: 36px; margin-top: 40px; }
      .buttons { display: grid; gap: 10px; justify-items: start; }
      .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; min-height: 56px; padding: 0 24px; background: var(--slate); color: var(--night-text); font-size: 16px; font-weight: 600; transition: background-color .2s ease, color .2s ease; }
      .button:hover { background: var(--ink); }
      .button-ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
      .button-ghost:hover { background: var(--ink); color: var(--paper); }
      .signature { padding-top: 18px; border-top: 1px solid var(--line); max-width: 280px; }
      .signature-name { font-size: 18px; font-weight: 650; letter-spacing: -.02em; }
      .signature-role { font-size: 14px; color: var(--muted); }
      .signature-site { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--slate); }

      /* Pie y consentimiento */
      .foot { border-top: 1px solid var(--line); }
      .foot-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding-block: 26px 30px; font-size: 13px; color: var(--muted); }
      .foot-brand { margin-right: auto; }
      .foot a:hover { color: var(--ink); }
      .consent { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 30; display: grid; gap: 12px; padding: 14px 16px; background: var(--night); color: var(--night-text); font-size: 13px; line-height: 1.5; border: 1px solid #3a3d42; box-shadow: 0 10px 30px rgba(0, 0, 0, .18); }
      .consent[hidden] { display: none; }
      .consent a { text-decoration: underline; }
      .consent-actions { display: flex; gap: 8px; justify-content: flex-end; }
      .consent button { min-height: 38px; padding: 0 16px; border: 1px solid #3a3d42; background: transparent; color: var(--night-text); font: inherit; cursor: pointer; }
      .consent .consent-accept { background: var(--night-text); color: var(--night); border-color: var(--night-text); }

      /* Movimiento */
      .js [data-reveal] { opacity: 0; transform: translateY(10px); transition: opacity .7s ease var(--d, 0ms), transform .7s var(--ease) var(--d, 0ms); }
      .js [data-reveal].is-in { opacity: 1; transform: none; }
      .js .cmp-steps li.hot { background: var(--paper); border-color: var(--slate-soft); color: var(--slate); transition: background-color .4s ease calc(.3s + var(--i) * 50ms), border-color .4s ease calc(.3s + var(--i) * 50ms), color .4s ease calc(.3s + var(--i) * 50ms); }
      .js .cmp.is-in .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); }

      .js .board .board-row { opacity: .25; transition: opacity .45s ease calc(.25s + var(--i) * 200ms); }
      .js .board.is-in .board-row { opacity: 1; }
      .js .deps li { opacity: .25; transition: opacity .45s ease calc(.25s + var(--i) * 180ms); }
      .js .deps.is-in li { opacity: 1; }

      @media (min-width: 420px) {
        .top-link { display: inline; }
        .cmp-steps li { font-size: 13px; }
      }
      .top-nav .top-link-x { display: none; }
      @media (min-width: 900px) {
        .top-nav .top-link-x { display: inline; }
      }
      @media (min-width: 720px) {
        :root { --gutter: 36px; }
        .board-head, .board-row { grid-template-columns: minmax(0, 1fr) 140px 110px; }
        .board-cell { font-size: 13px; }
        .cmp-row { grid-template-columns: 210px minmax(0, 1fr); align-items: center; gap: 16px; }
        .cmp-k span { display: block; margin-left: 0; }
        .cta-row { grid-template-columns: auto 1fr; align-items: end; gap: 64px; }
        .signature { justify-self: end; min-width: 260px; }
        .consent { left: auto; right: 24px; bottom: 24px; max-width: 560px; grid-template-columns: 1fr auto; align-items: center; }
      }
      @media (min-width: 1000px) {
        body { font-size: 18px; }
        .top-inner { height: 72px; }
        .hero { padding-top: 40px; padding-bottom: 116px; }
        .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; margin-top: 52px; align-items: start; }
        .section { padding-block: 128px; }
        .split { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
        .closing { padding-block: 180px 190px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js [data-reveal] { opacity: 1; transform: none; transition: none; }
        .js .board .board-row, .js .deps li { opacity: 1; transition: none; }
        .js .cmp-steps li.hot { border-color: var(--orange); color: var(--orange-ink); background: rgba(241, 101, 50, .08); transition: none; }
        .top, .button, .top-cta { transition: none; }
      }
      .inline-link { color: var(--slate); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
      .inline-link:hover { color: var(--ink); }
    </style>
  </body>
</html>
