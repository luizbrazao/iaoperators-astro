---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ui, getLocale } from "../i18n/ui";
import Hero from "../sections/home/Hero.astro";
import WhyUs from "../sections/home/WhyUs.astro";
import Services from "../sections/home/Services.astro";
import ServiceCatalog from "../sections/home/ServiceCatalog.astro";
import SiloDoors from "../sections/home/SiloDoors.astro";
import HomeCases from "../sections/home/HomeCases.astro";
import Testimonial from "../sections/home/Testimonial.astro";
import ClientTestimonials from "../sections/home/ClientTestimonials.astro";
import BlogSection from "../sections/home/BlogSection.astro";
import FAQ from "../sections/home/FAQ.astro";
import { fetchBlogPosts } from "../lib/blog";
import { getServices } from "@/data/servicios";
import {
  SOCIAL_PROFILES,
  WEBSITE_ID,
  ORG_REF,
  organizationNode,
} from "@/data/identidad";

type FaqItem = { q: string; a: string };

const locale = getLocale(Astro.currentLocale);

// Fallback forte: nunca deixe dict virar undefined
const dict =
  (ui as any)?.[locale] ??
  (ui as any)?.es ??
  (ui as any)?.en ??
  (ui as any)?.pt ??
  {};

// Site
const site = Astro.site?.toString() ?? "https://iaoperators.com";

// Blog posts
const posts = await fetchBlogPosts(locale);
const latestPosts = (posts ?? []).slice(0, 3);

// Socials: fuente unica en src/data/identidad.ts. Antes esta lista tenia tres
// perfiles (sin X) y usaba @iaoperators en minuscula, mientras el Footer tenia
// cuatro con @IAOperators: dos `sameAs` distintos para la misma entidad.
const socials = [...SOCIAL_PROFILES];

// Guards (evita undefined em cascata)
const home = (dict as any)?.home ?? {};

// ✅ Meta deve vir do namespace "home" (home.json)
const meta = home?.meta ?? {};

// FAQ items seguros
const faq = home?.faq ?? { items: [] };
const faqItems: FaqItem[] = Array.isArray(faq?.items) ? (faq.items as FaqItem[]) : [];

// JSON-LD: Organization + WebSite; FAQPage solo si hay items.
//
// El nodo Organization se construye en src/data/identidad.ts para que su @id
// sea el mismo aqui, en /[locale]/sobre/ y en /[locale]/metodologia/: tres
// emisiones, una sola entidad. Sin @id eran tres nodos sueltos.
//
// El catalogo de ofertas se deriva de src/data/servicios.ts (fuente unica del
// menu, del hub y del footer). Antes estaba escrito a mano aqui, en espanol
// para los tres idiomas, y le faltaba consultoria-ia.
const OFFER_CATALOG = {
  "@type": "OfferCatalog",
  name: "Servicios de IA Operators",
  itemListElement: getServices(locale).map((service) => ({
    "@type": "Offer",
    itemOffered: {
      "@type": "Service",
      name: service.label,
      url: new URL(service.href, site).toString(),
    },
  })),
};

const jsonLd: any[] = [
  organizationNode({
    locale,
    description:
      "Integración y automatización de sistemas con IA para empresas: ERP, TPV, e-commerce, CRM y WhatsApp, y adaptación a Verifactu y a la Ley 10/2025. De la estrategia a producción, sin hand-offs.",
    extra: { hasOfferCatalog: OFFER_CATALOG },
  }),
  // Sin potentialAction/SearchAction: la URL plantilla estaba malformada
  // (doble barra + {locale} sin sustituir apuntando a un filtro de categoría,
  // no a una búsqueda) y Google retiró el Sitelinks Search Box en nov/2024,
  // así que el marcado ya no producía nada.
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": WEBSITE_ID,
    name: "IA Operators",
    url: site,
    inLanguage: locale,
    publisher: ORG_REF,
  },
];

if (faqItems.length) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  });
}

// Meta com fallback
const metaTitle = meta?.title ?? "IA Operators";
const metaDescription = meta?.description ?? "";
---

<!-- Sin <main> propio: BaseLayout ya envuelve el slot en <main>, y el
     anidamiento producía dos <main> en el DOM (hallazgo de la auditoría). -->
<BaseLayout title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
    <Hero locale={locale} hero={home?.hero ?? {}} />
    <WhyUs why={home?.why ?? {}} industries={home?.industries ?? []} />

    <!-- Orden de la home en ES (fase 1 del reposicionamiento, 2026-08-10):
         problema → tres pilares → cómo trabajamos → prueba → capacidades.
         El catálogo de servicios estaba justo debajo de las puertas y era lo
         primero que leía un visitante después del problema: once servicios
         horizontales contando una historia de agencia generalista antes de que
         la de integración/cumplimiento/arquitectura hubiera terminado. Baja
         detrás de la prueba y en variante secundaria, sin perder un solo enlace.

         EN/PT conservan exactamente el orden anterior: no tienen los silos
         ES-only y su reposicionamiento no es objeto de esta fase. -->
    {locale === "es" && <SiloDoors />}
    {locale !== "es" && <ServiceCatalog locale={locale} />}

    <Services services={home?.services ?? {}} />

    {locale === "es" && <HomeCases locale={locale} />}

    <Testimonial testimonial={home?.testimonial ?? {}} socials={socials} ctaHref={`/${locale}/sobre/`} />
    <ClientTestimonials clientTestimonials={home?.clientTestimonials ?? { badge: "", title: "", items: [] }} />

    {locale === "es" && <ServiceCatalog locale={locale} variant="secondary" />}

    <BlogSection blogSection={home?.blogSection ?? {}} posts={latestPosts} locale={locale} />
    <FAQ faq={faq ?? { items: [] }} />
</BaseLayout>
