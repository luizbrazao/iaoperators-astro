---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ui, getLocale } from "../i18n/ui";
import Hero from "../sections/home/Hero.astro";
import WhyUs from "../sections/home/WhyUs.astro";
import Services from "../sections/home/Services.astro";
import ServiceCatalog from "../sections/home/ServiceCatalog.astro";
import ComplianceBanner from "../sections/home/ComplianceBanner.astro";
import Testimonial from "../sections/home/Testimonial.astro";
import ClientTestimonials from "../sections/home/ClientTestimonials.astro";
import BlogSection from "../sections/home/BlogSection.astro";
import FAQ from "../sections/home/FAQ.astro";
import { fetchBlogPosts } from "../lib/blog";

type Social = { label: string; href: string };
type FaqItem = { q: string; a: string };

const locale = getLocale(Astro.currentLocale);

// Fallback forte: nunca deixe dict virar undefined
const dict =
  (ui as any)?.[locale] ??
  (ui as any)?.es ??
  (ui as any)?.en ??
  (ui as any)?.pt ??
  {};

// Site
const site = Astro.site?.toString() ?? "https://iaoperators.com";

// Blog posts
const posts = await fetchBlogPosts(locale);
const latestPosts = (posts ?? []).slice(0, 3);

// Socials
const socials: Social[] = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/ferbrazao/" },
  { label: "Instagram", href: "https://www.instagram.com/iaoperators" },
  { label: "YouTube", href: "https://www.youtube.com/@iaoperators" },
];

// Guards (evita undefined em cascata)
const home = (dict as any)?.home ?? {};

// ✅ Meta deve vir do namespace "home" (home.json)
const meta = home?.meta ?? {};

// FAQ items seguros
const faq = home?.faq ?? { items: [] };
const faqItems: FaqItem[] = Array.isArray(faq?.items) ? (faq.items as FaqItem[]) : [];

// JSON-LD: Organization + WebSite; FAQPage só se tiver itens
const jsonLd: any[] = [
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "ProfessionalService"],
    name: "IA Operators",
    url: site,
    logo: {
      "@type": "ImageObject",
      url: `${site}/favicon-32x32.png`,
    },
    description: "Auditoría, roadmap e implementación tecnológica para empresas medianas. Diagnóstico riguroso, priorización y ejecución sin hand-offs.",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Málaga",
      addressCountry: "ES",
    },
    areaServed: ["ES", "PT", "BR"],
    founder: {
      "@type": "Person",
      name: "Luiz Brazão",
      jobTitle: "Fundador",
      url: site,
    },
    knowsAbout: [
      "Technology audit",
      "Digital transformation",
      "AI automation",
      "Systems integration",
      "Technology roadmap",
      "Mid-market technology consulting",
      "SaaS management",
      "Shadow IT",
      "n8n",
      "LangChain",
      "API integration",
    ],
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Servicios de IA Operators",
      itemListElement: [
        { name: "Automatización con IA", path: "servicios/automatizacion-ia/" },
        { name: "Chatbots", path: "servicios/chatbots/" },
        { name: "Diseño web", path: "servicios/diseno-web/" },
        { name: "Agencia SEO", path: "servicios/agencia-seo/" },
        { name: "Marketing digital", path: "servicios/marketing-digital/" },
        { name: "Agencia de IA", path: "servicios/agencia-ia/" },
        { name: "Radiografía Digital — Auditoría de sistemas", path: "auditoria-de-sistemas/" },
        { name: "Roadmap Tecnológico", path: "roadmap-tecnologico/" },
        { name: "Implementación tecnológica", path: "implementacion/" },
      ].map((s) => ({
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: s.name,
          url: new URL(`/${locale}/${s.path}`, site).toString(),
        },
      })),
    },
    sameAs: socials.map((item) => item.href),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "IA Operators",
    url: site,
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: `${site}/{locale}/blog/?cat={search_term_string}`,
      },
      "query-input": "required name=search_term_string",
    },
  },
];

if (faqItems.length) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  });
}

// Meta com fallback
const metaTitle = meta?.title ?? "IA Operators";
const metaDescription = meta?.description ?? "";
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
  <main>
    <Hero locale={locale} hero={home?.hero ?? {}} />
    {locale === "es" && <ComplianceBanner />}
    <WhyUs why={home?.why ?? {}} industries={home?.industries ?? []} />
    <ServiceCatalog locale={locale} />
    <Services services={home?.services ?? {}} />
    <Testimonial testimonial={home?.testimonial ?? {}} socials={socials} />
    <ClientTestimonials clientTestimonials={home?.clientTestimonials ?? { badge: "", title: "", items: [] }} />
    <BlogSection blogSection={home?.blogSection ?? {}} posts={latestPosts} locale={locale} />
    <FAQ faq={faq ?? { items: [] }} />
  </main>
</BaseLayout>
