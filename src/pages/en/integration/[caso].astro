---
// English routes for the five integration cases.
//
// El slug público sale de CASO_SLUG_BY_LOC (src/data/integracion.ts) y la clave
// canónica se resuelve con casoKeyFromSlug, así que una ruta de otro idioma
// nunca genera página aquí. El markup, trilingüe, vive en
// src/sections/silos/CasoIntegracion.astro.
import CasoIntegracion from "@/sections/silos/CasoIntegracion.astro";
import { CASO_SLUGS, CASO_SLUG_BY_LOC, casoKeyFromSlug, type CasoKey } from "@/data/integracion";

export function getStaticPaths() {
  return CASO_SLUGS.map((key) => ({ params: { caso: CASO_SLUG_BY_LOC["en"][key] } }));
}

const casoKey = casoKeyFromSlug("en", Astro.params.caso as string) as CasoKey;
---

<CasoIntegracion locale="en" casoKey={casoKey} />
