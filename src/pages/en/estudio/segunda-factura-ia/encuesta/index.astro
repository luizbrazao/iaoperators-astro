---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SurveyForm from "@/islands/SurveyForm";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-forms.css";

const site = Astro.site?.toString() ?? "https://iaoperators.com";

// Sin barra final: Astro.site termina en "/" y `${siteRoot}/es/` daba "//es/".

const siteRoot = site.replace(/\/$/, "");
const canonical = new URL("/en/estudio/segunda-factura-ia/encuesta/", site).toString();
const ogImage = "/og/en/segunda-factura-ia-encuesta.png";

const alternates = [
  { lang: "es", href: new URL("/es/estudio/segunda-factura-ia/encuesta/", site).toString() },
  { lang: "en", href: canonical },
  { lang: "pt", href: new URL("/pt/estudio/segunda-factura-ia/encuesta/", site).toString() },
];
const xDefault = new URL("/es/estudio/segunda-factura-ia/encuesta/", site).toString();

const pageTitle = "Survey | The Second Bill of AI 2026";
const pageDescription =
  "Take part in IA Operators' exploratory survey on AI use at work, exposure of internal information, governance and vendor dependency.";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "IA Operators",
      item: `${siteRoot}/en/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Study",
      item: `${siteRoot}/en/estudio/segunda-factura-ia/encuesta/`,
    },
  ],
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: canonical,
  inLanguage: "en-US",
  isPartOf: {
    "@type": "WebSite",
    name: "IA Operators",
    url: `${siteRoot}/en/`,
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonical}
  alternates={alternates}
  xDefaultUrl={xDefault}
  ogImage={ogImage}
  ogImageAlt="The Second Bill of AI 2026 survey"
  jsonLd={[pageJsonLd, breadcrumbJsonLd]}
  editorial
>
  <div class="ed-container">
    <header class="pg-hero">
      <nav class="pf-crumbs ed-eyebrow" aria-label="Breadcrumb">
        <ol>
          <li><a href="/en/">Home</a></li>
          <li><span aria-current="page">Study</span></li>
        </ol>
      </nav>
      <h1>The Second Bill of AI 2026</h1>
      <div class="pg-hero-bottom">
        <p class="ed-eyebrow">Exploratory study 2026</p>
        <p class="pg-lead">
          A short survey to understand how companies and professionals are using AI at work, what controls exist and where the least visible risks appear: personal accounts, internal documents, dependency on a single vendor and Shadow AI.
        </p>
      </div>
    </header>

    <section class="pg-section" aria-label="What this phase will give us">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">What this phase will give us</p>
        <ul class="pg-checklist">
          <li>Data on real-world AI adoption at work.</li>
          <li>Indicators on personal-account use, document exposure and anonymization practices.</li>
          <li>A methodological baseline for the later public study, without publishing conclusions before collecting a sufficient sample.</li>
        </ul>
      </div>
    </section>

    <div class="sf-section">
      <SurveyForm client:load locale="en" variant="editorial" thankYouPath="/en/estudio/segunda-factura-ia/encuesta/gracias/" />
    </div>

    <section class="pg-section sf-cols-section" aria-label="Methodology and privacy">
      <ul class="pg-columns sf-cols">
        <li>
          <h2>Methodological neutrality</h2>
          <p>Questions are written in neutral language, with balanced options and an “I don't know” choice where relevant. The survey does not request trade secrets or identifiable examples.</p>
        </li>
        <li>
          <h2>Privacy and processing</h2>
          <p>The email is optional. When provided, it must be stored separately from the behavioral responses. Individual responses will not be published in isolation.</p>
        </li>
        <li>
          <h2>Intended use</h2>
          <p>This phase serves to validate hypotheses, detect relevant segments and prepare a public study with original data — not to claim it represents every company.</p>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
