---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/editorial-pages.css";
import "@/styles/editorial-forms.css";

const site = Astro.site?.toString() ?? "https://iaoperators.com";
const canonical = new URL("/en/estudio/segunda-factura-ia/encuesta/gracias/", site).toString();
---

<BaseLayout
  title="Thanks for taking part | The Second Bill of AI 2026"
  description="Your response has been recorded."
  canonicalUrl={canonical}
  robots="noindex,follow"
  editorial
>
  <div class="ed-container">
    <section class="sf-thanks">
      <p class="ed-eyebrow">Survey submitted</p>
      <h1>Thanks for taking part</h1>
      <p class="pg-lead">
        Your response is now part of the study's exploratory phase. If you left your email, we'll let you know when we publish the aggregate results.
      </p>
      <div class="pg-actions">
        <a class="ed-button" href="/en/blog/">Keep reading<span class="ed-arrow" aria-hidden="true">↗</span></a>
        <a class="ed-underlined" href="/en/">Back to the site <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
