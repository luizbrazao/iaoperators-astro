<script>
  // FADE IN
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
    });
  }, { threshold: 0.05 });
  document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));

  // ACCORDION — event delegation
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const blocoHeader = target.closest('.bloco-header') as HTMLElement | null;
    if (blocoHeader) {
      const body = blocoHeader.nextElementSibling as HTMLElement;
      const isOpen = blocoHeader.classList.contains('open');
      blocoHeader.classList.toggle('open', !isOpen);
      body.classList.toggle('open', !isOpen);
      return;
    }

    const diaHeader = target.closest('.dia-header') as HTMLElement | null;
    if (diaHeader) {
      const body = diaHeader.nextElementSibling as HTMLElement;
      const isOpen = diaHeader.classList.contains('open');
      diaHeader.classList.toggle('open', !isOpen);
      body.classList.toggle('open', !isOpen);
    }
  });
</script>

