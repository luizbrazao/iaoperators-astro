---
// Bloque de reconocimientos. Uso EXCLUSIVO en /[locale]/sobre/.
//
// No importar desde BaseLayout, Header, Footer ni ninguna sección compartida:
// un enlace sitewide multiplicaría estos destinos por todas las rutas.

import { RECONOCIMIENTOS, RECONOCIMIENTOS_COPY } from "@/data/reconocimientos";
import type { Loc } from "@/data/identidad";

type Props = { locale: string };
const { locale } = Astro.props as Props;

const loc: Loc = locale === "pt" || locale === "en" ? locale : "es";
const copy = RECONOCIMIENTOS_COPY[loc];
---

{RECONOCIMIENTOS.length > 0 && (
  <section aria-labelledby="reconocimientos-title" class="mb-16">
    <h2
      id="reconocimientos-title"
      class="text-2xl font-bold text-white mb-2 border-l-4 border-orange-500 pl-4"
    >
      {copy.title}
    </h2>
    <p class="text-gray-400 text-sm leading-relaxed mb-6 pl-5">{copy.intro}</p>

    <ul class="grid sm:grid-cols-2 gap-4 list-none p-0">
      {RECONOCIMIENTOS.map((item) => (
        <li class="p-5 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-orange-500/30 transition-colors">
          <a
            href={item.href}
            target="_blank"
            rel={item.rel || undefined}
            class="text-orange-400 hover:text-orange-300 font-semibold transition-colors"
          >
            {item.anchor} ↗
          </a>
          <p class="text-gray-400 text-sm leading-relaxed mt-2">
            {item.caption[loc]}
          </p>
        </li>
      ))}
    </ul>
  </section>
)}
