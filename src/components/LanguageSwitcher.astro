---
import { getLocale, locales } from "../i18n/ui";

type SwitcherLink = { locale: string; href: string };
type Props = {
  linksOverride?: SwitcherLink[];
  variant?: "list" | "dropdown";
};

const { linksOverride, variant = "list" } = Astro.props as Props;
const current = getLocale(Astro.currentLocale);
const pathname = Astro.url.pathname;
const basePath = pathname.replace(new RegExp(`^/${current}(?=/|$)`), "") || "/";

const fallbackLinks = locales.map((locale) => ({
  locale,
  href: `/${locale}${basePath}`.replace(/\/+$/, "/"),
  isActive: locale === current,
}));

const links = linksOverride?.length
  ? linksOverride.map((l) => ({
      ...l,
      href: l.href.replace(/\/+$/, "/"),
      isActive: l.locale === current,
    }))
  : fallbackLinks;

const LOCALE_LABELS: Record<string, string> = {
  es: "Español",
  en: "English",
  pt: "Português",
};
---

{variant === "dropdown" ? (
  <div class="relative" data-lang-root>
    <button
      type="button"
      id="langBtn"
      class="
        h-10 w-10
        rounded-full
        border border-white/10
        bg-white/5 hover:bg-white/10
        text-gray-300 hover:text-white
        flex items-center justify-center
        transition cursor-pointer
      "
      aria-haspopup="true"
      aria-expanded="false"
      aria-controls="langMenu"
      aria-label="Language switcher"
    >
      <!-- globe icon -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M3 12h18"></path>
        <path d="M12 3a14 14 0 0 1 0 18"></path>
        <path d="M12 3a14 14 0 0 0 0 18"></path>
      </svg>
    </button>

    <div
      id="langMenu"
      class="hidden absolute right-0 top-full pt-3 z-50"
      role="menu"
    >
      <div
        class="
          w-[180px]
          rounded-2xl
          border border-white/10
          bg-[#0a0a0a]/95
          backdrop-blur-xl
          shadow-[0_20px_60px_rgba(0,0,0,0.7)]
          p-2
        "
      >
        {links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm transition",
              l.isActive
                ? "bg-orange-500/10 text-orange-300"
                : "text-gray-300 hover:bg-white/10 hover:text-white",
            ]}
            aria-current={l.isActive ? "page" : undefined}
            rel="alternate"
            hreflang={l.locale}
            role="menuitem"
            data-close-lang
          >
            <span>{LOCALE_LABELS[l.locale] ?? l.locale.toUpperCase()}</span>
            <span class="text-xs opacity-60 uppercase">{l.locale}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
) : (
  <nav aria-label="Language switcher" class="flex gap-2 text-sm">
    {links.map((l) => (
      <a
        href={l.href}
        class:list={[
          "px-2 py-1 rounded border",
          l.isActive
            ? "border-border"
            : "border-border/50 opacity-80 hover:opacity-100",
        ]}
        aria-current={l.isActive ? "page" : undefined}
        rel="alternate"
        hreflang={l.locale}
      >
        {l.locale.toUpperCase()}
      </a>
    ))}
  </nav>
)}
