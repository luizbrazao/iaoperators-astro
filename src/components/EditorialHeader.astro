---
import { getPilares } from "@/data/navegacion";
import { SHELL, asShellLoc, shellHref } from "@/i18n/editorialShell";
interface Props { languageLinks: Array<{ locale: string; href: string }> }
const { languageLinks } = Astro.props;
const locale = asShellLoc(Astro.currentLocale);
const l = SHELL[locale];
const links = [
  ...getPilares(locale).map(({label, href}) => ({label, href})),
  {label: l.cases, href: shellHref(locale, "portfolio/")},
  {label: "Blog", href: shellHref(locale, "blog/")},
];
---
<a class="ed-skip" href="#main-content">{l.skip}</a>
<div class="ed-container">
  <header class="ed-header">
    <a class="ed-wordmark" href={shellHref(locale)} aria-label={l.homeAria}><img src="/brand/ia-operators-logo.png" alt="" width="453" height="82" /></a>
    <nav class="ed-desktop-nav" aria-label={l.mainNav}>
      {links.map(link => <a href={link.href}>{link.label}</a>)}
      <a class="ed-nav-contact" href={shellHref(locale, "contact/")}>{l.talk} <span aria-hidden="true">↗</span></a>
      <div class="ed-languages" aria-label={l.languages}>{languageLinks.map(link => <a href={link.href} lang={link.locale} aria-current={link.locale === locale ? "page" : undefined}>{link.locale.toUpperCase()}</a>)}</div>
    </nav>
    <details class="ed-mobile-menu">
      <summary>{l.menu} <span aria-hidden="true">+</span></summary>
      <nav aria-label={l.mobileNav}>
        {links.map(link => <a href={link.href}>{link.label}</a>)}
        <a href={shellHref(locale, "servicios/")}>{l.allCapabilities}</a>
        <a class="ed-nav-contact" href={shellHref(locale, "contact/")}>{l.talk} <span aria-hidden="true">↗</span></a>
        <div class="ed-languages" aria-label={l.languages}>{languageLinks.map(link => <a href={link.href} lang={link.locale} aria-current={link.locale === locale ? "page" : undefined}>{link.locale.toUpperCase()}</a>)}</div>
      </nav>
    </details>
  </header>
</div>
<script>
  const menu = document.querySelector<HTMLDetailsElement>(".ed-mobile-menu");
  if (menu) {
    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
    document.addEventListener("click", event => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.querySelectorAll("a").forEach(link => link.addEventListener("click", () => { menu.open = false; }));
  }
</script>
