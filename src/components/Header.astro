---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getLocale, ui } from "../i18n/ui";
import { getServiceGroups, hubCtaLabel, SERVICE_HUB_PATH } from "@/data/servicios";

type Props = { languageLinks?: Array<{ locale: string; href: string }> };
const { languageLinks } = Astro.props as Props;
const locale = getLocale(Astro.currentLocale);
const dict =
  (ui as any)?.[locale] ?? (ui as any)?.es ?? (ui as any)?.en ?? (ui as any)?.pt ?? {};

const nav =
  (dict as any)?.nav ??
  (dict as any)?.common?.nav ??
  (dict as any)?.home?.nav ??
  {};

// Catálogo de servicios: fuente única en src/data/servicios.ts.
const serviceGroups = getServiceGroups(locale);
const serviceItems = serviceGroups.flatMap((g) => g.items);
const hubCta = hubCtaLabel(locale);

const labels = {
  services: nav?.services ?? "Services",
  methodology: nav?.methodology ?? "Methodology",
  portfolio: nav?.portfolio ?? "Portfolio",
  community: nav?.community ?? "Community",
  youtube: nav?.youtube ?? "YouTube",
  blog: nav?.blog ?? "Blog",
  contact: nav?.contact ?? "Contact",
  // ES-only: landing regulatoria (Ley 10/2025). No se traduce porque la obligación es española.
  cumplimiento: "Cumplimiento",
};

const withLocale = (path: string) => `/${locale}/${path}`.replace(/\/+$/, "/");

const links = {
  home: `/${locale}/`,
  servicesHub: withLocale(SERVICE_HUB_PATH),
  methodology: withLocale("metodologia/"),
  portfolio: withLocale("portfolio/"),
  blog: withLocale("blog/"),
  contact: withLocale("contact/"),
  cumplimiento: "/es/cumplimiento/",
  community: "https://www.skool.com/ia-operators-hub-9023/about",
  youtube: "https://www.youtube.com/@IAOperators",
};

// El menú móvil NO repite los diez servicios: lleva al hub. Los enlaces
// individuales siguen en el HTML (panel de escritorio), así que el rastreo
// no pierde nada y el móvil deja de ser una lista interminable.
const mobileLinks = [
  { key: "servicesHub", href: links.servicesHub, label: hubCta, external: false },
  ...(locale === "es"
    ? [{ key: "cumplimiento", href: links.cumplimiento, label: labels.cumplimiento, external: false }]
    : []),
  { key: "methodology", href: links.methodology, label: labels.methodology, external: false },
  { key: "portfolio", href: links.portfolio, label: labels.portfolio, external: false },
  { key: "community", href: links.community, label: labels.community, external: true },
  { key: "youtube", href: links.youtube, label: labels.youtube, external: true },
  { key: "blog", href: links.blog, label: labels.blog, external: false },
];
---

<header class="fixed top-6 left-0 right-0 z-50 flex justify-center pointer-events-none">
  <div
    class="
      relative flex items-center gap-6
      w-[90%] sm:w-auto sm:inline-flex
      py-2 pl-6 pr-2
      rounded-full
      border border-white/10
      bg-white/5
      backdrop-blur-2xl
      shadow-[0_12px_40px_rgba(0,0,0,0.55)]
      pointer-events-auto
    "
  >
    <div class="pointer-events-none absolute inset-0 rounded-full bg-linear-to-b from-white/10 via-white/0 to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px rounded-full bg-linear-to-r from-transparent via-white/30 to-transparent"></div>

    <div class="relative z-10 flex items-center gap-6 w-full">
      <!-- Logo -->
      <a href={links.home} class="shrink-0" data-close-menu>
        <img
          src="https://framerusercontent.com/images/XwOvRWgJ6sirH2T1tQHcZMN4zXg.png"
          alt="IA Operators"
          class="h-6 md:h-7 w-auto select-none"
        />
      </a>

      <!-- Desktop navigation -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-300 whitespace-nowrap">
        <!-- Services dropdown -->
        <div
          id="servicesDropdown"
          class="relative"
          data-services-root
        >
          <button
            type="button"
            id="servicesBtn"
            class="flex items-center gap-1.5 hover:text-white transition-colors cursor-pointer"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="servicesMenu"
          >
            {labels.services}
            <span class="text-xs transition-transform duration-200" data-services-arrow>▾</span>
          </button>

          <div
            id="servicesMenu"
            class="hidden absolute left-1/2 -translate-x-1/2 top-full pt-3 z-50"
            role="menu"
          >
            <div
              class="
                w-[min(92vw,660px)]
                rounded-2xl border border-white/10
                bg-[#0a0a0a]/95 backdrop-blur-xl
                shadow-[0_20px_60px_rgba(0,0,0,0.7)]
                p-3
              "
            >
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-2">
                {serviceGroups.map((group) => (
                  <div>
                    <p class="px-3 pt-1 pb-2 text-[10px] font-semibold uppercase tracking-widest text-gray-500">
                      {group.title}
                    </p>
                    {group.items.map((item) => (
                      <a
                        href={item.href}
                        class="block rounded-xl px-3 py-2.5 hover:bg-white/5 transition group"
                        role="menuitem"
                        data-close-services
                      >
                        <div class="flex items-center gap-2 text-white text-sm font-semibold">
                          <span class="text-orange-400 text-xs tabular-nums">{item.num}</span>
                          {item.label}
                        </div>
                        <p class="text-xs text-gray-400 mt-0.5 group-hover:text-gray-300">
                          {item.desc}
                        </p>
                      </a>
                    ))}
                  </div>
                ))}
              </div>

              <a
                href={links.servicesHub}
                class="mt-3 flex items-center justify-between rounded-xl px-3 py-2.5 bg-white/[0.03] hover:bg-white/[0.07] transition"
                role="menuitem"
                data-close-services
              >
                <span class="text-sm text-white font-medium">{hubCta}</span>
                <span class="text-orange-400">→</span>
              </a>
            </div>
          </div>
        </div>

        {locale === "es" && (
          <a href={links.cumplimiento} class="hover:text-white transition-colors whitespace-nowrap">
            {labels.cumplimiento}
          </a>
        )}

        <a href={links.methodology} class="hover:text-white transition-colors">
          {labels.methodology}
        </a>

        <a href={links.portfolio} class="hover:text-white transition-colors">
          {labels.portfolio}
        </a>

        <a href={links.blog} class="hover:text-white transition-colors">
          {labels.blog}
        </a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-2 ml-auto md:ml-0">
        <!-- Desktop social + lang icons -->
        <div class="hidden md:flex items-center gap-1.5">
          <a
            href={links.youtube}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={labels.youtube}
            title={labels.youtube}
            class="
              h-10 w-10
              rounded-full
              border border-white/10
              bg-white/5 hover:bg-white/10
              text-gray-300 hover:text-white
              flex items-center justify-center
              transition
            "
          >
            <svg width="18" height="18" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
              <path d="M31.331 8.248A4.022 4.022 0 0 0 28.502 5.4C26.006 4.727 16 4.727 16 4.727s-10.007 0-12.502.673A4.02 4.02 0 0 0 .669 8.248C0 10.76 0 16 0 16s0 5.241.669 7.752a4.018 4.018 0 0 0 2.829 2.847c2.496.673 12.502.673 12.502.673s10.007 0 12.502-.673a4.02 4.02 0 0 0 2.829-2.847C32 21.24 32 16 32 16s0-5.24-.669-7.752Zm-18.604 12.51v-9.516L21.091 16l-8.364 4.758Z" />
            </svg>
          </a>

          <a
            href={links.community}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${labels.community} · Skool`}
            title={`${labels.community} · Skool`}
            class="
              h-10 w-10
              rounded-full
              border border-white/10
              bg-white/5 hover:bg-white/10
              text-gray-300 hover:text-white
              flex items-center justify-center
              transition
            "
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17.5 6.5C16 5.5 14.2 5 12 5c-3 0-5 1-5 3s2 2.5 5 3 5 1.5 5 3.5-2 3.5-5 3.5c-2.2 0-4-.5-5.5-1.5"/>
            </svg>
          </a>

          <LanguageSwitcher linksOverride={languageLinks} variant="dropdown" />
        </div>

        <!-- Desktop contact button (efeito conic spin) -->
        <a href={links.contact} class="hidden md:inline-flex" data-close-menu>
          <span class="relative group">
            <span class="relative overflow-hidden rounded-full p-1px inline-flex">
              <span class="spin-ring absolute inset-[-1000%]"></span>
              <span class="relative flex items-center gap-2 rounded-full bg-[#0f0f0f]/70 px-5 py-2.5 text-sm font-medium text-white hover:bg-white/5 transition">
                {labels.contact}
                <span class="text-gray-400 group-hover:text-white transition">↗</span>
              </span>
            </span>
          </span>
        </a>

        <!-- Hamburger mobile -->
        <button
          id="menuBtn"
          type="button"
          class="
            md:hidden
            h-12 w-12
            rounded-full
            border border-white/10
            bg-white/5 hover:bg-white/10
            backdrop-blur-xl
            text-white
            flex items-center justify-center
            transition
            cursor-pointer
            z-50
          "
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobileMenu"
        >
          <span id="iconMenu" class="pointer-events-none">☰</span>
          <span id="iconClose" class="pointer-events-none hidden">✕</span>
        </button>
      </div>

      <!-- Mobile menu (hidden by default) -->
      <div
        id="mobileMenu"
        class="
          hidden md:hidden
          absolute top-[120%] right-0
          w-280px
          rounded-2xl
          border border-white/10
          bg-[#0a0a0a]
          shadow-[0_0_50px_rgba(0,0,0,0.8)]
          z-999
          overflow-hidden
        "
        role="dialog"
        aria-label="Mobile menu"
      >
        <div class="p-3 flex flex-col gap-1">
          {mobileLinks.map((item) => (
            <a
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              class="block px-4 py-3 rounded-lg text-gray-300 hover:bg-white/10 hover:text-white transition font-medium"
              data-close-menu
            >
              {item.label}
            </a>
          ))}

          <div class="h-px bg-white/10 my-2 mx-2"></div>

          <a
            href={links.contact}
            class="block px-4 py-3 rounded-lg text-orange-400 hover:bg-orange-500/10 transition font-bold"
            data-close-menu
          >
            {labels.contact}
          </a>

          <div class="px-4 py-2">
            <LanguageSwitcher linksOverride={languageLinks} />
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- CSS + Script -->
<style is:global>
  /* ring conic gradient como no Vite antigo */
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .spin-ring {
    background: conic-gradient(
      from 90deg at 50% 50%,
      #000000 0%,
      #000000 50%,
      #f97316 100%
    );
    animation: spin 3s linear infinite;
  }
</style>

<script is:inline>
  // Mobile menu: sem React, sem framer-motion — só funciona™
  const btn = document.getElementById("menuBtn");
  const menu = document.getElementById("mobileMenu");
  const iconMenu = document.getElementById("iconMenu");
  const iconClose = document.getElementById("iconClose");

  function setOpen(next) {
    if (!btn || !menu || !iconMenu || !iconClose) return;
    btn.setAttribute("aria-expanded", String(next));
    menu.classList.toggle("hidden", !next);
    iconMenu.classList.toggle("hidden", next);
    iconClose.classList.toggle("hidden", !next);
  }

  function isOpen() {
    return btn?.getAttribute("aria-expanded") === "true";
  }

  // Toggle
  btn?.addEventListener("click", (e) => {
    e.stopPropagation();
    setOpen(!isOpen());
  });

  // Fecha com ESC
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // Fecha ao clicar fora
  document.addEventListener("mousedown", (e) => {
    if (!isOpen()) return;
    const target = e.target;
    if (!(target instanceof Node)) return;
    if (menu?.contains(target)) return;
    if (btn?.contains(target)) return;
    setOpen(false);
  });

  // Fecha ao clicar em qualquer link marcado
  document.querySelectorAll("[data-close-menu]").forEach((el) => {
    el.addEventListener("click", () => setOpen(false));
  });

  // Services dropdown (desktop)
  const servicesRoot = document.querySelector("[data-services-root]");
  const servicesBtn = document.getElementById("servicesBtn");
  const servicesMenu = document.getElementById("servicesMenu");
  const servicesArrow = document.querySelector("[data-services-arrow]");

  function setServicesOpen(next) {
    if (!servicesBtn || !servicesMenu) return;
    servicesBtn.setAttribute("aria-expanded", String(next));
    servicesMenu.classList.toggle("hidden", !next);
    if (servicesArrow) {
      servicesArrow.style.transform = next ? "rotate(180deg)" : "rotate(0deg)";
    }
  }

  function isServicesOpen() {
    return servicesBtn?.getAttribute("aria-expanded") === "true";
  }

  servicesBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    setServicesOpen(!isServicesOpen());
  });

  // Hover open on desktop (pointer: fine)
  if (servicesRoot && window.matchMedia("(hover: hover)").matches) {
    servicesRoot.addEventListener("mouseenter", () => setServicesOpen(true));
    servicesRoot.addEventListener("mouseleave", () => setServicesOpen(false));
  }

  // Fecha com ESC
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setServicesOpen(false);
  });

  // Fecha ao clicar fora
  document.addEventListener("mousedown", (e) => {
    if (!isServicesOpen()) return;
    const target = e.target;
    if (!(target instanceof Node)) return;
    if (servicesRoot?.contains(target)) return;
    setServicesOpen(false);
  });

  // Fecha ao clicar em link interno do dropdown
  document.querySelectorAll("[data-close-services]").forEach((el) => {
    el.addEventListener("click", () => setServicesOpen(false));
  });

  // Language dropdown (desktop)
  const langRoot = document.querySelector("[data-lang-root]");
  const langBtn = document.getElementById("langBtn");
  const langMenu = document.getElementById("langMenu");

  function setLangOpen(next) {
    if (!langBtn || !langMenu) return;
    langBtn.setAttribute("aria-expanded", String(next));
    langMenu.classList.toggle("hidden", !next);
  }

  function isLangOpen() {
    return langBtn?.getAttribute("aria-expanded") === "true";
  }

  langBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    setLangOpen(!isLangOpen());
  });

  if (langRoot && window.matchMedia("(hover: hover)").matches) {
    langRoot.addEventListener("mouseenter", () => setLangOpen(true));
    langRoot.addEventListener("mouseleave", () => setLangOpen(false));
  }

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setLangOpen(false);
  });

  document.addEventListener("mousedown", (e) => {
    if (!isLangOpen()) return;
    const target = e.target;
    if (!(target instanceof Node)) return;
    if (langRoot?.contains(target)) return;
    setLangOpen(false);
  });

  document.querySelectorAll("[data-close-lang]").forEach((el) => {
    el.addEventListener("click", () => setLangOpen(false));
  });
</script>
