---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getLocale, ui } from "../i18n/ui";

type Props = { languageLinks?: Array<{ locale: string; href: string }> };
const { languageLinks } = Astro.props as Props;
const locale = getLocale(Astro.currentLocale);
const dict =
  (ui as any)?.[locale] ?? (ui as any)?.es ?? (ui as any)?.en ?? (ui as any)?.pt ?? {};

const nav =
  (dict as any)?.nav ??
  (dict as any)?.common?.nav ??
  (dict as any)?.home?.nav ??
  {};

// Rótulos localizados da nova landing de serviço (fallback se não houver no i18n nav)
const AUTOMATION_NAV: Record<string, { label: string; desc: string }> = {
  es: { label: "Automatización con IA", desc: "Agentes, procesos y n8n a medida" },
  pt: { label: "Automação com IA", desc: "Agentes, processos e n8n sob medida" },
  en: { label: "AI Automation", desc: "Agents, processes and custom n8n" },
};
const automationNav = AUTOMATION_NAV[locale] ?? AUTOMATION_NAV.es;
const CHATBOTS_NAV: Record<string, { label: string; desc: string }> = {
  es: { label: "Chatbots con IA", desc: "WhatsApp, asistentes y reservas 24/7" },
  pt: { label: "Chatbots com IA", desc: "WhatsApp, assistentes e agendamentos 24/7" },
  en: { label: "AI Chatbots", desc: "WhatsApp, assistants and 24/7 booking" },
};
const chatbotsNav = CHATBOTS_NAV[locale] ?? CHATBOTS_NAV.es;
const WEB_NAV: Record<string, { label: string; desc: string }> = {
  es: { label: "Diseño web", desc: "Sitios rápidos, SEO y conversión" },
  pt: { label: "Criação de sites", desc: "Sites rápidos, SEO e conversão" },
  en: { label: "Web design", desc: "Fast sites, SEO and conversion" },
};
const webNav = WEB_NAV[locale] ?? WEB_NAV.es;
const SEO_NAV: Record<string, { label: string; desc: string }> = {
  es: { label: "Agencia SEO", desc: "Posicionamiento y AI Search" },
  pt: { label: "Agência de SEO", desc: "Posicionamento e AI Search" },
  en: { label: "SEO agency", desc: "Rankings and AI Search" },
};
const seoNav = SEO_NAV[locale] ?? SEO_NAV.es;
const MARKETING_NAV: Record<string, { label: string; desc: string }> = {
  es: { label: "Marketing digital", desc: "Estrategia, ads y automatización" },
  pt: { label: "Marketing digital", desc: "Estratégia, ads e automação" },
  en: { label: "Digital marketing", desc: "Strategy, ads and automation" },
};
const marketingNav = MARKETING_NAV[locale] ?? MARKETING_NAV.es;
const IA_NAV: Record<string, { label: string; desc: string }> = {
  es: { label: "Agencia de IA", desc: "Estrategia e implementación de IA" },
  pt: { label: "Agência de IA", desc: "Estratégia e implementação de IA" },
  en: { label: "AI agency", desc: "AI strategy and implementation" },
};
const iaNav = IA_NAV[locale] ?? IA_NAV.es;

const labels = {
  services: nav?.services ?? "Services",
  automation: nav?.automation ?? automationNav.label,
  automationDescription: nav?.automationDescription ?? automationNav.desc,
  chatbots: nav?.chatbots ?? chatbotsNav.label,
  chatbotsDescription: nav?.chatbotsDescription ?? chatbotsNav.desc,
  web: nav?.web ?? webNav.label,
  webDescription: nav?.webDescription ?? webNav.desc,
  seo: nav?.seo ?? seoNav.label,
  seoDescription: nav?.seoDescription ?? seoNav.desc,
  marketing: nav?.marketing ?? marketingNav.label,
  marketingDescription: nav?.marketingDescription ?? marketingNav.desc,
  ia: nav?.ia ?? iaNav.label,
  iaDescription: nav?.iaDescription ?? iaNav.desc,
  audit: nav?.audit ?? "Audit",
  auditDescription: nav?.auditDescription ?? "",
  roadmap: nav?.roadmap ?? "Roadmap",
  roadmapDescription: nav?.roadmapDescription ?? "",
  implementation: nav?.implementation ?? "Implementation",
  implementationDescription: nav?.implementationDescription ?? "",
  methodology: nav?.methodology ?? "Methodology",
  portfolio: nav?.portfolio ?? "Portfolio",
  community: nav?.community ?? "Community",
  youtube: nav?.youtube ?? "YouTube",
  blog: nav?.blog ?? "Blog",
  contact: nav?.contact ?? "Contact",
};

const withLocale = (path: string) => `/${locale}/${path}`.replace(/\/+$/, "/");

// Links (mantém os do header antigo)
const links = {
  home: `/${locale}/`,
  automation: withLocale("servicios/automatizacion-ia/"),
  chatbots: withLocale("servicios/chatbots/"),
  web: withLocale("servicios/diseno-web/"),
  seo: withLocale("servicios/agencia-seo/"),
  marketing: withLocale("servicios/marketing-digital/"),
  ia: withLocale("servicios/agencia-ia/"),
  audit: withLocale("auditoria-de-sistemas/"),
  roadmap: withLocale("roadmap-tecnologico/"),
  implementation: withLocale("implementacion/"),
  methodology: withLocale("metodologia/"),
  portfolio: withLocale("portfolio/"),
  blog: withLocale("blog/"),
  contact: withLocale("contact/"),
  community: "https://www.skool.com/ia-operators-hub-9023/about",
  youtube: "https://www.youtube.com/@IAOperators",
};

const mobileLinks = [
  { key: "automation", href: links.automation, external: false },
  { key: "chatbots", href: links.chatbots, external: false },
  { key: "web", href: links.web, external: false },
  { key: "seo", href: links.seo, external: false },
  { key: "marketing", href: links.marketing, external: false },
  { key: "ia", href: links.ia, external: false },
  { key: "audit", href: links.audit, external: false },
  { key: "roadmap", href: links.roadmap, external: false },
  { key: "implementation", href: links.implementation, external: false },
  { key: "methodology", href: links.methodology, external: false },
  { key: "portfolio", href: links.portfolio, external: false },
  { key: "community", href: links.community, external: true },
  { key: "youtube", href: links.youtube, external: true },
  { key: "blog", href: links.blog, external: false },
];
---

<header class="fixed top-6 left-0 right-0 z-50 flex justify-center pointer-events-none">
  <div
    class="
      relative flex items-center gap-6
      w-[90%] sm:w-auto sm:inline-flex
      py-2 pl-6 pr-2
      rounded-full
      border border-white/10
      bg-white/5
      backdrop-blur-2xl
      shadow-[0_12px_40px_rgba(0,0,0,0.55)]
      pointer-events-auto
    "
  >
    <div class="pointer-events-none absolute inset-0 rounded-full bg-linear-to-b from-white/10 via-white/0 to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px rounded-full bg-linear-to-r from-transparent via-white/30 to-transparent"></div>

    <div class="relative z-10 flex items-center gap-6 w-full">
      <!-- Logo -->
      <a href={links.home} class="shrink-0" data-close-menu>
        <img
          src="https://framerusercontent.com/images/XwOvRWgJ6sirH2T1tQHcZMN4zXg.png"
          alt="IA Operators"
          class="h-6 md:h-7 w-auto select-none"
        />
      </a>

      <!-- Desktop navigation -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-300 whitespace-nowrap">
        <!-- Services dropdown -->
        <div
          id="servicesDropdown"
          class="relative"
          data-services-root
        >
          <button
            type="button"
            id="servicesBtn"
            class="flex items-center gap-1.5 hover:text-white transition-colors cursor-pointer"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="servicesMenu"
          >
            {labels.services}
            <span class="text-xs transition-transform duration-200" data-services-arrow>▾</span>
          </button>

          <div
            id="servicesMenu"
            class="
              hidden absolute left-1/2 -translate-x-1/2 top-full pt-3
              z-50
            "
            role="menu"
          >
            <div
              class="
                w-[360px]
                rounded-2xl
                border border-white/10
                bg-[#0a0a0a]/95
                backdrop-blur-xl
                shadow-[0_20px_60px_rgba(0,0,0,0.7)]
                p-2
              "
            >
              <a
                href={links.automation}
                class="block rounded-xl px-4 py-3 hover:bg-white/5 transition group"
                role="menuitem"
                data-close-services
              >
                <div class="flex items-center gap-2 text-white font-semibold">
                  <span class="text-orange-400">01</span>
                  {labels.automation}
                </div>
                {labels.automationDescription && (
                  <p class="text-xs text-gray-400 mt-1 group-hover:text-gray-300">
                    {labels.automationDescription}
                  </p>
                )}
              </a>

              <a
                href={links.chatbots}
                class="block rounded-xl px-4 py-3 hover:bg-white/5 transition group"
                role="menuitem"
                data-close-services
              >
                <div class="flex items-center gap-2 text-white font-semibold">
                  <span class="text-orange-400">02</span>
                  {labels.chatbots}
                </div>
                {labels.chatbotsDescription && (
                  <p class="text-xs text-gray-400 mt-1 group-hover:text-gray-300">
                    {labels.chatbotsDescription}
                  </p>
                )}
              </a>

              <a
                href={links.web}
                class="block rounded-xl px-4 py-3 hover:bg-white/5 transition group"
                role="menuitem"
                data-close-services
              >
                <div class="flex items-center gap-2 text-white font-semibold">
                  <span class="text-orange-400">03</span>
                  {labels.web}
                </div>
                {labels.webDescription && (
                  <p class="text-xs text-gray-400 mt-1 group-hover:text-gray-300">
                    {labels.webDescription}
                  </p>
                )}
              </a>

              <a
                href={links.seo}
                class="block rounded-xl px-4 py-3 hover:bg-white/5 transition group"
                role="menuitem"
                data-close-services
              >
                <div class="flex items-center gap-2 text-white font-semibold">
                  <span class="text-orange-400">04</span>
                  {labels.seo}
                </div>
                {labels.seoDescription && (
                  <p class="text-xs text-gray-400 mt-1 group-hover:text-gray-300">
                    {labels.seoDescription}
                  </p>
                )}
              </a>

              <a
                href={links.marketing}
                class="block rounded-xl px-4 py-3 hover:bg-white/5 transition group"
                role="menuitem"
                data-close-services
              >
                <div class="flex items-center gap-2 text-white font-semibold">
                  <span class="text-orange-400">05</span>
                  {labels.marketing}
                </div>
                {labels.marketingDescription && (
                  <p class="text-xs text-gray-400 mt-1 group-hover:text-gray-300">
                    {labels.marketingDescription}
                  </p>
                )}
              </a>

              <a
                href={links.ia}
                class="block rounded-xl px-4 py-3 hover:bg-white/5 transition group"
                role="menuitem"
                data-close-services
              >
                <div class="flex items-center gap-2 text-white font-semibold">
                  <span class="text-orange-400">06</span>
                  {labels.ia}
                </div>
                {labels.iaDescription && (
                  <p class="text-xs text-gray-400 mt-1 group-hover:text-gray-300">
                    {labels.iaDescription}
                  </p>
                )}
              </a>

              <a
                href={links.audit}
                class="block rounded-xl px-4 py-3 hover:bg-white/5 transition group"
                role="menuitem"
                data-close-services
              >
                <div class="flex items-center gap-2 text-white font-semibold">
                  <span class="text-orange-400">07</span>
                  {labels.audit}
                </div>
                {labels.auditDescription && (
                  <p class="text-xs text-gray-400 mt-1 group-hover:text-gray-300">
                    {labels.auditDescription}
                  </p>
                )}
              </a>

              <a
                href={links.roadmap}
                class="block rounded-xl px-4 py-3 hover:bg-white/5 transition group"
                role="menuitem"
                data-close-services
              >
                <div class="flex items-center gap-2 text-white font-semibold">
                  <span class="text-orange-400">08</span>
                  {labels.roadmap}
                </div>
                {labels.roadmapDescription && (
                  <p class="text-xs text-gray-400 mt-1 group-hover:text-gray-300">
                    {labels.roadmapDescription}
                  </p>
                )}
              </a>

              <a
                href={links.implementation}
                class="block rounded-xl px-4 py-3 hover:bg-white/5 transition group"
                role="menuitem"
                data-close-services
              >
                <div class="flex items-center gap-2 text-white font-semibold">
                  <span class="text-orange-400">09</span>
                  {labels.implementation}
                </div>
                {labels.implementationDescription && (
                  <p class="text-xs text-gray-400 mt-1 group-hover:text-gray-300">
                    {labels.implementationDescription}
                  </p>
                )}
              </a>
            </div>
          </div>
        </div>

        <a href={links.methodology} class="hover:text-white transition-colors">
          {labels.methodology}
        </a>

        <a href={links.portfolio} class="hover:text-white transition-colors">
          {labels.portfolio}
        </a>

        <a href={links.blog} class="hover:text-white transition-colors">
          {labels.blog}
        </a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-2 ml-auto md:ml-0">
        <!-- Desktop social + lang icons -->
        <div class="hidden md:flex items-center gap-1.5">
          <a
            href={links.youtube}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={labels.youtube}
            title={labels.youtube}
            class="
              h-10 w-10
              rounded-full
              border border-white/10
              bg-white/5 hover:bg-white/10
              text-gray-300 hover:text-white
              flex items-center justify-center
              transition
            "
          >
            <svg width="18" height="18" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
              <path d="M31.331 8.248A4.022 4.022 0 0 0 28.502 5.4C26.006 4.727 16 4.727 16 4.727s-10.007 0-12.502.673A4.02 4.02 0 0 0 .669 8.248C0 10.76 0 16 0 16s0 5.241.669 7.752a4.018 4.018 0 0 0 2.829 2.847c2.496.673 12.502.673 12.502.673s10.007 0 12.502-.673a4.02 4.02 0 0 0 2.829-2.847C32 21.24 32 16 32 16s0-5.24-.669-7.752Zm-18.604 12.51v-9.516L21.091 16l-8.364 4.758Z" />
            </svg>
          </a>

          <a
            href={links.community}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${labels.community} · Skool`}
            title={`${labels.community} · Skool`}
            class="
              h-10 w-10
              rounded-full
              border border-white/10
              bg-white/5 hover:bg-white/10
              text-gray-300 hover:text-white
              flex items-center justify-center
              transition
            "
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17.5 6.5C16 5.5 14.2 5 12 5c-3 0-5 1-5 3s2 2.5 5 3 5 1.5 5 3.5-2 3.5-5 3.5c-2.2 0-4-.5-5.5-1.5"/>
            </svg>
          </a>

          <LanguageSwitcher linksOverride={languageLinks} variant="dropdown" />
        </div>

        <!-- Desktop contact button (efeito conic spin) -->
        <a href={links.contact} class="hidden md:inline-flex" data-close-menu>
          <span class="relative group">
            <span class="relative overflow-hidden rounded-full p-1px inline-flex">
              <span class="spin-ring absolute inset-[-1000%]"></span>
              <span class="relative flex items-center gap-2 rounded-full bg-[#0f0f0f]/70 px-5 py-2.5 text-sm font-medium text-white hover:bg-white/5 transition">
                {labels.contact}
                <span class="text-gray-400 group-hover:text-white transition">↗</span>
              </span>
            </span>
          </span>
        </a>

        <!-- Hamburger mobile -->
        <button
          id="menuBtn"
          type="button"
          class="
            md:hidden
            h-12 w-12
            rounded-full
            border border-white/10
            bg-white/5 hover:bg-white/10
            backdrop-blur-xl
            text-white
            flex items-center justify-center
            transition
            cursor-pointer
            z-50
          "
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobileMenu"
        >
          <span id="iconMenu" class="pointer-events-none">☰</span>
          <span id="iconClose" class="pointer-events-none hidden">✕</span>
        </button>
      </div>

      <!-- Mobile menu (hidden by default) -->
      <div
        id="mobileMenu"
        class="
          hidden md:hidden
          absolute top-[120%] right-0
          w-280px
          rounded-2xl
          border border-white/10
          bg-[#0a0a0a]
          shadow-[0_0_50px_rgba(0,0,0,0.8)]
          z-999
          overflow-hidden
        "
        role="dialog"
        aria-label="Mobile menu"
      >
        <div class="p-3 flex flex-col gap-1">
          {mobileLinks.map((item) => (
            <a
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              class="block px-4 py-3 rounded-lg text-gray-300 hover:bg-white/10 hover:text-white transition font-medium"
              data-close-menu
            >
              {(labels as any)[item.key] ?? item.key}
            </a>
          ))}

          <div class="h-px bg-white/10 my-2 mx-2"></div>

          <a
            href={links.contact}
            class="block px-4 py-3 rounded-lg text-orange-400 hover:bg-orange-500/10 transition font-bold"
            data-close-menu
          >
            {labels.contact}
          </a>

          <div class="px-4 py-2">
            <LanguageSwitcher linksOverride={languageLinks} />
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- CSS + Script -->
<style is:global>
  /* ring conic gradient como no Vite antigo */
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .spin-ring {
    background: conic-gradient(
      from 90deg at 50% 50%,
      #000000 0%,
      #000000 50%,
      #f97316 100%
    );
    animation: spin 3s linear infinite;
  }
</style>

<script is:inline>
  // Mobile menu: sem React, sem framer-motion — só funciona™
  const btn = document.getElementById("menuBtn");
  const menu = document.getElementById("mobileMenu");
  const iconMenu = document.getElementById("iconMenu");
  const iconClose = document.getElementById("iconClose");

  function setOpen(next) {
    if (!btn || !menu || !iconMenu || !iconClose) return;
    btn.setAttribute("aria-expanded", String(next));
    menu.classList.toggle("hidden", !next);
    iconMenu.classList.toggle("hidden", next);
    iconClose.classList.toggle("hidden", !next);
  }

  function isOpen() {
    return btn?.getAttribute("aria-expanded") === "true";
  }

  // Toggle
  btn?.addEventListener("click", (e) => {
    e.stopPropagation();
    setOpen(!isOpen());
  });

  // Fecha com ESC
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // Fecha ao clicar fora
  document.addEventListener("mousedown", (e) => {
    if (!isOpen()) return;
    const target = e.target;
    if (!(target instanceof Node)) return;
    if (menu?.contains(target)) return;
    if (btn?.contains(target)) return;
    setOpen(false);
  });

  // Fecha ao clicar em qualquer link marcado
  document.querySelectorAll("[data-close-menu]").forEach((el) => {
    el.addEventListener("click", () => setOpen(false));
  });

  // Services dropdown (desktop)
  const servicesRoot = document.querySelector("[data-services-root]");
  const servicesBtn = document.getElementById("servicesBtn");
  const servicesMenu = document.getElementById("servicesMenu");
  const servicesArrow = document.querySelector("[data-services-arrow]");

  function setServicesOpen(next) {
    if (!servicesBtn || !servicesMenu) return;
    servicesBtn.setAttribute("aria-expanded", String(next));
    servicesMenu.classList.toggle("hidden", !next);
    if (servicesArrow) {
      servicesArrow.style.transform = next ? "rotate(180deg)" : "rotate(0deg)";
    }
  }

  function isServicesOpen() {
    return servicesBtn?.getAttribute("aria-expanded") === "true";
  }

  servicesBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    setServicesOpen(!isServicesOpen());
  });

  // Hover open on desktop (pointer: fine)
  if (servicesRoot && window.matchMedia("(hover: hover)").matches) {
    servicesRoot.addEventListener("mouseenter", () => setServicesOpen(true));
    servicesRoot.addEventListener("mouseleave", () => setServicesOpen(false));
  }

  // Fecha com ESC
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setServicesOpen(false);
  });

  // Fecha ao clicar fora
  document.addEventListener("mousedown", (e) => {
    if (!isServicesOpen()) return;
    const target = e.target;
    if (!(target instanceof Node)) return;
    if (servicesRoot?.contains(target)) return;
    setServicesOpen(false);
  });

  // Fecha ao clicar em link interno do dropdown
  document.querySelectorAll("[data-close-services]").forEach((el) => {
    el.addEventListener("click", () => setServicesOpen(false));
  });

  // Language dropdown (desktop)
  const langRoot = document.querySelector("[data-lang-root]");
  const langBtn = document.getElementById("langBtn");
  const langMenu = document.getElementById("langMenu");

  function setLangOpen(next) {
    if (!langBtn || !langMenu) return;
    langBtn.setAttribute("aria-expanded", String(next));
    langMenu.classList.toggle("hidden", !next);
  }

  function isLangOpen() {
    return langBtn?.getAttribute("aria-expanded") === "true";
  }

  langBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    setLangOpen(!isLangOpen());
  });

  if (langRoot && window.matchMedia("(hover: hover)").matches) {
    langRoot.addEventListener("mouseenter", () => setLangOpen(true));
    langRoot.addEventListener("mouseleave", () => setLangOpen(false));
  }

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setLangOpen(false);
  });

  document.addEventListener("mousedown", (e) => {
    if (!isLangOpen()) return;
    const target = e.target;
    if (!(target instanceof Node)) return;
    if (langRoot?.contains(target)) return;
    setLangOpen(false);
  });

  document.querySelectorAll("[data-close-lang]").forEach((el) => {
    el.addEventListener("click", () => setLangOpen(false));
  });
</script>
