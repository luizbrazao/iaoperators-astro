---
// Las tres páginas del pilar de arquitectura (Radiografía Digital, Roadmap
// tecnológico, Implementación) con el lenguaje editorial. Solo presenta: el
// texto sale del mismo diccionario (audit / roadmap / implementation) que la
// versión anterior y el orden de las secciones no cambia, así que H1, H2, H3 y
// enlaces se mantienen. EN y PT siguen con el markup de cada página.
import RelatedCases from "@/components/RelatedCases.astro";
import PilarArquitectura from "@/components/PilarArquitectura.astro";
import { getArquitectura, arquitecturaHubHref, ARQUITECTURA_TITLE } from "@/data/servicios";
import copy from "@/i18n/locales/es/pagesEditorial.json";
import "@/styles/editorial-pages.css";

type Step = "audit" | "roadmap" | "implementation";
interface NextLink { href: string; title: string; body: string; cta: string }
interface Props {
  /** Diccionario de la página: audit, roadmap o implementation. */
  d: any;
  current: Step;
  contactHref: string;
  /** Destino del CTA secundario del hero (ancla de la propia página). */
  heroSecondaryHref: string;
  /** Ancla de la sección de entregables o de la metodología, si la página la usa. */
  deliverablesId?: string;
  methodologyId?: string;
  /** Enlace "← paso anterior" junto al CTA del precio. */
  pricingBack?: { href: string; label: string };
  /** Casos de prueba (RelatedCases), solo donde la página ya los mostraba. */
  relatedPath?: string;
  /** "Qué viene después", solo en la Radiografía. */
  next?: { title: string; body: string; items: NextLink[] };
}
const { d, current, contactHref, heroSecondaryHref, deliverablesId, methodologyId, pricingBack, relatedPath, next } = Astro.props;
const { hero = {}, problem = {}, deliverables = {}, methodology = {}, audience = {}, pricing = {}, faq = {}, finalCta = {} } = d ?? {};
const L = copy.servicioArquitectura;
const paso = getArquitectura("es").find((p) => p.key === current);
const bare = (text = "") => text.replace(/\s*[↗→←]\s*$/, "").replace(/^\s*←\s*/, "");
const pad = (n: number) => String(n).padStart(2, "0");
const title: string = hero.title ?? "";
const split = title.indexOf(": ");
const h1Lead = split > 0 ? title.slice(0, split + 1) : title;
const h1Accent = split > 0 ? title.slice(split + 2) : "";
---
<div class="ed-container">
  <header class="pg-hero pg-hero-compact">
    <nav class="pf-crumbs ed-eyebrow" aria-label={copy.breadcrumb.label}>
      <ol>
        <li><a href="/es/">{copy.breadcrumb.home}</a></li>
        <li><a href={arquitecturaHubHref("es")}>{ARQUITECTURA_TITLE.es}</a></li>
        <li><span aria-current="page">{paso?.label}</span></li>
      </ol>
    </nav>
    <h1>{h1Lead}{h1Accent && <> <span>{h1Accent}</span></>}</h1>
    <div class="pg-hero-bottom">
      <p class="ed-eyebrow">{hero.badge ?? `${L.pillar} · ${paso?.label}`}</p>
      <div>
        {hero.subtitle && <p class="pg-lead pg-lead-strong">{hero.subtitle}</p>}
        {hero.intro && <p class="pg-lead pg-lead-muted">{hero.intro}</p>}
        <div class="pg-actions">
          <a class="ed-button" href={contactHref}>{bare(hero.ctaPrimary)}<span class="ed-arrow" aria-hidden="true">↗</span></a>
          {hero.ctaSecondary && <a class="ed-underlined" href={heroSecondaryHref}>{hero.ctaSecondary} <span aria-hidden="true">↓</span></a>}
        </div>
      </div>
    </div>
  </header>

  {problem.items?.length > 0 && (
    <section class="pg-section" aria-labelledby="problema-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.problema}</p>
        <div>
          <h2 id="problema-title">{problem.title}</h2>
          {problem.subtitle && <div class="pg-prose"><p>{problem.subtitle}</p></div>}
        </div>
      </div>
      <ul class="pg-symptoms">{problem.items.map((item: string) => <li>{item}</li>)}</ul>
    </section>
  )}

  {deliverables.items?.length > 0 && (
    <section class="pg-section" id={deliverablesId} aria-labelledby="entregables-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.entregables}</p>
        <div>
          <h2 id="entregables-title">{deliverables.title}</h2>
          {deliverables.subtitle && <div class="pg-prose"><p>{deliverables.subtitle}</p></div>}
        </div>
      </div>
      <ol class="pg-columns">
        {deliverables.items.map((item: any, index: number) => (
          <li><span class="ed-eyebrow">{pad(index + 1)}</span><h3>{item.title}</h3><p>{item.body}</p></li>
        ))}
      </ol>
    </section>
  )}

  {methodology.phases?.length > 0 && (
    <section class="pg-section" id={methodologyId} aria-labelledby="metodologia-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{methodology.badge ?? L.metodologia}</p>
        <div>
          <h2 id="metodologia-title">{methodology.title}</h2>
          {methodology.subtitle && <div class="pg-prose"><p>{methodology.subtitle}</p></div>}
        </div>
      </div>
      <ol class="pg-phases">
        {methodology.phases.map((phase: any) => (
          <li><span class="ed-eyebrow">{phase.code}</span><h3>{phase.title}</h3><p>{phase.body}</p></li>
        ))}
      </ol>
    </section>
  )}

  {audience.items?.length > 0 && (
    <section class="pg-section" aria-labelledby="audiencia-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.audiencia}</p>
        <div>
          <h2 id="audiencia-title">{audience.title}</h2>
          {audience.subtitle && <div class="pg-prose"><p>{audience.subtitle}</p></div>}
          <ul class="pg-checklist">{audience.items.map((item: string) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </section>
  )}

  {pricing.title && (
    <section class="pg-pricing" aria-labelledby="inversion-title">
      <p class="ed-eyebrow">{pricing.badge ?? L.inversion}</p>
      <div>
        <h2 id="inversion-title">{pricing.title}</h2>
        {pricing.subtitle && <p class="pg-pricing-sub">{pricing.subtitle}</p>}
        {pricing.items?.length > 0 && <ul class="pg-checklist">{pricing.items.map((item: string) => <li>{item}</li>)}</ul>}
        <div class="pg-actions">
          <a class="ed-button" href={contactHref}>{bare(pricing.cta)}<span class="ed-arrow" aria-hidden="true">↗</span></a>
          {pricingBack && <a class="ed-underlined" href={pricingBack.href}><span aria-hidden="true">←</span> {bare(pricingBack.label)}</a>}
        </div>
      </div>
    </section>
  )}
</div>

{relatedPath && <RelatedCases path={relatedPath} locale="es" variant="editorial" />}

<div class="ed-container">
  {faq.items?.length > 0 && (
    <section class="pg-section pg-faq ed-faq" aria-labelledby="faq-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.faq}</p>
        <div>
          <h2 id="faq-title">{faq.title}</h2>
          <div class="pg-faq-list">
            {faq.items.map((item: any) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
          </div>
        </div>
      </div>
    </section>
  )}

  {next && (
    <section class="pg-section pg-section-flush pg-next" aria-labelledby="despues-title">
      <div class="ed-section-intro">
        <p class="ed-eyebrow">{L.despues}</p>
        <div>
          <h2 id="despues-title">{next.title}</h2>
          <div class="pg-prose"><p>{next.body}</p></div>
        </div>
      </div>
      <div class="pg-offers">
        {next.items.map((item) => (
          <a class="ed-offer" href={item.href}>
            <span class="ed-eyebrow">{bare(item.cta)}</span><h3>{item.title}</h3><p>{item.body}</p><span class="ed-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  )}
</div>

<div class="pg-method-wrap">
  <PilarArquitectura current={current} locale="es" variant="editorial" />
</div>

{finalCta.title && (
  <section class="ed-closing" aria-labelledby="servicio-closing-title">
    <div class="ed-container">
      <p class="ed-eyebrow">{copy.closingLabel}</p>
      <h2 id="servicio-closing-title" class="pg-closing-title">{finalCta.title}</h2>
      {finalCta.subtitle && <p class="pg-closing-copy">{finalCta.subtitle}</p>}
      <a class="ed-button" href={contactHref}>{bare(finalCta.cta)}<span class="ed-arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>
)}
